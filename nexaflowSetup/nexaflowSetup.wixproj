<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <!-- ICE61 is the expected, benign companion of MajorUpgrade/@AllowSameVersionUpgrades. -->
    <SuppressIces>ICE61</SuppressIces>
    <!--
      WIX1101 says a versioned file was given its language by the project rather than by the file. That is the
      point for the fonts, which are the only files given one (see HarvestCoreOutput): a font has no language to
      state, and 0, neutral, is the honest answer — the warning has nothing left to tell.
    -->
    <SuppressSpecificWarnings>1101</SuppressSpecificWarnings>
    <!--
      The payload is built by BuildAppPayload and HarvestToolsOutput below, not by anything Visual Studio can
      see, so its fast up-to-date check would skip this project whenever only Core's sources changed. MSBuild's
      own incrementality is what decides here.
    -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <_CoreCsproj>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\src\Nexaflow.Core\Nexaflow.Core.csproj'))</_CoreCsproj>
    <NexaflowVersion>$([System.Text.RegularExpressions.Regex]::Match($(_CoreCsproj), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</NexaflowVersion>
    <DefineConstants>AppVersion=$(NexaflowVersion)</DefineConstants>
  </PropertyGroup>

  <!--
    What the MSI carries is built from this project's targets, never through a ProjectReference, because what a
    ProjectReference builds depends on who is building:

      • A solution build hands every project beneath it the solution's configuration map, and NexaflowSetup.slnx
        names only the two wixprojs. A project missing from that map has its references' Configuration unset, so
        Core came out Release and every feature, provider and library under it came out Debug — and the MSI
        shipped those Debug assemblies beside a Release Nexaflow.exe.
      • Visual Studio builds only the projects in the solution and passes BuildProjectReferences=false to each, so
        Core and the CLI were not built at all. The harvest read whatever an earlier Nexaflow.slnx build had left
        behind, and a checkout without one stopped at the snaplink check, looking for an nfi.dll nothing built.

    So the payload is restored and built the way the command line builds one project on its own: Configuration
    and Platform passed down, references built, and the solution's map and the IDE's flags taken away. Both builds
    use the same set, so a later query of either project lands on the instance that built it.
  -->
  <PropertyGroup>
    <_PayloadBuildProperties>Configuration=$(Configuration);Platform=$(Platform);BuildProjectReferences=true</_PayloadBuildProperties>
    <_PayloadContextProperties>CurrentSolutionConfigurationContents;BuildingSolutionFile;BuildingInsideVisualStudio;SolutionDir;SolutionExt;SolutionFileName;SolutionName;SolutionPath</_PayloadContextProperties>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to the WixToolset.Sdk version above rather than floating. A floating spec makes NuGet
      re-check the feed on every restore, so a slow, offline or skipped restore resolves nothing — and
      WiX then reports the UI extension as "The Package element contains an unhandled extension element
      'WixUI'", which reads as a broken Package.wxs rather than as a restore that never happened. It
      resolved to 7.0.0 regardless; saying so lets it come from the local cache. Bump with the SDK.
    -->
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>

  <!--
    Regenerate the installer branding art so the painted version tracks Nexaflow.Core's <Version>
    (the same source AppVersion reads). Incremental: runs only when Core.csproj or the script changes
    — i.e. on a version bump — so a normal installer rebuild produces no image churn, and a plain
    Core build never triggers it at all. Windows-only (GDI+ via powershell.exe); WiX is Windows-only
    too, so this never blocks a cross-platform build. Regenerates the bundle's banner as well, and the
    bundle's ProjectReference to this project guarantees it runs before the bootstrapper links.
  -->
  <Target Name="RegenerateBranding"
          BeforeTargets="CoreCompile"
          Inputs="$(MSBuildThisFileDirectory)generate-branding.ps1;$(MSBuildThisFileDirectory)..\src\Nexaflow.Core\Nexaflow.Core.csproj"
          Outputs="$(MSBuildThisFileDirectory)banner.bmp;$(MSBuildThisFileDirectory)dialog.bmp;$(MSBuildThisFileDirectory)License.rtf;$(MSBuildThisFileDirectory)..\nexaflowBundle\bundlebanner.png">
    <Message Importance="high" Text="Regenerating installer branding from Nexaflow.Core &lt;Version&gt;…" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)generate-branding.ps1&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>

  <!--
    Release gate: every snaplink in the product tree must still point at a real target (file exists, markdown
    heading resolves, class/method still declared, URL well-formed). Runs the *same* SnaplinkValidator the
    Product tab's "Validate snaplinks" uses — one implementation, so the build and the UI can never disagree.

    Only the installer build runs this, so a normal `dotnet build Nexaflow.slnx` is unaffected. `.product/` is
    gitignored working state, so a clean CI checkout has no tree: the CLI exits 0 with "nothing to validate"
    rather than failing. Exit 1 = broken snaplinks → the release build stops here.
  -->
  <!--
    The validator is the nfi.exe this installer ships, published by HarvestToolsOutput — so the tree is checked by
    exactly the binary a user gets, and there is no second build of the CLI to keep in step with the first.
    HarvestToolsOutput fails before this runs if that nfi.exe is missing, so an exit code here is the validator's
    own: 1 means the tree has issues, anything else that it could not run.
  -->
  <Target Name="ValidateSnaplinks" DependsOnTargets="HarvestToolsOutput" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_RepoRoot>
    </PropertyGroup>

    <Message Importance="high" Text="Validating product snaplinks in $(_RepoRoot)…" />
    <Exec Command="&quot;$(_ToolsStage)nfi.exe&quot; validate &quot;$(_RepoRoot)&quot;" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_SnaplinkExit" />
    </Exec>

    <!--
      Kind-agnostic on purpose: the gate now covers more than broken snaplinks (a stale [CoversNode] id is a
      rotten test declaration, not a link), and naming only snaplinks sent the reader hunting the tree for a
      link that was never there. The listed issues above say which family each one is.
    -->
    <Error Condition="'$(_SnaplinkExit)' == '1'"
           Text="Product tree integrity check failed (see the itemised list above). Snaplink issues are fixable in the Product tab (⋮ → Validate snaplinks → Integrity); a stale test coverage declaration is fixed in the test's [CoversNode] attribute, or by restoring the node. Re-run with: dotnet run --project src/Nexaflow.Services.Initiatives.Cli -- validate ." />
    <Error Condition="'$(_SnaplinkExit)' != '0' and '$(_SnaplinkExit)' != '1'"
           Text="Product snaplink validator failed to run (exit $(_SnaplinkExit))." />
  </Target>

  <!--
    Payload for the optional Tools feature: nfi.exe and its dependencies, harvested into
    [INSTALLFOLDER]tools.

    Published RID-specific (win-x64) rather than harvested from the CLI's plain build output, because
    tree-sitter and libgit2 ship native binaries for EVERY runtime identifier — the framework build
    output is ~618 MB of linux/osx/arm payload we would otherwise put in the MSI. A win-x64 publish
    prunes that to ~73 MB. SelfContained=false because the bundle already installs the .NET 10 runtime.

    Invoked through the MSBuild task, not Exec("dotnet publish"): a raw Exec would spawn a second build
    process of Syntax/IO.Common racing this one on the same obj/bin (the CS2012 hazard described at
    BuildAppPayload). Removing BuildingInsideVisualStudio also keeps the CLI's NfiPublishViaScript hook, which
    is for Visual Studio's Publish button, out of this publish.
  -->
  <Target Name="HarvestToolsOutput" DependsOnTargets="RestoreAppPayload" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_ToolsCliProj>$(MSBuildThisFileDirectory)..\src\Nexaflow.Services.Initiatives.Cli\Nexaflow.Services.Initiatives.Cli.csproj</_ToolsCliProj>
      <_ToolsStage>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)tools-payload'))\</_ToolsStage>
      <_ToolsWxs>$(IntermediateOutputPath)ToolsComponents.wxs</_ToolsWxs>
    </PropertyGroup>

    <Message Importance="high" Text="Publishing nfi.exe (win-x64) for the optional Tools feature…" />

    <MSBuild Projects="$(_ToolsCliProj)" Targets="Publish"
             Properties="$(_PayloadBuildProperties);RuntimeIdentifier=win-x64;SelfContained=false;PublishDir=$(_ToolsStage)"
             RemoveProperties="$(_PayloadContextProperties)" />

    <Error Condition="!Exists('$(_ToolsStage)nfi.exe')"
           Text="Tools payload is missing: expected nfi.exe in $(_ToolsStage) after publishing Nexaflow.Services.Initiatives.Cli for win-x64. Check the CLI project's AssemblyName and RuntimeIdentifiers." />

    <ItemGroup>
      <_ToolsFile Include="$(_ToolsStage)**\*" Exclude="$(_ToolsStage)**\*.pdb" />
    </ItemGroup>

    <!--
      Guard against a stale staging directory silently shipping the wrong RID's natives: a win-x64
      publish must not contain linux/osx payload, and it must contain the tree-sitter grammars the
      graph build needs.
    -->
    <ItemGroup>
      <_ToolsForeignNative Include="@(_ToolsFile)"
          Condition="'%(Extension)' == '.so' or '%(Extension)' == '.dylib'" />
      <_ToolsTreeSitter Include="@(_ToolsFile)"
          Condition="$([System.String]::Copy('%(Filename)').StartsWith('tree-sitter'))" />
    </ItemGroup>

    <Error Condition="'@(_ToolsForeignNative->Count())' != '0'"
           Text="Tools payload is polluted: $(_ToolsStage) holds @(_ToolsForeignNative->Count()) non-Windows native binaries (.so/.dylib), so the publish was not RID-specific or the staging dir is stale. Delete $(_ToolsStage) and rebuild." />
    <Error Condition="'@(_ToolsTreeSitter->Count())' == '0'"
           Text="Tools payload is incomplete: no tree-sitter native grammars in $(_ToolsStage), so `nfi graph build` would fail on every file. Check that Nexaflow.Syntax's natives flow into the CLI's publish output." />

    <ItemGroup>
      <_ToolsWxsComp Include="@(_ToolsFile)" Condition="'%(_ToolsFile.RecursiveDir)' == ''">
        <Line>      &lt;Component&gt;&lt;File Source=&quot;%(_ToolsFile.Identity)&quot; /&gt;&lt;/Component&gt;</Line>
      </_ToolsWxsComp>
      <_ToolsWxsComp Include="@(_ToolsFile)" Condition="'%(_ToolsFile.RecursiveDir)' != ''">
        <Line>      &lt;Component Subdirectory=&quot;$([System.Text.RegularExpressions.Regex]::Replace('%(_ToolsFile.RecursiveDir)', '\\$', ''))&quot;&gt;&lt;File Source=&quot;%(_ToolsFile.Identity)&quot; /&gt;&lt;/Component&gt;</Line>
      </_ToolsWxsComp>
    </ItemGroup>

    <ItemGroup>
      <_ToolsWxsLine Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;" />
      <_ToolsWxsLine Include="&lt;Wix xmlns=&quot;http://wixtoolset.org/schemas/v4/wxs&quot;&gt;" />
      <_ToolsWxsLine Include="  &lt;Fragment&gt;" />
      <_ToolsWxsLine Include="    &lt;ComponentGroup Id=&quot;ToolsComponents&quot; Directory=&quot;TOOLSFOLDER&quot;&gt;" />
      <_ToolsWxsLine Include="@(_ToolsWxsComp->'%(Line)')" />
      <_ToolsWxsLine Include="    &lt;/ComponentGroup&gt;" />
      <_ToolsWxsLine Include="  &lt;/Fragment&gt;" />
      <_ToolsWxsLine Include="&lt;/Wix&gt;" />
    </ItemGroup>

    <WriteLinesToFile File="$(_ToolsWxs)" Lines="@(_ToolsWxsLine)" Overwrite="true" />

    <ItemGroup>
      <Compile Include="$(_ToolsWxs)" />
    </ItemGroup>
  </Target>

  <!--
    Restoring this solution restores the two wixprojs and nothing else, so the payload's packages are restored here,
    with the properties it is built with. Restore is its own evaluation, as `msbuild -restore` makes it: a fresh
    MSBuildRestoreSessionId keeps it apart from the build that follows, which then reads the props and targets the
    restore wrote rather than a pre-restore copy.
  -->
  <Target Name="RestoreAppPayload">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\src\Nexaflow.Core\Nexaflow.Core.csproj;$(MSBuildThisFileDirectory)..\src\Nexaflow.Services.Initiatives.Cli\Nexaflow.Services.Initiatives.Cli.csproj"
             Targets="Restore"
             Properties="$(_PayloadBuildProperties);MSBuildRestoreSessionId=$([System.Guid]::NewGuid());MSBuildIsRestoring=true"
             RemoveProperties="$(_PayloadContextProperties)" />
  </Target>

  <!--
    Builds Nexaflow.Core and, through its references, every feature, provider, language pack and library the app
    ships, all in $(Configuration)|$(Platform). Core's Build target returns the path it built, and that path is
    what HarvestCoreOutput harvests: the exact output of this build, never a folder guessed from the
    configuration name (which is how a stale folder once shipped without the Gemini provider).

    Exactly one build of Core happens. A second MSBuild call with a different set of global properties is a
    separate instance that runs beside the first and races it on Nexaflow.dll — under parallel MSBuild that
    surfaces as file-lock CS2012, a half-done WPF markup compile, or an incomplete harvest — which is why the
    property sets above are shared, and why nothing else here builds Core.
  -->
  <Target Name="BuildAppPayload" DependsOnTargets="RestoreAppPayload">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\src\Nexaflow.Core\Nexaflow.Core.csproj" Targets="Build"
             Properties="$(_PayloadBuildProperties)" RemoveProperties="$(_PayloadContextProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="_CoreRef" />
    </MSBuild>
  </Target>

  <!--
    Generate AppComponents.wxs at build time from all files in the Core output directory.
  -->
  <Target Name="HarvestCoreOutput" DependsOnTargets="BuildAppPayload" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_CoreProjDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\Nexaflow.Core'))</_CoreProjDir>
      <_CoreTargetPath>@(_CoreRef)</_CoreTargetPath>
      <_CoreOutDir>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::Combine('$(_CoreProjDir)', '$(_CoreTargetPath)'))))\</_CoreOutDir>
      <_HarvestWxs>$(IntermediateOutputPath)AppComponents.wxs</_HarvestWxs>
    </PropertyGroup>

    <Error Condition="'$(_CoreTargetPath)' == '' or !Exists('$(_CoreOutDir)')"
           Text="Could not resolve Nexaflow.Core's build output. Its build returned '$(_CoreTargetPath)', resolved dir '$(_CoreOutDir)' does not exist. Cannot harvest the installer payload." />

    <MakeDir Directories="$(IntermediateOutputPath)" />

    <!-- Collect all files from Core output, excluding debug symbols -->
    <ItemGroup>
      <_CoreFile Include="$(_CoreOutDir)**\*" Exclude="$(_CoreOutDir)**\*.pdb" />
    </ItemGroup>

    <!--
      Completeness guard: every provider project must have produced a DLL in the payload.
      Turns a stale/incomplete harvest (the Gemini bug) from a silent omission into a hard error.
    -->
    <ItemGroup>
      <_ProviderProj Include="$(MSBuildThisFileDirectory)..\src\Nexaflow.Providers\**\*.csproj" />
      <_HarvestedProvider Include="@(_CoreFile)"
          Condition="'%(Extension)' == '.dll' and $([System.String]::Copy('%(Filename)').StartsWith('Nexaflow.Providers.'))" />
    </ItemGroup>

    <Error Condition="'@(_ProviderProj->Count())' != '@(_HarvestedProvider->Count())'"
           Text="Installer payload is incomplete: harvested @(_HarvestedProvider->Count()) provider DLL(s) from $(_CoreOutDir) but the solution has @(_ProviderProj->Count()) provider project(s). Core's output is stale — clean/rebuild Nexaflow.Core for $(Configuration), then rebuild the installer. Harvested: @(_HarvestedProvider->'%(Filename)', ', ')." />

    <!--
      Same completeness check for the feature assemblies: every Nexaflow.Features.* project must have produced
      a DLL in the payload. Catches a feature (or one of the Compressed backends) silently dropping out of the
      harvest — the same class of bug as the missing Gemini provider, now covered for the whole feature set.
    -->
    <ItemGroup>
      <!-- Match the real feature projects only; exclude the transient *_wpftmp.csproj files WPF spawns
           during a markup-compile pass (which would otherwise inflate the count and false-trip the guard). -->
      <_FeatureProj Include="$(MSBuildThisFileDirectory)..\src\Nexaflow.Features\**\Nexaflow.Features.*.csproj"
                    Exclude="$(MSBuildThisFileDirectory)..\src\Nexaflow.Features\**\*_wpftmp.csproj" />
      <_HarvestedFeature Include="@(_CoreFile)"
          Condition="'%(Extension)' == '.dll' and $([System.String]::Copy('%(Filename)').StartsWith('Nexaflow.Features.'))" />
    </ItemGroup>

    <Error Condition="'@(_FeatureProj->Count())' != '@(_HarvestedFeature->Count())'"
           Text="Installer payload is incomplete: harvested @(_HarvestedFeature->Count()) feature DLL(s) from $(_CoreOutDir) but the solution has @(_FeatureProj->Count()) feature project(s). Core's output is stale or a feature stopped propagating — clean/rebuild Nexaflow.Core for $(Configuration), then rebuild the installer. Harvested: @(_HarvestedFeature->'%(Filename)', ', ')." />

    <!--
      Same completeness check for the language packs: every Nexaflow.Language.* project must have landed in the
      payload's Languages\ folder, or the app ships without that language's help pages and UI strings - and for
      English, without the fallback every other language sits on.
    -->
    <ItemGroup>
      <_LanguagePackProj Include="$(MSBuildThisFileDirectory)..\src\Nexaflow.Languages\**\Nexaflow.Language.*.csproj" />
      <_HarvestedLanguagePack Include="@(_CoreFile)"
          Condition="'%(Extension)' == '.dll' and $([System.String]::Copy('%(Filename)').StartsWith('Nexaflow.Language.'))" />
    </ItemGroup>

    <Error Condition="'@(_LanguagePackProj->Count())' != '@(_HarvestedLanguagePack->Count())'"
           Text="Installer payload is incomplete: harvested @(_HarvestedLanguagePack->Count()) language pack(s) from $(_CoreOutDir) but the solution has @(_LanguagePackProj->Count()) language pack project(s). Core's output is stale — clean/rebuild Nexaflow.Core for $(Configuration), then rebuild the installer. Harvested: @(_HarvestedLanguagePack->'%(Filename)', ', ')." />

    <!--
      Completeness guard: the libVLC native runtime (VideoLAN.LibVLC.Windows, via Nexaflow.Features.Video)
      ships under libvlc\win-x64\. The package drops it into the Video project's output but it does NOT flow
      through ProjectReference into Core's output, so Core's CopyLibVlc target copies it in explicitly. If it
      ever goes missing the Video tab ships with no engine and playback fails — make that a hard error, like
      the provider guard.
    -->
    <ItemGroup>
      <_HarvestedLibVlc Include="@(_CoreFile)" Condition="'%(Filename)%(Extension)' == 'libvlc.dll'" />
    </ItemGroup>

    <Error Condition="'@(_HarvestedLibVlc->Count())' == '0'"
           Text="Installer payload is incomplete: the libVLC native runtime (libvlc.dll under libvlc\win-x64\) is missing from $(_CoreOutDir), so video playback would not work. Core's CopyLibVlc target should copy it from the Video project's output into Core's output — clean/rebuild Nexaflow.Core, then rebuild the installer." />

    <!--
      Completeness guard: the image editor's engine (SkiaSharp, via Nexaflow.Features.Images) needs its native
      libraries — libSkiaSharp for decoding, rendering and encoding, libHarfBuzzSharp for shaping markup text. They
      arrive through the package's runtimes\win-x64\native assets; if either is missing every image fails to open.
    -->
    <ItemGroup>
      <_HarvestedSkia Include="@(_CoreFile)" Condition="'%(Filename)%(Extension)' == 'libSkiaSharp.dll' or '%(Filename)%(Extension)' == 'libHarfBuzzSharp.dll'" />
    </ItemGroup>

    <Error Condition="'@(_HarvestedSkia->Count())' &lt; '2'"
           Text="Installer payload is incomplete: libSkiaSharp.dll and libHarfBuzzSharp.dll (the image viewer's native engine) must both be in $(_CoreOutDir); found: @(_HarvestedSkia->'%(Filename)', ', '). The SkiaSharp native asset packages flow from Nexaflow.Features.Images — clean/rebuild Nexaflow.Core, then rebuild the installer." />

    <!--
      Generate one <Component> per file.
      Root-level files use no Subdirectory attribute.
      Files in subdirs use Subdirectory="path\to\subdir" (trailing backslash stripped via regex).
      A font is the one kind of file here with a version and no language: WiX reads the version from the font
      itself (Bravura 1.392), and a font states no language because it has none. MSI holds a versioned file that is
      not in the system Font table to having a language (ICE60), and the app's fonts are private — IconFonts\ and
      MusicFonts\, loaded from the install folder, never registered. So fonts are given the neutral language, 0,
      which is the true one. Only fonts: WiX reports DefaultLanguage on an unversioned file as a warning of its own.
    -->
    <ItemGroup>
      <_CoreFile Condition="'%(Extension)' == '.ttf' or '%(Extension)' == '.otf' or '%(Extension)' == '.ttc'">
        <FileAttributes>DefaultLanguage=&quot;0&quot; </FileAttributes>
      </_CoreFile>
    </ItemGroup>
    <ItemGroup>
      <_WxsComp Include="@(_CoreFile)" Condition="'%(_CoreFile.RecursiveDir)' == ''">
        <Line>      &lt;Component&gt;&lt;File %(_CoreFile.FileAttributes)Source=&quot;%(_CoreFile.Identity)&quot; /&gt;&lt;/Component&gt;</Line>
      </_WxsComp>
      <_WxsComp Include="@(_CoreFile)" Condition="'%(_CoreFile.RecursiveDir)' != ''">
        <Line>      &lt;Component Subdirectory=&quot;$([System.Text.RegularExpressions.Regex]::Replace('%(_CoreFile.RecursiveDir)', '\\$', ''))&quot;&gt;&lt;File %(_CoreFile.FileAttributes)Source=&quot;%(_CoreFile.Identity)&quot; /&gt;&lt;/Component&gt;</Line>
      </_WxsComp>
    </ItemGroup>

    <!-- Assemble all lines: header + components + footer -->
    <ItemGroup>
      <_WxsLine Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;" />
      <_WxsLine Include="&lt;Wix xmlns=&quot;http://wixtoolset.org/schemas/v4/wxs&quot;&gt;" />
      <_WxsLine Include="  &lt;Fragment&gt;" />
      <_WxsLine Include="    &lt;ComponentGroup Id=&quot;AppComponents&quot; Directory=&quot;INSTALLFOLDER&quot;&gt;" />
      <_WxsLine Include="@(_WxsComp->'%(Line)')" />
      <_WxsLine Include="    &lt;/ComponentGroup&gt;" />
      <_WxsLine Include="  &lt;/Fragment&gt;" />
      <_WxsLine Include="&lt;/Wix&gt;" />
    </ItemGroup>

    <WriteLinesToFile File="$(_HarvestWxs)" Lines="@(_WxsLine)" Overwrite="true" />

    <ItemGroup>
      <Compile Include="$(_HarvestWxs)" />
    </ItemGroup>
  </Target>
</Project>
