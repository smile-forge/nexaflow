<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <!-- ICE61 is the expected, benign companion of MajorUpgrade/@AllowSameVersionUpgrades. -->
    <SuppressIces>ICE61</SuppressIces>
    <_CoreCsproj>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\src\Nexaflow.Core\Nexaflow.Core.csproj'))</_CoreCsproj>
    <NexaflowVersion>$([System.Text.RegularExpressions.Regex]::Match($(_CoreCsproj), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</NexaflowVersion>
    <DefineConstants>AppVersion=$(NexaflowVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Nexaflow.Core\Nexaflow.Core.csproj" />
    <!--
      Build-order edge only (ReferenceOutputAssembly=false → not part of the MSI payload): guarantees the
      snaplink validator exists before ValidateSnaplinks runs, and — crucially — that it is built inside THIS
      MSBuild graph. A `dotnet run` here would spawn a second, concurrent build of Syntax/IO.Common and race
      the Core build on the same obj/bin (the CS2012 hazard documented in HarvestCoreOutput below).
    -->
    <ProjectReference Include="..\src\Nexaflow.Services.Initiatives.Cli\Nexaflow.Services.Initiatives.Cli.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="*" />
    <PackageReference Include="WixToolset.Util.wixext" Version="*" />
  </ItemGroup>

  <!--
    Regenerate the installer branding art so the painted version tracks Nexaflow.Core's <Version>
    (the same source AppVersion reads). Incremental: runs only when Core.csproj or the script changes
    — i.e. on a version bump — so a normal installer rebuild produces no image churn, and a plain
    Core build never triggers it at all. Windows-only (GDI+ via powershell.exe); WiX is Windows-only
    too, so this never blocks a cross-platform build. Regenerates the bundle's banner as well, and the
    bundle's ProjectReference to this project guarantees it runs before the bootstrapper links.
  -->
  <Target Name="RegenerateBranding"
          BeforeTargets="CoreCompile"
          Inputs="$(MSBuildThisFileDirectory)generate-branding.ps1;$(MSBuildThisFileDirectory)..\src\Nexaflow.Core\Nexaflow.Core.csproj"
          Outputs="$(MSBuildThisFileDirectory)banner.bmp;$(MSBuildThisFileDirectory)dialog.bmp;$(MSBuildThisFileDirectory)License.rtf;$(MSBuildThisFileDirectory)..\nexaflowBundle\bundlebanner.png">
    <Message Importance="high" Text="Regenerating installer branding from Nexaflow.Core &lt;Version&gt;…" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)generate-branding.ps1&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>

  <!--
    Release gate: every snaplink in the product tree must still point at a real target (file exists, markdown
    heading resolves, class/method still declared, URL well-formed). Runs the *same* SnaplinkValidator the
    Product tab's "Validate snaplinks" uses — one implementation, so the build and the UI can never disagree.

    Only the installer build runs this, so a normal `dotnet build Nexaflow.slnx` is unaffected. `.product/` is
    gitignored working state, so a clean CI checkout has no tree: the CLI exits 0 with "nothing to validate"
    rather than failing. Exit 1 = broken snaplinks → the release build stops here.
  -->
  <Target Name="ValidateSnaplinks" AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_RepoRoot>
      <_CliProj>$(MSBuildThisFileDirectory)..\src\Nexaflow.Services.Initiatives.Cli\Nexaflow.Services.Initiatives.Cli.csproj</_CliProj>
    </PropertyGroup>

    <MSBuild Projects="$(_CliProj)" Targets="GetTargetPath" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_SnaplinkCli" />
    </MSBuild>

    <Message Importance="high" Text="Validating product snaplinks in $(_RepoRoot)…" />
    <Exec Command="dotnet &quot;@(_SnaplinkCli)&quot; validate &quot;$(_RepoRoot)&quot;" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_SnaplinkExit" />
    </Exec>

    <Error Condition="'$(_SnaplinkExit)' == '1'"
           Text="Product snaplink integrity check failed: one or more snaplinks point at a target that no longer exists (see the list above). Fix them in the Product tab (⋮ → Validate snaplinks → Integrity), or run: dotnet run --project src/Nexaflow.Services.Initiatives.Cli -- validate ." />
    <Error Condition="'$(_SnaplinkExit)' != '0' and '$(_SnaplinkExit)' != '1'"
           Text="Product snaplink validator failed to run (exit $(_SnaplinkExit))." />
  </Target>

  <!--
    Generate AppComponents.wxs at build time from all files in the Core output directory.
    This replaces the old hand-authored AppComponents.wxs which only listed Nexacore.exe.
  -->
  <Target Name="HarvestCoreOutput" AfterTargets="ResolveProjectReferences" BeforeTargets="CoreCompile">
    <!--
      Harvest from the EXACT directory MSBuild built Nexaflow.Core into. The old code hardcoded
      bin\$(Configuration)\net10.0-windows\win-x64 — which silently shipped a stale/leftover folder
      whenever Core's output was out of date, and that is how the Gemini provider DLL went missing
      from the installer with no error. So instead we ask Core for its own TargetPath.

      Core is ALREADY built here: this target runs AfterTargets=ResolveProjectReferences, which builds
      the <ProjectReference> to Core above. Do NOT build it again with a nested <MSBuild Targets="Build">
      — a second build with a different global-property set (e.g. dropping Platform) is a *separate*
      MSBuild instance that runs concurrently with the ProjectReference build and races it on
      Nexaflow.dll: under parallel MSBuild that surfaces as file-lock CS2012, a half-done WPF markup
      compile ("tag does not exist in namespace" warnings), or an incomplete harvest → the bundle can't
      find nexaflowSetup.msi. We only *query* the path, passing the same Configuration+Platform so it
      resolves the very output the ProjectReference produced (win-x64 comes from Core's RuntimeIdentifier;
      the x64 obj segment comes from the Platform global property — omit it and the path is wrong).
      GetTargetPath returns a path relative to Core's project, so root it at Core's dir (Path.Combine
      ignores the base when the returned path is already absolute, so this is correct either way).
    -->
    <PropertyGroup>
      <_CoreProjDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\Nexaflow.Core'))</_CoreProjDir>
    </PropertyGroup>

    <MSBuild Projects="$(_CoreProjDir)\Nexaflow.Core.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_CoreRef" />
    </MSBuild>

    <PropertyGroup>
      <_CoreTargetPath>@(_CoreRef)</_CoreTargetPath>
      <_CoreOutDir>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::Combine('$(_CoreProjDir)', '$(_CoreTargetPath)'))))\</_CoreOutDir>
      <_HarvestWxs>$(IntermediateOutputPath)AppComponents.wxs</_HarvestWxs>
    </PropertyGroup>

    <Error Condition="'$(_CoreTargetPath)' == '' or !Exists('$(_CoreOutDir)')"
           Text="Could not resolve Nexaflow.Core's build output. GetTargetPath returned '$(_CoreTargetPath)', resolved dir '$(_CoreOutDir)' does not exist. Cannot harvest the installer payload." />

    <MakeDir Directories="$(IntermediateOutputPath)" />

    <!-- Collect all files from Core output, excluding debug symbols -->
    <ItemGroup>
      <_CoreFile Include="$(_CoreOutDir)**\*" Exclude="$(_CoreOutDir)**\*.pdb" />
    </ItemGroup>

    <!--
      Completeness guard: every provider project must have produced a DLL in the payload.
      Turns a stale/incomplete harvest (the Gemini bug) from a silent omission into a hard error.
    -->
    <ItemGroup>
      <_ProviderProj Include="$(MSBuildThisFileDirectory)..\src\Nexaflow.Providers\**\*.csproj" />
      <_HarvestedProvider Include="@(_CoreFile)"
          Condition="'%(Extension)' == '.dll' and $([System.String]::Copy('%(Filename)').StartsWith('Nexaflow.Providers.'))" />
    </ItemGroup>

    <Error Condition="'@(_ProviderProj->Count())' != '@(_HarvestedProvider->Count())'"
           Text="Installer payload is incomplete: harvested @(_HarvestedProvider->Count()) provider DLL(s) from $(_CoreOutDir) but the solution has @(_ProviderProj->Count()) provider project(s). Core's output is stale — clean/rebuild Nexaflow.Core for $(Configuration), then rebuild the installer. Harvested: @(_HarvestedProvider->'%(Filename)', ', ')." />

    <!--
      Same completeness check for the feature assemblies: every Nexaflow.Features.* project must have produced
      a DLL in the payload. Catches a feature (or one of the Compressed backends) silently dropping out of the
      harvest — the same class of bug as the missing Gemini provider, now covered for the whole feature set.
    -->
    <ItemGroup>
      <!-- Match the real feature projects only; exclude the transient *_wpftmp.csproj files WPF spawns
           during a markup-compile pass (which would otherwise inflate the count and false-trip the guard). -->
      <_FeatureProj Include="$(MSBuildThisFileDirectory)..\src\Nexaflow.Features\**\Nexaflow.Features.*.csproj"
                    Exclude="$(MSBuildThisFileDirectory)..\src\Nexaflow.Features\**\*_wpftmp.csproj" />
      <_HarvestedFeature Include="@(_CoreFile)"
          Condition="'%(Extension)' == '.dll' and $([System.String]::Copy('%(Filename)').StartsWith('Nexaflow.Features.'))" />
    </ItemGroup>

    <Error Condition="'@(_FeatureProj->Count())' != '@(_HarvestedFeature->Count())'"
           Text="Installer payload is incomplete: harvested @(_HarvestedFeature->Count()) feature DLL(s) from $(_CoreOutDir) but the solution has @(_FeatureProj->Count()) feature project(s). Core's output is stale or a feature stopped propagating — clean/rebuild Nexaflow.Core for $(Configuration), then rebuild the installer. Harvested: @(_HarvestedFeature->'%(Filename)', ', ')." />

    <!--
      Completeness guard: the libVLC native runtime (VideoLAN.LibVLC.Windows, via Nexaflow.Features.Video)
      ships under libvlc\win-x64\. The package drops it into the Video project's output but it does NOT flow
      through ProjectReference into Core's output, so Core's CopyLibVlc target copies it in explicitly. If it
      ever goes missing the Video tab ships with no engine and playback fails — make that a hard error, like
      the provider guard.
    -->
    <ItemGroup>
      <_HarvestedLibVlc Include="@(_CoreFile)" Condition="'%(Filename)%(Extension)' == 'libvlc.dll'" />
    </ItemGroup>

    <Error Condition="'@(_HarvestedLibVlc->Count())' == '0'"
           Text="Installer payload is incomplete: the libVLC native runtime (libvlc.dll under libvlc\win-x64\) is missing from $(_CoreOutDir), so video playback would not work. Core's CopyLibVlc target should copy it from the Video project's output into Core's output — clean/rebuild Nexaflow.Core, then rebuild the installer." />

    <!--
      Generate one <Component> per file.
      Root-level files use no Subdirectory attribute.
      Files in subdirs use Subdirectory="path\to\subdir" (trailing backslash stripped via regex).
    -->
    <ItemGroup>
      <_WxsComp Include="@(_CoreFile)" Condition="'%(_CoreFile.RecursiveDir)' == ''">
        <Line>      &lt;Component&gt;&lt;File Source=&quot;%(_CoreFile.Identity)&quot; /&gt;&lt;/Component&gt;</Line>
      </_WxsComp>
      <_WxsComp Include="@(_CoreFile)" Condition="'%(_CoreFile.RecursiveDir)' != ''">
        <Line>      &lt;Component Subdirectory=&quot;$([System.Text.RegularExpressions.Regex]::Replace('%(_CoreFile.RecursiveDir)', '\\$', ''))&quot;&gt;&lt;File Source=&quot;%(_CoreFile.Identity)&quot; /&gt;&lt;/Component&gt;</Line>
      </_WxsComp>
    </ItemGroup>

    <!-- Assemble all lines: header + components + footer -->
    <ItemGroup>
      <_WxsLine Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;" />
      <_WxsLine Include="&lt;Wix xmlns=&quot;http://wixtoolset.org/schemas/v4/wxs&quot;&gt;" />
      <_WxsLine Include="  &lt;Fragment&gt;" />
      <_WxsLine Include="    &lt;ComponentGroup Id=&quot;AppComponents&quot; Directory=&quot;INSTALLFOLDER&quot;&gt;" />
      <_WxsLine Include="@(_WxsComp->'%(Line)')" />
      <_WxsLine Include="    &lt;/ComponentGroup&gt;" />
      <_WxsLine Include="  &lt;/Fragment&gt;" />
      <_WxsLine Include="&lt;/Wix&gt;" />
    </ItemGroup>

    <WriteLinesToFile File="$(_HarvestWxs)" Lines="@(_WxsLine)" Overwrite="true" />

    <ItemGroup>
      <Compile Include="$(_HarvestWxs)" />
    </ItemGroup>
  </Target>
</Project>
