<UserControl x:Class="Nexaflow.Visuals.Terminal.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Nexaflow.Visuals.Terminal.Models"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <!-- One terminal line (scrollback / screen) -->
        <Style x:Key="TerminalLine" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="Consolas, Courier New, monospace"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>

        <!-- Files panel entry: glyph + name. Folders navigate; entries are a drag source. -->
        <DataTemplate x:Key="FsEntryTemplate" DataType="{x:Type m:TerminalFsEntry}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}"
                           FontSize="12" FontFamily="Consolas, Courier New"
                           Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip="{Binding FullPath}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Environment list row: name + value, with a copy/edit context menu. -->
        <DataTemplate x:Key="EnvVarTemplate" DataType="{x:Type m:EnvVar}">
            <Grid Margin="0,1"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="EnvName"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           FontSize="11" FontFamily="Consolas, Courier New"
                           Foreground="{StaticResource AccentBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}"
                           Padding="0,0,8,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Value}"
                           FontSize="11" FontFamily="Consolas, Courier New"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="600" FontFamily="Consolas, Courier New" FontSize="11"
                                 Content="{Binding Value}"/>
                    </TextBlock.ToolTip>
                </TextBlock>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy"
                                  Command="{Binding PlacementTarget.Tag.CopyEnvVarCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Edit…"
                                  Command="{Binding PlacementTarget.Tag.EditEnvVarCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Grid.ContextMenu>
            </Grid>
        </DataTemplate>

        <Style x:Key="TerminalListItem" TargetType="ListBoxItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>

        <Style x:Key="OverlayTextBox" TargetType="TextBox">
            <Setter Property="Background"   Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush"   Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Padding"      Value="6,4"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SurfaceButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Themed sub-tabs (the default WPF TabControl renders light/unspaced). -->
        <Style x:Key="TerminalTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="14,8"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter TargetName="Bd" Property="Background"      Value="{StaticResource DeepBgBrush}"/>
                                <Setter Property="Foreground"                      Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TerminalTabControl" TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top path bar -->
        <Border Grid.Row="0"
                Background="{StaticResource DeepBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center" Margin="14,0,8,0" LastChildFill="False">
                <!-- Right: deep link to this shell's environments in the workspace Configure overlay -->
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        VerticalAlignment="Center" Padding="6,2"
                        Command="{Binding ConfigureCommand}"
                        ToolTip="Configure console environments"
                        Visibility="{Binding ShowConfigureButton, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2699;" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Configure" FontSize="11" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock DockPanel.Dock="Left" Text="&#x2B21;" Foreground="{StaticResource AccentBrush}"
                           FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentPath}"
                           Foreground="{StaticResource TextBrush}"
                           FontFamily="Consolas, Courier New" FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Left" Text="  [running...]"
                           Foreground="{StaticResource WarningBrush}" FontSize="11"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
            </DockPanel>
        </Border>

        <!-- Three-column main area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="150"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"   MinWidth="200"/>
                <ColumnDefinition Width="170" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Files / Environment sub-tabs -->
            <Border Grid.Column="0"
                    Background="{StaticResource DeepBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <TabControl Style="{StaticResource TerminalTabControl}"
                            ItemContainerStyle="{StaticResource TerminalTabItem}">
                    <TabItem Header="Files">
                        <ListBox x:Name="FilesList"
                                 ItemsSource="{Binding Files}"
                                 ItemTemplate="{StaticResource FsEntryTemplate}"
                                 ItemContainerStyle="{StaticResource TerminalListItem}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="FilesList_MouseDoubleClick"
                                 PreviewMouseLeftButtonDown="FilesList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="FilesList_PreviewMouseMove"
                                 Padding="6,6"/>
                    </TabItem>
                    <TabItem Header="Environment">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="6,6,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource OverlayTextBox}"
                                         Text="{Binding EnvFilter, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Filter variables"/>
                                <Button Grid.Column="1" Content="＋" Margin="4,0,0,0"
                                        Style="{StaticResource SurfaceButton}" Padding="8,4"
                                        ToolTip="Add a variable"
                                        Command="{Binding AddEnvVarCommand}"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="6,2">
                                <ItemsControl ItemsSource="{Binding EnvVars}"
                                              ItemTemplate="{StaticResource EnvVarTemplate}"
                                              Grid.IsSharedSizeScope="True"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Center: the live terminal -->
            <Grid Grid.Column="2">
                <Border Background="{StaticResource BgBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="10,6">
                            <TextBlock Text="Console" Style="{StaticResource PanelHeaderText}"/>
                        </Border>

                        <!-- Inline AI banner host: the shell injects its dissolvable response banner here. -->
                        <ContentControl x:Name="EngagementHost" DockPanel.Dock="Bottom"/>

                        <!-- Focusable terminal surface: clicking it focuses; keystrokes go to the shell. -->
                        <Border x:Name="TerminalSurface" Background="Transparent"
                                Focusable="True" AllowDrop="True"
                                PreviewKeyDown="Terminal_PreviewKeyDown"
                                PreviewTextInput="Terminal_PreviewTextInput"
                                PreviewMouseDown="Terminal_PreviewMouseDown"
                                DragOver="Terminal_DragOver" Drop="Terminal_Drop">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy"  Click="CopyTerminal_Click"/>
                                    <MenuItem Header="Paste" Click="PasteTerminal_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <ScrollViewer x:Name="ConsoleScroller"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Padding="14,10" Background="Transparent" Focusable="False">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Scrollback}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource TerminalLine}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding ScreenText}" Style="{StaticResource TerminalLine}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Environment-variable add/edit overlay -->
                <Border Visibility="{Binding EnvEditVisible, Converter={StaticResource BoolVis}}"
                        Background="#CC000000" Panel.ZIndex="20">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Width="380" Padding="18"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Environment variable"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="Name" Style="{StaticResource PanelHeaderText}" Margin="0,0,0,3"/>
                            <TextBox x:Name="EnvEditNameBox"
                                     Style="{StaticResource OverlayTextBox}" Margin="0,0,0,10"
                                     Text="{Binding EnvEditName, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding EnvEditNameReadOnly}"/>
                            <TextBlock Text="Value" Style="{StaticResource PanelHeaderText}" Margin="0,0,0,3"/>
                            <TextBox x:Name="EnvEditValueBox"
                                     Style="{StaticResource OverlayTextBox}" Margin="0,0,0,10"
                                     Text="{Binding EnvEditValue, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="EnvEdit_KeyDown"/>
                            <TextBlock Text="Apply to" Style="{StaticResource PanelHeaderText}" Margin="0,0,0,3"/>
                            <ComboBox ItemsSource="{Binding EnvScopes}"
                                      SelectedItem="{Binding EnvEditScope}"
                                      Margin="0,0,0,16" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource SurfaceButton}"
                                        Margin="0,0,8,0" Command="{Binding CancelEnvEditCommand}"/>
                                <Button Content="Save" Style="{StaticResource AccentButton}"
                                        Command="{Binding ConfirmEnvEditCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Launch-time environment picker -->
                <Border Visibility="{Binding EnvPickerVisible, Converter={StaticResource BoolVis}}"
                        Background="#CC000000" Panel.ZIndex="30">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Width="420" MaxHeight="460" Padding="18"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Choose an environment for this location"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <CheckBox DockPanel.Dock="Bottom"
                                      Content="Always use this environment for this location"
                                      IsChecked="{Binding AlwaysUseHere}"
                                      Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                      Margin="0,12,0,0"/>
                            <Button DockPanel.Dock="Bottom" Content="Cancel" HorizontalAlignment="Right"
                                    Style="{StaticResource SurfaceButton}" Margin="0,12,0,0"
                                    Command="{Binding CancelEnvPickerCommand}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding EnvPickerOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:TerminalEnvironment}">
                                            <Button Margin="0,3" HorizontalContentAlignment="Stretch"
                                                    Style="{StaticResource SurfaceButton}"
                                                    Command="{Binding DataContext.PickEnvironmentCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}" FontSize="13"/>
                                                    <TextBlock Text="{Binding InitialCommand}"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontFamily="Consolas, Courier New" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- Right: command history -->
            <Border Grid.Column="3"
                    Background="{StaticResource DeepBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="History" Style="{StaticResource PanelHeaderText}"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,6">
                        <ItemsControl ItemsSource="{Binding CommandHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" Margin="0,2" CornerRadius="4"
                                            Background="{StaticResource Surface2Brush}"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.RerunCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas, Courier New"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
