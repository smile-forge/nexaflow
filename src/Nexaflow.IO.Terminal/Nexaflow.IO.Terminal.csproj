<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- KillOnCloseJob: the process-wide kill-on-close job every child shell is bound to. -->
    <ProjectReference Include="..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
    <!-- What a drop on a terminal carries, typed in as quoted paths (TerminalDropLogic). -->
    <ProjectReference Include="..\Nexaflow.Interaction\Nexaflow.Interaction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- An environment variable edited in a terminal's environment editor is observable (EnvVar). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexaflow.Tests.Features" />
    <InternalsVisibleTo Include="Nexaflow.Tests.IO" />
  </ItemGroup>

</Project>
