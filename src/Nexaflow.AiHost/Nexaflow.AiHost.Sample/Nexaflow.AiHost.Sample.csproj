<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An app that is not Nexaflow, running a private AI host through the SDK alone: the proof that the host and its SDK
    stand on their own, and the shortest example of using them. It references the SDK and nothing else of Nexaflow's
    (Tests.AiHost holds it to that, and runs it).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.AiHost.Client\Nexaflow.AiHost.Client.csproj" />
  </ItemGroup>

</Project>
