<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The app's side of the AI host: starts Nexaflow.AiHost on demand, binds it to the kill-on-close job, speaks the
    contracts over a pipe only this user can open, and restarts it when it dies or stops answering. One per app;
    the client provider takes it by injection. Windows-only for the pipe's access control.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.AiHost.Contracts\Nexaflow.AiHost.Contracts.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
    <!-- ModelAsset and the catalog manifest: the runtime pack is fetched through the same asset store as models. -->
    <ProjectReference Include="..\..\Nexaflow.Providers\Nexaflow.Providers.Common\Nexaflow.Providers.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to the host's own ONNX Runtime and onnxruntime-genai; Tests.AiHost holds them together. -->
    <EmbeddedResource Include="RuntimePacks\cuda-pack.json" LogicalName="cuda-pack.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexaflow.Tests.AiHost" />
  </ItemGroup>

</Project>
