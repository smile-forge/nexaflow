<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The app's side of the AI host: starts Nexaflow.AiHost on demand, binds it to a kill-on-close job of its own, speaks the
    contracts over a pipe only this user can open, and restarts it when it dies or stops answering. One per app;
    the client provider takes it by injection. Windows-only for the pipe's access control.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>
    <!-- Nvml: the driver's library is called through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.AiHost.Contracts\Nexaflow.AiHost.Contracts.csproj" />

    <!-- The runtime pack is a set of model files, fetched through the same asset store as models. -->
    <ProjectReference Include="..\Nexaflow.AiHost.Provisioning\Nexaflow.AiHost.Provisioning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to the host's own ONNX Runtime and onnxruntime-genai; Tests.AiHost holds them together. -->
    <EmbeddedResource Include="RuntimePacks\cuda-pack.json" LogicalName="cuda-pack.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The log file the host writes too: one source, compiled into each. -->
    <Compile Include="..\Shared\AiHostLogFile.cs" Link="AiHostLogFile.cs" />
    <!-- The cards as their driver reads them: the machine read before any host runs (MachineCards). -->
    <Compile Include="..\Shared\Nvml.cs" Link="Nvml.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexaflow.Tests.AiHost" />
  </ItemGroup>

</Project>
