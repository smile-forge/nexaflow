<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The app's side of the AI host: starts Nexaflow.AiHost on demand, binds it to a kill-on-close job of its own, speaks the
    contracts over a pipe only this user can open, and restarts it when it dies or stops answering. One per app;
    the client provider takes it by injection. Windows-only for the pipe's access control.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>

    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.AiHost.Contracts\Nexaflow.AiHost.Contracts.csproj" />

    <!-- The model files and the store the host keeps them in, as the app sees it. -->
    <ProjectReference Include="..\Nexaflow.AiHost.Provisioning\Nexaflow.AiHost.Provisioning.csproj" />
    <!-- What the host runs, and what this machine is: an app weighs a model before any host runs. -->
    <ProjectReference Include="..\Nexaflow.AiHost.Catalog\Nexaflow.AiHost.Catalog.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The log file the host writes too: one source, compiled into each. -->
    <Compile Include="..\Shared\AiHostLogFile.cs" Link="AiHostLogFile.cs" />
    <!-- The kill-on-close job the hosts it starts are bound to, as the service binds its worker. -->
    <Compile Include="..\Shared\HostProcessJob.cs" Link="HostProcessJob.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexaflow.Tests.AiHost" />
  </ItemGroup>

</Project>
