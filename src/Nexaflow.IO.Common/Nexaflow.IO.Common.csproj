<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The query language defines the recogniser contract; the glob one lives here, next to Glob itself,
         so Nexaflow.Search needs no glob implementation and no reference back to this library. -->
    <ProjectReference Include="..\Nexaflow.Search\Nexaflow.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexaflow.Tests.Features" />
    <InternalsVisibleTo Include="Nexaflow.Tests.Features.Viewers" />
    <InternalsVisibleTo Include="Nexaflow.Tests.Features.WindowsOS" />
    <InternalsVisibleTo Include="Nexaflow.Tests.IO" />
  </ItemGroup>

</Project>
