<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Documents as wholes. Written out in a format: one writer per format, each spelling the format-neutral document a laid
    page is walked into (Nexaflow.Markdown's Export). Worked through with a model a piece at a time (Processing): what a
    document is, a summary of it section by section, a translation of it passage by passage, each sized to what the model
    reads at once. WPF-free; a format's own package is taken where that format arrives — OpenXML for Word — so
    Nexaflow.Markdown keeps depending on nothing.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.Markdown\Nexaflow.Markdown.csproj" />
  </ItemGroup>

</Project>
