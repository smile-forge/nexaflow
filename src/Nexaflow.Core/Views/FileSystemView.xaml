<UserControl x:Class="Nexaflow.Core.Views.FileSystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Core.ViewModels"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── GridView column header style ────────────────────────────── -->
        <ControlTemplate x:Key="GvColHeaderPaddingTemplate" TargetType="GridViewColumnHeader">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"/>
        </ControlTemplate>

        <Style x:Key="GvColHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background"          Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"          Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="BorderBrush"         Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"     Value="0,0,1,1"/>
            <Setter Property="Padding"             Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Padding role — the filler header at the right edge; swap Template at Style level -->
                <Trigger Property="Role" Value="Padding">
                    <Setter Property="Template" Value="{StaticResource GvColHeaderPaddingTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── ListView item style ─────────────────────────────────────── -->
        <Style x:Key="FileRowStyle" TargetType="ListViewItem">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="Foreground"              Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"                 Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="2,1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.OpenEntryCommand,
                                                        Source={x:Reference FileListView}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <GridViewRowPresenter
                                Columns="{Binding View.Columns, Source={x:Reference FileListView}}"
                                Content="{TemplateBinding Content}"/>
                        </Border>
												<ControlTemplate.Triggers>
														<DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
																<Setter TargetName="RowBg" Property="Background"
																				Value="{StaticResource Surface2Brush}"/>
																<Setter TargetName="RowBg" Property="BorderBrush"
																				Value="{StaticResource AccentBrush}"/>
																<Setter TargetName="RowBg" Property="BorderThickness" Value="1"/>
														</DataTrigger>
														<MultiTrigger>
																<MultiTrigger.Conditions>
																		<Condition Property="IsSelected" Value="False"/>
																		<Condition Property="IsMouseOver" Value="True"/>
																</MultiTrigger.Conditions>
																<Setter TargetName="RowBg" Property="Background"
																				Value="{StaticResource SurfaceBrush}"/>
														</MultiTrigger>
												</ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TreeView item style ─────────────────────────────────────── -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Padding"    Value="4,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border x:Name="RowBorder"
                                    Grid.Row="0"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Expand chevron -->
                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Width="16" Height="16"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                      RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                  Focusable="False" Style="{x:Null}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Width="16" Height="16" Background="Transparent">
                                                    <Path x:Name="ArrowRight"
                                                          Data="M 6 4 L 10 8 L 6 12"
                                                          Stroke="{StaticResource TextDimBrush}"
                                                          StrokeThickness="1.5" StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Path x:Name="ArrowDown"
                                                          Data="M 4 6 L 8 10 L 12 6"
                                                          Stroke="{StaticResource TextDimBrush}"
                                                          StrokeThickness="1.5" StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ArrowRight" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="ArrowDown"  Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- Header (uses the HierarchicalDataTemplate) -->
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ItemsPresenter Grid.Row="1" x:Name="ItemsHost"
                                            Margin="16,0,0,0" Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBorder" Property="Background"
                                        Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
								<MultiDataTrigger>
									<MultiDataTrigger.Conditions>
										<Condition Binding="{Binding IsSelected}" Value="False"/>
										<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
									</MultiDataTrigger.Conditions>
									<Setter TargetName="RowBorder" Property="Background"
											Value="{StaticResource SurfaceBrush}"/>
								</MultiDataTrigger>
                            <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Tree panel -->
            <ColumnDefinition Width="240" MinWidth="140" MaxWidth="480"/>
            <!-- Splitter -->
            <ColumnDefinition Width="5"/>
            <!-- File list panel -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left: Directory Tree ──────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <TreeView x:Name="DirectoryTree"
                      Background="Transparent"
                      BorderThickness="0"
                      ItemsSource="{Binding TreeRoots}"
                      ItemContainerStyle="{StaticResource TreeItemStyle}"
                      SelectedItemChanged="DirectoryTree_SelectedItemChanged"
                      PreviewMouseRightButtonDown="DirectoryTree_PreviewMouseRightButtonDown"
                      Padding="8"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FileSystemTreeNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}"
                                       FontSize="13" Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"         Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"     Color="{StaticResource TextColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <!-- ── Splitter ──────────────────────────────────────────────── -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- ── Right: AI summary + ListView + footer ────────────────── -->
        <Grid Grid.Column="2" x:Name="RightGrid">
            <Grid.ColumnDefinitions>
                <!-- File list + footer -->
                <ColumnDefinition Width="*"/>
                <!-- Action strip -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- AI Summary panel: height driven by code-behind; 0 when hidden -->
                <RowDefinition x:Name="AiSummaryRow" Height="0"/>
                <!-- Splitter: only visible when summary is shown -->
                <RowDefinition Height="Auto"/>
                <!-- File list: takes all remaining space -->
                <RowDefinition Height="*"/>
                <!-- Footer bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── AI Summary panel ──────────────────────────────────── -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    x:Name="AiSummaryPanel"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding AiSummaryVisible,
                                 Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title bar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,5">
                        <Grid>
                            <TextBlock Text="AI Summary"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="SaveSummaryButton"
                                    Content="Save"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="10,3"
                                    FontSize="11"
                                    Command="{Binding SaveAiSummaryCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"   Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Cursor"       Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="3"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Editable text body -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding AiSummaryText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="13"
                                 Padding="10,8"
                                 VerticalAlignment="Stretch"
                                 CaretBrush="{StaticResource TextBrush}"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── Splitter between summary and list ─────────────────── -->
            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          Height="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="{StaticResource BorderBrush}"
                          Visibility="{Binding AiSummaryVisible,
                                       Converter={StaticResource BoolToVis}}"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- ── File ListView ─────────────────────────────────────── -->
            <ListView Grid.Row="2" Grid.Column="0"
                      x:Name="FileListView"
                      ItemsSource="{Binding Entries}"
                      ItemContainerStyle="{StaticResource FileRowStyle}"
                      Background="{StaticResource BgBrush}"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      SelectionChanged="FileListView_SelectionChanged"
                      PreviewMouseLeftButtonDown="FileListView_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="FileListView_PreviewMouseRightButtonDown"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      Padding="4,4,4,4">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource GvColHeaderStyle}">

                        <!-- Name column (star width, takes remaining space) -->
                        <GridViewColumn x:Name="ColName" Width="300"
                                        Header="Name">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Button Content="Name" Style="{x:Null}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="11" FontWeight="SemiBold"
                                            Cursor="Hand" Padding="0"
                                            Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="Name"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="📄"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="Text" Value="📁"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Type column -->
                        <GridViewColumn Width="90">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Button Content="Type" Style="{x:Null}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="11" FontWeight="SemiBold"
                                            Cursor="Hand" Padding="0"
                                            Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="TypeLabel"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <TextBlock Text="{Binding TypeLabel}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Size column -->
                        <GridViewColumn Width="80">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Button Content="Size" Style="{x:Null}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="11" FontWeight="SemiBold"
                                            Cursor="Hand" Padding="0"
                                            Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="SizeBytes"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <TextBlock Text="{Binding SizeLabel}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Modified column -->
                        <GridViewColumn Width="150">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Button Content="Modified" Style="{x:Null}"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="11" FontWeight="SemiBold"
                                            Cursor="Hand" Padding="0"
                                            Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="Modified"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <TextBlock Text="{Binding ModifiedLabel}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>

            <!-- ── Footer bar ────────────────────────────────────────── -->
            <Border Grid.Row="3" Grid.Column="0"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,4">
                <TextBlock Text="{Binding EntryCountLabel}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- ── File Action Strip ─────────────────────────────────── -->
            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="4"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Width="120"
                    MinWidth="120"
                    MaxWidth="120">
                <Grid>
                    <!-- Scrollable button area -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FileActions}"
                                      Margin="4,6,4,6"
                                      VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Fixed 2-column grid; each cell is exactly 54×58 px -->
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FileActionViewModel}">
                                    <Button Command="{Binding ExecuteCommand}"
                                            ToolTip="{Binding ButtonTooltip}"
                                            Width="54" Height="58"
                                            Margin="1"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
                                                <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid>
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4"
                                                                        Padding="2">
                                                                    <StackPanel VerticalAlignment="Center"
                                                                                HorizontalAlignment="Center">
                                                                        <!-- Registry icon image (when available) -->
                                                                        <Image Source="{Binding IconImage}"
                                                                               Width="20" Height="20"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IconImage, Converter={x:Static vm:NullToBoolConverter.Instance}}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>
                                                                        <!-- Emoji / glyph fallback -->
                                                                        <TextBlock Text="{Binding Icon}"
                                                                                   FontSize="18"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IconImage, Converter={x:Static vm:NullToBoolConverter.Instance}}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontSize="9"
                                                                                   HorizontalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   Margin="0,3,0,0"
                                                                                   MaxWidth="48"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <!-- Dim overlay: shown when another button is flashing -->
                                                                <Border x:Name="DimOverlay"
                                                                        Background="#99000000"
                                                                        CornerRadius="4"
                                                                        Visibility="Collapsed"/>
                                                                <!-- Success tick overlay -->
                                                                <Border x:Name="TickOverlay"
                                                                        Background="#CC1A7A3C"
                                                                        CornerRadius="4"
                                                                        Visibility="Collapsed">
                                                                    <TextBlock Text="✔"
                                                                               FontSize="20"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background"
                                                                            Value="{StaticResource Surface2Brush}"/>
                                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                                            Value="{StaticResource AccentBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                                </Trigger>
                                                                <!-- Success flash -->
                                                                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                                                    <Setter TargetName="TickOverlay" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <!-- Dimmed while sibling flashes -->
                                                                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                                    <Setter TargetName="DimOverlay" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <!-- Destructive: dim red border -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsDestructive}" Value="True"/>
                                                                        <Condition Binding="{Binding ShiftHeld}"     Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#88FF4444"/>
                                                                </MultiDataTrigger>
                                                                <!-- Destructive + Shift: bright red border -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsDestructive}" Value="True"/>
                                                                        <Condition Binding="{Binding ShiftHeld}"     Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFF3333"/>
                                                                    <Setter TargetName="Bd" Property="Background"  Value="#22FF2222"/>
                                                                </MultiDataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── Input Prompt Overlay (spans entire right pane) ───────────── -->
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="2"
                    Visibility="{Binding InputPromptVisible,
                                 Converter={StaticResource BoolToVis}}"
                    Background="#CC000000"
                    Panel.ZIndex="20">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="320"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding InputPromptTitle}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding InputPromptLabel}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Margin="0,0,0,12">
                            <TextBox x:Name="InputPromptTextBox"
                                     Text="{Binding InputPromptValue,
                                            UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource Surface2Brush}"
                                     Foreground="{StaticResource TextBrush}"
                                     CaretBrush="{StaticResource TextBrush}"
                                     BorderThickness="0"
                                     FontSize="12"
                                     Padding="8,6"
                                     GotFocus="InputPromptTextBox_GotFocus"
                                     KeyDown="InputPromptTextBox_KeyDown"/>
                        </Border>
                        <Button Content="Rename"
                                Command="{Binding ConfirmInputPromptCommand}"
                                Cursor="Hand"
                                Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0,7"/>
                                    <Setter Property="FontSize"        Value="12"/>
                                    <Setter Property="FontWeight"      Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Cancel"
                                Command="{Binding CancelInputPromptCommand}"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
                                    <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0,7"/>
                                    <Setter Property="FontSize"        Value="12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{StaticResource BorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ── Confirmation Overlay (spans entire right pane) ───────────── -->
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="2"
                    Visibility="{Binding ConfirmationVisible,
                                 Converter={StaticResource BoolToVis}}"
                    Background="#CC000000"
                    Panel.ZIndex="19">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="#FFFF3333"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="320"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding ConfirmationTitle}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ConfirmationPrompt}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="Confirm"
                                Command="{Binding ConfirmActionCommand}"
                                Cursor="Hand"
                                Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="#CCFF2222"/>
                                    <Setter Property="Foreground"      Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0,7"/>
                                    <Setter Property="FontSize"        Value="12"/>
                                    <Setter Property="FontWeight"      Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFFF2222"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Cancel"
                                Command="{Binding CancelConfirmationCommand}"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
                                    <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0,7"/>
                                    <Setter Property="FontSize"        Value="12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>

    </Grid>
</UserControl>
