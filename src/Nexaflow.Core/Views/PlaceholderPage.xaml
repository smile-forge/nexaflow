<UserControl x:Class="Nexaflow.Core.Views.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BgBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3">
            <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center"/>
            <TextBlock Text="Page content loads here"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
