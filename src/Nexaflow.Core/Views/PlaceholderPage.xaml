<UserControl x:Class="Nexaflow.Core.Views.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="PlaceholderPage"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">
    <Grid Background="{StaticResource BgBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
            <TextBlock x:Name="HeadlineText"
                       AutomationProperties.AutomationId="PlaceholderPage_Headline"
                       Text="{loc:Str Shell.Placeholder.Headline}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="DetailText"
                       AutomationProperties.AutomationId="PlaceholderPage_Detail"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
