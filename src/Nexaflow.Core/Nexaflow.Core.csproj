<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Win10 SDK moniker: the WindowsApps feature uses WinRT (Store package APIs); the host must
         target an OS version >= any project it references. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Appicon.ico</ApplicationIcon>
    <Company>Smile-Forge</Company>
    <Product>Nexaflow</Product>
    <Description>Nexaflow is an open-source Windows shell replacement</Description>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Version>1.1.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Nexaflow</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Appicon.ico" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Updatum" Version="1.4.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Cuda" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Ribbon\default-ribbon.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Shown by the setup wizard's "What's New" step (read via Application.GetResourceStream). -->
    <Resource Include="Assets\WhatsNew.md" />
    <!-- Shown by the Options "About" page (read via Application.GetResourceStream). -->
    <Resource Include="Assets\ThirdPartyNotices.md" />
  </ItemGroup>

  <!--
    Whisper.net.Runtime[.Cuda] ship every RID under runtimes\ regardless of our win-x64
    RuntimeIdentifier. We're Windows-x64-only, so prune the dead trees (the linux CUDA .so
    alone is ~160 MB). Runs after both Build and Publish; keeps win-x64 + cuda\win-x64.
  -->
  <Target Name="StripNonWinX64Runtimes" AfterTargets="Build;Publish">
    <ItemGroup>
      <_NfRuntimeRoot Include="$(OutDir)runtimes" Condition="Exists('$(OutDir)runtimes')" />
      <_NfRuntimeRoot Include="$(PublishDir)runtimes" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)runtimes')" />
    </ItemGroup>
    <RemoveDir Directories="@(_NfRuntimeRoot->'%(Identity)\cuda\linux-x64');@(_NfRuntimeRoot->'%(Identity)\win-arm64');@(_NfRuntimeRoot->'%(Identity)\win-x86')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.AIChat\Nexaflow.Features.AIChat.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Code\Nexaflow.Features.Code.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Common\Nexaflow.Features.Common.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Compressed\Nexaflow.Features.Compressed.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Compressed.SharpCompress\Nexaflow.Features.Compressed.SharpCompress.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Compressed.Modern\Nexaflow.Features.Compressed.Modern.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Compressed.SecureZip\Nexaflow.Features.Compressed.SecureZip.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Console\Nexaflow.Features.Console.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Dotnet\Nexaflow.Features.Dotnet.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Git\Nexaflow.Features.Git.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Hex\Nexaflow.Features.Hex.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Json\Nexaflow.Features.Json.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Logs\Nexaflow.Features.Logs.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Processes\Nexaflow.Features.Processes.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.SystemInfo\Nexaflow.Features.SystemInfo.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Tabular\Nexaflow.Features.Tabular.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.WindowsApps\Nexaflow.Features.WindowsApps.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.WindowsFileSystem\Nexaflow.Features.WindowsFileSystem.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.WindowsRegistry\Nexaflow.Features.WindowsRegistry.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.WindowsSearch\Nexaflow.Features.WindowsSearch.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Images\Nexaflow.Features.Images.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Markdown\Nexaflow.Features.Markdown.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Projects\Nexaflow.Features.Projects.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Scratchpad\Nexaflow.Features.Scratchpad.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Text\Nexaflow.Features.Text.csproj" />
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Web\Nexaflow.Features.Web.csproj" />
    <ProjectReference Include="..\Nexaflow.Providers\Nexaflow.Providers.Common\Nexaflow.Providers.Common.csproj" />
    <ProjectReference Include="..\Nexaflow.Providers\Nexaflow.Providers.Aria\Nexaflow.Providers.Aria.csproj" />
    <ProjectReference Include="..\Nexaflow.Providers\Nexaflow.Providers.Claude\Nexaflow.Providers.Claude.csproj" />
    <ProjectReference Include="..\Nexaflow.Providers\Nexaflow.Providers.Ollama\Nexaflow.Providers.Ollama.csproj" />
    <ProjectReference Include="..\Nexaflow.Providers\Nexaflow.Providers.OpenAI\Nexaflow.Providers.OpenAI.csproj" />
	<ProjectReference Include="..\Nexaflow.Providers\Nexaflow.Providers.Gemini\Nexaflow.Providers.Gemini.csproj" />
    <ProjectReference Include="..\Nexaflow.Visuals.Common\Nexaflow.Visuals.Common.csproj" />
    <ProjectReference Include="..\Nexaflow.Visuals.Terminal\Nexaflow.Visuals.Terminal.csproj" />
    <ProjectReference Include="..\Nexaflow.Visuals.Text\Nexaflow.Visuals.Text.csproj" />
    <ProjectReference Include="..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />

    <!-- Elevation: the launcher uses the contract DTOs (real ref). The bridge exe is referenced for build
         ordering only (ReferenceOutputAssembly=false) — CopyPrivilegeBridge places its output explicitly. -->
    <ProjectReference Include="..\Nexaflow.Elevation\Nexaflow.Elevation.Contracts\Nexaflow.Elevation.Contracts.csproj" />
    <ProjectReference Include="..\Nexaflow.Elevation\Nexaflow.PrivilegeBridge\Nexaflow.PrivilegeBridge.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!--
    Copy the privilege bridge (exe + its dep closure) into a subfolder of Core's output so
    (a) ElevatedBridgeLauncher finds it at AppContext.BaseDirectory\PrivilegeBridge\ and
    (b) the WiX harvester (globs $(_CoreOutDir)**\*) packages it automatically. A subfolder isolates the
    bridge's deps (its System.Management etc.) from Core's own DLLs. Mirrors the StripNonWinX64Runtimes
    target's style of resolving another project's output via GetTargetPath.
  -->
  <Target Name="CopyPrivilegeBridge" AfterTargets="Build">
    <PropertyGroup>
      <_BridgeProj>$(MSBuildThisFileDirectory)..\Nexaflow.Elevation\Nexaflow.PrivilegeBridge\Nexaflow.PrivilegeBridge.csproj</_BridgeProj>
      <_BridgeDest>$(OutDir)PrivilegeBridge\</_BridgeDest>
    </PropertyGroup>

    <MSBuild Projects="$(_BridgeProj)" Targets="Build" Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(_BridgeProj)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_BridgeTarget" />
    </MSBuild>

    <PropertyGroup>
      <_BridgeOutDir>$([System.IO.Path]::GetDirectoryName('%(_BridgeTarget.Identity)'))\</_BridgeOutDir>
    </PropertyGroup>

    <ItemGroup>
      <_BridgeFile Include="$(_BridgeOutDir)**\*" Exclude="$(_BridgeOutDir)**\*.pdb" />
    </ItemGroup>

    <MakeDir Directories="$(_BridgeDest)" />
    <Copy SourceFiles="@(_BridgeFile)"
          DestinationFiles="@(_BridgeFile->'$(_BridgeDest)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
