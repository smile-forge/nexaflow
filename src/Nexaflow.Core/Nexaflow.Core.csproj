<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Win10 SDK moniker: the WindowsApps feature uses WinRT (Store package APIs); the host must
         target an OS version >= any project it references. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Appicon.ico</ApplicationIcon>
    <Company>Smile-Forge</Company>
    <Product>Nexaflow</Product>
    <Description>Nexaflow is an open-source Windows shell replacement</Description>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.0</FileVersion>
    <Version>0.8.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Nexacore</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Appicon.ico" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Updatum" Version="1.4.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Cuda" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Ribbon\default-ribbon.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Shown by the setup wizard's "What's New" step (read via Application.GetResourceStream). -->
    <Resource Include="Assets\WhatsNew.md" />
  </ItemGroup>

  <!--
    Whisper.net.Runtime[.Cuda] ship every RID under runtimes\ regardless of our win-x64
    RuntimeIdentifier. We're Windows-x64-only, so prune the dead trees (the linux CUDA .so
    alone is ~160 MB). Runs after both Build and Publish; keeps win-x64 + cuda\win-x64.
  -->
  <Target Name="StripNonWinX64Runtimes" AfterTargets="Build;Publish">
    <ItemGroup>
      <_NfRuntimeRoot Include="$(OutDir)runtimes" Condition="Exists('$(OutDir)runtimes')" />
      <_NfRuntimeRoot Include="$(PublishDir)runtimes" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)runtimes')" />
    </ItemGroup>
    <RemoveDir Directories="@(_NfRuntimeRoot->'%(Identity)\cuda\linux-x64');@(_NfRuntimeRoot->'%(Identity)\win-arm64');@(_NfRuntimeRoot->'%(Identity)\win-x86')" />
  </Target>

  <!--
    LlamaSharp 0.27 probes runtimes\win-x64\native\cuda{driverMajor}\ and ONLY that folder. On a CUDA-13
    host it looks in cuda13\, but only LLamaSharp.Backend.Cuda12 exists (cuda12\) — so it silently falls
    back to CPU. CUDA drivers are backward-compatible, so mirror the cuda12 binaries into cuda13\ in the
    build output. The installer's recursive harvest then ships cuda13\ (so the installed app already has
    it — no runtime copy into a read-only Program Files dir), and dev runs pick it up directly.
  -->
  <Target Name="MirrorCuda12AsCuda13" AfterTargets="Build;Publish">
    <ItemGroup>
      <_Cuda12Out Include="$(OutDir)runtimes\win-x64\native\cuda12\*.dll"
                  Condition="Exists('$(OutDir)runtimes\win-x64\native\cuda12')" />
      <_Cuda12Pub Include="$(PublishDir)runtimes\win-x64\native\cuda12\*.dll"
                  Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)runtimes\win-x64\native\cuda12')" />
    </ItemGroup>
    <Copy SourceFiles="@(_Cuda12Out)" DestinationFolder="$(OutDir)runtimes\win-x64\native\cuda13"
          SkipUnchangedFiles="true" Condition="'@(_Cuda12Out)' != ''" />
    <Copy SourceFiles="@(_Cuda12Pub)" DestinationFolder="$(PublishDir)runtimes\win-x64\native\cuda13"
          SkipUnchangedFiles="true" Condition="'@(_Cuda12Pub)' != ''" />
  </Target>

