<UserControl x:Class="Nexaflow.Core.Controls.AiResponseOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown;assembly=Nexaflow.Visuals.Text"
             IsHitTestVisible="True">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <ControlTemplate x:Key="PillButton" TargetType="Button">
            <Border x:Name="root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="7" Padding="10,6">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot"
          Visibility="{Binding AiResponseOverlayOpen, Converter={StaticResource BoolVis}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- ~10% gap at top -->
            <RowDefinition Height="9*"/>    <!-- ~90% overlay -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>   <!-- ~10% gap -->
            <ColumnDefinition Width="8*"/>  <!-- ~80% overlay -->
            <ColumnDefinition Width="*"/>   <!-- ~10% gap -->
        </Grid.ColumnDefinitions>

        <!-- Dimmed modal backdrop: spans the whole control and swallows clicks
             behind the panel so nothing underneath is interactive. -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Grid.Column="0" Grid.ColumnSpan="3"
                Background="#CC0F1117"/>

        <Border x:Name="Panel"
                Grid.Row="1" Grid.Column="1"
                Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.7" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="SlideXform" Y="0"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- header -->
                    <RowDefinition Height="*"/>     <!-- body -->
                    <RowDefinition Height="Auto"/>  <!-- footer -->
                </Grid.RowDefinitions>

                <!-- Header: solid accent bar so the AI surface is unmistakable -->
                <Border Grid.Row="0"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="11,11,0,0"
                        Padding="16,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="✦"
                                   FontSize="15" Margin="0,0,8,0"
                                   Foreground="{StaticResource OnAccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AiResponseAiName}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource OnAccentBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Style="{StaticResource TopBarAction}"
                                Command="{Binding CloseAiResponseOverlayCommand}"
                                ToolTip="Close">
                            <TextBlock Text="✕" FontSize="13" Foreground="{StaticResource OnAccentBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body: selectable markdown, or a centred status line while the agent works -->
                <Grid Grid.Row="1">
                    <md:SelectableMarkdownView x:Name="MarkdownBody"
                                               Markdown="{Binding AiResponseText}"
                                               VerticalScrollBarVisibility="Auto"
                                               Margin="20,14"
                                               Visibility="{Binding AiOverlayShowsMarkdown, Converter={StaticResource BoolVis}}"/>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding AiOverlayIsRunning, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding AiProgressText}"
                                   FontSize="16" FontStyle="Italic"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <!-- Animated ellipsis: cycles "" → "." → ".." → "..." while the agent works. -->
                        <TextBlock x:Name="EllipsisDots" Text="…" Width="22"
                                   FontSize="16" FontStyle="Italic"
                                   Foreground="{StaticResource TextMutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AiOverlayIsRunning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="DotsAnim">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Text" Duration="0:0:1.2">
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0"   Value=""/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="."/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.6" Value=".."/>
                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.9" Value="..."/>
                                                        </ObjectAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="DotsAnim"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Footer: hidden while running -->
                <Border Grid.Row="2"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,10"
                        Visibility="{Binding AiOverlayShowsMarkdown, Converter={StaticResource BoolVis}}">
                    <Grid>
                        <!-- Message / final state -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding AiOverlayIsMessage, Converter={StaticResource BoolVis}}">
                            <Button Content="Continue as Conversation"
                                    Command="{Binding ContinueAsConversationCommand}"
                                    FontSize="12"
                                    Background="{StaticResource AccentBrush}"
                                    Foreground="{StaticResource OnAccentBrush}"
                                    BorderThickness="0"
                                    Template="{StaticResource PillButton}"/>
                        </StackPanel>

                        <!-- Approval state -->
                        <Grid Visibility="{Binding AiOverlayIsApproval, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding AiToolApprovalSummary}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Deny"
                                        Command="{Binding DenyToolBatchCommand}"
                                        FontSize="12" Margin="0,0,8,0"
                                        Background="{StaticResource BorderBrush}"
                                        Foreground="{StaticResource TextBrush}"
                                        BorderThickness="0"
                                        Template="{StaticResource PillButton}"/>
                                <Button Content="Accept"
                                        Command="{Binding AcceptToolBatchCommand}"
                                        FontSize="12"
                                        Background="{StaticResource AccentBrush}"
                                        Foreground="{StaticResource OnAccentBrush}"
                                        BorderThickness="0"
                                        Template="{StaticResource PillButton}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
