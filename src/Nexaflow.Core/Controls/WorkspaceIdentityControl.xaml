<UserControl x:Class="Nexaflow.Core.Controls.WorkspaceIdentityControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             x:Name="Root">
    <UserControl.Resources>
        <cv:ColorStringToBrushConverter x:Key="ColorBrush"/>

        <!-- Neutral (surface) action button -->
        <Style x:Key="NeutralButton" TargetType="Button">
            <Setter Property="Height"     Value="32"/>
            <Setter Property="MinWidth"   Value="160"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger (destructive) action button -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height"     Value="32"/>
            <Setter Property="MinWidth"   Value="160"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- DataContext of this panel is set in code-behind to an editing copy of the workspace; the swatch
         list pulls from the control itself (ElementName=Root). -->
    <StackPanel x:Name="EditPanel" MaxWidth="540" HorizontalAlignment="Left">

        <TextBlock Text="{loc:Str Shell.Workspace.Identity.Title}" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="{loc:Str Shell.Workspace.Identity.Intro}"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <!-- Live preview tile + Name + Symbol -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="8"
                    Margin="0,0,16,0" VerticalAlignment="Center"
                    Background="{Binding Color, Converter={StaticResource ColorBrush}}">
                <TextBlock Text="{Binding Icon}" FontSize="28"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{loc:Str Shell.Workspace.Name}" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource DarkTextBox}" FontSize="13"
                         AutomationProperties.AutomationId="identity_Name"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" Width="64">
                <TextBlock Text="{loc:Str Shell.Workspace.Symbol}" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" Margin="0,0,0,4"/>
                <TextBox Style="{StaticResource DarkTextBox}" FontSize="13" MaxLength="3"
                         AutomationProperties.AutomationId="identity_Icon"
                         Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <!-- Colour: swatch bank + hex value -->
        <TextBlock Text="{loc:Str Shell.Workspace.Colour}" Foreground="{StaticResource TextMutedBrush}"
                   FontSize="11" Margin="0,0,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="0" VerticalAlignment="Top"
                          ItemsSource="{Binding Swatches, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="22" Height="22" Margin="0,0,6,6"
                                Cursor="Hand"
                                Background="{Binding Brush}"
                                Tag="{Binding Hex}"
                                ToolTip="{Binding Hex}"
                                Click="OnSwatchClick"
                                AutomationProperties.AutomationId="identity_Swatch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="11"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox Grid.Column="1" Width="100" Margin="8,0,0,0" Padding="4"
                     VerticalAlignment="Top"
                     Style="{StaticResource DarkTextBox}" FontSize="12"
                     AutomationProperties.AutomationId="identity_Color"
                     Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{loc:Str Shell.Workspace.HexTip}"/>
        </Grid>

        <!-- Conversations: export to markdown -->
        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,16"/>
        <TextBlock Text="{loc:Str Shell.Workspace.Conversations.Title}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="{loc:Str Shell.Workspace.Conversations.Intro}"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button Content="{loc:Str Shell.Workspace.Conversations.Export}" Style="{StaticResource NeutralButton}"
                HorizontalAlignment="Left" Click="OnExportClick"
                AutomationProperties.AutomationId="identity_Export"/>

        <!-- Danger zone: delete workspace -->
        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,22,0,16"/>
        <TextBlock Text="{loc:Str Shell.Workspace.DeleteZone.Title}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource DangerBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="{loc:Str Shell.Workspace.DeleteZone.Detail}"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button x:Name="DeleteButton" Content="{loc:Str Shell.Workspace.DeleteZone.Button}" Style="{StaticResource DangerButton}"
                HorizontalAlignment="Left" Click="OnDeleteClick"
                AutomationProperties.AutomationId="identity_Delete"/>
    </StackPanel>
</UserControl>
