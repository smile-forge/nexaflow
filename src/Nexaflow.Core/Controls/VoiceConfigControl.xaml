<UserControl x:Class="Nexaflow.Core.Controls.VoiceConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <StackPanel Margin="4">

        <TextBlock Text="Model" Margin="0,0,0,4"
                   Foreground="{StaticResource TextMutedBrush}"/>
        <ComboBox ItemsSource="{Binding Models}"
                  SelectedItem="{Binding SelectedModel}"
                  Style="{StaticResource DarkComboBox}"
                  Width="280" HorizontalAlignment="Left" Margin="0,0,0,8">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- What the selected size is suited for -->
        <TextBlock Text="{Binding SelectedDescription}"
                   TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="11" Margin="0,0,0,18"/>

        <!-- Download status -->
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{StaticResource TextBrush}"/>
                <ProgressBar Height="6" Margin="0,10,0,0"
                             Minimum="0" Maximum="100"
                             Value="{Binding DownloadPercent}"
                             Foreground="{StaticResource AccentBrush}"
                             Background="{StaticResource BorderBrush}"
                             BorderThickness="0"
                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolVis}}"/>
                <Button Content="Download now"
                        Margin="0,10,0,0" Padding="12,6"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White" BorderThickness="0"
                        Command="{Binding DownloadCommand}"
                        Visibility="{Binding CanDownload, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
