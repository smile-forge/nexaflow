<UserControl x:Class="Nexaflow.Core.Controls.ShellConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nexaflow.Core.Controls">

    <ScrollViewer Padding="20,12">
        <StackPanel x:Name="RootPanel">

            <!-- ── Theme ── -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Theme"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1"
                          Style="{StaticResource DarkComboBox}"
                          AutomationProperties.AutomationId="ShellThemeCombo"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme}"/>
            </Grid>

            <!-- Palette swatches -->
            <StackPanel Margin="180,4,0,2" Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Swatches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type Color}">
                            <Rectangle Width="18" Height="18" Margin="0,0,4,0" RadiusX="3" RadiusY="3">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Restart notice -->
            <TextBlock Margin="180,2,0,12"
                       Text="A restart is required for theme changes to take effect."
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11"/>

            <!-- ── Language ── -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Language"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1"
                          Style="{StaticResource DarkComboBox}"
                          AutomationProperties.AutomationId="ShellLanguageCombo"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage}"/>
            </Grid>

            <!-- ── Text size ── -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Text size"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource DarkComboBox}"
                              Width="80"
                              AutomationProperties.AutomationId="ShellTextSizeCombo"
                              ItemsSource="{Binding TextSizeOptions}"
                              SelectedItem="{Binding TextFontSize}"/>
                    <!-- Rendered at the chosen size, so the number is not the only thing telling you what you
                         picked. FontSize binds the same property the combo writes, so it tracks as you pick. -->
                    <TextBlock Text="The quick brown fox"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="{Binding TextFontSize}"/>
                </StackPanel>
            </Grid>
            <TextBlock Margin="180,2,0,12"
                       Text="Base size for the text editor, markdown documents and the hex grid. Each viewer's own zoom multiplies it. Takes effect immediately."
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap"/>

            <!-- ── Start with Windows ── -->
            <Grid Margin="0,12,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Start with Windows"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.AutomationId="ShellPrestartToggle"
                                  IsChecked="{Binding PrestartAtLogin}"/>
                    <TextBlock Text="Preload at login for instant startup"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Margin="180,2,0,12"
                       Text="Runs Nexaflow in the background when you sign in so windows open instantly. Takes effect at next login."
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap"/>

            <!-- ── Background animations on battery ── -->
            <Grid Margin="0,12,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Battery saver"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.AutomationId="ShellBatteryAnimationsToggle"
                                  IsChecked="{Binding DisableAnimationsOnBattery}"/>
                    <TextBlock Text="Disable background animations when on battery"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Margin="180,2,0,12"
                       Text="Stops the animated backdrop some themes draw behind the shell while running on battery. Takes effect immediately; themes without a backdrop (Dark, Light) are unaffected."
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
