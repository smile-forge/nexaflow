<UserControl x:Class="Nexaflow.Core.Controls.ShellConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             xmlns:local="clr-namespace:Nexaflow.Core.Controls">

    <!-- Horizontal scrolling disabled on purpose: a ScrollViewer that may scroll sideways measures its
         content at INFINITE width, and under that a Width="*" column stops meaning "share the viewport"
         and starts meaning "as wide as the child asks for". Nothing then holds a row to the panel, so
         opening the theme dropdown scrolled the whole page sideways and took the 180px label column off
         the left edge — which read as the combo widening. It also clipped the wrapping descriptions
         mid-word, because they were never given a width to wrap at. -->
    <ScrollViewer Padding="20,12" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="RootPanel">

            <!-- ── Theme ── -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Shell.Options.Shell.Theme}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1"
                          Style="{StaticResource DarkComboBox}"
                          AutomationProperties.AutomationId="ShellThemeCombo"
                          ItemsSource="{Binding ThemeOptions}"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedTheme}"/>
            </Grid>

            <!-- Palette swatches -->
            <StackPanel Margin="180,4,0,2" Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding Swatches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type Color}">
                            <Rectangle Width="18" Height="18" Margin="0,0,4,0" RadiusX="3" RadiusY="3">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Restart notice -->
            <TextBlock Margin="180,2,0,12"
                       Text="{loc:Str Shell.Options.Shell.RestartNote}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11"/>

            <!-- ── Language ── (the installed language packs; a LanguageInfo shows its DisplayName) -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Shell.Options.Shell.Language}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1"
                          Style="{StaticResource DarkComboBox}"
                          AutomationProperties.AutomationId="ShellLanguageCombo"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding SelectedLanguage}"/>
            </Grid>

            <!-- ── Text size ── -->
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Shell.Options.Shell.TextSize}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource DarkComboBox}"
                              Width="80"
                              AutomationProperties.AutomationId="ShellTextSizeCombo"
                              ItemsSource="{Binding TextSizeOptions}"
                              SelectedItem="{Binding TextFontSize}"/>
                    <!-- Rendered at the chosen size, so the number is not the only thing telling you what you
                         picked. FontSize binds the same property the combo writes, so it tracks as you pick. -->
                    <TextBlock Text="{loc:Str Shell.Options.Shell.TextSample}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="{Binding TextFontSize}"/>
                </StackPanel>
            </Grid>
            <TextBlock Margin="180,2,0,12"
                       Text="{loc:Str Shell.Options.Shell.TextSizeNote}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap"/>

            <!-- ── Start with Windows ── -->
            <Grid Margin="0,12,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Shell.Options.Shell.Startup}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.AutomationId="ShellPrestartToggle"
                                  IsChecked="{Binding PrestartAtLogin}"/>
                    <TextBlock Text="{loc:Str Shell.Options.Shell.Preload}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Margin="180,2,0,12"
                       Text="{loc:Str Shell.Options.Shell.PreloadNote}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap"/>

            <!-- ── Background animations on battery ── -->
            <Grid Margin="0,12,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Shell.Options.Shell.Battery}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.AutomationId="ShellBatteryAnimationsToggle"
                                  IsChecked="{Binding DisableAnimationsOnBattery}"/>
                    <TextBlock Text="{loc:Str Shell.Options.Shell.BatteryToggle}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Margin="180,2,0,12"
                       Text="{loc:Str Shell.Options.Shell.BatteryNote}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap"/>

            <!-- ── Enhanced AI protection ── -->
            <Grid Margin="0,12,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Shell.Options.Shell.Protection}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.AutomationId="ShellAiProtectionToggle"
                                  IsChecked="{Binding EnhancedAiProtection}"/>
                    <TextBlock Text="{loc:Str Shell.Options.Shell.AiProtection}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Margin="180,2,0,12"
                       Text="{loc:Str Shell.Options.Shell.AiProtectionNote}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
