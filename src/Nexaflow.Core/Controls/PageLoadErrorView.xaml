<UserControl x:Class="Nexaflow.Core.Controls.PageLoadErrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="PageLoadError">
    <Grid Background="{StaticResource BgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="620" Margin="24,32" HorizontalAlignment="Center">

                <TextBlock Text="⚠" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{StaticResource DangerBrush}"/>

                <TextBlock x:Name="HeadlineText"
                           Text="This tab couldn't open"
                           FontSize="17" FontWeight="Bold" Margin="0,12,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock x:Name="SummaryText"
                           FontSize="12" Margin="0,8,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <!-- Missing components that plausibly explain the failure. Hidden when nothing is missing,
                     so the panel never invents a cause it doesn't have. -->
                <Border x:Name="DependencyPanel" Visibility="Collapsed"
                        Margin="0,18,0,0" Padding="14" CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{StaticResource DangerBrush}"
                        Background="{StaticResource DangerSubtleBrush}">
                    <StackPanel>
                        <TextBlock Text="This is probably why"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <ItemsControl x:Name="DependencyList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="12" FontWeight="Bold" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="Options → About → System components lists these and where to get them."/>
                    </StackPanel>
                </Border>

                <!-- The exception itself. A TextBox so it can be selected and copied; read-only and
                     borderless so it still reads as text rather than an input. -->
                <Border Margin="0,18,0,0" Padding="12" CornerRadius="6"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                    <StackPanel>
                        <TextBlock Text="Technical detail"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBox x:Name="DetailBox"
                                 AutomationProperties.AutomationId="PageLoadError_Detail"
                                 Margin="0,8,0,0"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 BorderThickness="0" Background="Transparent"
                                 MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button x:Name="CopyButton"
                            AutomationProperties.AutomationId="PageLoadError_Copy"
                            Content="Copy details" Padding="14,6" Cursor="Hand" BorderThickness="0"
                            Background="{StaticResource AccentBrush}"
                            Foreground="{StaticResource OnAccentBrush}"
                            Click="OnCopyClick"/>
                    <Button x:Name="ComponentsButton"
                            AutomationProperties.AutomationId="PageLoadError_Components"
                            Content="View components" Margin="8,0,0,0" Padding="14,6"
                            Cursor="Hand" BorderThickness="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            Background="Transparent"
                            Foreground="{StaticResource TextBrush}"
                            Click="OnComponentsClick"/>
                </StackPanel>

                <TextBlock x:Name="LogPathText"
                           FontSize="11" Margin="0,14,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
