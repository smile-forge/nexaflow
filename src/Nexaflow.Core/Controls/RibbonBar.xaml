<UserControl x:Class="Nexaflow.Core.Controls.RibbonBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Nexaflow.Core.Models"
             xmlns:cvn="clr-namespace:Nexaflow.Core.Converters"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             AllowDrop="True">
    <UserControl.Resources>
        <cvn:RibbonKindVisibilityConverter x:Key="RibbonKindVis"/>
        <cv:BoolToVisibilityConverter     x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Empty hit-test fill so drag works in the gap after the last button -->
        <Border Grid.Column="0" Background="Transparent"/>

        <!-- Items populated from code-behind via ItemsSource -->
        <StackPanel Orientation="Horizontal" x:Name="ItemsPanel"
                    Grid.Column="0" VerticalAlignment="Stretch"/>

        <!-- Overflow button — shown only when items don't fit -->
        <Button x:Name="OverflowBtn"
                Grid.Column="1"
                Visibility="Collapsed"
                VerticalAlignment="Stretch"
                ToolTip="More ribbon items"
                Padding="8,0"
                Cursor="Hand"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Click="OverflowBtn_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" Background="Transparent">
                        <TextBlock Text="More…"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="8,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource Surface2Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Overflow popup -->
        <Popup x:Name="OverflowPopup"
               PlacementTarget="{Binding ElementName=OverflowBtn}"
               Placement="Bottom"
               StaysOpen="False">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Padding="4">
                <StackPanel x:Name="OverflowList" Orientation="Vertical" MinWidth="120"/>
            </Border>
        </Popup>

        <!-- Edit-ribbon toggle — full-height, right edge, arrow pinned to bottom -->
        <Button x:Name="EditBtn"
                Grid.Column="2"
                AutomationProperties.AutomationId="Chrome_RibbonEdit"
                VerticalAlignment="Stretch"
                ToolTip="Customise ribbon"
                Width="28" Padding="0"
                Cursor="Hand"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Click="EditBtn_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root" Background="Transparent">
                        <Path Data="M0 0 L6 0 L3 4 Z"
                              Fill="{StaticResource TextMutedBrush}"
                              Width="6" Height="4" Stretch="Fill"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,8"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource Surface2Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
