<UserControl x:Class="Nexaflow.Core.Controls.AiReplyCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown;assembly=Nexaflow.Visuals.Text"
             xmlns:beh="clr-namespace:Nexaflow.Visuals.Common.Behaviors;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">
    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="CardVis"/>
    </UserControl.Resources>

    <!-- The whole of what the AI bar's line holds, rendered: a reply, what an approval explains, or a plan. Shown on hover over
         the reply, pinned by a click on it; nothing behind it is blocked. Bound to ShellAIResponseHandler. -->
    <Border x:Name="Card" Style="{StaticResource PopupBorder}" Padding="0"
            Visibility="{Binding Card.IsOpen, Converter={StaticResource CardVis}}"
            MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="14,8,8,0">
                <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="AiCard_Close"
                        Style="{StaticResource TopBarAction}" Command="{Binding Card.CloseCommand}"
                        ToolTip="{loc:Str Shell.AiResponse.Close}"
                        Visibility="{Binding Card.IsPinned, Converter={StaticResource CardVis}}">
                    <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </Button>
                <TextBlock Text="{Binding AiResponseAiName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </DockPanel>

            <!-- The scroller is outside the surface so a reply being written can be followed to its end. -->
            <ScrollViewer Grid.Row="1" beh:ScrollFollowsEnd.IsEnabled="True"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <md:MarkdownSurface Markdown="{Binding AiResponseText}" VerticalScrollBarVisibility="Disabled" Margin="14,6,14,12"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
