<UserControl x:Class="Nexaflow.Core.Controls.RibbonEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:bh="clr-namespace:Nexaflow.Visuals.Common.Behaviors;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             xmlns:ctrl="clr-namespace:Nexaflow.Core.Controls"
             xmlns:m="clr-namespace:Nexaflow.Core.Models"
             xmlns:vm="clr-namespace:Nexaflow.Core.ViewModels"
             x:Name="EditorRoot">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>

        <!-- Section headings over each group of controls. -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- A strip card: a ListBoxItem, so each card is a control a journey can select. -->
        <Style x:Key="StripCard" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
            <Setter Property="Margin" Value="2,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ring" BorderThickness="2" CornerRadius="6" Padding="2"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chips for a one-of-several choice (section, colour slot, outline weight). -->
        <Style x:Key="Chip" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="chip" Background="{StaticResource Surface2Brush}" CornerRadius="10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A list that wraps and never scrolls: no ScrollViewer, so the WrapPanel is given the width it has. -->
        <Style x:Key="WrapList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipList" TargetType="ListBox" BasedOn="{StaticResource WrapList}">
            <Setter Property="DisplayMemberPath" Value="Name"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Chip}"/>
        </Style>



        <!-- A card on the strip: the real ribbon button (drawn exactly as the ribbon draws it), or a divider. -->
        <DataTemplate x:Key="ButtonCard" DataType="{x:Type vm:RibbonEditorCard}">
            <ctrl:RibbonItemButton AutomationProperties.AutomationId="RibbonEditor_CardPreview"
                                   Item="{Binding Item}" IsCompact="{Binding Item.IsHalf}"
                                   IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center"/>
        </DataTemplate>
        <DataTemplate x:Key="SeparatorCard" DataType="{x:Type vm:RibbonEditorCard}">
            <Rectangle Width="1" Margin="6,8" Fill="{StaticResource BorderBrush}" VerticalAlignment="Stretch"/>
        </DataTemplate>
        <ctrl:RibbonCardTemplateSelector x:Key="CardTemplate"
                                         Button="{StaticResource ButtonCard}"
                                         Separator="{StaticResource SeparatorCard}"/>
    </UserControl.Resources>

    <!-- The editor card tracks the live ribbon width (+ the selector inset) so the editing surface matches
         the strip it edits rather than a fixed size. Its host, MainWindow, creates it only while it is open. -->
    <vcc:ModalCard IsOpen="True" Background="{StaticResource Surface2Brush}" Padding="24"
                   CancelCommand="{Binding CancelCommand}"
                   CardWidth="{Binding RibbonWidth, ElementName=EditorRoot}" CardMinWidth="760">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- header       -->
                <RowDefinition Height="Auto"/>   <!-- strip        -->
                <RowDefinition Height="Auto"/>   <!-- selection    -->
                <RowDefinition Height="Auto"/>   <!-- footer       -->
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Str Shell.RibbonEditor.Title}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{loc:Str Shell.RibbonEditor.Hint}" FontSize="11" Margin="0,4,0,0"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <Button AutomationProperties.AutomationId="RibbonEditor_CloseX"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource TopBarAction}" Command="{Binding CancelCommand}">
                    <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                </Button>
            </Grid>

            <!-- ── The ribbon, as cards: select to style, drag to reorder ── -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,12" MinHeight="84">
                <ListBox AutomationProperties.AutomationId="RibbonEditor_Strip"
                         ItemsSource="{Binding Cards}"
                         SelectedItem="{Binding Selected}"
                         ItemTemplateSelector="{StaticResource CardTemplate}"
                         ItemContainerStyle="{StaticResource StripCard}"
                         bh:DragReorder.Command="{Binding ReorderCommand}"
                         Background="Transparent" BorderThickness="0" Margin="4,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <!-- ── The selection ── -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,12" MinHeight="48">
                <Grid>
                    <TextBlock Text="{loc:Str Shell.RibbonEditor.NoSelection}" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolVis}}"/>

                    <!-- A separator: all there is to do is move or remove it. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsSeparatorSelected, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{loc:Str Shell.RibbonEditor.Separator}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,16,0"/>
                        <Button AutomationProperties.AutomationId="RibbonEditor_SeparatorLeft" Content="◀"
                                Style="{StaticResource RibbonHalfButton}" Padding="10,6" Margin="0,0,4,0"
                                Command="{Binding MoveLeftCommand}"/>
                        <Button AutomationProperties.AutomationId="RibbonEditor_SeparatorRight" Content="▶"
                                Style="{StaticResource RibbonHalfButton}" Padding="10,6" Margin="0,0,16,0"
                                Command="{Binding MoveRightCommand}"/>
                        <Button AutomationProperties.AutomationId="RibbonEditor_DeleteSeparator"
                                Style="{StaticResource RibbonHalfButton}" Padding="12,6"
                                Command="{Binding DeleteCommand}">
                            <TextBlock Text="{loc:Str Shell.RibbonEditor.Delete}" FontSize="12" Foreground="{StaticResource DangerBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- A button: its name, size and place on the left, its look on the right. -->
                    <Grid Visibility="{Binding IsButtonSelected, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Str Shell.RibbonEditor.Preview}"/>
                            <Border Background="{StaticResource Chrome.Bg}" CornerRadius="6" Height="72" Margin="0,0,0,12">
                                <ctrl:RibbonItemButton AutomationProperties.AutomationId="RibbonEditor_Preview"
                                                       Item="{Binding SelectedItem}" IsCompact="{Binding SelectedItem.IsHalf}"
                                                       IsHitTestVisible="False" Focusable="False"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Str Shell.RibbonEditor.Name}"/>
                            <TextBox AutomationProperties.AutomationId="RibbonEditor_Name"
                                     Style="{StaticResource DarkTextBox}" Padding="6,4" FontSize="12" Margin="0,0,0,12"
                                     Text="{Binding SelectedItem.Label, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Str Shell.RibbonEditor.Arrange}"/>
                            <WrapPanel Margin="0,0,0,12">
                                <Button AutomationProperties.AutomationId="RibbonEditor_SizeToggle"
                                        Style="{StaticResource RibbonHalfButton}" Padding="10,6" Margin="0,0,4,4"
                                        Content="{Binding SizeToggleText}" Command="{Binding ToggleSizeCommand}"/>
                                <Button AutomationProperties.AutomationId="RibbonEditor_MoveLeft" Content="◀"
                                        ToolTip="{loc:Str Shell.RibbonEditor.MoveLeft}"
                                        Style="{StaticResource RibbonHalfButton}" Padding="10,6" Margin="0,0,4,4"
                                        Command="{Binding MoveLeftCommand}"/>
                                <Button AutomationProperties.AutomationId="RibbonEditor_MoveRight" Content="▶"
                                        ToolTip="{loc:Str Shell.RibbonEditor.MoveRight}"
                                        Style="{StaticResource RibbonHalfButton}" Padding="10,6" Margin="0,0,4,4"
                                        Command="{Binding MoveRightCommand}"/>
                            </WrapPanel>

                            <WrapPanel>
                                <Button AutomationProperties.AutomationId="RibbonEditor_ResetLook"
                                        Style="{StaticResource RibbonHalfButton}" Padding="10,6" Margin="0,0,4,4"
                                        Content="{loc:Str Shell.RibbonEditor.ResetLook}"
                                        Command="{Binding ResetLookCommand}"/>
                                <Button AutomationProperties.AutomationId="RibbonEditor_DeleteItem"
                                        Style="{StaticResource RibbonHalfButton}" Padding="10,6" Margin="0,0,4,4"
                                        Command="{Binding DeleteCommand}">
                                    <TextBlock Text="{loc:Str Shell.RibbonEditor.Delete}" FontSize="12" Foreground="{StaticResource DangerBrush}"/>
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="300"/>
                            </Grid.RowDefinitions>

                            <ListBox Style="{StaticResource ChipList}" Margin="0,0,0,10"
                                     AutomationProperties.AutomationId="RibbonEditor_Sections"
                                     ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"/>

                            <!-- Icon: every emoji and Fluent icon, searchable. -->
                            <icons:IconPicker Grid.Row="1" AutomationPrefix="RibbonEditor_Icons"
                                              SelectedIcon="{Binding SelectedItem.Icon, Mode=TwoWay}"
                                              Visibility="{Binding IsIconSection, Converter={StaticResource BoolVis}}"/>

                            <!-- Colours: one picker, pointed at the icon-and-text, background or border colour. -->
                            <Grid Grid.Row="1" Visibility="{Binding IsColoursSection, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <ListBox Style="{StaticResource ChipList}" Margin="0,0,0,8"
                                             AutomationProperties.AutomationId="RibbonEditor_Slots"
                                             ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"/>
                                    <vcc:ColorPicker AutomationPrefix="RibbonEditor_Colour"
                                                     Value="{Binding SelectedColour, Mode=TwoWay}"
                                                     DefaultColor="{Binding SlotDefaultColor}"
                                                     BaselineKey="{Binding ColourBaseline}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Visibility="{Binding IsBorderSlot, Converter={StaticResource BoolVis}}"
                                                Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Str Shell.RibbonEditor.Outline}"/>
                                        <ListBox Style="{StaticResource ChipList}"
                                                 AutomationProperties.AutomationId="RibbonEditor_Weights"
                                                 ItemsSource="{Binding BorderWeights}" SelectedItem="{Binding SelectedBorderWeight}"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Str Shell.RibbonEditor.UsedColours}"/>
                                    <ItemsControl ItemsSource="{Binding UsedColours}" Margin="0,0,0,12" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="22" Height="22" Margin="0,0,4,4" Cursor="Hand"
                                                        AutomationProperties.AutomationId="RibbonEditor_UsedColour"
                                                        ToolTip="{Binding}"
                                                        Background="{Binding Converter={x:Static cv:ColorSpecToBrushConverter.Instance}}"
                                                        Command="{Binding DataContext.UseColourCommand, ElementName=EditorRoot}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="11"
                                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Str Shell.RibbonEditor.Readability}"/>
                                    <TextBlock Text="{Binding ContrastText}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{loc:Str Shell.RibbonEditor.ContrastAdvice}" FontSize="11" TextWrapping="Wrap"
                                               Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}"
                                               Visibility="{Binding IsLowContrast, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Shape: the selected button drawn in every shape. -->
                            <ListBox Grid.Row="1" AutomationProperties.AutomationId="RibbonEditor_Shapes"
                                     ItemsSource="{Binding ShapeOptions}" SelectedItem="{Binding SelectedShape}"
                                Style="{StaticResource WrapList}"
                                ItemContainerStyle="{StaticResource StripCard}"
                                Visibility="{Binding IsShapeSection, Converter={StaticResource BoolVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RibbonShapeOption}">
                                        <StackPanel Width="96" Margin="4">
                                            <Border Background="{StaticResource Chrome.Bg}" CornerRadius="6" Height="72">
                                                <ctrl:RibbonItemButton AutomationProperties.AutomationId="RibbonEditor_ShapePreview"
                                                                       Item="{Binding Preview}" IsHitTestVisible="False" Focusable="False"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Footer ── -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Add a button for any openable (CanBeContextItem) page -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Str Shell.RibbonEditor.AddPage}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                    <ComboBox AutomationProperties.AutomationId="RibbonEditor_PageCatalog"
                              Style="{StaticResource DarkComboBox}" Width="220" MaxDropDownHeight="280"
                              ItemsSource="{Binding AvailablePages}" SelectedItem="{Binding PageToAdd}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:RibbonCatalogEntry}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button AutomationProperties.AutomationId="RibbonEditor_AddPage" Content="{loc:Str Shell.RibbonEditor.Add}"
                            Style="{StaticResource RibbonHalfButton}" Padding="12,6" FontSize="12" Margin="8,0,0,0"
                            Foreground="{StaticResource AccentBrush}" Command="{Binding AddPageCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button AutomationProperties.AutomationId="RibbonEditor_AddSeparator" Content="{loc:Str Shell.RibbonEditor.InsertSeparator}"
                            Style="{StaticResource RibbonHalfButton}" Padding="12,6" FontSize="12" Margin="0,0,8,0"
                            Foreground="{StaticResource TextMutedBrush}" Command="{Binding AddSeparatorCommand}"/>
                    <Button AutomationProperties.AutomationId="RibbonEditor_ResetDefaults" Content="{loc:Str Shell.RibbonEditor.ResetDefaults}"
                            Style="{StaticResource RibbonHalfButton}" Padding="12,6" FontSize="12" Margin="0,0,8,0"
                            Foreground="{StaticResource TextMutedBrush}" Command="{Binding ResetDefaultsCommand}"/>
                    <Button AutomationProperties.AutomationId="RibbonEditor_Cancel" Content="{loc:Str Shell.RibbonEditor.Cancel}"
                            Style="{StaticResource RibbonHalfButton}" Padding="16,6" FontSize="12" Margin="0,0,8,0"
                            Foreground="{StaticResource TextMutedBrush}" Command="{Binding CancelCommand}"/>
                    <Button AutomationProperties.AutomationId="RibbonEditor_Done" Content="{loc:Str Shell.RibbonEditor.Done}"
                            Style="{StaticResource RibbonHalfButton}" Padding="20,6" FontSize="12"
                            Foreground="{StaticResource AccentBrush}" Command="{Binding DoneCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </vcc:ModalCard>
</UserControl>
