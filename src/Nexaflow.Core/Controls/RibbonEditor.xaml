<UserControl x:Class="Nexaflow.Core.Controls.RibbonEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Nexaflow.Core.Models"
             x:Name="EditorRoot">

    <!-- Full-screen semi-transparent backdrop -->
    <Grid Background="#CC0F1117">

        <!-- Centred editor card — tracks the live ribbon width (+ the selector inset) so the
             editing surface matches the strip it edits rather than a fixed size. -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Style="{StaticResource PopupBorder}"
                Width="{Binding RibbonWidth, ElementName=EditorRoot}"
                MinWidth="600"
                Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- header       -->
                    <RowDefinition Height="Auto"/>   <!-- card strip   -->
                    <RowDefinition Height="Auto"/>   <!-- props panel  -->
                    <RowDefinition Height="Auto"/>   <!-- footer       -->
                </Grid.RowDefinitions>

                <!-- ── Header ── -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Customise Ribbon"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Drag to reorder · click an item to edit · Done to apply"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource TopBarAction}"
                            Click="Cancel_Click">
                        <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>

                <!-- ── Ribbon preview strip (horizontally scrolling, natural height) ── -->
                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Margin="0,0,0,12" MinHeight="72">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal"
                                    x:Name="CardsPanel"
                                    VerticalAlignment="Stretch"
                                    Margin="4,0"/>
                    </ScrollViewer>
                </Border>

                <!-- ── Properties panel — always visible, content changes with selection ── -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16,12" Margin="0,0,0,12"
                        MinHeight="48">
                    <Grid>

                        <!-- State 1: nothing selected -->
                        <TextBlock x:Name="NoSelectionMsg"
                                   Text="Click an item above to edit it"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- State 2: separator selected -->
                        <StackPanel x:Name="SepProps"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Separator" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Style="{StaticResource RibbonHalfButton}"
                                    Padding="12,6" Click="DeleteSelected_Click">
                                <TextBlock Text="✕  Delete" FontSize="12" Foreground="{StaticResource DangerBrush}"/>
                            </Button>
                        </StackPanel>

                        <!-- State 3: button selected -->
                        <Grid x:Name="BtnProps" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Name -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                <TextBlock Text="NAME" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="NameInput"
                                         Style="{StaticResource DarkTextBox}"
                                         Width="150" Padding="6,4" FontSize="12"
                                         TextChanged="NameInput_TextChanged"/>
                            </StackPanel>

                            <!-- Size toggle -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <TextBlock Text="SIZE" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <Button x:Name="SizeToggleBtn"
                                        Style="{StaticResource RibbonHalfButton}"
                                        Padding="12,6" MinWidth="90"
                                        Click="SizeToggle_Click"/>
                            </StackPanel>

                            <!-- Icon picker: 6-column scrolling grid -->
                            <StackPanel Grid.Column="4" VerticalAlignment="Top">
                                <TextBlock Text="ICON" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <Border Background="{StaticResource Surface2Brush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        MaxHeight="120">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <WrapPanel x:Name="IconGrid"
                                                   Orientation="Horizontal"
                                                   Width="204"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>

                            <!-- Colour swatches + hex input -->
                            <StackPanel Grid.Column="6" VerticalAlignment="Top">
                                <TextBlock Text="COLOUR" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <WrapPanel x:Name="ColorSwatches" Width="160" Margin="0,0,0,6"/>
                                <TextBox x:Name="HexInput"
                                         Style="{StaticResource DarkTextBox}"
                                         Width="160" Padding="6,4" FontSize="11" MaxLength="9"
                                         ToolTip="#RRGGBB or #AARRGGBB"
                                         TextChanged="HexInput_TextChanged"/>
                            </StackPanel>

                            <!-- Delete -->
                            <StackPanel Grid.Column="8" VerticalAlignment="Top">
                                <TextBlock Text="REMOVE" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <Button Style="{StaticResource RibbonHalfButton}"
                                        Padding="12,6" Click="DeleteSelected_Click">
                                    <TextBlock Text="✕  Delete" FontSize="12" Foreground="{StaticResource DangerBrush}"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Border>

                <!-- ── Footer ── -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Add a button for any openable (CanBeContextItem) page -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Add page:" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="PageCatalogCombo"
                                  Style="{StaticResource DarkComboBox}"
                                  Width="220" MaxDropDownHeight="280">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:RibbonCatalogEntry}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="＋ Add"
                                Style="{StaticResource RibbonHalfButton}"
                                Padding="12,6" FontSize="12"
                                Foreground="{StaticResource AccentBrush}"
                                Click="AddPageButton_Click"
                                Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Layout + dismiss actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Insert separator"
                            Style="{StaticResource RibbonHalfButton}"
                            Padding="12,6" FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Click="AddSeparator_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="Reset to defaults"
                            Style="{StaticResource RibbonHalfButton}"
                            Padding="12,6" FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Click="ResetDefaults_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="Cancel"
                            Style="{StaticResource RibbonHalfButton}"
                            Padding="16,6" FontSize="12"
                            Foreground="{StaticResource TextMutedBrush}"
                            Click="Cancel_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="Done"
                            Style="{StaticResource RibbonHalfButton}"
                            Padding="20,6" FontSize="12"
                            Foreground="{StaticResource AccentBrush}"
                            Click="Done_Click"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>

