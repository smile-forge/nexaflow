<UserControl x:Class="Nexaflow.Core.Controls.WorkContextSelectorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Nexaflow.Core.Models"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             x:Name="Root">
    <UserControl.Resources>
        <cv:ColorStringToBrushConverter x:Key="ColorBrush"/>

        <Style x:Key="CtxItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Coloured rectangle: context colour fill, full height -->
        <Border x:Name="SelectorBorder"
                Background="{Binding CurrentWorkContext.Color, ElementName=Root, Converter={StaticResource ColorBrush}}"
                ClipToBounds="True">
            <Button x:Name="TriggerButton"
                    Background="Transparent"
                    BorderThickness="0"
                    WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="OnTriggerClick"
                    ToolTip="{Binding CurrentWorkContext.Name, ElementName=Root}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#28FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{Binding CurrentWorkContext.Icon, ElementName=Root}"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Button>
        </Border>

        <!-- Context switcher popup -->
        <Popup x:Name="ContextPopup"
               PlacementTarget="{Binding ElementName=SelectorBorder}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    MinWidth="180"
                    Padding="0,4">
                <ItemsControl x:Name="ContextList"
                              ItemsSource="{Binding WorkContexts, ElementName=Root}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:WorkContextConfig}">
                            <Button Style="{StaticResource CtxItemButton}"
                                    Tag="{Binding}"
                                    Click="OnContextItemClick">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="12" CornerRadius="2" Margin="0,0,8,0"
                                            Background="{Binding Color, Converter={StaticResource ColorBrush}}"/>
                                    <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>
