<UserControl x:Class="Nexaflow.Core.Controls.ProfilesConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:local="clr-namespace:Nexaflow.Core.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <cv:ColorStringToBrushConverter x:Key="ColorBrush"/>
    </UserControl.Resources>

    <ScrollViewer Padding="20,12">
        <StackPanel x:Name="RootPanel">

            <!-- Profile list -->
            <ItemsControl x:Name="ProfileItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12"
                                Background="{StaticResource Surface2Brush}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Colour swatch -->
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4"
                                        Margin="0,0,10,0" VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={StaticResource ColorBrush}}">
                                    <TextBlock Text="{Binding Icon}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Fields -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Name"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Color"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"/>
                                    </Grid>

                                    <!-- Swatch picker (shared bank) — click sets this profile's colour;
                                         the hex box above remains for a custom value. -->
                                    <ItemsControl Margin="60,0,0,4"
                                                  ItemsSource="{Binding Swatches,
                                                      RelativeSource={RelativeSource AncestorType={x:Type local:ProfilesConfigControl}}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="18" Height="18" Margin="0,0,4,0"
                                                        Cursor="Hand"
                                                        Background="{Binding Brush}"
                                                        Tag="{Binding Hex}"
                                                        ToolTip="{Binding Hex}"
                                                        Click="OnSwatchClick">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="9"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Icon"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Clone + Remove buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="⧉"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource TopBarAction}"
                                            FontSize="12"
                                            ToolTip="Clone this profile (new symbol &amp; colour, all other settings copied)"
                                            Tag="{Binding}"
                                            Click="OnCloneClick"/>
                                    <Button Content="✕"
                                            Margin="4,0,0,0"
                                            Style="{StaticResource TopBarAction}"
                                            FontSize="12"
                                            ToolTip="Remove this profile (the active profile can't be removed)"
                                            Tag="{Binding}"
                                            Click="OnRemoveClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add button -->
            <Button Content="+ Add Work Context"
                    Style="{StaticResource TopBarAction}"
                    HorizontalAlignment="Left"
                    Margin="0,4,0,0"
                    Click="OnAddClick"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
