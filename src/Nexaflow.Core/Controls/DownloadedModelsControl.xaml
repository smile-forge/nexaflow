<UserControl x:Class="Nexaflow.Core.Controls.DownloadedModelsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:vm="clr-namespace:Nexaflow.Core.ViewModels"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <DockPanel Margin="16,12">
        <DockPanel DockPanel.Dock="Top">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="{loc:Str Shell.Config.Downloaded.Heading}"
                       FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{loc:Str Shell.Config.Downloaded.Intro}"
                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10"
                   Foreground="{StaticResource TextMutedBrush}"/>
        <TextBlock DockPanel.Dock="Top" Text="{loc:Str Shell.Config.Downloaded.Empty}" FontSize="12" Margin="0,8"
                   Foreground="{StaticResource TextMutedBrush}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Models}" AutomationProperties.AutomationId="DownloadedModels_List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DownloadedModelViewModel}">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UsedBy}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Size}" FontSize="12" Margin="12,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextBrush}"/>
                                <Button Grid.Column="2" Style="{StaticResource RowButton}" Command="{Binding DeleteCommand}"
                                        Content="{loc:Str Shell.Config.Downloaded.Delete}" ToolTip="{Binding DeleteTip}"
                                        AutomationProperties.AutomationId="DownloadedModels_Delete"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
