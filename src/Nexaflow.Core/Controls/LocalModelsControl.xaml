<UserControl x:Class="Nexaflow.Core.Controls.LocalModelsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:vm="clr-namespace:Nexaflow.Core.ViewModels"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="Margin"          Value="6,0,0,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="16,12">
        <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}"
                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Intro}"
                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10"
                   Foreground="{StaticResource TextMutedBrush}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Models}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LocalModelRowViewModel}">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{loc:Str Shell.Config.LocalModels.InUse}" FontSize="11" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                                                   Visibility="{Binding IsInUse, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Size}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Margin="12,0"
                                           MaxWidth="260" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource RowButton}" Command="{Binding UseCommand}"
                                            Content="{loc:Str Shell.Config.LocalModels.Use}"
                                            Visibility="{Binding DataContext.CanChoose, Converter={StaticResource BoolVis},
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            AutomationProperties.AutomationId="LocalModels_Use"/>
                                    <Button Style="{StaticResource RowButton}" Command="{Binding DownloadCommand}"
                                            Content="{loc:Str Shell.Config.LocalModels.Download}"
                                            AutomationProperties.AutomationId="LocalModels_Download"/>
                                    <Button Style="{StaticResource RowButton}" Command="{Binding RemoveCommand}"
                                            Content="{loc:Str Shell.Config.LocalModels.Remove}"
                                            AutomationProperties.AutomationId="LocalModels_Remove"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
