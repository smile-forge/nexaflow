<UserControl x:Class="Nexaflow.Core.Controls.LocalModelsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:cvn="clr-namespace:Nexaflow.Core.Converters"
             xmlns:vm="clr-namespace:Nexaflow.Core.ViewModels"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <cvn:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
        <cv:NullToVisibilityConverter x:Key="NullHidden"/>

        <!-- A model the machine cannot run is listed, greyed, never chosen. -->
        <Style x:Key="ChoiceItem" TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}">
            <Setter Property="IsEnabled" Value="{Binding Runs}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One model in a job's list: here (✓), to download (⬇ and its size), or not for this machine (⊘ and why). -->
        <DataTemplate x:Key="ChoiceTemplate" DataType="{x:Type vm:LocalChoiceViewModel}">
            <DockPanel MinWidth="320">
                <TextBlock DockPanel.Dock="Left" Width="18" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="⬇"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHere}" Value="True">
                                    <Setter Property="Text" Value="✓"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Runs}" Value="False">
                                    <Setter Property="Text" Value="⊘"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11" Margin="12,0,0,0"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource TextBrush}"/>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="16,12">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Str Shell.Config.Local.Heading}"
                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock DockPanel.Dock="Top" Text="{loc:Str Shell.Config.Local.Intro}"
                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,10"
                   Foreground="{StaticResource TextMutedBrush}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LocalJobViewModel}">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,6,0,0"
                                           Foreground="{StaticResource TextBrush}"/>
                                <StackPanel Grid.Column="1">
                                    <ComboBox AutomationProperties.AutomationId="LocalModels_Choice"
                                              AutomationProperties.Name="{Binding Label}"
                                              Style="{StaticResource DarkComboBox}" ItemContainerStyle="{StaticResource ChoiceItem}"
                                              ItemTemplate="{StaticResource ChoiceTemplate}"
                                              ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                              Visibility="{Binding CanChoose, Converter={StaticResource BoolVis}}"
                                              HorizontalAlignment="Left" MinWidth="380"/>
                                    <TextBlock Text="{Binding Remark}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Visibility="{Binding Remark, Converter={StaticResource NullHidden}}"/>
                                    <TextBlock Text="{Binding Note}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Visibility="{Binding CanChoose, Converter={StaticResource InverseBoolVis}}"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
