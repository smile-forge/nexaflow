<UserControl x:Class="Nexaflow.Core.Controls.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:Nexaflow.Core.Controls"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="PaneRoot">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab bar: breadcrumb left, tabs right -->
        <Border Grid.Row="0"
                Background="{DynamicResource TabStrip.Bg}"
                BorderBrush="{DynamicResource TabStrip.Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.35*"/>
                    <ColumnDefinition Width="0.65*"/>
                </Grid.ColumnDefinitions>

                <ctrl:BreadcrumbBar x:Name="BreadcrumbBarControl"
                                    Grid.Column="0"
                                    Segments="{Binding Pane.ActivePage.Breadcrumbs, ElementName=PaneRoot}"
                                    BorderBrush="{DynamicResource TabStrip.Border}"
                                    BorderThickness="0,0,1,0"/>

                <ctrl:TabStrip x:Name="TabStripControl"
                               Grid.Column="1"
                               AutomationProperties.AutomationId="TabStrip"
                               Pane="{Binding Pane, ElementName=PaneRoot}"
                               Tabs="{Binding Pane.Pages, ElementName=PaneRoot}"
                               ActivateTabCommand="{Binding ActivateTabCommand, ElementName=PaneRoot}"
                               CloseTabCommand="{Binding CloseTabCommand, ElementName=PaneRoot}"
                               PinTabToRibbonCommand="{Binding PinTabToRibbonCommand, ElementName=PaneRoot}"
                               TearOffTabCommand="{Binding TearOffTabCommand, ElementName=PaneRoot}"
                               ReceiveTabCommand="{Binding ReceiveTabCommand, ElementName=PaneRoot}"
                               SplitTabCommand="{Binding SplitTabCommand, ElementName=PaneRoot}"
                               SplitEmptyCommand="{Binding SplitEmptyCommand, ElementName=PaneRoot}"
                               ClosePaneCommand="{Binding ClosePaneCommand, ElementName=PaneRoot}"
                               CloseOthersCommand="{Binding CloseOthersCommand, ElementName=PaneRoot}"
                               PaneActivatedCommand="{Binding PaneActivatedCommand, ElementName=PaneRoot}"/>
            </Grid>
        </Border>

        <!-- Page content host. Wrapped so the active theme can render a backdrop ("Page" region)
             behind whatever feature page is shown — Pro themes supply none and this is inert. -->
        <vcc:ThemedRegion Grid.Row="1" Region="Page">
            <ContentPresenter x:Name="ContentHost"/>
        </vcc:ThemedRegion>
    </Grid>
</UserControl>
