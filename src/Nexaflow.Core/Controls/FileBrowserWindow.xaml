<Window x:Class="Nexaflow.Core.Controls.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
        Title="Select File"
        Width="720" Height="640"
        MinWidth="560" MinHeight="460"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        BorderBrush="{StaticResource BorderLightBrush}"
        BorderThickness="1"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Shared button template for this window -->
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border x:Name="root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header. Doubles as the window's own caption: the native one is off, so this is what it drags by. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,18"
                MouseLeftButtonDown="Caption_MouseLeftButtonDown">
            <StackPanel>
                <TextBlock x:Name="HeaderText"
                           Text="Select File"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="SubText"
                           Margin="0,4,0,0"
                           FontSize="12.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- File / folder tree -->
        <TreeView x:Name="FileTree"
                  Grid.Row="1"
                  Background="{StaticResource SurfaceBrush}"
                  BorderThickness="0"
                  Margin="12"
                  Padding="6,8"
                  Foreground="{StaticResource TextBrush}"
                  FontSize="13"
                  SelectedItemChanged="FileTree_SelectedItemChanged"
                  ItemsSource="{Binding Roots}">
            <TreeView.Resources>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource PickerTreeItem}">
                    <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
                    <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                    <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick"/>
                </Style>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" FontSize="12.5" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- What a save would come to: the name being typed, the file it makes, and what writing it would mean.
             Shown instead of the row below, which is all an Open needs. -->
        <Border x:Name="SaveFoot" Grid.Row="2"
                Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,16"
                Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{loc:Str Shell.Picker.Name}"
                               Margin="0,0,12,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBox x:Name="NameBox" Grid.Column="1"
                             Style="{StaticResource DarkTextBox}"
                             FontSize="13.5"
                             TextChanged="NameBox_TextChanged"/>
                    <TextBlock x:Name="ExtText" Grid.Column="2"
                               Margin="10,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock x:Name="WhereText"
                           Margin="0,13,0,0"
                           FontSize="12.5" FontFamily="Consolas"
                           Opacity="0.88"
                           Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="RoomText"
                           Margin="0,5,0,0"
                           FontSize="12.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="FlagText"
                           Margin="0,5,0,0"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Selected path display -->
        <Border x:Name="OpenFoot" Grid.Row="2"
                Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="22,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Str Shell.Picker.FileLabel}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12.5" VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedPathText"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="0,1,0,0"
                Padding="22,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Str Shell.Prompt.Cancel}"
                        Width="100" Height="36"
                        Margin="0,0,10,0"
        IsCancel="True"
                        FontSize="13"
                        Background="{StaticResource Surface2Brush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Padding="8,4"
                        Template="{StaticResource RoundedButtonTemplate}"
                        Click="Cancel_Click"
                        AutomationProperties.AutomationId="FileBrowser_Cancel"/>
        <Button x:Name="OkBtn"
                        Content="{loc:Str Shell.Prompt.Ok}"
                        Width="100" Height="36"
                        IsDefault="True"
                        IsEnabled="False"
                        FontSize="13" FontWeight="SemiBold"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="8,4"
                        Template="{StaticResource RoundedButtonTemplate}"
                        Click="Ok_Click"
                        AutomationProperties.AutomationId="FileBrowser_Ok"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
