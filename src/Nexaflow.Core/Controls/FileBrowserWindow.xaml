<Window x:Class="Nexaflow.Core.Controls.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select File"
        Width="500" Height="520"
        MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        BorderBrush="{StaticResource BorderLightBrush}"
        BorderThickness="1"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Shared button template for this window -->
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border x:Name="root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <TextBlock x:Name="HeaderText"
                       Text="Select File"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
        </Border>

        <!-- File / folder tree -->
        <TreeView x:Name="FileTree"
                  Grid.Row="1"
                  Background="{StaticResource SurfaceBrush}"
                  BorderThickness="0"
                  Margin="8"
                  Foreground="{StaticResource TextBrush}"
                  FontSize="13"
                  SelectedItemChanged="FileTree_SelectedItemChanged"
                  ItemsSource="{Binding Roots}">
            <TreeView.Resources>
                <Style TargetType="TreeViewItem">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="4,3"/>
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
                    <EventSetter Event="Selected" Handler="TreeViewItem_Selected"/>
                    <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Selected path display -->
        <Border Grid.Row="2"
                Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="File: "
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectedPathText"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="80" Height="30"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        FontSize="12"
                        Background="{StaticResource Surface2Brush}"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Padding="8,4"
                        Template="{StaticResource RoundedButtonTemplate}"
                        Click="Cancel_Click"/>
                <Button x:Name="OkBtn"
                        Content="OK"
                        Width="80" Height="30"
                        IsDefault="True"
                        IsEnabled="False"
                        FontSize="12"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="8,4"
                        Template="{StaticResource RoundedButtonTemplate}"
                        Click="Ok_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
