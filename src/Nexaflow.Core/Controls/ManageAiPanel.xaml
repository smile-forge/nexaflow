<UserControl x:Class="Nexaflow.Core.Controls.ManageAiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nexaflow.Core.Controls"
             xmlns:vm="clr-namespace:Nexaflow.Core.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="*"/>     <!-- main content -->
            <RowDefinition Height="Auto"/>  <!-- footer buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,16,20,8">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource TopBarAction}"
                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window},
                                      Path=DataContext.CloseManageAiCommand}">
                <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
            </Button>
        </Grid>

        <!-- Two-column body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: section list -->
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Style="{StaticResource DarkListBox}"
                         Padding="8,4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"
                               BasedOn="{StaticResource DarkListBoxItem}">
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfigEditViewModel}">
                            <TextBlock Text="{Binding FriendlyName}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextBrush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Right: shared config editor (custom control or reflected property grid) -->
            <local:ConfigEditorView Grid.Column="1" Margin="20,12"
                                    DataContext="{Binding SelectedSection}"/>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Apply: enabled only when the current section has unsaved changes -->
                <Button Content="Apply"
                        Width="90" Height="32"
                        Margin="0,0,8,0"
                        FontSize="12"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding ApplyCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7" Padding="8,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="root" Property="Opacity" Value="0.35"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Close: applies pending changes to the running workspace on the way out -->
                <Button Content="Close"
                        Width="90" Height="32"
                        FontSize="12"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window},
                                          Path=DataContext.CloseManageAiCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7" Padding="8,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
