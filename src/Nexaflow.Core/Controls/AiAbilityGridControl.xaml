<UserControl x:Class="Nexaflow.Core.Controls.AiAbilityGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:cvn="clr-namespace:Nexaflow.Core.Converters"
             xmlns:vm="clr-namespace:Nexaflow.Core.ViewModels"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter       x:Key="BoolVis"/>
        <cvn:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
        <cv:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Cell button: selectable column item per row -->
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="Width"       Value="130"/>
            <Setter Property="Height"      Value="36"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Column header remove button -->
        <Style x:Key="RemoveColumnButton" TargetType="Button">
            <Setter Property="Width"       Value="16"/>
            <Setter Property="Height"      Value="16"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cell DataTemplate: an empty ring, or the column's place in the row's chain. A Local cell says what it holds, or why it
             cannot be used — greyed, its tip shown all the same. -->
        <DataTemplate x:Key="CellTemplate" DataType="{x:Type vm:AiAbilityCellViewModel}">
            <Button Command="{Binding ToggleCommand}"
                    ToolTipService.ShowOnDisabled="True"
                    AutomationProperties.AutomationId="AiGrid_Cell">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource CellButton}">
                        <Setter Property="ToolTip" Value="{loc:Str Shell.Config.AiGrid.CellTip}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Column.IsLocal}" Value="True">
                                <Setter Property="ToolTip" Value="{Binding Note}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Grid>
                        <TextBlock Text="–" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsGreyed, Converter={StaticResource BoolVis}}"/>
                        <Grid Width="20" Height="20"
                              Visibility="{Binding IsUsable, Converter={StaticResource BoolVis}}">
                            <Ellipse Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" Fill="Transparent"
                                     Visibility="{Binding IsInChain, Converter={StaticResource InverseBoolVis}}"/>
                            <Grid Visibility="{Binding IsInChain, Converter={StaticResource BoolVis}}">
                                <Ellipse Fill="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{Binding Position}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource OnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Grid>
                    <!-- A Local model the row uses that is not downloaded yet: a warning beside its place in the chain. -->
                    <TextBlock Text="{loc:Str Shell.Config.AiGrid.Local.RequiresDownload}" FontSize="10" Margin="6,0,0,0"
                               Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"
                               Visibility="{Binding RequiresDownload, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Row DataTemplate -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:AiAbilityRowViewModel}">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="40">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- A row with nothing assigned: marked, in the warning colour, as disabled. -->
                    <StackPanel Width="170" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AbilityName}" FontSize="12" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUnassigned}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{loc:Str Shell.Config.AiGrid.Disabled}" ToolTip="{loc:Str Shell.Config.AiGrid.DisabledTip}"
                                   FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource WarningBrush}"
                                   Visibility="{Binding IsUnassigned, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Cells}"
                                  ItemTemplate="{StaticResource CellTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <DockPanel Margin="16,12">

        <!-- ── Header bar ── -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{loc:Str Shell.Options.Abilities.Title}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Command="{Binding OpenAddPanelCommand}"
                    Visibility="{Binding ShowAddPanel, Converter={StaticResource InverseBoolVis}}"
                    Padding="10,5"
                    FontSize="12"
                    Foreground="{StaticResource TextBrush}"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    AutomationProperties.AutomationId="AiGrid_AddColumn">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="{loc:Str Shell.Options.Abilities.AddColumn}" FontSize="12"/>
            </Button>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="{loc:Str Shell.Config.AiGrid.ChainHint}"
                   FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"
                   Margin="0,0,0,10"/>

        <!-- What the Local column needs: its models downloaded — at once, from here — or a cloud service where this machine
             runs none. -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="5"
                Background="{StaticResource Surface2Brush}" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding LocalNotice, Converter={StaticResource NullToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="AiGrid_DownloadLocal"
                        Content="{loc:Str Shell.Config.AiGrid.Local.DownloadAll}" Command="{Binding DownloadLocalCommand}"
                        Visibility="{Binding CanDownloadLocal, Converter={StaticResource BoolVis}}"
                        Padding="12,4" FontSize="12" Margin="12,0,0,0" BorderThickness="0"
                        Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"/>
                <TextBlock Text="{Binding LocalNotice}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}"/>
            </DockPanel>
        </Border>

        <!-- ── Add-column inline panel ── -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding ShowAddPanel, Converter={StaticResource BoolVis}}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="5"
                Background="{StaticResource Surface2Brush}"
                Padding="12,10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{loc:Str Shell.Options.Abilities.AddColumnTitle}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <!-- Provider selector -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{loc:Str Shell.Options.Abilities.Provider}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableOffers}"
                                  SelectedItem="{Binding NewOffer}"
                                  DisplayMemberPath="Display"
                                  Style="{StaticResource DarkComboBox}"
                                  Width="210"/>
                    </StackPanel>

                    <!-- Model selector -->
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{loc:Str Shell.Options.Abilities.Model}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{loc:Str Shell.Options.Abilities.Loading}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding IsLoadingModels, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding SuggestedModels}"
                                  SelectedItem="{Binding NewModelName, Mode=TwoWay}"
                                  Style="{StaticResource DarkComboBox}"
                                  Width="200"/>
                    </StackPanel>

                    <!-- Add / Cancel buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                        <Button Content="{loc:Str Shell.Options.Abilities.Add}"
                                Command="{Binding ConfirmAddCommand}"
                                Padding="12,5" FontSize="12"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,0,6,0"
                                AutomationProperties.AutomationId="AiGrid_ConfirmAdd">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="{loc:Str Shell.Options.Cancel}"
                                Command="{Binding CancelAddCommand}"
                                Padding="12,5" FontSize="12"
                                Foreground="{StaticResource TextBrush}"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                AutomationProperties.AutomationId="AiGrid_CancelAdd">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Grid (header + rows) ── -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Column header row -->
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Background="{StaticResource SurfaceBrush}"
                        Height="72">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Blank space matching ability-name column -->
                        <TextBlock Width="170"/>

                        <!-- One header cell per column -->
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AiColumnViewModel}">
                                    <Grid Width="130" Margin="0,2">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ProviderName}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Model}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding KindLabel}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{loc:Str Shell.Config.AiGrid.StaysOnMachine}"
                                                       ToolTip="{loc:Str Shell.Config.AiGrid.StaysOnMachineTip}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding StaysOnMachine, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource RemoveColumnButton}"
                                                Margin="0,2,4,0"
                                                Command="{Binding DataContext.RemoveColumnCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolVis}}"
                                                ToolTip="{loc:Str Shell.Options.Abilities.RemoveColumn}"
                                                AutomationProperties.AutomationId="AiGrid_RemoveColumn">
                                            <TextBlock Text="×" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Ability rows -->
                <ItemsControl ItemsSource="{Binding Rows}"
                              ItemTemplate="{StaticResource RowTemplate}"/>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
