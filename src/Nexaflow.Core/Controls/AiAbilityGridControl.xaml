<UserControl x:Class="Nexaflow.Core.Controls.AiAbilityGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:cvn="clr-namespace:Nexaflow.Core.Converters"
             xmlns:vm="clr-namespace:Nexaflow.Core.ViewModels">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter       x:Key="BoolVis"/>
        <cvn:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>

        <Style x:Key="AbilityNameText" TargetType="TextBlock">
            <Setter Property="Width"              Value="170"/>
            <Setter Property="Foreground"         Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"           Value="12"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="Padding"            Value="0,0,12,0"/>
        </Style>

        <!-- Cell button: selectable column item per row -->
        <Style x:Key="CellButton" TargetType="Button">
            <Setter Property="Width"       Value="130"/>
            <Setter Property="Height"      Value="36"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Column header remove button -->
        <Style x:Key="RemoveColumnButton" TargetType="Button">
            <Setter Property="Width"       Value="16"/>
            <Setter Property="Height"      Value="16"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cell DataTemplate -->
        <DataTemplate x:Key="CellTemplate" DataType="{x:Type vm:AiAbilityCellViewModel}">
            <Button Style="{StaticResource CellButton}"
                    Command="{Binding SelectCommand}">
                <!-- Selection indicator: outer ring + filled dot -->
                <Grid Width="18" Height="18">
                    <Ellipse Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.5" Fill="Transparent"/>
                    <Ellipse Width="10" Height="10"
                             Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}">
                        <Ellipse.Fill>
                            <StaticResource ResourceKey="AccentBrush"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Row DataTemplate -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:AiAbilityRowViewModel}">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="40">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AbilityName}" Style="{StaticResource AbilityNameText}"/>
                    <ItemsControl ItemsSource="{Binding Cells}"
                                  ItemTemplate="{StaticResource CellTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <DockPanel Margin="16,12">

        <!-- ── Header bar ── -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="AI Ability Assignments"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Command="{Binding OpenAddPanelCommand}"
                    Visibility="{Binding ShowAddPanel, Converter={StaticResource InverseBoolVis}}"
                    Padding="10,5"
                    FontSize="12"
                    Foreground="{StaticResource TextBrush}"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="+ Add Provider / Model" FontSize="12"/>
            </Button>
        </DockPanel>

        <!-- ── Add-column inline panel ── -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding ShowAddPanel, Converter={StaticResource BoolVis}}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="5"
                Background="{StaticResource Surface2Brush}"
                Padding="12,10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Add a provider / model column"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <!-- Provider selector -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Provider" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableProviders}"
                                  SelectedItem="{Binding NewProviderName}"
                                  Style="{StaticResource DarkComboBox}"
                                  Width="150"/>
                    </StackPanel>

                    <!-- Model selector -->
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Model" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text=" (loading…)" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding IsLoadingModels, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding SuggestedModels}"
                                  SelectedItem="{Binding NewModelName, Mode=TwoWay}"
                                  Style="{StaticResource DarkComboBox}"
                                  Width="200"/>
                    </StackPanel>

                    <!-- Add / Cancel buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                        <Button Content="Add"
                                Command="{Binding ConfirmAddCommand}"
                                Padding="12,5" FontSize="12"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,0,6,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Cancel"
                                Command="{Binding CancelAddCommand}"
                                Padding="12,5" FontSize="12"
                                Foreground="{StaticResource TextBrush}"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Grid (header + rows) ── -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Column header row -->
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Background="{StaticResource SurfaceBrush}"
                        Height="52">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Blank space matching ability-name column -->
                        <TextBlock Width="170"/>

                        <!-- One header cell per column -->
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AiColumnViewModel}">
                                    <Grid Width="130" Margin="0,4">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding ProviderName}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Model}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding IsNone, Converter={StaticResource InverseBoolVis}}"/>
                                        </StackPanel>
                                        <!-- Remove button — hidden for the None column -->
                                        <Button Style="{StaticResource RemoveColumnButton}"
                                                Margin="0,2,4,0"
                                                Visibility="{Binding IsNone, Converter={StaticResource InverseBoolVis}}"
                                                Command="{Binding DataContext.RemoveColumnCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove this column">
                                            <TextBlock Text="×" FontSize="10"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Ability rows -->
                <ItemsControl ItemsSource="{Binding Rows}"
                              ItemTemplate="{StaticResource RowTemplate}"/>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
