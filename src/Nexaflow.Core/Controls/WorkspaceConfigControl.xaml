<UserControl x:Class="Nexaflow.Core.Controls.WorkspaceConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:local="clr-namespace:Nexaflow.Core.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <cv:ColorStringToBrushConverter x:Key="ColorBrush"/>
    </UserControl.Resources>

    <ScrollViewer Padding="20,12">
        <StackPanel x:Name="RootPanel">

            <!-- Add button (top of the list) -->
            <Button Content="+ Add Workspace"
                    Style="{StaticResource TopBarAction}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10"
                    Click="OnAddClick"/>

            <!-- Workspace list -->
            <ItemsControl x:Name="ProfileItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Thin border separates each workspace -->
                        <Border Margin="0,0,0,6" Padding="5"
                                Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                AllowDrop="True"
                                Drop="OnItemDrop">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Display icon (48px, +50%) — doubles as the drag handle to reorder -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6"
                                        Margin="0,0,12,0" VerticalAlignment="Center"
                                        Cursor="SizeAll"
                                        ToolTip="Drag to reorder"
                                        Background="{Binding Color, Converter={StaticResource ColorBrush}}"
                                        MouseLeftButtonDown="OnDragHandleMouseDown"
                                        MouseMove="OnDragHandleMouseMove">
                                    <TextBlock Text="{Binding Icon}" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel Grid.Column="1">
                                    <!-- Row 1: Name + Icon on one line -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Name"
                                              Foreground="{StaticResource TextMutedBrush}"
                                              FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                            Style="{StaticResource DarkTextBox}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="Icon" Margin="10,0,0,0"
                                              Foreground="{StaticResource TextMutedBrush}"
                                              FontSize="11" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="3"
                                            Style="{StaticResource DarkTextBox}"
                                            Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"
                                            MaxLength="3"
                                            FontSize="12"/>
                                    </Grid>
                                    <!-- Row 2: swatch picker + hex value to its right -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      ItemsSource="{Binding Swatches,
                                                          RelativeSource={RelativeSource AncestorType={x:Type local:WorkspaceConfigControl}}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="18" Height="18" Margin="0,0,4,0"
                                                            Cursor="Hand"
                                                            Background="{Binding Brush}"
                                                            Tag="{Binding Hex}"
                                                            ToolTip="{Binding Hex}"
                                                            Click="OnSwatchClick">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="9"
                                                                        BorderBrush="{StaticResource BorderBrush}"
                                                                        BorderThickness="1"/>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBox Grid.Column="1" Width="95" Margin="4,0,0,0" Padding="4"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"
                                                 ToolTip="Hex colour (e.g. #5B8CFF)"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Action buttons: vertical stack -->
                                <StackPanel Grid.Column="2" Orientation="Vertical"
                                            VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="108">
                                    <Button Style="{StaticResource TopBarAction}"
                                            Height="24" Margin="0,0,0,4"
                                            HorizontalContentAlignment="Left"
                                            ToolTip="Configure this workspace (AI, providers, per-workspace settings)"
                                            Tag="{Binding}" Click="OnConfigureClick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚙" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Configure" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource TopBarAction}"
                                            Height="24" Margin="0,0,0,4"
                                            HorizontalContentAlignment="Left"
                                            ToolTip="Clone this workspace (new symbol &amp; colour, all other settings copied)"
                                            Tag="{Binding}" Click="OnCloneClick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⧉" FontSize="13" Margin="0,0,8,0"/>
                                            <TextBlock Text="Clone" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Hidden for the live (active) workspace — it can't be removed. -->
                                    <Button Height="24"
                                            HorizontalContentAlignment="Left"
                                            ToolTip="Remove this workspace"
                                            Tag="{Binding}" Click="OnRemoveClick">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TopBarAction}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInUse}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✕" FontSize="13" Margin="0,0,8,0"
                                                       Foreground="{StaticResource DangerBrush}"/>
                                            <TextBlock Text="Delete" FontSize="12"
                                                       Foreground="{StaticResource DangerBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
