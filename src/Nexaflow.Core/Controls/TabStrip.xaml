<UserControl x:Class="Nexaflow.Core.Controls.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Single-column layout: button overlays right edge so VisiblePanel.ActualWidth
         never changes when the button toggles, eliminating the MeasureOverflow
         feedback loop that was caused by the old two-column grid. -->
    <Grid>
        <!-- Tab area — always full width, clips overflowing tabs -->
        <StackPanel x:Name="VisiblePanel"
                    Orientation="Horizontal"
                    ClipToBounds="True"
                    VerticalAlignment="Stretch"
                    Margin="8,0"
                    SizeChanged="VisiblePanel_SizeChanged"/>

        <!-- Overflow "..." button — right-aligned overlay, shown only when needed -->
        <Button x:Name="OverflowBtn"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                Style="{StaticResource RibbonButton}"
                Padding="10,0"
                ToolTip="More tabs"
                Click="OverflowBtn_Click">
            <TextBlock Text="•••" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
        </Button>

        <!-- Overflow popup -->
        <Popup x:Name="OverflowPopup"
               HorizontalAlignment="Right"
               StaysOpen="False"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=OverflowBtn}"
               AllowsTransparency="True">
            <Border Style="{StaticResource PopupBorder}" Padding="6" MinWidth="180">
                <StackPanel x:Name="OverflowList"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
