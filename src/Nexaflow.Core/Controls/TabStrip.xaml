<UserControl x:Class="Nexaflow.Core.Controls.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Tab item chrome. DataContext is the Page, so active/hover state and the
             label/icon are fully data-bound — no code-behind mirroring of Title/IsActive.
             Order matters: the IsActive trigger is last so an active tab keeps its accent
             styling even while hovered. Inner TextBlocks inherit TextElement.Foreground. -->
        <Style x:Key="TabItemBorderStyle" TargetType="Border">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="CornerRadius"    Value="6,6,0,0"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"             Value="{DynamicResource Tab.HoverBg}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background"             Value="{DynamicResource Tab.ActiveBg}"/>
                    <Setter Property="BorderBrush"            Value="{DynamicResource Tab.Accent}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Tab.Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <!-- Single-column layout: button overlays right edge so VisiblePanel.ActualWidth
         never changes when the button toggles, eliminating the MeasureOverflow
         feedback loop that was caused by the old two-column grid.
         Background=Transparent makes the empty strip area hit-testable so a right-click there
         raises this control's ContextMenu (the "Split" / "Close pane" menu) instead of falling
         through to the parent border. -->
    <Grid Background="Transparent">
        <!-- Tab area — always full width, clips overflowing tabs -->
        <StackPanel x:Name="VisiblePanel"
                    Orientation="Horizontal"
                    ClipToBounds="True"
                    VerticalAlignment="Stretch"
                    Margin="8,0"
                    SizeChanged="VisiblePanel_SizeChanged"/>

        <!-- Overflow "..." button — right-aligned overlay, shown only when needed -->
        <Button x:Name="OverflowBtn"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Visibility="Collapsed"
                Style="{StaticResource RibbonButton}"
                Padding="10,0"
                ToolTip="More tabs"
                Click="OverflowBtn_Click">
            <TextBlock Text="•••" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"/>
        </Button>

        <!-- Overflow popup — Placement=Custom; PlaceOverflowPopup right-anchors it to the button. -->
        <Popup x:Name="OverflowPopup"
               StaysOpen="False"
               Placement="Custom"
               PlacementTarget="{Binding ElementName=OverflowBtn}"
               AllowsTransparency="True">
            <Border Style="{StaticResource PopupBorder}" Padding="6" MinWidth="180">
                <StackPanel x:Name="OverflowList"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
