<UserControl x:Class="Nexaflow.Core.Controls.WorkspaceDefaultTabsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- heading + instructions -->
            <RowDefinition Height="Auto"/>  <!-- empty state -->
            <RowDefinition Height="*"/>     <!-- tab list -->
            <RowDefinition Height="Auto"/>  <!-- session-restore opt-out -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:Str Shell.Workspace.DefaultTabs.Title}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       Text="{loc:Str Shell.Workspace.DefaultTabs.Intro}"/>
        </StackPanel>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="0,4,0,0"
                   FontSize="12" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}"
                   Visibility="Collapsed"
                   Text="{loc:Str Shell.Workspace.DefaultTabs.Empty}"/>

        <ScrollViewer Grid.Row="2" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Display}" VerticalAlignment="Center"
                                           FontSize="13" Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="✕" Tag="{Binding}"
                                        Click="Remove_Click" Cursor="Hand"
                                        Width="26" Height="26" FontSize="12"
                                        ToolTip="{loc:Str Shell.Workspace.DefaultTabs.RemoveTip}"
                                        Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                        BorderThickness="0"
                                        AutomationProperties.AutomationId="DefaultTabs_Remove">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="root" Background="{TemplateBinding Background}"
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="root" Property="Background"
                                                            Value="{StaticResource DangerBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,12,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <CheckBox x:Name="NoSessionRestoreCheck"
                          Content="{loc:Str Shell.Workspace.DefaultTabs.NeverRestore}"
                          Foreground="{StaticResource TextBrush}" FontSize="12"
                          Checked="NoSessionRestore_Changed" Unchecked="NoSessionRestore_Changed"
                          AutomationProperties.AutomationId="DefaultTabs_NoSessionRestore"/>
                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="{loc:Str Shell.Workspace.DefaultTabs.NeverRestoreNote}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
