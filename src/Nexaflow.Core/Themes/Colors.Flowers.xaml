<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Palette: pressed flowers on cream paper ──
         A LIGHT immersive theme, but a STILL one: a drawn botanical plate (StillScene.Window ->
         FlowerbedScene) sits behind the shell and never moves. Its own warm off-white ground, deep
         leaf-ink text, and the two hues that carry the plate — a zinnia rose and a stem green.

         The illustration's charm is saturated colour on UNPRINTED paper, so the chrome stays warm
         paper tones and every strong hue is spent on the accents, the Swatch bank and the code
         palette. The accent is pitched a stop deeper than the coral it comes from: white on the
         literal coral is ~3.9:1, and OnAccentBrush defaults to white, so the rose (~5:1) keeps every
         checked toggle and primary button legible without an override.

         BgColor is the one translucent token: the page root is a paper veil the plate reads through,
         while SurfaceColor stays fully opaque so a list, an editor or a card never has flowers
         behind its text. That split is what keeps an illustrated theme a working one. -->
    <Color x:Key="BgColor">#9EFAF5EA</Color>       <!-- page root: a paper veil the plate reads through -->
    <Color x:Key="SurfaceColor">#FFFCF6</Color>     <!-- panels, cards, top bar, tabs — petal white -->
    <Color x:Key="Surface2Color">#F1E7D5</Color>    <!-- inputs, hover, selection, ribbon band — warm oat -->
    <Color x:Key="BorderColor">#D2C2A6</Color>      <!-- defined edges — the structure -->
    <Color x:Key="BorderLightColor">#E6DAC4</Color> <!-- subtle inner dividers -->
    <Color x:Key="AccentColor">#C4405C</Color>
    <!-- Zinnia rose -->
    <Color x:Key="Accent2Color">#2F7D4E</Color>
    <!-- Stem green -->
    <Color x:Key="TextColor">#26332A</Color>        <!-- deep leaf ink (~12:1 on the paper) -->
    <Color x:Key="TextMutedColor">#57654F</Color>   <!-- sage; clears 4.5:1 on the linen wings too, not just the paper -->
    <Color x:Key="DeepBgColor">#E8DCC4</Color>      <!-- chrome wings / drag bar / footer: linen -->

    <!-- ── Brushes ── -->
    <SolidColorBrush x:Key="BgBrush"         Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"    Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush"   Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush"     Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush"    Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="TextBrush"       Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"  Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DeepBgBrush"     Color="{StaticResource DeepBgColor}"/>

    <!-- Logo: bloom to marigold to stem. Straight rose-to-green would pass through mud at the
         midpoint; the marigold stop is what keeps the sweep in the plate's own colours. -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C4405C" Offset="0"/>
        <GradientStop Color="#EE8B3A" Offset="0.5"/>
        <GradientStop Color="#2F7D4E" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Dimensions -->
    <GridLength x:Key="TopBarHeight">72</GridLength>
    <GridLength x:Key="TabBarHeight">38</GridLength>
    <GridLength x:Key="InteractionHeight">90</GridLength>

</ResourceDictionary>
