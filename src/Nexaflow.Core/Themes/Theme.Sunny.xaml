<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Nexaflow.Core.Themes">

    <!-- ════════════════════════════════════════════════════════════════════════
         SUNNY — immersive, but LIGHT (unlike Ocean/Forest/Sandstone).
         A cheerful sky (Scene.Window) shows softly through the translucent content; chrome, tabs and
         the input are clean near-opaque cream/white framing it. The strong colour comes from the
         accents, the active tab and the rainbow logo — not the frame. The page is light enough that
         the dark text stays readable while balloons drift past as soft pastels.
         ════════════════════════════════════════════════════════════════════════ -->

    <!-- Chrome: clean warm-cream frame (near-opaque so the sky stays in the content window). -->
    <SolidColorBrush x:Key="Chrome.Deep"   Color="#F2F3E9D2"/>
    <SolidColorBrush x:Key="Chrome.Panel"  Color="#F2FCF6EA"/>
    <SolidColorBrush x:Key="Chrome.Bg"     Color="#EEF7EFDC"/>
    <SolidColorBrush x:Key="Chrome.Border" Color="#66E2D4BA"/>

    <!-- Tab strip: light cream frame; the active tab lifts to white (coral accent comes from Tab.Accent). -->
    <SolidColorBrush x:Key="TabStrip.Bg"   Color="#F2F4ECD8"/>
    <SolidColorBrush x:Key="TabStrip.Border" Color="#66E2D4BA"/>
    <SolidColorBrush x:Key="Tab.HoverBg"   Color="#99FBF1DC"/>
    <SolidColorBrush x:Key="Tab.ActiveBg"  Color="#FFFFFFFF"/>

    <!-- AI bar: surround transparent to the sky; a clean white input field. -->
    <SolidColorBrush x:Key="AiBar.Bg"      Color="#66FFF7E8"/>
    <SolidColorBrush x:Key="AiBar.InputBg" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="AiBar.Border"  Color="#66E2D4BA"/>

    <!-- File view tree + action strip: transparent to the sky, matching the file list. -->
    <SolidColorBrush x:Key="FileList.PanelBg" Color="#66FFF7E8"/>

    <!-- The one backdrop, behind every row. -->
    <DataTemplate x:Key="Scene.Window">
        <t:SunnyScene/>
    </DataTemplate>

    <!-- User chat bubble: soft warm peach — dark navy text (#2D3444) readable at ~10:1. Distinct from
         white Surface panels while staying in the warm sky palette. -->
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#FFE8DA"/>

    <!-- Danger hover: strengthen so the Delete button clearly reddens on the light cream surface. -->
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#55DC2626"/>

    <!-- AI status dot: deepen the hues to read on the bright cream/white bar; playful but distinct. -->
    <SolidColorBrush x:Key="AiStatus.Ready"   Color="#1FA565"/>  <!-- green  -->
    <SolidColorBrush x:Key="AiStatus.Busy"    Color="#FF7A2D"/>  <!-- orange -->
    <SolidColorBrush x:Key="AiStatus.Handler" Color="#6D5BE0"/>  <!-- indigo -->
    <LinearGradientBrush x:Key="AiStatus.ListenBrush" StartPoint="0,0" EndPoint="1,1">
        <!-- playful violet → pink: distinct from green ready and orange busy -->
        <GradientStop Color="#9B6BFF" Offset="0"/>
        <GradientStop Color="#FF6BB5" Offset="1"/>
    </LinearGradientBrush>

    <!-- The "White" post-it blends into the warm cream sky canvas — give it a cool blue-grey paper so
         it pops against the warm background; the fixed dark ink stays readable. -->
    <LinearGradientBrush x:Key="PostIt.White.Fill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#DCE6F2" Offset="0"/>
        <GradientStop Color="#C9D8EA" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PostIt.White.Header" Color="#AEC2DC"/>

</ResourceDictionary>
