<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                        xmlns:t="clr-namespace:Nexaflow.Core.Themes">

    <!-- ════════════════════════════════════════════════════════════════════════
         FLOWERS — region overrides + a STILL backdrop.
         A warm PAPER frame (chrome, tabs, sidebar) wraps the content canvas, so panels, the active
         tab and input fields read as pressed onto the page. Structure comes from the three-step
         zoning + warm borders + deep leaf ink, not from value jumps:
            wings  #E8DCC4  <  frame #F2E7D3  <  content (BgColor) #FAF5EA  <  panels #FFFCF6
         The colour of the plate lives where colour MEANS something — the accents, the chart/category
         bank and the code palette — never in the frame.

         The frame is near-opaque on purpose: FlowerbedScene shows through the PAGE and the AI-bar
         surround, and is held out of the chrome. A plate behind everything would be prettier for the
         first ten seconds and unreadable thereafter, which is the same call Sunny makes.
         ════════════════════════════════════════════════════════════════════════ -->

    <!-- Chrome: linen frame; logo column / drag bar / right panel a step deeper. -->
    <SolidColorBrush x:Key="Chrome.Deep"       Color="#F7E8DCC4"/>
        <SolidColorBrush x:Key="Chrome.Panel"      Color="#F2F2E7D3"/>
        <SolidColorBrush x:Key="Chrome.RightPanel" Color="#F7E8DCC4"/>
        <SolidColorBrush x:Key="Chrome.Bg"         Color="#F2F2E7D3"/>
    <!-- Ribbon buttons lift off the linen strip as soft petal-white, so the strip reads as a surface
         the buttons sit ON rather than as one flat band. -->
    <SolidColorBrush x:Key="Ribbon.ButtonBg"   Color="#80FFFDF7"/>

    <!-- Tab strip: linen frame; the active tab lifts to petal white, hover is a subtle lighten. -->
    <SolidColorBrush x:Key="TabStrip.Bg"  Color="#F0F2E7D3"/>
        <SolidColorBrush x:Key="Tab.HoverBg"  Color="#B3F8F0E1"/>
        <SolidColorBrush x:Key="Tab.ActiveBg" Color="#FFFFFCF6"/>

    <!-- Window.Bg is deliberately NOT set. A veil here stacks under every other surface's own veil,
         so it quietened the plate everywhere in order to tame the one state where it is bare (no tab
         open) — and that state stopped being a problem once the motifs got smaller and denser. Tune
         the plate's strength in FlowerbedScene, where it is one number, not by layering veils. -->


    <!-- AI bar: transparent to the plate, with a clean petal-white input field and cluster panels so
         a flower sits behind the buttons rather than through them. -->
    <SolidColorBrush x:Key="AiBar.Bg"        Color="#B8FAF5EA"/>
        <SolidColorBrush x:Key="AiBar.InputBg"   Color="#FFFFFCF6"/>
        <SolidColorBrush x:Key="AiBar.ClusterBg" Color="#E6FFFCF6"/>

    <!-- File view tree + action strip: transparent to the plate, matching the file list. -->
    <!-- Matched to the page's own veil rather than left thinner: the tree carries the smallest text
         in the shell, and a lighter veil here put the boldest flowers under exactly that. -->
    <SolidColorBrush x:Key="FileList.PanelBg" Color="#B8FAF5EA"/>

    <!-- The one backdrop, behind every row. StillScene rather than Scene because it never animates,
         which is also why the battery policy leaves it up: see ThemedRegion.ApplyRegion. -->
    <DataTemplate x:Key="StillScene.Window">
        <t:FlowerbedScene/>
    </DataTemplate>

    <!-- User chat bubble: soft blush — the accent's own hue at petal strength, so the deep leaf ink
         (#26332A) stays readable (~10:1) where the full rose would not. -->
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#F9DDE1"/>

    <!-- Danger hover: 15% red is nearly invisible on a light surface — strengthen so the Delete
         button clearly reddens on hover. -->
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#55DC2626"/>

    <!-- AI status dot: taken from the plate (leaf, marigold, lavender petal) but deepened to read on
         the light linen bar, and kept mutually distinct. The handler indigo is held well clear of the
         rose accent so a matched handler never reads as "primary action". -->
    <SolidColorBrush x:Key="AiStatus.Ready"   Color="#2F7D4E"/>  <!-- leaf green   -->
    <SolidColorBrush x:Key="AiStatus.Busy"    Color="#DD7A1E"/>  <!-- marigold     -->
    <SolidColorBrush x:Key="AiStatus.Handler" Color="#6A5AA8"/>  <!-- lavender     -->
    <LinearGradientBrush x:Key="AiStatus.ListenBrush" StartPoint="0,0" EndPoint="1,1">
        <!-- lavender petal to cosmos pink: deep enough for the light bar, and clear of both the green
             ready state and the marigold busy state -->
        <GradientStop Color="#7E6FA8" Offset="0"/>
        <GradientStop Color="#D94E8A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Categorical bank — the plate IS a categorical palette, so the chart/pie/category hues come
         straight off it. Retuned deeper than the dark-theme defaults (bright pastels vanish on cream)
         while keeping the twelve mutually separable, which is the bank's whole contract. -->
    <SolidColorBrush x:Key="Swatch.Blue"   Color="#2F6E9E"/>  <!-- navy leaf        -->
    <SolidColorBrush x:Key="Swatch.Red"    Color="#C9273C"/>  <!-- red zinnia       -->
    <SolidColorBrush x:Key="Swatch.Green"  Color="#3E8E52"/>  <!-- leaf             -->
    <SolidColorBrush x:Key="Swatch.Amber"  Color="#E8A62E"/>  <!-- daisy centre     -->
    <SolidColorBrush x:Key="Swatch.Purple" Color="#7A64B0"/>  <!-- lavender petal   -->
    <SolidColorBrush x:Key="Swatch.Orange" Color="#E4702A"/>  <!-- orange bloom     -->
    <SolidColorBrush x:Key="Swatch.Cyan"   Color="#2E9BC4"/>  <!-- pale sky leaf    -->
    <SolidColorBrush x:Key="Swatch.Pink"   Color="#E06A86"/>  <!-- cosmos           -->
    <SolidColorBrush x:Key="Swatch.Teal"   Color="#2FA792"/>  <!-- berry teal       -->
    <SolidColorBrush x:Key="Swatch.Yellow" Color="#CDAA1E"/>  <!-- sunflower ray    -->
    <SolidColorBrush x:Key="Swatch.Slate"  Color="#7C7A8C"/>  <!-- dusty stem       -->
    <SolidColorBrush x:Key="Swatch.Lime"   Color="#8CA83F"/>  <!-- olive frond      -->

    <!-- The "White" post-it is nearly the colour of this theme's paper canvas — give it a sage-green
         paper so it stays visible while the fixed dark ink remains readable. Other note colours keep
         the contributed pastel defaults. -->
    <LinearGradientBrush x:Key="PostIt.White.Fill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E4EBDD" Offset="0"/>
        <GradientStop Color="#D5DFCB" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PostIt.White.Header" Color="#BFCDB0"/>

    <!-- Syntax palette — botanical inks, all dark enough for the light editor canvas. Comments take
         the sage so they recede without disappearing; literals and tags take the plate's reds. -->
    <SolidColorBrush x:Key="TextSwatch.Comment"   Color="#5E7757"/>
    <SolidColorBrush x:Key="TextSwatch.Keyword"   Color="#6A4FA3"/>
    <SolidColorBrush x:Key="TextSwatch.String"    Color="#B0392F"/>
    <SolidColorBrush x:Key="TextSwatch.Number"    Color="#0F7A6B"/>
    <SolidColorBrush x:Key="TextSwatch.Type"      Color="#1F6E8C"/>
    <SolidColorBrush x:Key="TextSwatch.Constant"  Color="#A85A16"/>
    <SolidColorBrush x:Key="TextSwatch.Function"  Color="#8A6A1E"/>
    <SolidColorBrush x:Key="TextSwatch.Operator"  Color="#4A4640"/>
    <SolidColorBrush x:Key="TextSwatch.Parameter" Color="#1F3D5C"/>
    <SolidColorBrush x:Key="TextSwatch.Tag"       Color="#A32B45"/>
    <SolidColorBrush x:Key="TextSwatch.Attribute" Color="#B54D1C"/>

</ResourceDictionary>
