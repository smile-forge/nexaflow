<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Nexaflow.Core.Themes">

    <!-- ════════════════════════════════════════════════════════════════════════
         DESERT — immersive, LIGHT, and windy.
         One Scene.Window desert sits behind the whole shell: dunes under a dusty sky, a rippled floor, and
         bushes that sway in the breeze and bend to its gusts while streaks and swirls of sand blow past. Rarely
         — never more than once an hour — the wind gathers toward a storm and lets it go (DesertWind).

         The frame is near-opaque sand on purpose, as in Flowers and Sunny: the desert shows through the PAGE and
         the AI-bar surround and is held out of the chrome, so the moving sand never runs behind a tab title or a
         ribbon label.
         ════════════════════════════════════════════════════════════════════════ -->

    <!-- Chrome: sand frame; logo column / drag bar / right panel a step deeper, in the dune's shade. -->
    <SolidColorBrush x:Key="Chrome.Deep"       Color="#F7E9D7B8"/>
    <SolidColorBrush x:Key="Chrome.Panel"      Color="#F2F3E6CF"/>
    <SolidColorBrush x:Key="Chrome.RightPanel" Color="#F7E9D7B8"/>
    <SolidColorBrush x:Key="Chrome.Bg"         Color="#F2F3E6CF"/>
    <SolidColorBrush x:Key="Chrome.Border"     Color="#66C9AE84"/>
    <!-- Ribbon buttons lift off the sand strip as bleached linen. -->
    <SolidColorBrush x:Key="Ribbon.ButtonBg"   Color="#80FFFAF1"/>

    <!-- Tab strip: sand frame; the active tab lifts to linen, hover a subtle lighten. -->
    <SolidColorBrush x:Key="TabStrip.Bg"     Color="#F0F3E6CF"/>
    <SolidColorBrush x:Key="TabStrip.Border" Color="#66C9AE84"/>
    <SolidColorBrush x:Key="Tab.HoverBg"     Color="#B3F9EFDD"/>
    <SolidColorBrush x:Key="Tab.ActiveBg"    Color="#FFFFFAF1"/>

    <!-- AI bar: transparent to the desert, with a linen input and cluster panels so a gust blows BEHIND the
         buttons rather than through them. -->
    <SolidColorBrush x:Key="AiBar.Bg"        Color="#99FAF2E2"/>
    <SolidColorBrush x:Key="AiBar.InputBg"   Color="#FFFFFAF1"/>
    <SolidColorBrush x:Key="AiBar.ClusterBg" Color="#E6FFFAF1"/>
    <SolidColorBrush x:Key="AiBar.Border"    Color="#66C9AE84"/>

    <!-- File view tree + action strip: a touch heavier than the page veil — the tree carries the smallest
         text in the shell, and the ripple field's darkest lines sit under it. -->
    <SolidColorBrush x:Key="FileList.PanelBg" Color="#99FAF2E2"/>

    <!-- The one backdrop, behind every row. Scene rather than StillScene: it animates, so the battery policy
         may take it down, which is the point of the policy. -->
    <DataTemplate x:Key="Scene.Window">
        <t:DesertScene/>
    </DataTemplate>

    <!-- User chat bubble: apricot sand — the umber text (#33241A) reads at ~11:1. -->
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#F6DEC4"/>

    <!-- Danger hover: 15% red is nearly invisible on a light surface — strengthen it. -->
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#55DC2626"/>

    <!-- Locate lasso: deepened so the loop still shouts on sand. -->
    <SolidColorBrush x:Key="Locate.Stroke" Color="#D9001B"/>

    <!-- AI status dot: from the scene (bush green, sand gold, a dusk indigo well clear of the terracotta
         accent) and deepened to read on the light bar. -->
    <SolidColorBrush x:Key="AiStatus.Ready"   Color="#4E7A2E"/>  <!-- bush green -->
    <SolidColorBrush x:Key="AiStatus.Busy"    Color="#D08A16"/>  <!-- sand gold  -->
    <SolidColorBrush x:Key="AiStatus.Handler" Color="#5A5FA8"/>  <!-- dusk indigo -->
    <LinearGradientBrush x:Key="AiStatus.ListenBrush" StartPoint="0,0" EndPoint="1,1">
        <!-- desert dusk, violet to rose: clear of the green ready state and the gold busy state -->
        <GradientStop Color="#7B6BB0" Offset="0"/>
        <GradientStop Color="#C2577E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Categorical bank — restated a stop deeper than the dark-theme pastels, which vanish on cream, in the
         desert's own hues, and kept mutually separable, which is the bank's whole contract. -->
    <SolidColorBrush x:Key="Swatch.Blue"   Color="#2F6E9E"/>  <!-- sky              -->
    <SolidColorBrush x:Key="Swatch.Red"    Color="#B8392E"/>  <!-- red rock         -->
    <SolidColorBrush x:Key="Swatch.Green"  Color="#4E8A3E"/>  <!-- bush             -->
    <SolidColorBrush x:Key="Swatch.Amber"  Color="#D9962A"/>  <!-- sand gold        -->
    <SolidColorBrush x:Key="Swatch.Purple" Color="#7A5FA8"/>  <!-- dusk             -->
    <SolidColorBrush x:Key="Swatch.Orange" Color="#D46A26"/>  <!-- terracotta       -->
    <SolidColorBrush x:Key="Swatch.Cyan"   Color="#2E91B5"/>  <!-- oasis            -->
    <SolidColorBrush x:Key="Swatch.Pink"   Color="#C9567A"/>  <!-- desert rose      -->
    <SolidColorBrush x:Key="Swatch.Teal"   Color="#2B8F80"/>  <!-- agave            -->
    <SolidColorBrush x:Key="Swatch.Yellow" Color="#BFA01E"/>  <!-- dry grass        -->
    <SolidColorBrush x:Key="Swatch.Slate"  Color="#7A7468"/>  <!-- weathered stone  -->
    <SolidColorBrush x:Key="Swatch.Lime"   Color="#8A9A3A"/>  <!-- sage             -->

    <!-- The "White" post-it is nearly the colour of this theme's linen — give it the sky's cool blue-grey so
         it stands off the warm sand while the fixed dark ink stays readable. -->
    <LinearGradientBrush x:Key="PostIt.White.Fill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#DCE6F0" Offset="0"/>
        <GradientStop Color="#C9D7E6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PostIt.White.Header" Color="#AEC1D8"/>

    <!-- Syntax palette — dark desert inks for the light editor canvas. Comments take the dune shade so they
         recede without vanishing; keywords the terracotta, strings the bush green. -->
    <SolidColorBrush x:Key="TextSwatch.Comment"   Color="#7A684E"/>
    <SolidColorBrush x:Key="TextSwatch.Keyword"   Color="#A3461F"/>
    <SolidColorBrush x:Key="TextSwatch.String"    Color="#4E7A2E"/>
    <SolidColorBrush x:Key="TextSwatch.Number"    Color="#2F6E9E"/>
    <SolidColorBrush x:Key="TextSwatch.Type"      Color="#1F6E8C"/>
    <SolidColorBrush x:Key="TextSwatch.Constant"  Color="#A85A16"/>
    <SolidColorBrush x:Key="TextSwatch.Function"  Color="#86580E"/>
    <SolidColorBrush x:Key="TextSwatch.Operator"  Color="#4A4038"/>
    <SolidColorBrush x:Key="TextSwatch.Parameter" Color="#2D4A6A"/>
    <SolidColorBrush x:Key="TextSwatch.Tag"       Color="#9A3B52"/>
    <SolidColorBrush x:Key="TextSwatch.Attribute" Color="#B4532A"/>

</ResourceDictionary>
