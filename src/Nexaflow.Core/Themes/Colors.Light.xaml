<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Palette: professional light ──
         A cohesive cool-grey ladder (low internal contrast so it never looks harsh) where structure
         comes from DEFINED borders, strong near-black text and a confident accent — not from value
         jumps between the greys. White panels lift off a soft grey canvas; the chrome wings sit a
         step deeper to frame. Fixes the old "washed out" look where bg/surface/border were all the
         same near-white tint. -->
    <Color x:Key="BgColor">#F1F4F8</Color>        <!-- canvas: page / content base -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>    <!-- panels, cards, top bar, tabs -->
    <Color x:Key="Surface2Color">#E6EBF2</Color>   <!-- inputs, hover, selection, ribbon band -->
    <Color x:Key="BorderColor">#C2CBD9</Color>     <!-- defined edges — the structure -->
    <Color x:Key="BorderLightColor">#D8DEE9</Color><!-- subtle inner dividers -->
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="Accent2Color">#7C3AED</Color>
    <Color x:Key="TextColor">#172230</Color>       <!-- near-black: strong contrast -->
    <Color x:Key="TextMutedColor">#54637A</Color>
    <Color x:Key="TextDimColor">#8593A6</Color>
    <Color x:Key="DeepBgColor">#DAE1EB</Color>     <!-- chrome wings / drag bar / footer: a step deeper -->

    <!-- ── Brushes ── -->
    <SolidColorBrush x:Key="BgBrush"         Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"    Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush"   Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush"     Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush"    Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="TextBrush"       Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"  Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDimBrush"    Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="DeepBgBrush"     Color="{StaticResource DeepBgColor}"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Dimensions -->
    <GridLength x:Key="TopBarHeight">72</GridLength>
    <GridLength x:Key="TabBarHeight">38</GridLength>
    <GridLength x:Key="InteractionHeight">90</GridLength>

</ResourceDictionary>
