<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Nexaflow.Core.Themes">

    <!-- ════════════════════════════════════════════════════════════════════════
         SANDSTONE — immersive theme overrides + scene.
         A cut-stone wall (Scene.Window) lit by a slowly travelling sun sits behind the whole shell;
         the page and AI-bar surround stay transparent to it, while chrome, tabs and the input panels
         are deep-umber glass framing the view. Mirrors the Ocean/Forest structure.
         ════════════════════════════════════════════════════════════════════════ -->

    <!-- Chrome: deep umber wings framing a slightly warmer ribbon strip. -->
    <SolidColorBrush x:Key="Chrome.Deep"     Color="#F21A120B"/>
    <SolidColorBrush x:Key="Chrome.Panel"    Color="#F21A120B"/>
    <SolidColorBrush x:Key="Chrome.RightPanel" Color="#F21A120B"/>
    <SolidColorBrush x:Key="Chrome.Bg"       Color="#E63A2A1A"/>
    <SolidColorBrush x:Key="Chrome.Border"   Color="#59735540"/>
    <SolidColorBrush x:Key="Ribbon.ButtonBg" Color="#4D140D07"/>

    <!-- Tab strip: dark like the AI input panel, framing the top of the wall view. -->
    <SolidColorBrush x:Key="TabStrip.Bg"     Color="#F0150E08"/>
    <SolidColorBrush x:Key="TabStrip.Border" Color="#59735540"/>
    <SolidColorBrush x:Key="Tab.HoverBg"     Color="#993C2C1E"/>
    <SolidColorBrush x:Key="Tab.ActiveBg"    Color="#C04A3520"/>

    <!-- AI bar: surround transparent to the wall; input + clusters are dark umber panels. -->
    <SolidColorBrush x:Key="AiBar.Bg"        Color="#522E2016"/>
    <SolidColorBrush x:Key="AiBar.InputBg"   Color="#E0150E08"/>
    <SolidColorBrush x:Key="AiBar.ClusterBg" Color="#E0150E08"/>
    <SolidColorBrush x:Key="AiBar.Border"    Color="#59735540"/>

    <!-- File view tree + action strip: transparent to the wall, matching the file list. -->
    <SolidColorBrush x:Key="FileList.PanelBg" Color="#522E2016"/>

    <!-- The one backdrop, behind every row. -->
    <DataTemplate x:Key="Scene.Window">
        <t:SandstoneWall/>
    </DataTemplate>

    <!-- User chat bubble: deep umber — cream text (#F4ECDC) readable at ~13:1. Distinct from
         Surface2 (#3C2C1E); darker toward DeepBg so it reads as recessed/filled. -->
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#1E1509"/>
    <!-- AccentBrush is warm orange (#E0975A) — white borderline ~3:1. Use dark umber instead. -->
    <SolidColorBrush x:Key="OnAccentBrush"   Color="#18110A"/>

    <!-- AI status dot: earth-toned but distinct (sage green, terracotta, a dusty-mauve pip, a
         teal→mauve listen sweep) so the states read against the deep-umber bar. -->
    <SolidColorBrush x:Key="AiStatus.Ready"       Color="#9CB85E"/>  <!-- sage green -->
    <SolidColorBrush x:Key="AiStatus.Busy"        Color="#E0975A"/>  <!-- terracotta -->
    <SolidColorBrush x:Key="AiStatus.Handler"     Color="#C39BE0"/>  <!-- dusty mauve pip -->
    <SolidColorBrush x:Key="AiStatus.HandlerText" Color="#18110A"/>
    <LinearGradientBrush x:Key="AiStatus.ListenBrush" StartPoint="0,0" EndPoint="1,1">
        <!-- desert-dusk amethyst → rose: distinct from sage-green ready and terracotta busy -->
        <GradientStop Color="#B07FD5" Offset="0"/>
        <GradientStop Color="#E08BA8" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
