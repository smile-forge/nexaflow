<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Palette: bright & playful ──
         A LIGHT immersive theme: a cheerful sunny sky with drifting balloons & confetti (Scene.Window)
         shows softly through translucent white panels. Clean white surfaces, friendly navy text, and
         strong primary/secondary accents (coral + sunny yellow) carry the fun — "rich kindergarten":
         bright and playful but tasteful. -->
    <Color x:Key="BgColor">#66FFF7E8</Color>       <!-- page root: warm-white glass over the sky -->
    <Color x:Key="SurfaceColor">#FFFFFF</Color>     <!-- clean white panels / hover -->
    <Color x:Key="Surface2Color">#FBEEDA</Color>    <!-- warm inset / selection -->
    <Color x:Key="BorderColor">#E7D9C0</Color>
    <Color x:Key="BorderLightColor">#F1E8D6</Color>
    <Color x:Key="AccentColor">#FF5D5D</Color>
    <!-- Playful coral -->
    <Color x:Key="Accent2Color">#FFC83D</Color>
    <!-- Sunny yellow -->
    <Color x:Key="TextColor">#2D3444</Color>
    <Color x:Key="TextMutedColor">#6B7488</Color>
    <Color x:Key="TextDimColor">#9AA2B2</Color>
    <Color x:Key="GreenColor">#2BC56E</Color>
    <Color x:Key="OrangeColor">#FF8A3D</Color>
    <Color x:Key="DeepBgColor">#F4ECDA</Color>

    <!-- ── Brushes ── -->
    <SolidColorBrush x:Key="BgBrush"         Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"    Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush"   Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush"     Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush"    Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="TextBrush"       Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"  Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextDimBrush"    Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="GreenBrush"      Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="OrangeBrush"     Color="{StaticResource OrangeColor}"/>
    <SolidColorBrush x:Key="DeepBgBrush"     Color="{StaticResource DeepBgColor}"/>

    <!-- Rainbow logo — fun is here. -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5D5D" Offset="0"/>
        <GradientStop Color="#FFC83D" Offset="0.5"/>
        <GradientStop Color="#38B6FF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Dimensions -->
    <GridLength x:Key="TopBarHeight">72</GridLength>
    <GridLength x:Key="TabBarHeight">38</GridLength>
    <GridLength x:Key="InteractionHeight">90</GridLength>

</ResourceDictionary>
