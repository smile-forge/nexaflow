<UserControl x:Class="Nexaflow.Core.Themes.GothicScene"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Grid x:Name="Root" ClipToBounds="True">
        <Grid.Background>
            <!-- Midnight sky: near-black at the crown, a bruised purple bloom through the middle where
                 the moon hangs, sinking back to black at the foot where the tower and fog sit. -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#070410" Offset="0"/>
                <GradientStop Color="#0E0820" Offset="0.30"/>
                <GradientStop Color="#170C2A" Offset="0.55"/>
                <GradientStop Color="#1A0E2E" Offset="0.72"/>
                <GradientStop Color="#0C0718" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Canvas x:Name="Layer"/>
    </Grid>
</UserControl>
