<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Nexaflow.Core.Themes">

    <!-- ════════════════════════════════════════════════════════════════════════
         GOTHIC — immersive theme overrides + scene.
         A single Scene.Window midnight-tower night sits behind the whole shell; every
         region surface goes translucent (chrome only slightly, the page area generously)
         so the one continuous moonlit backdrop reads cohesively through the window. Pro
         themes override none of this and the night never instantiates.
         ════════════════════════════════════════════════════════════════════════ -->

    <!-- Chrome: near-black aubergine wings (logo column + right panel match) framing a faintly
         lifted ribbon strip. Near-opaque so it stays a solid FRAME — the night is the page, not
         the chrome. Ribbon buttons get a darker recessed tile to stand out from the strip. -->
    <SolidColorBrush x:Key="Chrome.Deep"     Color="#F20C0718"/>
    <SolidColorBrush x:Key="Chrome.Panel"    Color="#F20C0718"/>
    <SolidColorBrush x:Key="Chrome.RightPanel" Color="#F20C0718"/>
    <SolidColorBrush x:Key="Chrome.Bg"       Color="#EE1B1030"/>
    <SolidColorBrush x:Key="Chrome.Border"   Color="#55432F60"/>
    <SolidColorBrush x:Key="Ribbon.ButtonBg" Color="#4D0A0618"/>

    <!-- Tab strip: dark like the AI input panel, framing the top of the "window onto the night". -->
    <SolidColorBrush x:Key="TabStrip.Bg"     Color="#F00A0617"/>
    <SolidColorBrush x:Key="TabStrip.Border" Color="#55432F60"/>
    <SolidColorBrush x:Key="Tab.HoverBg"     Color="#99301E4A"/>
    <SolidColorBrush x:Key="Tab.ActiveBg"    Color="#C03E2660"/>

    <!-- AI bar: the surround stays transparent to the night (continuous with the page); the input and
         the button clusters are dark panels, so the tower reads as rising BEHIND them, not through. -->
    <SolidColorBrush x:Key="AiBar.Bg"        Color="#59140A24"/>
    <SolidColorBrush x:Key="AiBar.InputBg"   Color="#E00A0617"/>
    <SolidColorBrush x:Key="AiBar.ClusterBg" Color="#E00A0617"/>
    <SolidColorBrush x:Key="AiBar.Border"    Color="#55432F60"/>

    <!-- File view tree + action strip: transparent to the night, matching the file list. -->
    <SolidColorBrush x:Key="FileList.PanelBg" Color="#59140A24"/>

    <!-- The one backdrop, behind every row. -->
    <DataTemplate x:Key="Scene.Window">
        <t:GothicScene Variant="Full"/>
    </DataTemplate>

    <!-- User chat bubble: a deep crypt purple — pale-lavender text (#ECE4F7) readable at ~10:1.
         Distinct from Surface2 (#251A38); sits darker so it reads as filled. -->
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#2A1840"/>
    <!-- AccentBrush is bright violet (#B061FF) — white gives only ~2.9:1. Use near-black instead. -->
    <SolidColorBrush x:Key="OnAccentBrush"   Color="#150A26"/>

    <!-- AI status dot: night-toned but kept mutually distinct (a phantom green, an ember, a moonlit
         blue pip, a violet→orchid listen sweep) so the states stay readable against the dark bar. -->
    <SolidColorBrush x:Key="AiStatus.Ready"       Color="#5BE3A6"/>  <!-- phantom green -->
    <SolidColorBrush x:Key="AiStatus.Busy"        Color="#FF8A4D"/>  <!-- ember -->
    <SolidColorBrush x:Key="AiStatus.Handler"     Color="#6E8AFF"/>  <!-- moonlit blue pip -->
    <SolidColorBrush x:Key="AiStatus.HandlerText" Color="#0A0A1E"/>
    <LinearGradientBrush x:Key="AiStatus.ListenBrush" StartPoint="0,0" EndPoint="1,1">
        <!-- arcane violet → orchid: the theme's own mood, distinct from the green ready, ember busy
             and moonlit-blue handler that already populate this theme -->
        <GradientStop Color="#8A5CFF" Offset="0"/>
        <GradientStop Color="#D060E0" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
