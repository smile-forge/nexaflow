<vcc:AnimatedScene x:Class="Nexaflow.Core.Themes.ArcticScene"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             IsHitTestVisible="False">
    <Grid x:Name="Root" ClipToBounds="True">
        <Grid.Background>
            <!-- The sky, zenith to horizon: night still holding at the top (dark enough for stars and
                 an aurora to read), cooling through violet into the low sun's rose and amber. It holds
                 the horizon colour from 0.42 down because BuildScene paints the sea over everything
                 below the horizon — so the two never have to agree on where the horizon is, and a
                 change to HorizonFraction cannot open a seam of the wrong hue. -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#141A30" Offset="0"/>
                <GradientStop Color="#1E2440" Offset="0.08"/>
                <GradientStop Color="#332F4E" Offset="0.18"/>
                <GradientStop Color="#55415C" Offset="0.26"/>
                <GradientStop Color="#8A5754" Offset="0.34"/>
                <GradientStop Color="#C07C51" Offset="0.392"/>
                <GradientStop Color="#DBA36E" Offset="0.42"/>
                <GradientStop Color="#DBA36E" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Canvas x:Name="Layer"/>
    </Grid>
</vcc:AnimatedScene>
