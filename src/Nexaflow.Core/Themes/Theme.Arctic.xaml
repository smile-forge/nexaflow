<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Nexaflow.Core.Themes">

    <!-- ════════════════════════════════════════════════════════════════════════
         ARCTIC — immersive theme overrides + scene.
         One Scene.Window polar dusk sits behind the whole shell; every region surface goes
         translucent (chrome only slightly, the page area generously) so the single backdrop
         reads continuously through the window. Pro themes override none of this and the
         scene never instantiates.

         The scene's horizon sits at 42% of the window, so the page area gets the composition
         the photograph has: a band of low sun and peaks up top, drifting bergs and a shimmering
         sun path filling the water below.
         ════════════════════════════════════════════════════════════════════════ -->

    <!-- Chrome: deep glacier wings (logo column + right panel match) framing a lighter ribbon strip.
         Near-opaque so it stays a solid FRAME — the ice field is the page, not the chrome. -->
    <SolidColorBrush x:Key="Chrome.Deep"       Color="#F5102A3E"/>
    <SolidColorBrush x:Key="Chrome.Panel"      Color="#F5102A3E"/>
    <SolidColorBrush x:Key="Chrome.RightPanel" Color="#F5102A3E"/>
    <SolidColorBrush x:Key="Chrome.Bg"         Color="#F21C4E70"/>
    <SolidColorBrush x:Key="Chrome.Border"     Color="#664A93B4"/>
    <SolidColorBrush x:Key="Ribbon.ButtonBg"   Color="#4D0A2437"/>

    <!-- Tab strip: dark like the AI input panel, framing the top of the ice field. -->
    <SolidColorBrush x:Key="TabStrip.Bg"     Color="#F0081F30"/>
    <SolidColorBrush x:Key="TabStrip.Border" Color="#664A93B4"/>
    <SolidColorBrush x:Key="Tab.HoverBg"     Color="#991C4E70"/>
    <SolidColorBrush x:Key="Tab.ActiveBg"    Color="#C0245F86"/>

    <!-- AI bar: the surround stays transparent to the water (continuous with the page); the input and
         the button clusters are dark panels, so a berg drifts BEHIND them rather than through. -->
    <SolidColorBrush x:Key="AiBar.Bg"        Color="#660C2334"/>
    <SolidColorBrush x:Key="AiBar.InputBg"   Color="#E0081F30"/>
    <SolidColorBrush x:Key="AiBar.ClusterBg" Color="#E0081F30"/>
    <SolidColorBrush x:Key="AiBar.Border"    Color="#664A93B4"/>

    <!-- File view tree + action strip: transparent to the scene, matching the file list. -->
    <SolidColorBrush x:Key="FileList.PanelBg" Color="#660C2334"/>

    <!-- The one backdrop, behind every row. -->
    <DataTemplate x:Key="Scene.Window">
        <t:ArcticScene/>
    </DataTemplate>

    <!-- User chat bubble: deep polar water — snow-white text (#EAF6FC) reads at ~13:1. Sits between
         DeepBg and Surface so the bubble reads as submerged rather than as another panel. -->
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#0C2C42"/>
    <!-- AccentBrush is a bright meltwater blue (#79D2F2) — white gives only ~1.6:1. Use deep water. -->
    <SolidColorBrush x:Key="OnAccentBrush"   Color="#07202E"/>

    <!-- AI status dot: polar-toned but kept mutually distinct (an aurora green, a low-sun amber, an
         indigo pip well clear of the cyan accent, and a violet aurora sweep for listening). -->
    <SolidColorBrush x:Key="AiStatus.Ready"       Color="#35DCA8"/>  <!-- aurora green -->
    <SolidColorBrush x:Key="AiStatus.Busy"        Color="#FF9A5A"/>  <!-- low-sun amber -->
    <SolidColorBrush x:Key="AiStatus.Handler"     Color="#6E9CFF"/>  <!-- indigo pip -->
    <SolidColorBrush x:Key="AiStatus.HandlerText" Color="#06202E"/>
    <LinearGradientBrush x:Key="AiStatus.ListenBrush" StartPoint="0,0" EndPoint="1,1">
        <!-- the aurora's violet band: clear of the cyan accent, the green ready state and the
             indigo handler pip that already populate this theme -->
        <GradientStop Color="#6A5BE8" Offset="0"/>
        <GradientStop Color="#B486F5" Offset="1"/>
    </LinearGradientBrush>

    <!-- Syntax palette — ice tones with the horizon's gold for literals, readable on glacier glass. -->
    <SolidColorBrush x:Key="TextSwatch.Comment"   Color="#6E8FA3"/>
    <SolidColorBrush x:Key="TextSwatch.Keyword"   Color="#6FC5F0"/>
    <SolidColorBrush x:Key="TextSwatch.String"    Color="#8FDCC6"/>
    <SolidColorBrush x:Key="TextSwatch.Number"    Color="#BFE2F2"/>
    <SolidColorBrush x:Key="TextSwatch.Type"      Color="#63D6C8"/>
    <SolidColorBrush x:Key="TextSwatch.Constant"  Color="#FFC58A"/>
    <SolidColorBrush x:Key="TextSwatch.Function"  Color="#F2D89A"/>
    <SolidColorBrush x:Key="TextSwatch.Operator"  Color="#AFC8D6"/>
    <SolidColorBrush x:Key="TextSwatch.Parameter" Color="#C3E4FF"/>
    <SolidColorBrush x:Key="TextSwatch.Tag"       Color="#6FC5F0"/>
    <SolidColorBrush x:Key="TextSwatch.Attribute" Color="#A8E4FF"/>

</ResourceDictionary>
