<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Nexaflow.Core.Themes">

    <!-- ════════════════════════════════════════════════════════════════════════
         NATURE (forest) — immersive theme overrides + scene.
         A single dappled-woodland Scene.Window sits behind the whole shell; the page and AI-bar
         surround stay transparent to it (one continuous forest), while chrome, tabs and the input
         panels are deep-green glass framing the view. Mirrors the Ocean structure.
         ════════════════════════════════════════════════════════════════════════ -->

    <!-- Chrome: deep forest-green wings framing a slightly lighter ribbon strip. -->
    <SolidColorBrush x:Key="Chrome.Deep"     Color="#F20C2014"/>
    <SolidColorBrush x:Key="Chrome.Panel"    Color="#F20C2014"/>
    <SolidColorBrush x:Key="Chrome.Bg"       Color="#E6173E24"/>
    <SolidColorBrush x:Key="Chrome.Border"   Color="#59487950"/>
    <SolidColorBrush x:Key="Ribbon.ButtonBg" Color="#4D08160D"/>

    <!-- Tab strip: dark like the AI input panel, framing the top of the forest view. -->
    <SolidColorBrush x:Key="TabStrip.Bg"     Color="#F00A1A10"/>
    <SolidColorBrush x:Key="TabStrip.Border" Color="#59487950"/>
    <SolidColorBrush x:Key="Tab.HoverBg"     Color="#991F4A2B"/>
    <SolidColorBrush x:Key="Tab.ActiveBg"    Color="#C0265433"/>

    <!-- AI bar: surround transparent to the forest; input + clusters are dark panels so ferns read
         as growing from BEHIND them. -->
    <SolidColorBrush x:Key="AiBar.Bg"        Color="#5012301B"/>
    <SolidColorBrush x:Key="AiBar.InputBg"   Color="#E00A1A10"/>
    <SolidColorBrush x:Key="AiBar.ClusterBg" Color="#E00A1A10"/>
    <SolidColorBrush x:Key="AiBar.Border"    Color="#59487950"/>

    <!-- File view tree + action strip: transparent to the forest, matching the file list. -->
    <SolidColorBrush x:Key="FileList.PanelBg" Color="#5012301B"/>

    <!-- The one backdrop, behind every row. -->
    <DataTemplate x:Key="Scene.Window">
        <t:ForestScene/>
    </DataTemplate>

</ResourceDictionary>
