<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Nexaflow.Core.Themes">

    <!-- ════════════════════════════════════════════════════════════════════════
         NATURE (forest) — immersive theme overrides + scene.
         A single dappled-woodland Scene.Window sits behind the whole shell; the page and AI-bar
         surround stay transparent to it (one continuous forest), while chrome, tabs and the input
         panels are deep-green glass framing the view. Mirrors the Ocean structure.
         ════════════════════════════════════════════════════════════════════════ -->

    <!-- Chrome: deep forest-green wings framing a slightly lighter ribbon strip. -->
    <SolidColorBrush x:Key="Chrome.Deep"     Color="#F20C2014"/>
    <SolidColorBrush x:Key="Chrome.Panel"    Color="#F20C2014"/>
    <SolidColorBrush x:Key="Chrome.RightPanel" Color="#F20C2014"/>
    <SolidColorBrush x:Key="Chrome.Bg"       Color="#E6173E24"/>
    <SolidColorBrush x:Key="Chrome.Border"   Color="#59487950"/>
    <SolidColorBrush x:Key="Ribbon.ButtonBg" Color="#4D08160D"/>

    <!-- Tab strip: dark like the AI input panel, framing the top of the forest view. -->
    <SolidColorBrush x:Key="TabStrip.Bg"     Color="#F00A1A10"/>
    <SolidColorBrush x:Key="TabStrip.Border" Color="#59487950"/>
    <SolidColorBrush x:Key="Tab.HoverBg"     Color="#991F4A2B"/>
    <SolidColorBrush x:Key="Tab.ActiveBg"    Color="#C0265433"/>

    <!-- AI bar: surround transparent to the forest; input + clusters are dark panels so ferns read
         as growing from BEHIND them. -->
    <SolidColorBrush x:Key="AiBar.Bg"        Color="#5012301B"/>
    <SolidColorBrush x:Key="AiBar.InputBg"   Color="#E00A1A10"/>
    <SolidColorBrush x:Key="AiBar.ClusterBg" Color="#E00A1A10"/>
    <SolidColorBrush x:Key="AiBar.Border"    Color="#59487950"/>

    <!-- File view tree + action strip: transparent to the forest, matching the file list. -->
    <SolidColorBrush x:Key="FileList.PanelBg" Color="#5012301B"/>

    <!-- The one backdrop, behind every row. -->
    <DataTemplate x:Key="Scene.Window">
        <t:ForestScene/>
    </DataTemplate>

    <!-- User chat bubble: deep forest floor — cream text (#F2F7EA) readable at ~12:1. Distinct from
         Surface2 (#1F4A2B); darker toward DeepBg so it reads as recessed/filled. -->
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#0F2217"/>
    <!-- AccentBrush is gold (#EBB749) — white gives only ~2.2:1. Use dark forest instead. -->
    <SolidColorBrush x:Key="OnAccentBrush"   Color="#152515"/>

    <!-- AI status dot: woodland-toned but distinct (leaf green, honey, an orchid pip, a sky→teal
         listen sweep) so the states read against the deep-green bar. -->
    <SolidColorBrush x:Key="AiStatus.Ready"       Color="#6FCB6A"/>  <!-- leaf green -->
    <SolidColorBrush x:Key="AiStatus.Busy"        Color="#EBB749"/>  <!-- honey gold -->
    <SolidColorBrush x:Key="AiStatus.Handler"     Color="#C98BE0"/>  <!-- orchid pip -->
    <SolidColorBrush x:Key="AiStatus.HandlerText" Color="#152515"/>
    <LinearGradientBrush x:Key="AiStatus.ListenBrush" StartPoint="0,0" EndPoint="1,1">
        <!-- wildflower violet → magenta: distinct from leaf-green ready and honey busy -->
        <GradientStop Color="#9D7CE0" Offset="0"/>
        <GradientStop Color="#DC6FC0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Syntax palette — woodland greens and honey gold, readable on the mossy glass. -->
    <SolidColorBrush x:Key="TextSwatch.Comment"   Color="#7E9A6A"/>
    <SolidColorBrush x:Key="TextSwatch.Keyword"   Color="#E0A93A"/>
    <SolidColorBrush x:Key="TextSwatch.String"    Color="#B6D07A"/>
    <SolidColorBrush x:Key="TextSwatch.Number"    Color="#D9C77E"/>
    <SolidColorBrush x:Key="TextSwatch.Type"      Color="#74C79A"/>
    <SolidColorBrush x:Key="TextSwatch.Constant"  Color="#E08A4E"/>
    <SolidColorBrush x:Key="TextSwatch.Function"  Color="#CFE08A"/>
    <SolidColorBrush x:Key="TextSwatch.Operator"  Color="#A6B89A"/>
    <SolidColorBrush x:Key="TextSwatch.Parameter" Color="#A8C8D8"/>
    <SolidColorBrush x:Key="TextSwatch.Tag"       Color="#E0A93A"/>
    <SolidColorBrush x:Key="TextSwatch.Attribute" Color="#BFE0A0"/>

</ResourceDictionary>
