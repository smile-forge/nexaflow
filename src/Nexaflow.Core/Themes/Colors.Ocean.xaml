<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Palette: sunlit-reef GLASS ──
         Mirrors the Ocean HTML: a bright sunlit-reef backdrop (Scene.Window) behind deep-teal
         translucent panels with light cyan-white text and a bright reef-cyan accent. Surfaces are
         deep teal so the reef glows behind/around content while #EAFBFF text stays readable; the
         page root is translucent so the reef reads straight through feature pages. -->
    <Color x:Key="BgColor">#570B3442</Color>      <!-- page root: mostly transparent to the reef -->
    <Color x:Key="SurfaceColor">#123E4F</Color>    <!-- panels / cards -->
    <Color x:Key="Surface2Color">#17506A</Color>   <!-- raised panels / inputs -->
    <Color x:Key="BorderColor">#235E73</Color>
    <Color x:Key="BorderLightColor">#3A8AA0</Color>
    <Color x:Key="AccentColor">#3DDCE8</Color>
    <!-- Bright reef cyan -->
    <Color x:Key="Accent2Color">#FFC2A3</Color>
    <!-- Warm peach (reef/fish warmth) -->
    <Color x:Key="TextColor">#EAFBFF</Color>
    <Color x:Key="TextMutedColor">#9DCEDA</Color>
    <!-- Dim text sits a step below muted but stays clearly legible: the old #5C95A4 was a mid-teal that
         merged into the deep-teal surfaces / reef wash. -->
    <Color x:Key="DeepBgColor">#07232E</Color>

    <!-- ── Brushes ── -->
    <SolidColorBrush x:Key="BgBrush"         Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"    Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush"   Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush"     Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush"    Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="TextBrush"       Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"  Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DeepBgBrush"     Color="{StaticResource DeepBgColor}"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5FE3EE" Offset="0"/>
        <GradientStop Color="#FFC2A3" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Dimensions -->
    <GridLength x:Key="TopBarHeight">72</GridLength>
    <GridLength x:Key="TabBarHeight">38</GridLength>
    <GridLength x:Key="InteractionHeight">90</GridLength>

</ResourceDictionary>
