<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════════════
         REGION TOKENS
         Namespaced handles ({Region}.{Role}) that a shell region binds INSTEAD of
         the raw palette. Each defaults to a palette colour here; a theme overrides
         only the ones it wants to art-direct (see Theme.<name>.xaml), so one region
         can be restyled — or made translucent over a scene — without touching the rest.

         Dark (and any plain theme) keeps these defaults, so the shell is pixel-identical
         to the pre-theming palette. The names say WHERE a colour is used, not just its tone.

         Merge order: Colors.<theme> (palette) → THIS → feature contributions →
         Theme.<theme> (overrides + scenes) → Styles. So these aliases see the palette,
         and any later dict wins by key.
         ════════════════════════════════════════════════════════════════════════ -->

    <!-- ── Window: the whole-window backdrop region (hosts Scene.Window). ── -->
    <!-- Window.Bg intentionally absent → transparent, so the window's own Background shows
         unless a theme supplies a scene/veil. -->

    <!-- ── Chrome: top bar, logo/ticker column, ribbon strip, right action panel. ── -->
    <SolidColorBrush x:Key="Chrome.Deep"   Color="{StaticResource DeepBgColor}"/>   <!-- drag bar + logo column -->
    <SolidColorBrush x:Key="Chrome.Panel"  Color="{StaticResource SurfaceColor}"/>  <!-- top bar + ribbon bevel -->
    <SolidColorBrush x:Key="Chrome.RightPanel" Color="{StaticResource SurfaceColor}"/> <!-- right action panel; Light overrides to the logo wing -->
    <SolidColorBrush x:Key="Chrome.Bg"     Color="{StaticResource Surface2Color}"/> <!-- ribbon strip surface -->
    <SolidColorBrush x:Key="Chrome.Border" Color="{StaticResource BorderColor}"/>
    <!-- Resting fill of ribbon buttons. Transparent by default (Dark unchanged); a theme can tint it
         to separate the buttons from the ribbon-strip surface. -->
    <SolidColorBrush x:Key="Ribbon.ButtonBg" Color="Transparent"/>

    <!-- ── Tab strip + breadcrumb (PaneView header row). ── -->
    <SolidColorBrush x:Key="TabStrip.Bg"     Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="TabStrip.Border" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="Tab.HoverBg"     Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Tab.ActiveBg"    Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Tab.Accent"      Color="{StaticResource AccentColor}"/>

    <!-- ── AI interaction bar (MainWindow row 4). ── -->
    <SolidColorBrush x:Key="AiBar.Bg"        Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="AiBar.InputBg"   Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="AiBar.Border"    Color="{StaticResource BorderColor}"/>
    <!-- Panel behind the status/clear and context/mic button clusters. Transparent by default (Dark:
         buttons sit bare on the bar); a theme can darken it to group them like the input. -->
    <SolidColorBrush x:Key="AiBar.ClusterBg" Color="Transparent"/>

    <!-- ── File view secondary panels (tree + action strip). Default to the panel surface so Dark is
         unchanged; a theme can make them transparent-to-scene like the file list. ── -->
    <SolidColorBrush x:Key="FileList.PanelBg" Color="{StaticResource SurfaceColor}"/>

    <!-- ── Cross-feature semantic tokens ── -->
    <!-- User chat-bubble background. Default = AccentBrush (Dark: #4F8EF7 blue — light text readable).
         Override in Theme.<Name>.xaml where AccentColor is too light (e.g. gold, cyan) or where the
         theme background is light and the text colour is dark. -->
    <SolidColorBrush x:Key="UserBubbleBrush" Color="{StaticResource AccentColor}"/>
    <!-- Foreground for UI elements placed on top of AccentBrush (checked toggle buttons, etc.).
         Default = White (passes AA on all blue-family accents). Override where the accent is a light
         colour (gold, cyan, orange) and white would fail contrast. -->
    <SolidColorBrush x:Key="OnAccentBrush"   Color="White"/>
    <!-- Subtle accent fill (same hue, low opacity) for highlighted/primary surfaces — e.g. a
         primary action button. Derived from AccentColor so it retints with every theme. -->
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentColor}" Opacity="0.12"/>
    <!-- Destructive / danger colour. Universally understood as red; works on both dark and light
         surfaces. No per-theme override expected — any readable red serves the semantic meaning. -->
    <SolidColorBrush x:Key="DangerBrush"       Color="#DC2626"/>
    <!-- Subtle hover fill for danger-action surfaces (same hue at ~15% opacity). -->
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#26DC2626"/>

    <!-- Semantic status colours — meaning, not tone. DELIBERATELY NOT aliased to the palette's
         Green/Orange: those are mood-tinted per theme (Ocean "green" is a reef-cyan), which would make
         success/warning/danger blend into one another. Status must stay mutually DISTINCT for instant
         recognition, so these carry their own green/amber/red. A theme may retune them tonally but
         should keep them distinct (green stays green). -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E"/>   <!-- done / staged / go      (green) -->
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>   <!-- modified / attention    (amber) -->

    <!-- ════ Node / criterion status vocabulary ════
         The four-state set (should / shouldn't / done / faulted) shared by the Product tree and the
         Projects "completion criteria" list. Kept as its own bank (not aliased to Success/Warning/
         Danger) so the four stay mutually DISTINCT at a glance. A theme may retune them tonally in
         Theme.<name>.xaml but should keep them separable. Resolved by key at paint time. -->
    <SolidColorBrush x:Key="Status.Should"   Color="#EF9F27"/>  <!-- should    — amber -->
    <SolidColorBrush x:Key="Status.Shouldnt" Color="#B4B2A9"/>  <!-- shouldn't  — grey  -->
    <SolidColorBrush x:Key="Status.Done"     Color="#639922"/>  <!-- done      — green -->
    <SolidColorBrush x:Key="Status.Faulted"  Color="#E24B4A"/>  <!-- faulted   — red   -->

    <!-- ════ Page search (? / ISearchable) ════
         Every searchable page paints its matches from this bank, so a hit looks the same in a text
         editor, a log, a grid and a JSON tree — the point of one `?` across the app. Lives HERE rather
         than in a feature's IThemeContribution because a contribution only merges once that assembly
         activates, and feature activation is lazy: a token owned by one feature is absent for every
         other. Translucent washes drawn OVER content, so the alpha is baked in. -->
    <SolidColorBrush x:Key="Search.Match"   Color="#64FFC800"/>  <!-- a=100 in-text match wash        -->
    <SolidColorBrush x:Key="Search.RowWash" Color="#3CFFC800"/>  <!-- a=60  whole-row / whole-item wash -->
    <SolidColorBrush x:Key="Search.Mark"    Color="#DCFFC800"/>  <!-- a=220 minimap / gutter tick     -->

    <!-- ════ Categorical swatch bank ════
         A dozen mutually-distinct hues for components that need RECOGNISABLY DIFFERENT colours next to
         one another — pie / chart series, status buckets, category dots — rather than the theme's
         chrome/accent tones (which are close together by design). Distinctness is the whole point: a
         theme may re-tune the bank tonally (deeper for light surfaces, brighter on dark glass) but the
         hues must stay separable. Mirrors the hardcoded post-it / MarkdownPalette.Series banks, but as
         overridable theme resources. Consumers bind these brushes directly. -->
    <SolidColorBrush x:Key="Swatch.Blue"   Color="#4F8EF7"/>
    <SolidColorBrush x:Key="Swatch.Red"    Color="#FF6B6B"/>
    <SolidColorBrush x:Key="Swatch.Green"  Color="#4ECB71"/>
    <SolidColorBrush x:Key="Swatch.Amber"  Color="#FFD060"/>
    <SolidColorBrush x:Key="Swatch.Purple" Color="#A060FF"/>
    <SolidColorBrush x:Key="Swatch.Orange" Color="#FF9F43"/>
    <SolidColorBrush x:Key="Swatch.Cyan"   Color="#48DBFB"/>
    <SolidColorBrush x:Key="Swatch.Pink"   Color="#FF6BB5"/>
    <SolidColorBrush x:Key="Swatch.Teal"   Color="#1DD1A1"/>
    <SolidColorBrush x:Key="Swatch.Yellow" Color="#FECA57"/>
    <SolidColorBrush x:Key="Swatch.Slate"  Color="#8893B5"/>
    <SolidColorBrush x:Key="Swatch.Lime"   Color="#A8D85C"/>

    <!-- ════ Syntax / code highlighting palette ════
         Role-named colours for the text editor's syntax highlighting (tree-sitter + AvalonEdit .xshd),
         kept SEPARATE from the categorical Swatch.* accent bank so each theme can art-direct code to its
         own mood without disturbing chart/series hues. These defaults are tuned for the dark themes
         (readable on a near-black editor); light and immersive themes override them in Theme.<name>.xaml.
         Consumed at paint time by the editor colourizers (TreeSitterColorizer / XshdTheming). -->
    <SolidColorBrush x:Key="TextSwatch.Comment"   Color="#6A9955"/>
    <SolidColorBrush x:Key="TextSwatch.Keyword"   Color="#569CD6"/>
    <SolidColorBrush x:Key="TextSwatch.String"    Color="#CE9178"/>
    <SolidColorBrush x:Key="TextSwatch.Number"    Color="#B5CEA8"/>
    <SolidColorBrush x:Key="TextSwatch.Type"      Color="#4EC9B0"/>
    <SolidColorBrush x:Key="TextSwatch.Constant"  Color="#D19A66"/>
    <SolidColorBrush x:Key="TextSwatch.Function"  Color="#DCDCAA"/>
    <SolidColorBrush x:Key="TextSwatch.Operator"  Color="#C8C8C8"/>
    <SolidColorBrush x:Key="TextSwatch.Parameter" Color="#9CDCFE"/>
    <SolidColorBrush x:Key="TextSwatch.Tag"       Color="#569CD6"/>
    <SolidColorBrush x:Key="TextSwatch.Attribute" Color="#9CDCFE"/>

    <!-- ── AI status dot (lives in the AiBar) ──
         A primary interaction element, so it carries its OWN art-directable tokens rather than
         borrowing palette tones — each theme can tune the states to fit its mood. Defaults are the
         original indicator colours so plain themes are unchanged. -->
    <SolidColorBrush x:Key="AiStatus.Ready"       Color="#22D3A5"/>  <!-- idle / ready  (steady)       -->
    <SolidColorBrush x:Key="AiStatus.Busy"        Color="#F97316"/>  <!-- working      (size-pulse)    -->
    <SolidColorBrush x:Key="AiStatus.Handler"     Color="#6366F1"/>  <!-- single handler matched (pip) -->
    <SolidColorBrush x:Key="AiStatus.HandlerText" Color="White"/>    <!-- symbol drawn on the pip      -->
    <LinearGradientBrush x:Key="AiStatus.ListenBrush" StartPoint="0,0" EndPoint="1,1">
        <!-- listening / ambiguous (opacity-pulse). A violet "thinking" glow — deliberately in a hue
             family of its own (not the blue accents, not the green/amber solid states) so the state
             reads at a glance. Each theme retunes it (see Theme.<name>.xaml). -->
        <GradientStop Color="#6366F1" Offset="0"/>
        <GradientStop Color="#A855F7" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
