<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Nexaflow.Core.Themes">

    <!-- ════════════════════════════════════════════════════════════════════════
         OCEAN — immersive theme overrides + scene.
         A single Scene.Window reef sits behind the whole shell; every region surface
         goes translucent (chrome only slightly, the page area generously) so the one
         continuous backdrop reads cohesively through the window. Pro themes override
         none of this and the reef never instantiates.
         ════════════════════════════════════════════════════════════════════════ -->

    <!-- Chrome: deep-teal wings (logo column + right panel match) framing a brighter ribbon strip.
         Near-opaque so it stays a solid FRAME — the fish tank is the page, not the chrome.
         Ribbon buttons get a darker recessed tile to stand out from the ribbon strip. -->
    <SolidColorBrush x:Key="Chrome.Deep"     Color="#F5123F50"/>
    <SolidColorBrush x:Key="Chrome.Panel"    Color="#F5123F50"/>
    <SolidColorBrush x:Key="Chrome.RightPanel" Color="#F5123F50"/>
    <SolidColorBrush x:Key="Chrome.Bg"       Color="#F21E6E84"/>
    <SolidColorBrush x:Key="Chrome.Border"   Color="#663A8AA0"/>
    <SolidColorBrush x:Key="Ribbon.ButtonBg" Color="#4D0C3242"/>

    <!-- Tab strip: dark like the AI input panel, framing the top of the "fish tank" page. -->
    <SolidColorBrush x:Key="TabStrip.Bg"     Color="#F00A2E3A"/>
    <SolidColorBrush x:Key="TabStrip.Border" Color="#663A8AA0"/>
    <SolidColorBrush x:Key="Tab.HoverBg"     Color="#991E6E84"/>
    <SolidColorBrush x:Key="Tab.ActiveBg"    Color="#C0247E96"/>

    <!-- AI bar: the surround stays transparent to the sea (continuous with the page); the input and
         the button clusters are dark panels, so coral reads as growing from BEHIND them, not through. -->
    <SolidColorBrush x:Key="AiBar.Bg"        Color="#570B3442"/>
    <SolidColorBrush x:Key="AiBar.InputBg"   Color="#E00A2E3A"/>
    <SolidColorBrush x:Key="AiBar.ClusterBg" Color="#E00A2E3A"/>
    <SolidColorBrush x:Key="AiBar.Border"    Color="#663A8AA0"/>

    <!-- File view tree + action strip: transparent to the reef, matching the file list. -->
    <SolidColorBrush x:Key="FileList.PanelBg" Color="#570B3442"/>

    <!-- The one backdrop, behind every row. -->
    <DataTemplate x:Key="Scene.Window">
        <t:OceanReefScene Variant="Full"/>
    </DataTemplate>

    <!-- User chat bubble: deep ocean trench — light cyan text (#EAFBFF) readable at ~9:1. Distinct from
         Surface2 (#17506A); sits between DeepBg and Surface so it reads as filled/submerged. -->
    <SolidColorBrush x:Key="UserBubbleBrush" Color="#0B3245"/>
    <!-- AccentBrush is bright cyan (#3DDCE8) — white gives only ~1.7:1. Use deep ocean instead. -->
    <SolidColorBrush x:Key="OnAccentBrush"   Color="#07232E"/>

    <!-- AI status dot: reef-toned but kept mutually distinct (a reef-green, a warm coral, a sky-blue
         pip, a cyan→blue listen sweep) so the states stay readable against the deep-teal bar. -->
    <SolidColorBrush x:Key="AiStatus.Ready"       Color="#2EE6A6"/>  <!-- reef green -->
    <SolidColorBrush x:Key="AiStatus.Busy"        Color="#FF8A5C"/>  <!-- warm coral -->
    <SolidColorBrush x:Key="AiStatus.Handler"     Color="#5AA6FF"/>  <!-- sky blue pip -->
    <SolidColorBrush x:Key="AiStatus.HandlerText" Color="#06222E"/>
    <LinearGradientBrush x:Key="AiStatus.ListenBrush" StartPoint="0,0" EndPoint="1,1">
        <!-- deep-sea bioluminescent violet → orchid: distinct from the cyan accent, reef-green ready
             and sky-blue handler that already populate this theme -->
        <GradientStop Color="#7C6CF0" Offset="0"/>
        <GradientStop Color="#C86BE0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Syntax palette — cool reef tones, readable on the deep-teal editor glass. -->
    <SolidColorBrush x:Key="TextSwatch.Comment"   Color="#6B98A0"/>
    <SolidColorBrush x:Key="TextSwatch.Keyword"   Color="#56C8E8"/>
    <SolidColorBrush x:Key="TextSwatch.String"    Color="#7FE3C4"/>
    <SolidColorBrush x:Key="TextSwatch.Number"    Color="#B7E8CE"/>
    <SolidColorBrush x:Key="TextSwatch.Type"      Color="#4FD6C4"/>
    <SolidColorBrush x:Key="TextSwatch.Constant"  Color="#FFB37A"/>
    <SolidColorBrush x:Key="TextSwatch.Function"  Color="#E6DE8E"/>
    <SolidColorBrush x:Key="TextSwatch.Operator"  Color="#AECDD6"/>
    <SolidColorBrush x:Key="TextSwatch.Parameter" Color="#BFE9FF"/>
    <SolidColorBrush x:Key="TextSwatch.Tag"       Color="#56C8E8"/>
    <SolidColorBrush x:Key="TextSwatch.Attribute" Color="#9FE9FF"/>

</ResourceDictionary>
