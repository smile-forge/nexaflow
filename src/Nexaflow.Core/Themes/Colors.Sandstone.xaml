<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Palette: warm sandstone GLASS ──
         Immersive earth-tone theme (like Ocean/Forest): a cut-stone wall (Scene.Window) lit by a
         slowly travelling sun sits behind deep-umber translucent panels with warm cream text and a
         sandstone-gold accent. The page root is translucent so the wall reads straight through. -->
    <Color x:Key="BgColor">#522E2016</Color>       <!-- page root: warm umber glass over the wall -->
    <Color x:Key="SurfaceColor">#2C2016</Color>     <!-- panels / cards -->
    <Color x:Key="Surface2Color">#3C2C1E</Color>    <!-- raised panels / inputs -->
    <Color x:Key="BorderColor">#523D2C</Color>
    <Color x:Key="BorderLightColor">#735540</Color>
    <Color x:Key="AccentColor">#E0975A</Color>
    <!-- Sandstone gold / terracotta -->
    <Color x:Key="Accent2Color">#E8C277</Color>
    <!-- Warm sand -->
    <Color x:Key="TextColor">#F4ECDC</Color>
    <Color x:Key="TextMutedColor">#B7A793</Color>
    <Color x:Key="DeepBgColor">#18110A</Color>

    <!-- ── Brushes ── -->
    <SolidColorBrush x:Key="BgBrush"         Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"    Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush"   Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush"     Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush"    Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="TextBrush"       Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"  Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DeepBgBrush"     Color="{StaticResource DeepBgColor}"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0C56C" Offset="0"/>
        <GradientStop Color="#DD8A50" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Dimensions -->
    <GridLength x:Key="TopBarHeight">72</GridLength>
    <GridLength x:Key="TabBarHeight">38</GridLength>
    <GridLength x:Key="InteractionHeight">90</GridLength>

</ResourceDictionary>
