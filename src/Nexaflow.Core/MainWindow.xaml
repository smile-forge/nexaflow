<Window x:Class="Nexaflow.Core.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexaflow.Core.ViewModels"
        xmlns:m="clr-namespace:Nexaflow.Core.Models"
        xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
        xmlns:cvn="clr-namespace:Nexaflow.Core.Converters"
        xmlns:ctrl="clr-namespace:Nexaflow.Core.Controls"
        Title="NexaFlow" Height="880" Width="1280"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BgBrush}"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="15"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <cv:CountToVisibilityConverter       x:Key="CountVis"/>
        <cv:ZeroCountToVisibilityConverter   x:Key="ZeroCountVis"/>
        <cvn:AiStatusBrushConverter           x:Key="AiStatusBrush"/>
        <cvn:RibbonKindVisibilityConverter    x:Key="RibbonKindVis"/>
        <cv:StringToVisibilityConverter      x:Key="StringVis"/>

        <!-- ── Window caption (min/max/close) buttons ── -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root grid: TopBar | ContentArea | Splitter | Interaction -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="15"/>    <!-- 0: drag bar         -->
            <RowDefinition Height="72"/>    <!-- 1: top bar          -->
            <RowDefinition Height="*" MinHeight="100"/>     <!-- 2: content area     -->
            <RowDefinition Height="5"/>     <!-- 3: drag splitter    -->
            <RowDefinition Height="90" MinHeight="72" x:Name="AiRow"/>    <!-- 4: AI interaction   -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 0 — DRAG BAR
             Full-width caption strip; min/max/close pinned top-right.
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource DeepBgBrush}"/>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Button x:Name="MinimizeButton"
                    Style="{StaticResource CaptionButton}"
                    Content="&#xE921;"
                    ToolTip="Minimise"
                    Click="OnMinimizeClick"/>
            <Button x:Name="MaximizeRestoreButton"
                    Style="{StaticResource CaptionButton}"
                    Content="&#xE922;"
                    ToolTip="Maximise"
                    Click="OnMaximizeRestoreClick"/>
            <Button x:Name="CloseButton"
                    Style="{StaticResource CloseCaptionButton}"
                    Content="&#xE8BB;"
                    ToolTip="Close"
                    Click="OnCloseClick"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 1 — TOP BAR
             Left: logo + activity ticker | Mid: ribbon | Right: actions
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Background="{StaticResource SurfaceBrush}"
              x:Name="TopBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: logo + activity ticker ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource DeepBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">

                <Grid Margin="20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <TextBlock Grid.Row="0" VerticalAlignment="Center"
                               FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"
                               ToolTip="NexaFlow">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#A8D4FF" Offset="0"/>
                                <GradientStop Color="#C4A8FF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        ⬡ NexaFlow
                    </TextBlock>

                    <!-- Activity ticker -->
                    <ctrl:ActivityTicker Grid.Row="1"
                                         x:Name="ActivityTicker"
                                         Margin="0,0,0,10"
                                         ItemsSource="{Binding BackgroundTasks}"/>
                </Grid>
            </Border>

            <!-- ── Middle: ribbon (beveled) ── -->
            <Border Grid.Column="1" Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <!-- Bevel overlay: top 10 px in surface colour -->
                    <Border VerticalAlignment="Top" Height="10"
                            Background="{StaticResource SurfaceBrush}"/>

                    <ctrl:RibbonBar x:Name="RibbonBar"
                                     Margin="0,10,0,0"
                                     ItemsSource="{Binding RibbonItems}"
                                     RibbonActionCommand="{Binding RibbonActionCommand}"
                                     EditClickCommand="{Binding ToggleRibbonEditCommand}"
                                     PinTabToRibbonCommand="{Binding PinTabToRibbonCommand}"/>
                </Grid>
            </Border>

            <!-- ── Right: messages + options ── -->
            <Border Grid.Column="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Background="{StaticResource SurfaceBrush}">
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"
                            Margin="0,0,20,10">

                    <!-- Options button -->
                    <Button Style="{StaticResource TopBarAction}"
                            Command="{Binding ToggleOptionsCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,6">
                        <TextBlock Text="Options" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </Button>

                    <!-- Messages + badge -->
                    <Button Style="{StaticResource TopBarAction}"
                            Command="{Binding ToggleNotificationsCommand}"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2 2h12v9H9l-3 3V11H2z"
                                  Fill="{StaticResource TextMutedBrush}" Width="12" Height="12"
                                  Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Messages" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,4,0"/>
                            <Border Background="{StaticResource AccentBrush}"
                                    CornerRadius="8" Padding="4,1"
                                    Visibility="{Binding UnreadCount, Converter={StaticResource CountVis}}">
                                <TextBlock Text="{Binding UnreadCount}" Foreground="White"
                                           FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 2 — CONTENT AREA
             Tab bar (breadcrumb left | tabs right) + page host
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>   <!-- tab bar -->
                <RowDefinition Height="*"/>    <!-- page    -->
            </Grid.RowDefinitions>

            <!-- ── Tab bar ── -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.35*"/>
                        <ColumnDefinition Width="0.65*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Breadcrumb -->
                    <ctrl:BreadcrumbBar x:Name="BreadcrumbBarControl"
                                         Grid.Column="0"
                                         Segments="{Binding Breadcrumbs}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="0,0,1,0"/>

                    <!-- Tab strip -->
                    <ctrl:TabStrip Grid.Column="1"
                                    x:Name="TabStripControl"
                                    Tabs="{Binding Tabs}"
                                    ActivateTabCommand="{Binding ActivateTabCommand}"
                                    CloseTabCommand="{Binding CloseTabCommand}"
                                    PinTabToRibbonCommand="{Binding PinTabToRibbonCommand}"/>
                </Grid>
            </Border>

            <!-- ── Page host ── -->
            <ContentPresenter Grid.Row="1"
                              Content="{Binding CurrentPage}"
                              x:Name="PageHost"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 3 — DRAG SPLITTER
             ═══════════════════════════════════════════════════════════ -->
        <GridSplitter Grid.Row="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Height="5"
                      Background="Transparent"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS"
                      ShowsPreview="False"/>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 4 — AI INTERACTION BAR
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- status + mic -->
                    <ColumnDefinition Width="*"/>      <!-- text input   -->
                    <ColumnDefinition Width="Auto"/>   <!-- attach/clear -->
                </Grid.ColumnDefinitions>

                <!-- Left: AI indicator + mic — top-aligned -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top"
                            Margin="0,4,12,0">

                    <!-- Status dot -->
                    <ctrl:AiStatusDot IsBusy="{Binding AiIsBusy}"
                                      HandlerSymbol="{Binding AiHandlerSymbol}"
                                      IsListening="{Binding AiIsListening}"
                                      Width="28" Height="28"/>

                    <!-- Mic button -->
                    <Button Style="{StaticResource IconButton}"
                            ToolTip="Voice input (toggle)"
                            Command="{Binding ToggleVoiceCommand}"
                            Margin="0,6,0,0">
                        <TextBlock Text="🎙" FontSize="14"/>
                    </Button>
                </StackPanel>

                <!-- Centre: textarea — stretches to fill bar height -->
                <Border Grid.Column="1"
                        VerticalAlignment="Stretch"
                        Margin="0,6,0,6"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <ctrl:PlaceholderTextBox
                        x:Name="AiInput"
                        MinHeight="62"
                        Placeholder="Ask anything… summarise this view, find trends, generate a report…"
                        Text="{Binding AiInputText, UpdateSourceTrigger=PropertyChanged}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        Padding="14,10"
                        VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        AcceptsReturn="False"
                        SendCommand="{Binding SendAiMessageCommand}"
                        CaretBrush="#FFD8D8D8">
                        <ctrl:PlaceholderTextBox.Style>
                            <Style TargetType="ctrl:PlaceholderTextBox">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AiInputIsAiTyping}" Value="True">
                                        <Setter Property="Foreground" Value="#06b6d4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrl:PlaceholderTextBox.Style>
                    </ctrl:PlaceholderTextBox>
                </Border>

                <!-- Right: attach + clear — top-aligned -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top"
                            Margin="12,4,0,0">

                    <Button Style="{StaticResource IconButton}"
                            ToolTip="Attach file"
                            Command="{Binding AttachFileCommand}">
                        <TextBlock Text="📎" FontSize="14"/>
                    </Button>

                    <Button Style="{StaticResource IconButton}"
                            ToolTip="Clear input"
                            Command="{Binding ClearAiInputCommand}"
                            Margin="0,6,0,0">
                        <TextBlock Text="⊗" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — NOTIFICATIONS PANEL
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding NotificationsOpen, Converter={StaticResource BoolVis}}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,87,0,0" Width="320"
                Style="{StaticResource PopupBorder}"
                Padding="12" Panel.ZIndex="50">
            <StackPanel>
                <TextBlock Text="Notifications" Foreground="{StaticResource TextBrush}"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:NotificationItem}">
                            <Border Padding="8" CornerRadius="6" Margin="0,2"
                                    Background="{StaticResource Surface2Brush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="12" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Body}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Top"
                                            Style="{StaticResource TopBarAction}"
                                            Command="{Binding DataContext.DismissNotificationCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="✕" FontSize="10"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No notifications"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,12"
                           Visibility="{Binding Notifications.Count,
                                                Converter={StaticResource ZeroCountVis}}"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — OPTIONS PANEL
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding OptionsOpen, Converter={StaticResource BoolVis}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="#CC0F1117" Panel.ZIndex="100">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="800" Height="500" Style="{StaticResource PopupBorder}">
                <ctrl:OptionsPanel x:Name="OptionsPanelControl"/>
            </Border>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — RIBBON EDIT PANEL  (full-screen modal)
             ═══════════════════════════════════════════════════════════ -->
        <ctrl:RibbonEditor
                Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding RibbonEditOpen, Converter={StaticResource BoolVis}}"
                Panel.ZIndex="60"
                ItemsSource="{Binding RibbonItems}"
                CloseCommand="{Binding ToggleRibbonEditCommand}"
                ShellViewModel="{Binding}"/>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — ERROR TOAST
             Appears at the bottom-right when ErrorToast is non-null.
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding ErrorToast, Converter={StaticResource StringVis}}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,110"
                MaxWidth="420"
                Panel.ZIndex="200"
                Background="#CC2a0a0a"
                BorderBrush="#FF6B3333"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Warning icon -->
                <TextBlock Grid.Column="0" Text="⚠" FontSize="16"
                           Foreground="#FFDD6B"
                           VerticalAlignment="Top" Margin="0,1,10,0"/>

                <!-- Message -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="AI provider error"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#FFCCAA"/>
                    <TextBlock Text="{Binding ErrorToast}"
                               FontSize="11"
                               Foreground="#FFAA88"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Dismiss button -->
                <Button Grid.Column="2" VerticalAlignment="Top"
                        Style="{StaticResource TopBarAction}"
                        Margin="10,0,0,0"
                        Command="{Binding ClearErrorToastCommand}">
                    <TextBlock Text="✕" FontSize="11"
                               Foreground="#FF9977"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — UPDATE TOAST
             Appears at the bottom-right when UpdateToastVersion is non-null.
             Auto-dismisses after 5 minutes.
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding UpdateToastVersion, Converter={StaticResource StringVis}}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,110"
                MaxWidth="460"
                Panel.ZIndex="210"
                Background="#CC0a1828"
                BorderBrush="#FF336688"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: icon + title + version chip + close -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="⬆" FontSize="16"
                               Foreground="#66AAFF"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="Update Available"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#AACCFF"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="2"
                            Background="#1A336688" BorderBrush="#FF336688"
                            BorderThickness="1" CornerRadius="4"
                            Padding="6,2" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateToastVersion}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#88BBFF"/>
                    </Border>
                    <Button Grid.Column="3" VerticalAlignment="Top"
                            Style="{StaticResource TopBarAction}"
                            Margin="10,0,0,0"
                            Command="{Binding DismissUpdateToastCommand}">
                        <TextBlock Text="✕" FontSize="11"
                                   Foreground="#6688AA"/>
                    </Button>
                </Grid>

                <!-- Changelog scroll area -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="120"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,10,0,0">
                    <TextBlock Text="{Binding UpdateToastChangelog}"
                               FontSize="11"
                               Foreground="#7799BB"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <!-- Action buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Content="Not Now"
                            Style="{StaticResource TopBarAction}"
                            Padding="12,5"
                            Foreground="#6688AA"
                            Margin="0,0,8,0"
                            Command="{Binding DismissUpdateToastCommand}"/>
                    <Button Content="Update"
                            Style="{StaticResource TopBarAction}"
                            Padding="12,5"
                            Foreground="#AACCFF"
                            Background="#1A336688"
                            BorderBrush="#FF336688"
                            BorderThickness="1"
                            Command="{Binding AcceptUpdateCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
