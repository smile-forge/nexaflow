<Window x:Class="Nexaflow.Core.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexaflow.Core.ViewModels"
        xmlns:vmo="clr-namespace:Nexaflow.Core.ViewModels.Overlays"
        xmlns:m="clr-namespace:Nexaflow.Core.Models"
        xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
        xmlns:cvn="clr-namespace:Nexaflow.Core.Converters"
        xmlns:ctrl="clr-namespace:Nexaflow.Core.Controls"
        xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
        Title="NexaFlow" Height="880" Width="1280"
        AutomationProperties.AutomationId="MainWindow"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BgBrush}"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="19"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <cv:CountToVisibilityConverter       x:Key="CountVis"/>
        <cv:ZeroCountToVisibilityConverter   x:Key="ZeroCountVis"/>
        <cvn:AiStatusBrushConverter           x:Key="AiStatusBrush"/>
        <cvn:RibbonKindVisibilityConverter    x:Key="RibbonKindVis"/>
        <cvn:InverseBooleanConverter          x:Key="InvBool"/>
        <cv:StringToVisibilityConverter      x:Key="StringVis"/>
        <cv:ColorStringToBrushConverter      x:Key="ColorStringToBrush"/>
        <cv:NullToVisibilityConverter        x:Key="NullToVis"/>

        <!-- ── Overlay host templates: one per overlay content type. The single OverlayHost ContentControl
             (below the AI bar) renders ActiveOverlay via the matching template, so each overlay's tree is
             built lazily on open and torn down on close. Feature overlays ship their own DataTemplate via
             IThemeContribution and are found at app-resource level the same way. ── -->
        <DataTemplate DataType="{x:Type vmo:ConfirmationOverlay}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="420" Style="{StaticResource PopupBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelCommand}"
                                Width="90" Height="32" Margin="0,0,8,0" FontSize="12" Cursor="Hand"
                                Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="7" Padding="8,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Confirm" Command="{Binding ConfirmCommand}"
                                Width="90" Height="32" FontSize="12" Cursor="Hand"
                                Background="{StaticResource AccentBrush}" Foreground="White"
                                BorderThickness="0" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            CornerRadius="7" Padding="8,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmo:PromptOverlay}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="420" Style="{StaticResource PopupBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <!-- The editable value lives on ShellViewModel.PromptValue (read by ConfirmShellPrompt). -->
                    <TextBox ctrl:FocusOnLoad.Enabled="True"
                             Text="{Binding DataContext.PromptValue, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,0,18" FontSize="13"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" AcceptsReturn="False">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"  Command="{Binding ConfirmCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelCommand}"
                                Width="90" Height="32" Margin="0,0,8,0" FontSize="12" Cursor="Hand"
                                Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="7" Padding="8,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="OK" Command="{Binding ConfirmCommand}"
                                Width="90" Height="32" FontSize="12" Cursor="Hand"
                                Background="{StaticResource AccentBrush}" Foreground="White"
                                BorderThickness="0" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            CornerRadius="7" Padding="8,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OptionsViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/><RowDefinition Height="8*"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Grid.Column="1"
                        MinWidth="720" MinHeight="460" MaxWidth="1400" MaxHeight="1000"
                        Style="{StaticResource PopupBorder}">
                    <ctrl:OptionsPanel/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ManageAiViewModel}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="960" Height="600" Style="{StaticResource PopupBorder}">
                <ctrl:ManageAiPanel/>
            </Border>
        </DataTemplate>

        <!-- ── Pane tree: a lone Pane renders as one PaneView; a SplitPaneNode as two side by side.
             Each PaneView pulls the shared tab commands from this window's ShellViewModel. ── -->
        <DataTemplate DataType="{x:Type vm:Pane}">
            <ctrl:PaneView Pane="{Binding}"
                           ActivateTabCommand="{Binding DataContext.ActivateTabCommand,        RelativeSource={RelativeSource AncestorType=Window}}"
                           CloseTabCommand="{Binding DataContext.CloseTabCommand,               RelativeSource={RelativeSource AncestorType=Window}}"
                           PinTabToRibbonCommand="{Binding DataContext.PinTabToRibbonCommand,   RelativeSource={RelativeSource AncestorType=Window}}"
                           TearOffTabCommand="{Binding DataContext.TearOffTabCommand,           RelativeSource={RelativeSource AncestorType=Window}}"
                           ReceiveTabCommand="{Binding DataContext.ReceiveTabCommand,           RelativeSource={RelativeSource AncestorType=Window}}"
                           OpenPageCommand="{Binding DataContext.OpenPageCommand,               RelativeSource={RelativeSource AncestorType=Window}}"
                           SplitTabCommand="{Binding DataContext.SplitRightCommand,             RelativeSource={RelativeSource AncestorType=Window}}"
                           SplitEmptyCommand="{Binding DataContext.SplitEmptyCommand,           RelativeSource={RelativeSource AncestorType=Window}}"
                           ClosePaneCommand="{Binding DataContext.ClosePaneCommand,             RelativeSource={RelativeSource AncestorType=Window}}"
                           CloseOthersCommand="{Binding DataContext.CloseOthersInPaneCommand,   RelativeSource={RelativeSource AncestorType=Window}}"
                           PaneActivatedCommand="{Binding DataContext.PaneActivatedCommand,     RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SplitPaneNode}">
            <ctrl:SplitPaneView/>
        </DataTemplate>

        <!-- ── Window caption (min/max/close) buttons ── -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root grid: TopBar | ContentArea | Splitter | Interaction -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="19"/>    <!-- 0: drag bar         -->
            <RowDefinition Height="72"/>    <!-- 1: top bar          -->
            <RowDefinition Height="*" MinHeight="100"/>     <!-- 2: content area     -->
            <RowDefinition Height="5"/>     <!-- 3: drag splitter    -->
            <RowDefinition Height="90" MinHeight="90" x:Name="AiRow"/>    <!-- 4: AI interaction (≥90 keeps the mic/context cluster fully visible) -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             WINDOW BACKDROP — a single themed scene behind every row.
             An immersive theme supplies Scene.Window (e.g. the Ocean reef); Pro themes
             supply none and this is inert. Never hit-tests, sits beneath all content.
             ═══════════════════════════════════════════════════════════ -->
        <vcc:ThemedRegion Grid.Row="0" Grid.RowSpan="5" Region="Window"
                          IsHitTestVisible="False" Panel.ZIndex="-10"/>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 0 — DRAG BAR
             Full-width caption strip; min/max/close pinned top-right.
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Chrome.Deep}"/>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Button x:Name="MinimizeButton"
                    Style="{StaticResource CaptionButton}"
                    Content="&#xE921;"
                    ToolTip="Minimise"
                    Click="OnMinimizeClick"/>
            <Button x:Name="MaximizeRestoreButton"
                    Style="{StaticResource CaptionButton}"
                    Content="&#xE922;"
                    ToolTip="Maximise"
                    Click="OnMaximizeRestoreClick"/>
            <Button x:Name="CloseButton"
                    Style="{StaticResource CloseCaptionButton}"
                    Content="&#xE8BB;"
                    ToolTip="Close"
                    Click="OnCloseClick"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 1 — TOP BAR
             Left: logo + activity ticker | Mid: ribbon | Right: actions
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Background="{StaticResource Chrome.Panel}"
              x:Name="TopBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: logo + activity ticker ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource Chrome.Deep}"
                    BorderBrush="{StaticResource Chrome.Border}"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">

                <Grid Margin="20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo — gradient follows the theme's accent so it matches per-theme -->
                    <TextBlock Grid.Row="0" VerticalAlignment="Center"
                               FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="{StaticResource AccentGradientBrush}"
                               ToolTip="NexaFlow">
                        ⬡ NexaFlow
                    </TextBlock>

                    <!-- Activity ticker -->
                    <ctrl:ActivityTicker Grid.Row="1"
                                         x:Name="ActivityTicker"
                                         Margin="0,0,0,10"
                                         ItemsSource="{Binding BackgroundTasks}"/>
                </Grid>
            </Border>

            <!-- ── Middle: self-contained ribbon component ── -->
            <Border Grid.Column="1" Background="{StaticResource Chrome.Bg}"
                    BorderBrush="{StaticResource Chrome.Border}"
                    BorderThickness="0,1,0,0">
                <ctrl:RibbonControl x:Name="RibbonControl"
                                    AutomationProperties.AutomationId="RibbonControl"
                                    Workspace="{Binding CurrentWorkspace}"
                                    Profile="{Binding CurrentWorkspace.Profile}"
                                    Profiles="{Binding Profiles}"
                                    CanSwitchProfile="{Binding CanSwitchProfile}"
                                    SelectProfileCommand="{Binding SelectProfileCommand}"
                                    ConfigureProfileCommand="{Binding ConfigureCurrentWorkspaceCommand}"
                                    NewWorkspaceCommand="{Binding NewWorkspaceCommand}"
                                    OpenPageCommand="{Binding OpenRibbonItemCommand}"
                                    OpenPageInNewWindowCommand="{Binding OpenRibbonItemInNewWindowCommand}"
                                    Shell="{Binding ShellServices}"/>
            </Border>

            <!-- ── Right: messages + options ── (own token so only the Light theme retints it to the
                 logo-wing tint; every other theme keeps its intentional Chrome.Panel value) -->
            <Border Grid.Column="2"
                    BorderBrush="{StaticResource Chrome.Border}"
                    BorderThickness="1,0,0,0"
                    Background="{StaticResource Chrome.RightPanel}">
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"
                            Margin="0,0,20,10">

                    <!-- Options button -->
                    <Button Style="{StaticResource TopBarAction}"
                            Command="{Binding ToggleOptionsCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,6">
                        <TextBlock Text="Options" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </Button>

                    <!-- Messages + badge -->
                    <Button Style="{StaticResource TopBarAction}"
                            Command="{Binding ToggleNotificationsCommand}"
                            AutomationProperties.AutomationId="NotificationsButton"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2 2h12v9H9l-3 3V11H2z"
                                  Fill="{StaticResource TextMutedBrush}" Width="12" Height="12"
                                  Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="Messages" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,4,0"/>
                            <Border Background="{StaticResource AccentBrush}"
                                    CornerRadius="8" Padding="4,1"
                                    Visibility="{Binding UnreadCount, Converter={StaticResource CountVis}}">
                                <TextBlock Text="{Binding UnreadCount}" Foreground="White"
                                           FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 2 — CONTENT AREA
             PaneView renders the tab strip + breadcrumb + active page.
             The shell hands it the root Pane and the cross-pane commands.
             ═══════════════════════════════════════════════════════════ -->
        <ContentControl Grid.Row="2"
                        x:Name="RootPaneHost"
                        Content="{Binding RootPaneNode}"/>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — AI RESPONSE (modal over the page only)
             Dimmed backdrop spans rows 0–3 (drag bar, ribbon/tabs, content,
             splitter) so the page can't be clicked, but deliberately leaves
             row 4 (the AI input bar) live so the user can cancel the action.
             ═══════════════════════════════════════════════════════════ -->
        <ctrl:AiResponseOverlay Grid.Row="0" Grid.RowSpan="4"
                                Panel.ZIndex="100"
                                DataContext="{Binding Ai}"/>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 3 — DRAG SPLITTER
             ═══════════════════════════════════════════════════════════ -->
        <GridSplitter Grid.Row="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Height="5"
                      Background="Transparent"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS"
                      ShowsPreview="False"/>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 4 — AI INTERACTION BAR
             Wrapped as the "AiBar" region: an immersive theme can paint a backdrop here
             independently of the page area. The bar surface comes from the AiBar.Bg veil,
             so the inner Border stays transparent and only keeps the top divider line.
             ═══════════════════════════════════════════════════════════ -->
        <vcc:ThemedRegion Grid.Row="4" Region="AiBar">
        <Border Background="Transparent"
                BorderBrush="{StaticResource AiBar.Border}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- status + mic   -->
                    <ColumnDefinition Width="*"/>      <!-- text input     -->
                    <ColumnDefinition Width="Auto"/>   <!-- submit / cancel -->
                    <ColumnDefinition Width="Auto"/>   <!-- context + clear -->
                </Grid.ColumnDefinitions>

                <!-- Left: AI indicator + clear — on a dark panel matching the input -->
                <Border Grid.Column="0" VerticalAlignment="Stretch" Margin="0,6,12,6"
                        Background="{StaticResource AiBar.ClusterBg}" CornerRadius="10" Padding="7,8">
                    <StackPanel VerticalAlignment="Top">

                        <!-- Status dot -->
                        <ctrl:AiStatusDot IsBusy="{Binding AiIsBusy}"
                                          HandlerSymbol="{Binding AiHandlerSymbol}"
                                          IsListening="{Binding AiIsListening}"
                                          Width="28" Height="28"/>

                        <!-- Clear input -->
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="Clear input"
                                Command="{Binding ClearAiInputCommand}"
                                IsEnabled="{Binding AiIsBusy, Converter={StaticResource InvBool}}"
                                Margin="0,6,0,0">
                            <TextBlock Text="⊗" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Centre: textarea — stretches to fill bar height -->
                <Border Grid.Column="1"
                        VerticalAlignment="Stretch"
                        Margin="0,6,0,6"
                        Background="{StaticResource AiBar.InputBg}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <ctrl:PlaceholderTextBox
                        x:Name="AiInput"
                        AutomationProperties.AutomationId="AiInputBox"
                        MinHeight="62"
                        Placeholder="Ask anything… summarise this view, find trends, generate a report…"
                        Text="{Binding AiInputText, UpdateSourceTrigger=PropertyChanged}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        Padding="14,10"
                        VerticalScrollBarVisibility="Auto"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        SendCommand="{Binding SendAiMessageCommand}"
                        CompletionText="{Binding AiCompletionSuggestion}"
                        CaretBrush="#FFD8D8D8">
                        <ctrl:PlaceholderTextBox.Style>
                            <Style TargetType="ctrl:PlaceholderTextBox">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AiInputIsAiTyping}" Value="True">
                                        <Setter Property="Foreground" Value="#06b6d4"/>
                                    </DataTrigger>
                                    <!-- Disabled while the AI is processing or the mic is listening -->
                                    <DataTrigger Binding="{Binding AiIsBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ctrl:PlaceholderTextBox.Style>
                    </ctrl:PlaceholderTextBox>
                </Border>

                <!-- Submit / Cancel (swaps on AiIsBusy) + a Queue button that appears while busy so the
                     user can add to the in-flight request AND cancel it at the same time. -->
              <Grid Grid.Column="2" Margin="12,6,0,6" MinWidth="56">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>   <!-- queue (busy only) -->
                    <RowDefinition Height="*"/>   <!-- send / cancel     -->
                </Grid.RowDefinitions>

                <!-- Queue addendum — visible only while the agent is working; Enter also queues.
                     Takes the top half while busy (the main button drops to the bottom half). -->
                <Button Grid.Row="0" VerticalAlignment="Stretch" Margin="0,0,0,3"
                        Cursor="Hand" FontSize="14" Foreground="White"
                        Content="➤＋" ToolTip="Queue message (delivered at the next step)"
                        Command="{Binding SendAiMessageCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="qroot" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="qroot" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AiIsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button VerticalAlignment="Stretch"
                        Cursor="Hand" FontSize="16"
                        Foreground="White">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Content" Value="➤"/>
                            <Setter Property="ToolTip" Value="Send (Enter)"/>
                            <Setter Property="Command" Value="{Binding SendAiMessageCommand}"/>
                            <!-- Idle: span both rows (full height). Busy: drop to the bottom half. -->
                            <Setter Property="Grid.Row" Value="0"/>
                            <Setter Property="Grid.RowSpan" Value="2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="root"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Busy: become a Cancel button (stays enabled while AI processes),
                                     and drop to the bottom half so the queue button sits above it. -->
                                <DataTrigger Binding="{Binding AiIsBusy}" Value="True">
                                    <Setter Property="Content" Value="■"/>
                                    <Setter Property="ToolTip" Value="Cancel"/>
                                    <Setter Property="Command" Value="{Binding CancelAiCommand}"/>
                                    <Setter Property="Background" Value="#E11D48"/>
                                    <Setter Property="Grid.Row" Value="1"/>
                                    <Setter Property="Grid.RowSpan" Value="1"/>
                                </DataTrigger>
                                <!-- Listening: show a listening icon; click to stop early -->
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Content" Value="👂"/>
                                    <Setter Property="ToolTip" Value="Listening… (click to stop)"/>
                                    <Setter Property="Command" Value="{Binding ToggleVoiceCommand}"/>
                                    <Setter Property="Background" Value="#06b6d4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
              </Grid>

                <!-- Right: context toggle + mic — on a dark panel matching the input -->
                <Border Grid.Column="3" VerticalAlignment="Stretch" Margin="12,6,0,6"
                        Background="{StaticResource AiBar.ClusterBg}" CornerRadius="10" Padding="7,8">
                    <StackPanel VerticalAlignment="Top">

                        <ToggleButton ToolTip="Include page context"
                                      IsChecked="{Binding IncludeContext}"
                                      IsEnabled="{Binding AiIsBusy, Converter={StaticResource InvBool}}"
                                      Style="{StaticResource ContextToggleButton}">
                            <TextBlock Text="🔗" FontSize="14"/>
                        </ToggleButton>

                        <!-- Mic button — enabled only when voice is available; red while listening -->
                        <Button ToolTip="Voice input (toggle)"
                                Command="{Binding ToggleVoiceCommand}"
                                Margin="0,6,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Foreground" Value="#E11D48"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="🎙" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        </vcc:ThemedRegion>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — NOTIFICATIONS PANEL
             ═══════════════════════════════════════════════════════════ -->
        <!-- Click-outside scrim: a transparent full-window catch layer below the
             panel that dismisses it when clicked off. -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding NotificationsOpen, Converter={StaticResource BoolVis}}"
                Background="Transparent" Panel.ZIndex="49"
                MouseDown="NotificationScrim_MouseDown"/>
        <Border Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding NotificationsOpen, Converter={StaticResource BoolVis}}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,87,0,0" Width="640"
                Style="{StaticResource PopupBorder}"
                Padding="12" Panel.ZIndex="50">
            <StackPanel>
                <TextBlock Text="Notifications" Foreground="{StaticResource TextBrush}"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:NotificationItem}">
                            <Border Padding="8" CornerRadius="6" Margin="0,2"
                                    Background="{StaticResource Surface2Brush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBox Text="{Binding Title}"
                                                 Style="{StaticResource SelectableText}"
                                                 Foreground="{StaticResource TextBrush}"
                                                 FontSize="12" FontWeight="Medium"/>
                                        <TextBox Text="{Binding Body}"
                                                 Style="{StaticResource SelectableText}"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 FontSize="11" Margin="0,2,0,0"/>
                                        <!-- Message actions — same actions as the toast, triggerable from the inbox -->
                                        <ItemsControl ItemsSource="{Binding Actions}"
                                                      Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}"
                                                      Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:MessageAction}">
                                                    <Button Content="{Binding Label}"
                                                            Style="{StaticResource TopBarAction}"
                                                            Padding="10,4" Margin="0,0,6,0"
                                                            Foreground="{StaticResource TextBrush}"
                                                            Command="{Binding Command}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Top"
                                            Style="{StaticResource TopBarAction}"
                                            Command="{Binding DataContext.DismissNotificationCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="✕" FontSize="10"
                                                   Foreground="{StaticResource TextDimBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No notifications"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,12"
                           Visibility="{Binding Notifications.Count,
                                                Converter={StaticResource ZeroCountVis}}"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY HOST — one ContentControl renders whichever modal is active (ActiveOverlay),
             picked by DataTemplate (defined in Window.Resources above; feature overlays contribute
             their own via IThemeContribution). Built lazily on open, torn down on close. The backdrop
             dims the shell; backdrop-click closes only overlays that opt in via
             IShellOverlay.DismissOnBackdrop — the built-in modals don't (they use their own buttons).
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="150"
              Visibility="{Binding ActiveOverlay, Converter={StaticResource NullToVis}}">
            <Border Background="#CC0F1117" MouseDown="OverlayBackdrop_MouseDown"/>
            <ContentControl Content="{Binding ActiveOverlay}"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — RIBBON EDIT PANEL  (full-screen modal)
             ═══════════════════════════════════════════════════════════ -->
        <ctrl:RibbonEditor
                Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding ViewModel.IsEditOpen, ElementName=RibbonControl, Converter={StaticResource BoolVis}}"
                Panel.ZIndex="60"
                RibbonWidth="{Binding ActualWidth, ElementName=RibbonControl}"
                ItemsSource="{Binding ViewModel.Items, ElementName=RibbonControl}"
                AvailablePages="{Binding ViewModel.AvailablePages, ElementName=RibbonControl}"
                CloseCommand="{Binding ViewModel.ToggleEditCommand, ElementName=RibbonControl}"
                SaveCommand="{Binding ViewModel.SaveCommand, ElementName=RibbonControl}"/>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — TOAST  (transient presentation of the active message)
             Bound to ActiveToast; severity drives the colour/icon. Renders the
             message's actions as buttons. Auto-dismisses (duration by severity).
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding DataContext.ToastVisible, RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource BoolVis}}"
                DataContext="{Binding ActiveToast}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,110"
                MaxWidth="460"
                Panel.ZIndex="210"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14">
            <Border.Style>
                <!-- Theme-driven: popup surface + a severity-coloured border, drawn from
                     semantic theme brushes so every theme retints it. Info = accent. -->
                <Style TargetType="Border" BasedOn="{StaticResource PopupBorder}">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Update">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: severity icon + title + close -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="ℹ"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter Property="Text" Value="⚠"/>
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter Property="Text" Value="⚠"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Update">
                                        <Setter Property="Text" Value="⬆"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2" VerticalAlignment="Top"
                            Style="{StaticResource TopBarAction}"
                            Margin="10,0,0,0"
                            Command="{Binding DataContext.DismissActiveToastCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                    </Button>
                </Grid>

                <!-- Body (scrollable — long changelogs) -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="120"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,10,0,0">
                    <TextBlock Text="{Binding Body}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <!-- Action buttons (from the message's Actions) -->
                <ItemsControl Grid.Row="2"
                              Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}"
                              ItemsSource="{Binding Actions}"
                              Margin="0,12,0,0" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:MessageAction}">
                            <Button Content="{Binding Label}"
                                    Padding="12,5" Margin="8,0,0,0"
                                    Foreground="{StaticResource TextBrush}"
                                    Command="{Binding DataContext.RunToastActionCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TopBarAction}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

    </Grid>
</Window>
