<Window x:Class="Nexaflow.Core.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Nexaflow.Core.ViewModels"
        xmlns:dlg="clr-namespace:Nexaflow.Visuals.Common.Dialogs;assembly=Nexaflow.Visuals.Common"
        xmlns:m="clr-namespace:Nexaflow.Core.Models"
        xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
        xmlns:cvn="clr-namespace:Nexaflow.Core.Converters"
        xmlns:ctrl="clr-namespace:Nexaflow.Core.Controls"
        xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
        xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
                xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown;assembly=Nexaflow.Visuals.Text"
        Title="NexaFlow" Height="880" Width="1280"
        AutomationProperties.AutomationId="MainWindow"
        MinHeight="600" MinWidth="980"
        Background="{StaticResource BgBrush}"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="19"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <cv:CountToVisibilityConverter       x:Key="CountVis"/>
        <cv:ZeroCountToVisibilityConverter   x:Key="ZeroCountVis"/>
        <cvn:AiStatusBrushConverter           x:Key="AiStatusBrush"/>
        <cvn:RibbonKindVisibilityConverter    x:Key="RibbonKindVis"/>
        <cvn:InverseBooleanConverter          x:Key="InvBool"/>
        <cv:StringToVisibilityConverter      x:Key="StringVis"/>
        <cv:ColorStringToBrushConverter      x:Key="ColorStringToBrush"/>
        <cv:NullToVisibilityConverter        x:Key="NullToVis"/>

        <!-- ── Overlay host templates: one per overlay content type. The single OverlayHost ContentControl
             (below the AI bar) renders ActiveOverlay via the matching template, so each overlay's tree is
             built lazily on open and torn down on close. Feature overlays ship their own DataTemplate via
             IThemeContribution and are found at app-resource level the same way. ── -->
        <DataTemplate DataType="{x:Type dlg:ConfirmationRequest}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="420" Style="{StaticResource PopupBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button AutomationProperties.AutomationId="Chrome_ConfirmCancel" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                                MinWidth="90" Height="32" Margin="0,0,8,0" FontSize="12" Cursor="Hand"
                                Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="7" Padding="8,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- A third answer, when the question has one: "Discard" beside "Apply" and "Keep editing". -->
                        <Button AutomationProperties.AutomationId="Chrome_ConfirmAlternate" Content="{Binding AlternateLabel}" Command="{Binding AlternateCommand}"
                                Visibility="{Binding HasAlternate, Converter={StaticResource BoolVis}}"
                                MinWidth="90" Height="32" Margin="0,0,8,0" FontSize="12" Cursor="Hand"
                                Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="7" Padding="8,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button AutomationProperties.AutomationId="Chrome_ConfirmOk" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                                MinWidth="90" Height="32" FontSize="12" Cursor="Hand"
                                Background="{StaticResource AccentBrush}" Foreground="White"
                                BorderThickness="0" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            CornerRadius="7" Padding="8,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dlg:PromptRequest}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="420" Style="{StaticResource PopupBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox ctrl:FocusOnLoad.Enabled="True"
                             AutomationProperties.AutomationId="ShellPromptBox"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6" Margin="0,0,0,18" FontSize="13"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" AcceptsReturn="False">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"  Command="{Binding ConfirmCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{loc:Str Shell.Prompt.Cancel}" Command="{Binding CancelCommand}"
                                AutomationProperties.AutomationId="ShellPromptCancel"
                                Width="90" Height="32" Margin="0,0,8,0" FontSize="12" Cursor="Hand"
                                Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="7" Padding="8,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Background" Value="{StaticResource BorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="{loc:Str Shell.Prompt.Ok}" Command="{Binding ConfirmCommand}"
                                AutomationProperties.AutomationId="ShellPromptOk"
                                Width="90" Height="32" FontSize="12" Cursor="Hand"
                                Background="{StaticResource AccentBrush}" Foreground="White"
                                BorderThickness="0" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="root" Background="{TemplateBinding Background}"
                                            CornerRadius="7" Padding="8,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OptionsViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/><RowDefinition Height="8*"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Grid.Column="1"
                        MinWidth="720" MinHeight="460" MaxWidth="1400" MaxHeight="1000"
                        Style="{StaticResource PopupBorder}">
                    <ctrl:OptionsPanel AutomationProperties.AutomationId="Chrome_OptionsPanel"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:WorkspaceConfigViewModel}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="960" Height="600" Style="{StaticResource PopupBorder}">
                <ctrl:WorkspaceConfigPanel/>
            </Border>
        </DataTemplate>

        <!-- ── Pane tree: a lone Pane renders as one PaneView; a SplitPaneNode as two side by side.
             Each PaneView pulls the shared tab commands from this window's ShellViewModel. ── -->
        <DataTemplate DataType="{x:Type vm:Pane}">
            <ctrl:PaneView Pane="{Binding}"
                           ActivateTabCommand="{Binding DataContext.ActivateTabCommand,        RelativeSource={RelativeSource AncestorType=Window}}"
                           CloseTabCommand="{Binding DataContext.CloseTabCommand,               RelativeSource={RelativeSource AncestorType=Window}}"
                           PinTabToRibbonCommand="{Binding DataContext.PinTabToRibbonCommand,   RelativeSource={RelativeSource AncestorType=Window}}"
                           TearOffTabCommand="{Binding DataContext.TearOffTabCommand,           RelativeSource={RelativeSource AncestorType=Window}}"
                           ReceiveTabCommand="{Binding DataContext.ReceiveTabCommand,           RelativeSource={RelativeSource AncestorType=Window}}"
                           OpenPageCommand="{Binding DataContext.OpenPageCommand,               RelativeSource={RelativeSource AncestorType=Window}}"
                           SplitTabCommand="{Binding DataContext.SplitRightCommand,             RelativeSource={RelativeSource AncestorType=Window}}"
                           SplitEmptyCommand="{Binding DataContext.SplitEmptyCommand,           RelativeSource={RelativeSource AncestorType=Window}}"
                           ClosePaneCommand="{Binding DataContext.ClosePaneCommand,             RelativeSource={RelativeSource AncestorType=Window}}"
                           CloseOthersCommand="{Binding DataContext.CloseOthersInPaneCommand,   RelativeSource={RelativeSource AncestorType=Window}}"
                           PaneActivatedCommand="{Binding DataContext.PaneActivatedCommand,     RelativeSource={RelativeSource AncestorType=Window}}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SplitPaneNode}">
            <ctrl:SplitPaneView/>
        </DataTemplate>

        <!-- ── Window caption (min/max/close) buttons ── -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root grid: TopBar | ContentArea | Splitter | Interaction -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="19"/>    <!-- 0: drag bar         -->
            <RowDefinition Height="72"/>    <!-- 1: top bar          -->
            <RowDefinition Height="*" MinHeight="100"/>     <!-- 2: content area     -->
            <RowDefinition Height="5"/>     <!-- 3: drag splitter    -->
            <RowDefinition Height="90" MinHeight="90" x:Name="AiRow"/>    <!-- 4: AI interaction (≥90 keeps the mic/context cluster fully visible) -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             WINDOW BACKDROP — a single themed scene behind every row.
             An immersive theme supplies Scene.Window (e.g. the Ocean reef); Pro themes
             supply none and this is inert. Never hit-tests, sits beneath all content.
             ═══════════════════════════════════════════════════════════ -->
        <vcc:ThemedRegion Grid.Row="0" Grid.RowSpan="5" Region="Window"
                          IsHitTestVisible="False" Panel.ZIndex="-10"/>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 0 — DRAG BAR
             Full-width caption strip; min/max/close pinned top-right.
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Chrome.Deep}"/>
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Button AutomationProperties.AutomationId="Chrome_Minimize" x:Name="MinimizeButton"
                    Style="{StaticResource CaptionButton}"
                    Content="&#xE921;"
                    ToolTip="{loc:Str Shell.Caption.Minimise}"
                    Click="OnMinimizeClick"/>
            <Button AutomationProperties.AutomationId="Chrome_MaximizeRestore" x:Name="MaximizeRestoreButton"
                    Style="{StaticResource CaptionButton}"
                    Content="&#xE922;"
                    ToolTip="{loc:Str Shell.Caption.Maximise}"
                    Click="OnMaximizeRestoreClick"/>
            <Button AutomationProperties.AutomationId="Chrome_Close" x:Name="CloseButton"
                    Style="{StaticResource CloseCaptionButton}"
                    Content="&#xE8BB;"
                    ToolTip="{loc:Str Shell.Caption.Close}"
                    Click="OnCloseClick"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 1 — TOP BAR
             Left: logo + activity ticker | Mid: ribbon | Right: actions
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Background="{StaticResource Chrome.Panel}"
              x:Name="TopBar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: logo + activity ticker ── -->
            <Border Grid.Column="0"
                    Background="{StaticResource Chrome.Deep}"
                    BorderBrush="{StaticResource Chrome.Border}"
                    BorderThickness="0,0,1,0"
                    ClipToBounds="True">

                <Grid Margin="20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo — gradient follows the theme's accent so it matches per-theme -->
                    <TextBlock Grid.Row="0" VerticalAlignment="Center"
                               FontSize="20" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="{StaticResource AccentGradientBrush}"
                               ToolTip="NexaFlow">
                        ⬡ NexaFlow
                    </TextBlock>

                    <!-- Row 1: page-registered mediated-task controls (left) + activity ticker (right) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- User-mediated background controls (e.g. audio transport when Background play is on) -->
                        <ItemsControl Grid.Column="0"
                                      VerticalAlignment="Bottom" Margin="0,0,6,10"
                                      ItemsSource="{Binding MediatedTasks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ctrl:MediatedTaskHost Registration="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Activity ticker -->
                        <ctrl:ActivityTicker Grid.Column="1"
                                             x:Name="ActivityTicker"
                                             Margin="0,0,0,10"
                                             ItemsSource="{Binding BackgroundTasks}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Middle: self-contained ribbon component ── -->
            <Border Grid.Column="1" Background="{StaticResource Chrome.Bg}"
                    BorderBrush="{StaticResource Chrome.Border}"
                    BorderThickness="0,1,0,0">
                <ctrl:RibbonControl x:Name="RibbonControl"
                                    AutomationProperties.AutomationId="RibbonControl"
                                    Runtime="{Binding CurrentRuntime}"
                                    Workspace="{Binding CurrentRuntime.Workspace}"
                                    Workspaces="{Binding Workspaces}"
                                    CanSwitchWorkspace="{Binding CanSwitchWorkspace}"
                                    SelectWorkspaceCommand="{Binding SelectWorkspaceCommand}"
                                    ConfigureWorkspaceCommand="{Binding ConfigureCurrentWorkspaceCommand}"
                                    NewWorkspaceCommand="{Binding NewWorkspaceCommand}"
                                    UseTabsetAsDefaultCommand="{Binding UseTabsetAsDefaultCommand}"
                                    OpenPageCommand="{Binding OpenRibbonItemCommand}"
                                    OpenPageInNewWindowCommand="{Binding OpenRibbonItemInNewWindowCommand}"
                                    Shell="{Binding ShellServices}"/>
            </Border>

            <!-- ── Right: messages + options ── (own token so only the Light theme retints it to the
                 logo-wing tint; every other theme keeps its intentional Chrome.Panel value) -->
            <Border Grid.Column="2"
                    BorderBrush="{StaticResource Chrome.Border}"
                    BorderThickness="1,0,0,0"
                    Background="{StaticResource Chrome.RightPanel}">
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right"
                            Margin="0,0,20,10">

                    <!-- Help: this page's help, opened in the pane beside it (also F1). Pressed again while it
                         shows that page, it closes. -->
                    <Button Style="{StaticResource TopBarAction}"
                            Command="{Binding ToggleHelpCommand}"
                            AutomationProperties.AutomationId="Chrome_HelpButton"
                            AutomationProperties.Name="{loc:Str Shell.Help.Button}"
                            ToolTip="{loc:Str Shell.Help.Tooltip}"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,4">
                        <Border Width="15" Height="15" CornerRadius="7.5"
                                BorderBrush="{StaticResource TextMutedBrush}" BorderThickness="1.2">
                            <TextBlock Text="?" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>

                    <!-- Options button -->
                    <Button Style="{StaticResource TopBarAction}"
                            Command="{Binding ToggleOptionsCommand}"
                            AutomationProperties.AutomationId="Chrome_OptionsButton"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,6">
                        <TextBlock Text="{loc:Str Shell.TopBar.Options}" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    </Button>

                    <!-- Messages + badge -->
                    <Button Style="{StaticResource TopBarAction}"
                            Command="{Binding ToggleNotificationsCommand}"
                            AutomationProperties.AutomationId="NotificationsButton"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2 2h12v9H9l-3 3V11H2z"
                                  Fill="{StaticResource TextMutedBrush}" Width="12" Height="12"
                                  Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="{loc:Str Shell.TopBar.Messages}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,4,0"/>
                            <Border Background="{StaticResource AccentBrush}"
                                    CornerRadius="8" Padding="4,1"
                                    Visibility="{Binding UnreadCount, Converter={StaticResource CountVis}}">
                                <TextBlock Text="{Binding UnreadCount}" Foreground="White"
                                           FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 2 — CONTENT AREA
             PaneView renders the tab strip + breadcrumb + active page.
             The shell hands it the root Pane and the cross-pane commands.
             ═══════════════════════════════════════════════════════════ -->
        <ContentControl Grid.Row="2"
                        x:Name="RootPaneHost"
                        Content="{Binding RootPaneNode}"/>

        <!-- ═══════════════════════════════════════════════════════════
             REPLY CARD — the whole of the AI bar's reply, just above the bar
             Shown on hover over the reply, pinned by a click on it; it blocks
             nothing beside it.
             ═══════════════════════════════════════════════════════════ -->
        <ctrl:AiReplyCard x:Name="ReplyCardView" Grid.Row="0" Grid.RowSpan="4"
                          Panel.ZIndex="100" DataContext="{Binding Ai}"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom"
                          Margin="54,80,12,6" MaxWidth="960"/>

        <!-- Voice mode: what a spoken reply holds that speech cannot carry — a diagram, a table, code — shown over the
             page, which stays usable beneath, until Escape or the end of the conversation puts it away. -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="90"
                      ItemsSource="{Binding Voice.Shown}" Focusable="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PopupBorder}" Padding="10" Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <md:MarkdownSurface Markdown="{Binding Markdown}" VerticalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 3 — DRAG SPLITTER
             ═══════════════════════════════════════════════════════════ -->
        <GridSplitter Grid.Row="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Height="5"
                      Background="Transparent"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeNS"
                      ShowsPreview="False"/>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 4 — AI INTERACTION BAR
             Wrapped as the "AiBar" region: an immersive theme can paint a backdrop here
             independently of the page area. The bar surface comes from the AiBar.Bg veil,
             so the inner Border stays transparent and only keeps the top divider line.
             ═══════════════════════════════════════════════════════════ -->
        <vcc:ThemedRegion Grid.Row="4" Region="AiBar">
        <Border Background="Transparent"
                BorderBrush="{StaticResource AiBar.Border}"
                BorderThickness="0,1,0,0">
            <Grid x:Name="AiBarGrid" Margin="12,5,12,5">
                <!-- Two lines: the AI's above — its status dot, one line of what it is saying or doing, and at its end the workspace's
                     background tasks while it has any — and the user's below, taller — the mic, the box, and Send. The right column
                     stacks the page-context toggle (Queue while a run is in flight) over Send. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>     <!-- status dot / mic                -->
                    <ColumnDefinition Width="*"/>      <!-- the AI's line / the user's box  -->
                    <ColumnDefinition Width="56"/>     <!-- context or queue / send         -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>     <!-- the AI   -->
                    <RowDefinition Height="*"/>        <!-- the user -->
                </Grid.RowDefinitions>

                <!-- Keyboard focus is parked here while the user is idle, so WPF tears down the
                     AI input's caret; see PlaceholderTextBox "Idle caret parking". Zero-sized and
                     Focusable="False" until the moment we park on it, so it can never become the
                     window's default or tab focus - it is a focus target, not a control. -->
                <ContentControl x:Name="AiFocusPark" Grid.Column="0"
                                Focusable="False" IsTabStop="False"
                                Width="0" Height="0"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <!-- The AI's field: its status dot and, while it has something to say, one line beside it in the same field. In voice
                     mode, what it is saying or doing, and an action it is about to do with the buttons that decide it (red while held).
                     Answering a typed request, what it is doing, an approval with Allow and Deny, or the reply — the whole of it in the
                     reply card. With nothing to say it is the field around the dot alone; with a line it grows right
                     across the top (MainWindow.LayOutAiLine). Told from the user's field by the colour of its text and border alone. -->
                <Border x:Name="AiField" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,4" Padding="3,2,3,2"
                        HorizontalAlignment="Left" Width="30"
                        CornerRadius="8" BorderThickness="1" Background="{StaticResource AiBar.InputBg}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Voice.IsActive}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AiBar.Voice.Assistant}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Voice.Confirmation.IsHeld}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <ctrl:AiStatusDot DockPanel.Dock="Left"
                                          IsBusy="{Binding AiIsBusy}"
                                          HandlerSymbol="{Binding AiHandlerSymbol}"
                                          IsListening="{Binding AiIsListening}"
                                          Width="22" Height="22"/>
                        <!-- At the line's right end: the workspace's background tasks — work its assistant left running after replying — while it
                             has any; it opens their list. -->
                        <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="AiBar_BackgroundTasks"
                                Command="{Binding WorkspaceTasks.ToggleCommand}" ToolTip="{loc:Str Shell.BackgroundTasks.Header}"
                                Visibility="{Binding WorkspaceTasks.Any, Converter={StaticResource BoolVis}}"
                                VerticalAlignment="Center" Margin="8,0,2,0" Cursor="Hand" AutomationProperties.Name="{Binding WorkspaceTasks.Label}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="pill" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="8,1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⟳" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="{Binding WorkspaceTasks.Label}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="pill" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Voice.IsConfirming, Converter={StaticResource BoolVis}}">
                                <Button AutomationProperties.AutomationId="AiBar_VoiceStop"
                                        Content="{Binding Voice.Confirmation.StopLabel}" Command="{Binding Voice.StopActionCommand}" Margin="6,0,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryAction}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Voice.Confirmation.IsHeld}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button AutomationProperties.AutomationId="AiBar_VoiceProceed"
                                        Content="{Binding Voice.Confirmation.ProceedLabel}" Command="{Binding Voice.ProceedCommand}"
                                        Style="{StaticResource SecondaryAction}" Margin="6,0,0,0"
                                        Visibility="{Binding Voice.Confirmation.IsHeld, Converter={StaticResource InvBoolVis}}"/>
                            </StackPanel>
                            <Button AutomationProperties.AutomationId="AiBar_VoiceOpenConversation"
                                    Content="{loc:Str Shell.Voice.OpenConversation}" Command="{Binding Voice.OpenInConversationCommand}"
                                    Visibility="{Binding Voice.IsActive, Converter={StaticResource BoolVis}}"
                                    FontSize="11" Padding="8,0" Margin="6,0,0,0" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource AccentBrush}" Cursor="Hand"/>
                        </StackPanel>
                        <!-- Answering a typed request: Allow and Deny for an approval; More and close for a reply. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding Ai.InBar, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Ai.AiOverlayIsApproval, Converter={StaticResource BoolVis}}">
                                <Button AutomationProperties.AutomationId="AiBar_Allow" Content="{loc:Str Shell.AiResponse.Accept}"
                                        Command="{Binding Ai.AcceptToolBatchCommand}" Style="{StaticResource PrimaryAction}" Margin="6,0,0,0"/>
                                <Button AutomationProperties.AutomationId="AiBar_Deny" Content="{loc:Str Shell.AiResponse.Deny}"
                                        Command="{Binding Ai.DenyToolBatchCommand}" Style="{StaticResource SecondaryAction}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Ai.AiOverlayIsMessage, Converter={StaticResource BoolVis}}">
                                <Button AutomationProperties.AutomationId="AiBar_ContinueAsConversation" Content="{loc:Str Shell.AiResponse.ContinueAsConversation}"
                                        Command="{Binding Ai.ContinueAsConversationCommand}"
                                        FontSize="11" Padding="8,0" Margin="6,0,0,0" Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource AccentBrush}" Cursor="Hand"/>
                                <Button AutomationProperties.AutomationId="AiBar_ReplyDismiss" ToolTip="{loc:Str Shell.AiResponse.Dismiss}"
                                        Command="{Binding Ai.CloseAiResponseOverlayCommand}" Style="{StaticResource IconButton}" Margin="2,0,0,0">
                                    <TextBlock Text="✕" FontSize="11"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
<!-- The reply so far on one line: as it outgrows the line, its newest words stay in view and its start fades. The
     spoken conversation's, and a typed request's answer in the bar, each shown while it is the one talking. -->
<Grid>
<vcc:TailClip Margin="8,0" VerticalAlignment="Center" Visibility="{Binding Ai.BarShowsWork, Converter={StaticResource BoolVis}}">
    <TextBlock Text="{Binding Ai.BarLine}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
</vcc:TailClip>
<!-- What was said, from its start: hovering shows the whole of it in the reply card, a click pins the card open. -->
<Button x:Name="AiReplyLine" AutomationProperties.AutomationId="AiBar_Reply" AutomationProperties.Name="{Binding Ai.BarLine}"
        Command="{Binding Ai.Card.TogglePinCommand}" Cursor="Hand" Margin="8,0" VerticalAlignment="Center"
        Visibility="{Binding Ai.BarShowsSaid, Converter={StaticResource BoolVis}}"
        MouseEnter="AiReply_MouseEnter" MouseLeave="AiReply_MouseLeave">
    <Button.Template>
        <ControlTemplate TargetType="Button">
            <TextBlock Text="{Binding Ai.BarLine}" FontSize="13" TextTrimming="CharacterEllipsis" Background="Transparent"
                       Foreground="{StaticResource TextBrush}"/>
        </ControlTemplate>
    </Button.Template>
</Button>
                        <vcc:TailClip Margin="8,0" VerticalAlignment="Center">
<TextBlock AutomationProperties.AutomationId="AiBar_VoiceReply" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Voice.IsActive}" Value="True">
                                            <Setter Property="Text" Value="{Binding Voice.Line}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AiBar.Voice.Assistant}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Voice.IsConfirming}" Value="True">
                                            <Setter Property="Text" Value="{Binding Voice.Confirmation.Text}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Voice.Confirmation.IsHeld}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </vcc:TailClip>
</Grid>
</DockPanel>
                </Border>

                <!-- Top right: the page-context toggle — Queue in its place while a run is in flight (the toggle is locked then). -->
                <Grid Grid.Row="0" Grid.Column="2" Margin="8,0,0,4">
                    <ToggleButton AutomationProperties.AutomationId="AiBar_ContextToggle" ToolTip="{loc:Str Shell.AiBar.IncludeContext}"
                                  IsChecked="{Binding IncludeContext}" Width="Auto" HorizontalAlignment="Stretch"
                                  Visibility="{Binding AiIsBusy, Converter={StaticResource InvBoolVis}}"
                                  Style="{StaticResource ContextToggleButton}">
                        <TextBlock Text="🔗" FontSize="13"/>
                    </ToggleButton>
                    <!-- Queue addendum — visible only while the agent is working; Enter also queues. -->
                    <Button AutomationProperties.AutomationId="AiBar_Queue" VerticalAlignment="Stretch"
                            Cursor="Hand" FontSize="13" Foreground="White"
                            Content="➤＋" ToolTip="{loc:Str Shell.AiBar.Queue}"
                            Command="{Binding SendAiMessageCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="qroot" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="qroot" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AiIsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- The user's line: the mic — a conversation, or dictation where the models cannot hold one — then the box. -->
                <!-- ItemStatus says what the mic would start — True: a conversation, the workspace's speech models
                     confirmed; False: dictation — so automation can wait for the models rather than guess. -->
                <Button Grid.Row="1" Grid.Column="0" AutomationProperties.AutomationId="AiBar_Mic"
                        AutomationProperties.ItemStatus="{Binding VoiceConverses}"
                        Command="{Binding ToggleVoiceCommand}"
                        Width="Auto" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="ToolTip" Value="{loc:Str Shell.AiBar.Voice}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VoiceConverses}" Value="True">
                                    <Setter Property="ToolTip" Value="{loc:Str Shell.AiBar.Converse}"/>
                                </DataTrigger>
                                <!-- Live — dictating or in a conversation: filled red, the sign of a microphone that is on. -->
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="🎙" FontSize="14"/>
                </Button>

            <!-- The user's field: full height out of voice mode; in it, it gives the top line to the AI (MainWindow.LayOutForVoice). -->
                <Border x:Name="UserField" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="6,0,0,0"
                        Background="{StaticResource AiBar.InputBg}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <DockPanel>
                            <!-- The user's last turn, as the assistant was given it: a while, then it fades and gives its line back. -->
                            <TextBlock AutomationProperties.AutomationId="AiBar_VoiceTurn" DockPanel.Dock="Top" Text="{Binding Voice.TurnText}"
                                       FontSize="11" Margin="8,3,28,0" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Voice.IsTurnFresh}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Opacity" Value="0.75"/>
                                                <DataTrigger.EnterActions>
                                                    <RemoveStoryboard BeginStoryboardName="TurnFadesOut"/>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard x:Name="TurnFadesOut">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.75" To="0" Duration="0:0:0.8"/>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Duration="0:0:0.8">
                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.8" Value="{x:Static Visibility.Collapsed}"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ctrl:PlaceholderTextBox
                                x:Name="AiInput"
                                AutomationProperties.AutomationId="AiInputBox"
                                Placeholder="{loc:Str Shell.AiBar.Placeholder}"
                                Text="{Binding AiInputText, UpdateSourceTrigger=PropertyChanged}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                Padding="8,3,28,3"
                                VerticalScrollBarVisibility="Auto"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                SendCommand="{Binding SendAiMessageCommand}"
                                CompletionText="{Binding AiCompletionSuggestion}"
                                CaretBrush="#FFD8D8D8"
                                FocusPark="{Binding ElementName=AiFocusPark}">
                                <ctrl:PlaceholderTextBox.Style>
                                    <Style TargetType="ctrl:PlaceholderTextBox">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AiInputIsAiTyping}" Value="True">
                                                <Setter Property="Foreground" Value="#06b6d4"/>
                                            </DataTrigger>
                                            <!-- Disabled while the AI is processing or the mic is dictating -->
                                            <DataTrigger Binding="{Binding AiIsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDictating}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ctrl:PlaceholderTextBox.Style>
                            </ctrl:PlaceholderTextBox>
                        </DockPanel>

                        <!-- Clear: a red ✕ at the box's right, shown while the pointer is over the box. -->
                        <Button AutomationProperties.AutomationId="AiBar_Clear" ToolTip="{loc:Str Shell.AiBar.Clear}"
                                Command="{Binding ClearAiInputCommand}"
                                IsEnabled="{Binding AiIsBusy, Converter={StaticResource InvBool}}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=UserField}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="✕" FontSize="12"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Send / Cancel (swaps on AiIsBusy); Queue sits above it while busy. -->
                <Button Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="AiBar_Send" Margin="8,0,0,0" MinWidth="48"
                        VerticalAlignment="Stretch" Cursor="Hand" FontSize="16" Foreground="White">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Content" Value="➤"/>
                            <Setter Property="ToolTip" Value="{loc:Str Shell.AiBar.Send}"/>
                            <Setter Property="Command" Value="{Binding SendAiMessageCommand}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="root"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Busy: become a Cancel button (stays enabled while AI processes). -->
                                <DataTrigger Binding="{Binding AiIsBusy}" Value="True">
                                    <Setter Property="Content" Value="■"/>
                                    <Setter Property="ToolTip" Value="{loc:Str Shell.AiBar.Cancel}"/>
                                    <Setter Property="Command" Value="{Binding CancelAiCommand}"/>
                                    <Setter Property="Background" Value="#E11D48"/>
                                </DataTrigger>
                                <!-- Dictating: show a listening icon; click to stop early. A conversation keeps Send — a turn
                                     typed while talking is sent like any other, and the mic ends the conversation. -->
                                <DataTrigger Binding="{Binding IsDictating}" Value="True">
                                    <Setter Property="Content" Value="👂"/>
                                    <Setter Property="ToolTip" Value="{loc:Str Shell.AiBar.Listening}"/>
                                    <Setter Property="Command" Value="{Binding ToggleVoiceCommand}"/>
                                    <Setter Property="Background" Value="#06b6d4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        </vcc:ThemedRegion>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — BACKGROUND TASKS (the AI bar's pill opens it)
             ═══════════════════════════════════════════════════════════ -->
        <!-- Each job the workspace's assistant left running: what it is doing, for how long, and Stop. Clicking off closes it. -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding WorkspaceTasks.IsOpen, Converter={StaticResource BoolVis}}"
                Background="Transparent" Panel.ZIndex="49"
                MouseDown="BackgroundTasksScrim_MouseDown"/>
        <Border Grid.Row="0" Grid.RowSpan="4"
                Visibility="{Binding WorkspaceTasks.IsOpen, Converter={StaticResource BoolVis}}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,12,6" Width="460"
                Style="{StaticResource PopupBorder}"
                Padding="12" Panel.ZIndex="50">
            <StackPanel>
                <TextBlock Text="{loc:Str Shell.BackgroundTasks.Header}" Foreground="{StaticResource TextBrush}"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding WorkspaceTasks.Running}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:BackgroundTask}">
                            <Border Padding="8" CornerRadius="6" Margin="0,2" Background="{StaticResource Surface2Brush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextBrush}"
                                                   FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding ElapsedText}" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" Margin="10,0" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" AutomationProperties.AutomationId="AiBar_BackgroundTaskStop"
                                            Content="{loc:Str Shell.BackgroundTasks.Stop}" Command="{Binding StopCommand}"
                                            Style="{StaticResource TopBarAction}" Padding="10,4" VerticalAlignment="Center"
                                            Foreground="{StaticResource DangerBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — NOTIFICATIONS PANEL
             ═══════════════════════════════════════════════════════════ -->
        <!-- Click-outside scrim: a transparent full-window catch layer below the
             panel that dismisses it when clicked off. -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding NotificationsOpen, Converter={StaticResource BoolVis}}"
                Background="Transparent" Panel.ZIndex="49"
                MouseDown="NotificationScrim_MouseDown"/>
        <Border Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding NotificationsOpen, Converter={StaticResource BoolVis}}"
                AutomationProperties.AutomationId="Chrome_NotificationsPanel"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,87,0,0" Width="640"
                Style="{StaticResource PopupBorder}"
                Padding="12" Panel.ZIndex="50">
            <StackPanel>
                <TextBlock Text="{loc:Str Shell.Notifications.Header}" Foreground="{StaticResource TextBrush}"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Notifications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:NotificationItem}">
                            <Border Padding="8" CornerRadius="6" Margin="0,2"
                                    Background="{StaticResource Surface2Brush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBox Text="{Binding Title}"
                                                 Style="{StaticResource SelectableText}"
                                                 Foreground="{StaticResource TextBrush}"
                                                 FontSize="12" FontWeight="Medium"/>
                                        <TextBox Text="{Binding Body}"
                                                 Style="{StaticResource SelectableText}"
                                                 Foreground="{StaticResource TextMutedBrush}"
                                                 FontSize="11" Margin="0,2,0,0"/>
                                        <!-- Message actions — same actions as the toast, triggerable from the inbox -->
                                        <ItemsControl ItemsSource="{Binding Actions}"
                                                      Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}"
                                                      Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type m:MessageAction}">
                                                    <Button AutomationProperties.AutomationId="Notif_ItemAction" Content="{Binding Label}"
                                                            Style="{StaticResource TopBarAction}"
                                                            Padding="10,4" Margin="0,0,6,0"
                                                            Foreground="{StaticResource TextBrush}"
                                                            Command="{Binding Command}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Button AutomationProperties.AutomationId="Notif_Dismiss" Grid.Column="1" VerticalAlignment="Top"
                                            Style="{StaticResource TopBarAction}"
                                            Command="{Binding DataContext.DismissNotificationCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="✕" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{loc:Str Shell.Notifications.Empty}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,12"
                           Visibility="{Binding Notifications.Count,
                                                Converter={StaticResource ZeroCountVis}}"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY HOST — one ContentControl renders whichever modal is active (ActiveOverlay),
             picked by DataTemplate (defined in Window.Resources above; feature overlays contribute
             their own via IThemeContribution). Built lazily on open, torn down on close. The backdrop
             dims the shell; backdrop-click closes only overlays that opt in via
             IShellOverlay.DismissOnBackdrop.
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="150"
              Visibility="{Binding ActiveOverlay, Converter={StaticResource NullToVis}}">
            <Border Background="{DynamicResource ScrimBrush}" MouseDown="OverlayBackdrop_MouseDown"/>
            <ContentControl Content="{Binding ActiveOverlay}"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             MODAL HOST — the built-in confirmation / prompt (ActiveModal), a layer ABOVE the overlay
             host so a question raised from inside Options or Configure is reachable and answers for a
             panel that is still there behind it (with its unapplied edits) once the question is gone.
             Its backdrop only swallows clicks: these modals dismiss via their own buttons or Escape.
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="160"
              Visibility="{Binding ActiveModal, Converter={StaticResource NullToVis}}">
            <Border Background="{DynamicResource ScrimBrush}"/>
            <ContentControl Content="{Binding ActiveModal}"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — RIBBON EDIT PANEL  (full-screen modal)
             ═══════════════════════════════════════════════════════════ -->
        <!-- Holds nothing until the editor opens: the view (and its icon and colour pickers) is built from the
             template when the ribbon's Editor appears and released when it closes. Tag carries the ribbon width
             into the template, which cannot see this window's names. -->
        <ContentControl x:Name="RibbonEditorHost"
                        Grid.Row="0" Grid.RowSpan="5"
                        Panel.ZIndex="60"
                        Focusable="False"
                        Tag="{Binding ActualWidth, ElementName=RibbonControl}"
                        Content="{Binding ViewModel.Editor, ElementName=RibbonControl}">
            <!-- Keyed by type, not a ContentTemplate: an explicit template is built even for null content. -->
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:RibbonEditorViewModel}">
                    <ctrl:RibbonEditor AutomationProperties.AutomationId="Chrome_RibbonEditor"
                                       RibbonWidth="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>

        <!-- ═══════════════════════════════════════════════════════════
             OVERLAY — TOAST  (transient presentation of the active message)
             Bound to ActiveToast; severity drives the colour/icon. Renders the
             message's actions as buttons. Auto-dismisses (duration by severity).
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Visibility="{Binding DataContext.ToastVisible, RelativeSource={RelativeSource AncestorType=Window},
                                     Converter={StaticResource BoolVis}}"
                DataContext="{Binding ActiveToast}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,110"
                MaxWidth="460"
                Panel.ZIndex="210"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14">
            <Border.Style>
                <!-- Theme-driven: popup surface + a severity-coloured border, drawn from
                     semantic theme brushes so every theme retints it. Info = accent. -->
                <Style TargetType="Border" BasedOn="{StaticResource PopupBorder}">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Update">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>

                        <!-- Fade-out tail: opacity 1→0 over 2s once the visible duration elapses; reset to 1
                             when a fresh toast takes over (ToastFading back to false). -->
                        <DataTrigger Binding="{Binding DataContext.ToastFading, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: severity icon + title + close -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="ℹ"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter Property="Text" Value="⚠"/>
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                        <Setter Property="Text" Value="⚠"/>
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Update">
                                        <Setter Property="Text" Value="⬆"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    <Button AutomationProperties.AutomationId="Toast_Dismiss" Grid.Column="2" VerticalAlignment="Top"
                            Style="{StaticResource TopBarAction}"
                            Margin="10,0,0,0"
                            Command="{Binding DataContext.DismissActiveToastCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </Grid>

                <!-- Body (scrollable — long changelogs) -->
                <ScrollViewer Grid.Row="1"
                              MaxHeight="120"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,10,0,0">
                    <TextBlock Text="{Binding Body}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <!-- Action buttons (from the message's Actions) -->
                <ItemsControl Grid.Row="2"
                              Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}"
                              ItemsSource="{Binding Actions}"
                              Margin="0,12,0,0" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:MessageAction}">
                            <Button AutomationProperties.AutomationId="Toast_Action" Content="{Binding Label}"
                                    Padding="12,5" Margin="8,0,0,0"
                                    Foreground="{StaticResource TextBrush}"
                                    Command="{Binding DataContext.RunToastActionCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TopBarAction}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

    </Grid>
</Window>
