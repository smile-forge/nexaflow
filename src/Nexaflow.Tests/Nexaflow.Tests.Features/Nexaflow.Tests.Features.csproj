<Project Sdk="Microsoft.NET.Sdk">

  <!-- What is left once the viewers and the Windows-integration features moved to their own suites: the
       shell-adjacent features — AI chat, the console, network discovery, OneDrive, the product and project
       managers, the scratchpad, the web viewer, This PC — plus the generic search plumbing (query syntax,
       term parsing, the conformance guard) that belongs to no single feature.

       Sibling suites: Nexaflow.Tests.Features.Viewers, .WindowsOS, .Architecture; shared support in
       .Common. Add a new feature's tests to whichever suite matches its subject. -->
  <PropertyGroup>
    <!-- Pinned to the WinRT platform version so all four suites share one target with the support library
         (Nexaflow.Features.WindowsApps, over in .WindowsOS, is what forces it). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.3.2" />
    <PackageReference Include="NSubstitute" Version="6.0.0" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Author-time coverage-declaration checks (NXCOV001/2). The tree feeds id-validity; absent on a
         clean checkout (gitignored), where the analyzer degrades to the presence check only. -->
    <ProjectReference Include="..\..\Nexaflow.Analyzers\Nexaflow.Analyzers.Coverage\Nexaflow.Analyzers.Coverage.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\.product\tree.json')">
    <AdditionalFiles Include="..\..\..\.product\tree.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.Tests.Features.Common\Nexaflow.Tests.Features.Common.csproj" />
    <ProjectReference Include="..\Nexaflow.Tests.Fixtures\Nexaflow.Tests.Fixtures.csproj" />

    <ProjectReference Include="..\..\Nexaflow.Elevation\Nexaflow.Elevation.Contracts\Nexaflow.Elevation.Contracts.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Network\Nexaflow.IO.Network.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Terminal\Nexaflow.IO.Terminal.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Search\Nexaflow.Search.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Services.Initiatives\Nexaflow.Services.Initiatives.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Services.Initiatives.Cli\Nexaflow.Services.Initiatives.Cli.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Visuals.Terminal\Nexaflow.Visuals.Terminal.csproj" />

    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.Common\Nexaflow.Features.Common.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.AIChat\Nexaflow.Features.AIChat.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.Console\Nexaflow.Features.Console.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.Network\Nexaflow.Features.Network.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.Network.Arp\Nexaflow.Features.Network.Arp.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.Network.Ssdp\Nexaflow.Features.Network.Ssdp.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.Network.Actions\Nexaflow.Features.Network.Actions.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.OneDrive\Nexaflow.Features.OneDrive.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.ProductManager\Nexaflow.Features.ProductManager.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.Projects\Nexaflow.Features.Projects.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.Scratchpad\Nexaflow.Features.Scratchpad.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Features\Nexaflow.Features.Web\Nexaflow.Features.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
