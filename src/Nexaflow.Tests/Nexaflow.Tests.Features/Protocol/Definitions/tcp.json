      },
      "about": "RFC 9293 §3.1: 'The source port number.' 16 bits."
    },
    {
      "id": "destinationPort",
      "kind": "field",
      "as": "Destination Port",
      "form": {
        "of": "scalar",
        "octets": 2,
        "big": true,
        "signed": false
      },
      "about": "RFC 9293 §3.1: 'The destination port number.' 16 bits."
    },
    {
      "id": "sequenceNumber",
      "kind": "field",
      "as": "Sequence Number",
      "form": {
        "of": "scalar",
        "octets": 4,
        "big": true,
        "signed": false
      },
      "about": [
        "RFC 9293 §3.1: the sequence number of the first data octet in this segment, except that when SYN",
        "is set it is the initial sequence number and the first data octet is ISN+1."
      ]
    },
    {
      "id": "acknowledgmentNumber",
      "kind": "field",
      "as": "Acknowledgment Number",
      "form": {
        "of": "scalar",
        "octets": 4,
        "big": true,
        "signed": false
      },
      "about": [
        "RFC 9293 §3.1: the next sequence number the sender expects. Significant only when ACK is set.",
        "",
        "A DIFFERENT NODE from the ACK control bit, though a reader skimming would call both 'ack'. One is",
        "a 32-bit number and the other is one bit saying whether that number means anything. Same syllable,",
        "unrelated concepts, so they are not the same field."
      ]
    },
    {
      "id": "dataOffset",
      "kind": "field",
      "as": "Data Offset",
      "form": {
