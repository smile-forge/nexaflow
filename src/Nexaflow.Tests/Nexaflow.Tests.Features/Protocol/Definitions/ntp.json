{
  "protocol": "ntp",
  "title": "Network Time Protocol, version 4",
  "source": "RFC 5905",
  "about": [
    "Authored against RFC 5905 §7.3 and checked against real captures. Every field is fixed width and",
    "the packet is exactly 48 octets, so nothing here measures anything — which makes it the smallest",
    "honest test of the graph after TCP: no lengths, no options, no repetition, and one octet that is",
    "three separately-named runs of bits."
  ],
  "nodes": [
    {
      "id": "ntp",
      "kind": "protocol",
      "as": "Network Time Protocol",
      "about": [
        "RFC 5905 §7.3, 'Packet Header Format'. One format: a client request and a server response are the",
        "same 48 octets differing in Mode, not two shapes. So one message node, and Mode is an ordinary field."
      ]
    },
    {
      "id": "packet",
      "kind": "message",
      "as": "NTP packet"
    },
    {
      "id": "packing.packet",
      "kind": "packing",
      "as": "the one arrangement"
    },
    {
      "id": "header",
      "kind": "set",
      "as": "NTP Header",
      "about": [
        "The whole of it. NTP has no length field and no options in the base packet — every field is fixed",
        "and the header is exactly 48 octets, which is why nothing here measures anything."
      ]
    },
    {
      "id": "liVnMode",
      "kind": "set",
      "as": "LI | VN | Mode",
      "about": [
        "RFC 5905 §7.3 draws these as one octet split 2|3|3, and the corpus breakdown reads it that way too.",
        "A set of three fields rather than one field holding three numbers: each is separately named, separately",
        "meaningful, and separately something an edge can point at."
      ]
    },
    {
      "id": "leapIndicator",
      "kind": "field",
      "as": "LI",
      "form": {
        "of": "run",
        "bits": 2
      },
      "about": "Leap Indicator: warns of a leap second at the end of the day."
    },
    {
      "id": "versionNumber",
      "kind": "field",
      "as": "VN",
      "form": {
        "of": "run",
        "bits": 3
      },
      "about": "Version number — 4 for NTPv4."
    },
    {
      "id": "mode",
      "kind": "field",
      "as": "Mode",
      "form": {
        "of": "run",
        "bits": 3
      },
      "about": "What this packet is: 3 is a client request, 4 a server response."
    },
    {
      "id": "stratum",
      "kind": "field",
      "as": "Stratum",
      "form": {
        "of": "scalar",
        "octets": 1,
        "big": true,
        "signed": false
      },
      "about": "Distance from a reference clock. 0 is unspecified, 1 is primary."
    },
    {
      "id": "poll",
      "kind": "field",
      "as": "Poll",
      "form": {
        "of": "scalar",
        "octets": 1,
        "big": true,
        "signed": true
      },
      "about": "Log2 of the maximum interval between messages, in seconds. Signed."
    },
    {
      "id": "precision",
      "kind": "field",
      "as": "Precision",
      "form": {
        "of": "scalar",
        "octets": 1,
        "big": true,
        "signed": true
      },
      "about": "Log2 of the local clock precision, in seconds. Signed, and negative in practice."
    },
    {
      "id": "referenceId",
      "kind": "field",
      "as": "Reference ID",
      "form": {
        "of": "opaque",
        "octets": 4
      },
      "about": [
        "Four octets whose meaning depends on the stratum — an IPv4 address at stratum 2 and above, four",
        "characters of a source name at stratum 1, a kiss code on a KoD packet. Opaque because it is not one",
        "kind of value: reading it as a number would be picking one of those readings and calling it true."
      ]
    },
    {
      "id": "rootDelay",
      "kind": "set",
      "as": "Root Delay",
      "about": "NTP short format: 16 bits of seconds, 16 of fraction."
    },
    {
      "id": "rootDelay.seconds",
      "kind": "field",
      "as": "Root Delay (seconds)",
      "form": {
        "of": "scalar",
        "octets": 2,
        "big": true,
        "signed": false
      }
    },
    {
      "id": "rootDelay.fraction",
      "kind": "field",
      "as": "Root Delay (fraction)",
      "form": {
        "of": "scalar",
        "octets": 2,
        "big": true,
        "signed": false
      }
    },
    {
      "id": "rootDispersion",
      "kind": "set",
      "as": "Root Dispersion",
      "about": "The same short format."
    },
    {
      "id": "rootDispersion.seconds",
      "kind": "field",
      "as": "Root Dispersion (seconds)",
      "form": {
        "of": "scalar",
        "octets": 2,
        "big": true,
        "signed": false
      }
    },
    {
      "id": "rootDispersion.fraction",
      "kind": "field",
      "as": "Root Dispersion (fraction)",
      "form": {
        "of": "scalar",
        "octets": 2,
        "big": true,
        "signed": false
      }
    },
    {
      "id": "referenceTimestamp",
      "kind": "set",
      "as": "Reference Timestamp",
      "about": "NTP timestamp: 32 bits of seconds since 1900, 32 of fraction."
    },
    {
      "id": "referenceTimestamp.seconds",
      "kind": "field",
      "as": "Reference Timestamp (seconds)",
      "form": {
        "of": "scalar",
        "octets": 4,
        "big": true,
        "signed": false
      }
    },
    {
      "id": "referenceTimestamp.fraction",
      "kind": "field",
      "as": "Reference Timestamp (fraction)",
      "form": {
        "of": "scalar",
        "octets": 4,
        "big": true,
        "signed": false
      }
    },
    {
      "id": "originTimestamp",
      "kind": "set",
      "as": "Origin Timestamp",
      "about": "The client transmit time, echoed back verbatim by the server."
    },
    {
      "id": "originTimestamp.seconds",
      "kind": "field",
      "as": "Origin Timestamp (seconds)",
      "form": {
        "of": "scalar",
        "octets": 4,
        "big": true,
        "signed": false
      }
    },
    {
      "id": "originTimestamp.fraction",
      "kind": "field",
      "as": "Origin Timestamp (fraction)",
      "form": {
        "of": "scalar",
        "octets": 4,
        "big": true,
        "signed": false
      }
    },
    {
      "id": "receiveTimestamp",
      "kind": "set",
      "as": "Receive Timestamp",
      "about": "When the packet arrived."
    },
    {
      "id": "receiveTimestamp.seconds",
      "kind": "field",
      "as": "Receive Timestamp (seconds)",
      "form": {
        "of": "scalar",
        "octets": 4,
        "big": true,
        "signed": false
      }
    },
    {
      "id": "receiveTimestamp.fraction",
      "kind": "field",
      "as": "Receive Timestamp (fraction)",
      "form": {
        "of": "scalar",
        "octets": 4,
        "big": true,
        "signed": false
      }
    },
    {
      "id": "transmitTimestamp",
      "kind": "set",
      "as": "Transmit Timestamp",
      "about": "When the packet left."
    },
    {
      "id": "transmitTimestamp.seconds",
      "kind": "field",
      "as": "Transmit Timestamp (seconds)",
      "form": {
        "of": "scalar",
        "octets": 4,
        "big": true,
        "signed": false
      }
    },
