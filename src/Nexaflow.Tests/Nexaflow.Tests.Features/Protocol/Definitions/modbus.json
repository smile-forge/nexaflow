      "as": "Starting Address",
      "purpose": "The value of Starting Address."
    },
    {
      "id": "input.quantityOfRegisters",
      "kind": "input",
      "as": "Quantity of Registers",
      "purpose": "The value of Quantity of Registers."
    },
    {
      "id": "input.byteCount",
      "kind": "input",
      "as": "Byte Count",
      "purpose": "The value of Byte Count."
    },
    {
      "id": "input.registers",
      "kind": "input",
      "as": "Register values",
      "purpose": "The value of Register values."
    },
    {
      "id": "input.exceptionCode",
      "kind": "input",
      "as": "Exception Code",
      "purpose": "The value of Exception Code."
    },
    {
      "id": "validator.protocolId",
      "kind": "validator",
      "because": "The protocol identifier is zero for Modbus.",
      "ranges": [
        {
          "from": {
            "int": 0
          },
          "to": {
            "int": 0
          }
        }
      ]
    }
  ],
