<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Nexaflow.Maths — the LaTeX parse tree, its printer, and what it knows about commands.

    The same shape as Nexaflow.Tests.IO and Nexaflow.Tests.Initiatives: the subject is a WPF-free
    library, so the suite is one too. Plain net10.0, no desktop session, no shell, and no reference to
    anything that would need one. That is not tidiness — it is what lets the parser be exercised over a
    quarter of a million formulas without a window ever opening.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Author-time coverage-declaration checks (NXCOV001/2). -->
    <ProjectReference Include="..\..\Nexaflow.Analyzers\Nexaflow.Analyzers.Coverage\Nexaflow.Analyzers.Coverage.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\.product\tree.json')">
    <AdditionalFiles Include="..\..\..\.product\tree.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The subject, and the shared construct list + [CoversNode]. -->
    <ProjectReference Include="..\..\Nexaflow.Maths\Nexaflow.Maths.csproj" />
    <ProjectReference Include="..\Nexaflow.Tests.Fixtures\Nexaflow.Tests.Fixtures.csproj" />
    <!-- An oracle, not a dependency of the subject. AngouriMath writes LaTeX and knows exactly what
         structure it wrote, which makes it a better check on the parse tree than the typesetter — whose
         own tree is lossy and whose spans are the thing being replaced. WPF-free, like this suite. -->
    <ProjectReference Include="..\..\..\external\AngouriMath\Sources\AngouriMath\AngouriMath.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
