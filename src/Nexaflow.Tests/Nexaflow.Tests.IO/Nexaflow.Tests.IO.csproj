<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows because Nexaflow.IO.Network reads real adapters and Nexaflow.IO.Terminal is
         ConPTY; Common, Pe and Protocol are plain net10.0 and want nothing from Windows. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real wire captures for ten protocols, each with a byte-level field breakdown. The DynamicProtocol
         engine is developed against these: a grammar that cannot decode AND re-encode them is not a
         grammar, it is a hope. Static data, so checked in rather than generated by Tests.Fixtures. -->
    <Content Include="Protocol\Corpus\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- Protocols, as protocol graphs. These are the definition itself rather than a rendering of one:
         authored against the RFC directly, so nothing in them is shaped by what some earlier document
         format could spell. -->
    <Content Include="Protocol\Definitions\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Author-time coverage-declaration checks (NXCOV001/2). The tree feeds id-validity; absent on a
         clean checkout (gitignored), where the analyzer degrades to the presence check only. -->
    <ProjectReference Include="..\..\Nexaflow.Analyzers\Nexaflow.Analyzers.Coverage\Nexaflow.Analyzers.Coverage.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\.product\tree.json')">
    <AdditionalFiles Include="..\..\..\.product\tree.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The subjects. Nothing else: no Core, no Features, no Visuals — which is the point of the split,
         and what keeps these tests runnable without a desktop session or a shell. -->
    <ProjectReference Include="..\..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Network\Nexaflow.IO.Network.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Pe\Nexaflow.IO.Pe.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Protocol\Nexaflow.IO.Protocol.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Terminal\Nexaflow.IO.Terminal.csproj" />

    <!-- Shared, git-ignored sample-file dataset (TestSampleData / ISampleSet), and the [CoversNode] /
         [NoCoverage] attributes every test class declares its coverage with. -->
    <ProjectReference Include="..\Nexaflow.Tests.Fixtures\Nexaflow.Tests.Fixtures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
