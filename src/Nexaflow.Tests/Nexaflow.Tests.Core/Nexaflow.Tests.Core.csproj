  <ItemGroup>
    <ProjectReference Include="..\..\Nexaflow.Core\Nexaflow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
