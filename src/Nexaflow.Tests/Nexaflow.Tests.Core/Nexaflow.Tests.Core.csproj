<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches Core's OS target (Core transitively pulls in the WinRT WindowsApps feature). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- AiPaths runs the agent loop on Nexaflow's own model, in the AI host — copied into AiHost\ beside these tests,
         as it sits beside the app. -->
    <ProjectReference Include="..\..\Nexaflow.AiHost\Nexaflow.AiHost\Nexaflow.AiHost.csproj" ReferenceOutputAssembly="false" Private="false" HelperFolder="AiHost" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <!-- Speech made on the spot for the AI-path suite: a model hearing a recording is shown by what it heard. -->
    <PackageReference Include="System.Speech" Version="10.0.11" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.Tests.Fixtures\Nexaflow.Tests.Fixtures.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Core\Nexaflow.Core.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Visuals.Text\Nexaflow.Visuals.Text.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Visuals.Web\Nexaflow.Visuals.Web.csproj" />
    <!-- Author-time coverage-declaration checks (NXCOV001/2). The tree feeds id-validity; absent on a
         clean checkout (gitignored), where the analyzer degrades to the presence check only. -->
    <ProjectReference Include="..\..\Nexaflow.Analyzers\Nexaflow.Analyzers.Coverage\Nexaflow.Analyzers.Coverage.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\.product\tree.json')">
    <AdditionalFiles Include="..\..\..\.product\tree.json" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <!-- The same Languages\ folder the app gets, so the localization tests read the packs that actually ship. -->
  <Import Project="..\..\Nexaflow.Languages\LanguagePacks.Deploy.targets" />

</Project>
