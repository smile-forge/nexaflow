<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Nexaflow.Markdown — the formal syntax tree every rendered language is read into, the pipeline of
    stages that re-read it, and the per-language parsers that feed it.

    The same shape as Nexaflow.Tests.Maths and Nexaflow.Tests.IO: the subject is a WPF-free library, so
    the suite is one too. Plain net10.0, no desktop session, no shell, and no reference to anything that
    would need one. That is not tidiness — it is what lets a parser be exercised over ten thousand real
    tunes without a window ever opening.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Author-time coverage-declaration checks (NXCOV001/2). -->
    <ProjectReference Include="..\..\Nexaflow.Analyzers\Nexaflow.Analyzers.Coverage\Nexaflow.Analyzers.Coverage.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\.product\tree.json')">
    <AdditionalFiles Include="..\..\..\.product\tree.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Nexaflow.Markdown\Nexaflow.Markdown.csproj" />
    <ProjectReference Include="..\Nexaflow.Tests.Fixtures\Nexaflow.Tests.Fixtures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
