<UserControl x:Class="Nexaflow.Visuals.Common.Controls.SearchStatusChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexaflow.Visuals.Common.Converters"
             x:Name="Self">

    <!-- The converter is declared here rather than borrowed from the host: pages key it differently
         (BoolVis / BoolToVis), and a shared control must not depend on which name its host happened
         to pick. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="ChipVis"/>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                AutomationProperties.AutomationId="{Binding AutomationIdStatus, ElementName=Self}"
                Visibility="{Binding IsSearchActive, Converter={StaticResource ChipVis}}">

        <!-- Count first: the answer to "did ? find anything". SuffixText carries a "+" when the page
             stopped scanning early, so a floor never reads as an exact total. -->
        <TextBlock Text="{Binding SearchMatchCount, StringFormat='{}{0} match(es)'}"
                   AutomationProperties.AutomationId="{Binding AutomationIdMatchCount, ElementName=Self}"
                   Foreground="{DynamicResource AccentBrush}" FontSize="11"
                   VerticalAlignment="Center"/>
        <TextBlock Text="{Binding SuffixText, ElementName=Self}"
                   Foreground="{DynamicResource AccentBrush}" FontSize="11"
                   VerticalAlignment="Center"/>

        <TextBlock Text="{Binding CurrentSearchTerm, StringFormat=' for {0}'}"
                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                   MaxWidth="220" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center"/>

        <!-- Stepping only appears when there is something to step through; dismiss stays available so
             a zero-match search ("no matches for X" — still a result) can be cleared. -->
        <Button Style="{DynamicResource TbBtn}" Content="&#x2039;" Padding="6,0" Margin="8,0,0,0"
                AutomationProperties.AutomationId="{Binding AutomationIdPrevious, ElementName=Self}"
                ToolTip="Previous match"
                Visibility="{Binding HasSearchMatches, Converter={StaticResource ChipVis}}"
                Command="{Binding FindPreviousMatchCommand}"/>
        <Button Style="{DynamicResource TbBtn}" Content="&#x203A;" Padding="6,0"
                AutomationProperties.AutomationId="{Binding AutomationIdNext, ElementName=Self}"
                ToolTip="Next match"
                Visibility="{Binding HasSearchMatches, Converter={StaticResource ChipVis}}"
                Command="{Binding FindNextMatchCommand}"/>
        <Button Style="{DynamicResource TbBtn}" Content="&#x2715;" Padding="6,0"
                AutomationProperties.AutomationId="{Binding AutomationIdClear, ElementName=Self}"
                ToolTip="Clear the search"
                Command="{Binding ClearSearchCommand}"/>
    </StackPanel>
</UserControl>
