<UserControl x:Class="Nexaflow.Visuals.Common.Controls.ConfirmationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexaflow.Visuals.Common.Converters"
             x:Name="Self">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <!-- Scrim (#CC000000 is the sanctioned modal-scrim literal) + centered card. Collapsed when there
         is no request (binding FallbackValue) or the request has been answered (IsOpen=false). -->
    <Border Background="#CC000000"
            Visibility="{Binding Request.IsOpen, ElementName=Self,
                                 Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" MinWidth="330" MaxWidth="460" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel DataContext="{Binding Request, ElementName=Self}">
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}"
                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Prompt}" Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                        Style="{DynamicResource GhostButton}" Margin="0,0,0,6"/>
                <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}"
                        Style="{DynamicResource GhostButton}"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
