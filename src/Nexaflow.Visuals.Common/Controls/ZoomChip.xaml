<UserControl x:Class="Nexaflow.Visuals.Common.Controls.ZoomChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">

    <UserControl.Resources>
        <!-- The preset rows. Keyed rather than implicit so it cannot leak onto a host's buttons, and
             declared here rather than borrowed, for the same reason SearchStatusChip declares its own
             converter: a shared control must not depend on what its host happened to name things. -->
        <Style x:Key="ZoomPresetButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- The percentage doubles as the button that opens the presets: it is already the thing you
             look at to read the zoom, so it is where you reach to change it. -->
        <TextBlock x:Name="ZoomLabel"
                   Text="{Binding Zoom.Percent, ElementName=Self, StringFormat='{}{0}%'}"
                   AutomationProperties.AutomationId="{Binding AutomationIdLabel, ElementName=Self}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="11"
                   VerticalAlignment="Center"
                   Padding="6,3"
                   Cursor="Hand"
                   ToolTip="Click to set zoom (Ctrl+scroll, Ctrl+0 resets)"
                   MouseLeftButtonUp="ZoomLabel_Click"/>

        <Popup x:Name="ZoomPopup"
               PlacementTarget="{Binding ElementName=ZoomLabel}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="-4" VerticalOffset="-4">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4">
                <StackPanel x:Name="PresetPanel"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
