<UserControl x:Class="Nexaflow.Visuals.Common.Drafts.DraftBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization">

    <!-- The DataContext is the page's DraftSaving, null for a file opened where it lives: the banner shows only for a draft. -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1" Padding="12,6">
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{DynamicResource TbBtn}" Padding="10,2" Margin="12,0,0,0"
                    Command="{Binding SaveAsCommand}"
                    AutomationProperties.AutomationId="Draft_SaveAs"
                    Content="{loc:Str Common.Draft.SaveAs}" ToolTip="{loc:Str Common.Draft.SaveAsTip}"/>
            <TextBlock Text="{loc:Str Common.Draft.Notice}" Foreground="{DynamicResource TextBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Border>
</UserControl>
