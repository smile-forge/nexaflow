<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Nexaflow.Visuals.Common.Controls">

    <!-- ThemedRegion: scene (bottom) → backdrop veil (middle) → content (top).
         Stretch content by default so wrapping a region never alters its layout. -->
    <Style TargetType="{x:Type c:ThemedRegion}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ThemedRegion}">
                    <Grid ClipToBounds="True">
                        <ContentControl x:Name="PART_Scene"
                                        Focusable="False"
                                        IsHitTestVisible="False"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                        <Border x:Name="PART_Backdrop"/>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- VerticalTabItem: a full-width rail row with a selection accent bar on its leading edge.
         Theme brushes resolve with DynamicResource, not StaticResource: this dictionary is compiled
         into the library and merged before the app's theme, so the keys do not exist yet at parse
         time — and DynamicResource is also what lets a live theme switch retint the rail. -->
    <Style TargetType="{x:Type c:VerticalTabItem}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:VerticalTabItem}">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="bar" Grid.Column="0" Background="Transparent"
                                    CornerRadius="2" Margin="0,5"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" Margin="12,9"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd"  Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            <Setter TargetName="bar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- VerticalTabControl: left nav rail + bordered content surface. -->
    <Style TargetType="{x:Type c:VerticalTabControl}">
        <!-- Declared here rather than only in the constructor so the value survives a consumer
             applying its own Style. Without Stretch the hosted page is measured at its natural
             width, so star columns collapse to content and a page's scrollbar floats mid-panel. -->
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:VerticalTabControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding RailWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="HeaderPanel" Grid.Column="0" IsItemsHost="True"
                                    VerticalAlignment="Top" Margin="0,0,12,0"/>
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" ClipToBounds="True">
                            <!--
                                The alignments are set literally, and that is load-bearing.
                                A ContentPresenter inside a ControlTemplate does not simply default
                                to Stretch: it *implicitly aliases* several properties to the
                                templated parent, and that aliasing covers HorizontalAlignment ←
                                HorizontalContentAlignment (and the vertical pair). Since Control
                                defaults HorizontalContentAlignment to Left, the hosted page was
                                measured at its natural width — star columns collapsed to content
                                and page scrollbars floated mid-panel.
                                Writing nothing here does NOT disable that alias; only a local value
                                overrides it. Do not "simplify" these away.
                            -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ModalCard: the shared chrome of a tab-modal form — a scrim that swallows clicks and a centred card.
         Only the chrome lives here; the form's content, bindings and AutomationIds stay the feature's. A
         yes/no question is not a form: it goes through IShellServices (arch review §E1). Tab cycles inside
         the card so a keyboard user can't wander into the page it covers. -->
    <Style TargetType="{x:Type c:ModalCard}">
        <Setter Property="Padding" Value="20"/>
        <!-- The card's own surface; a form designed on another (Surface2) sets Background. The scrim is
             always the theme's ScrimBrush. -->
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:ModalCard}">
                    <Border Background="{DynamicResource ScrimBrush}">
                        <Border x:Name="PART_Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Width="{TemplateBinding CardWidth}" MinWidth="{TemplateBinding CardMinWidth}"
                                MaxWidth="{TemplateBinding CardMaxWidth}" MaxHeight="{TemplateBinding CardMaxHeight}"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <DockPanel>
                                <ContentPresenter x:Name="PART_Header" DockPanel.Dock="Top" ContentSource="Header"
                                                  Margin="0,0,0,10" TextElement.FontSize="14"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="{DynamicResource TextBrush}"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="PART_Header" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Tone" Value="Accent">
                            <Setter TargetName="PART_Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="Tone" Value="Danger">
                            <Setter TargetName="PART_Card" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Closed: collapsed, so it takes no layout and blocks nothing behind it. -->
            <Trigger Property="IsOpen" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- RangeSlider: a rail, the band between its ends in the accent at a low alpha, and an accent bar at each end. The rail is
         the control's Background and the accent its Foreground, so a host lays something of its own under a transparent rail. -->
    <Style TargetType="{x:Type c:RangeSlider}">
        <Setter Property="Height"     Value="22"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:RangeSlider}">
                    <Grid x:Name="PART_Rail" Background="Transparent">
                        <Border Height="{TemplateBinding RailHeight}" CornerRadius="2" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"/>
                        <Canvas>
                            <Thumb x:Name="PART_Span" Cursor="SizeAll" Focusable="False"
                                   Height="{Binding ActualHeight, ElementName=PART_Rail}">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" BorderThickness="1" BorderBrush="{TemplateBinding Foreground}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding Foreground.Color, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0.28"/>
                                            </Border.Background>
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <c:RangeThumb x:Name="PART_Lower" Width="8" Cursor="SizeWE"
                                          Height="{Binding ActualHeight, ElementName=PART_Rail}">
                                <c:RangeThumb.Template>
                                    <ControlTemplate TargetType="c:RangeThumb">
                                        <Border CornerRadius="3" Background="{TemplateBinding Foreground}"
                                                BorderBrush="{DynamicResource OnAccentBrush}" BorderThickness="1"/>
                                    </ControlTemplate>
                                </c:RangeThumb.Template>
                            </c:RangeThumb>
                            <c:RangeThumb x:Name="PART_Upper" Width="8" Cursor="SizeWE"
                                          Height="{Binding ActualHeight, ElementName=PART_Rail}">
                                <c:RangeThumb.Template>
                                    <ControlTemplate TargetType="c:RangeThumb">
                                        <Border CornerRadius="3" Background="{TemplateBinding Foreground}"
                                                BorderBrush="{DynamicResource OnAccentBrush}" BorderThickness="1"/>
                                    </ControlTemplate>
                                </c:RangeThumb.Template>
                            </c:RangeThumb>
                        </Canvas>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
