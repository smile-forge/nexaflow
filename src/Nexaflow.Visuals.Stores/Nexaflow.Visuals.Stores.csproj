<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A file browser over any IFileStore (Nexaflow.IO.Common.Stores): a USB drive's volumes, a phone over MTP. The tree,
    the list, the path bar, the menus, keys and drag-and-drop, and the changes — copies both ways, each read back and
    checked, new folders, renames and deletes. What hosts it (a live tool on the device page) supplies the store and
    the questions; it never knows which store it is browsing.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
    <ProjectReference Include="..\Nexaflow.Visuals.Common\Nexaflow.Visuals.Common.csproj" />
    <ProjectReference Include="..\Nexaflow.Visuals.Icons\Nexaflow.Visuals.Icons.csproj" />
  </ItemGroup>

</Project>
