<UserControl x:Class="Nexaflow.Visuals.Text.Pages.PageReadingPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <!-- The text of pages read into Markdown (PageReadingPanel): what the reading is doing, then the text as it comes. -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="12,8,8,6">
                <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" Style="{StaticResource RowButton}"
                        ToolTip="{loc:Str Text.PageReading.CloseTip}"
                        AutomationProperties.AutomationId="PageReading_Close" AutomationProperties.Name="{loc:Str Text.PageReading.CloseTip}">
                    <TextBlock Text="✕" FontSize="11"/>
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding SaveCommand}" Style="{StaticResource RowButton}" Margin="0,0,6,0"
                        ToolTip="{loc:Str Text.PageReading.SaveTip}" AutomationProperties.AutomationId="PageReading_Save">
                    <TextBlock Text="{loc:Str Text.PageReading.Save}"/>
                </Button>
                <Button DockPanel.Dock="Right" Command="{Binding CopyCommand}" Style="{StaticResource RowButton}" Margin="0,0,6,0"
                        ToolTip="{loc:Str Text.PageReading.CopyTip}" AutomationProperties.AutomationId="PageReading_Copy">
                    <TextBlock Text="{loc:Str Text.PageReading.Copy}"/>
                </Button>
                <TextBlock Text="{loc:Str Text.PageReading.Heading}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}"/>
            </DockPanel>

            <!-- What the reading is doing: reading, waiting on its download, or why there is no text. -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Surface2Brush}" Padding="12,6"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding DownloadCommand}" Style="{StaticResource RowButton}" Margin="8,0,0,0"
                            Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="PageReading_Download">
                        <TextBlock Text="{loc:Str Text.PageReading.Download}"/>
                    </Button>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <md:MarkdownSurface Markdown="{Binding Markdown}" BaseDirectory="{Binding Folder}" VerticalScrollBarVisibility="Auto"
                                AutomationProperties.AutomationId="PageReading_Text"/>
        </DockPanel>
    </Border>
</UserControl>
