<UserControl x:Class="Nexaflow.Visuals.Text.Pages.PageConversionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <!-- What converting pages to Markdown (PageConversion) is doing: reading, waiting on its download, or why it could not. -->
    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
        <DockPanel>
            <Button DockPanel.Dock="Right" Command="{Binding StopCommand}" Style="{StaticResource RowButton}" Margin="8,0,0,0"
                    ToolTip="{loc:Str Text.PageReading.StopTip}"
                    Visibility="{Binding IsReading, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="PageConversion_Stop">
                <TextBlock Text="{loc:Str Text.PageReading.Stop}"/>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding DownloadCommand}" Style="{StaticResource RowButton}" Margin="8,0,0,0"
                    Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.AutomationId="PageConversion_Download">
                <TextBlock Text="{loc:Str Text.PageReading.Download}"/>
            </Button>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="PageConversion_Status"/>
        </DockPanel>
    </Border>
</UserControl>
