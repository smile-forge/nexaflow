<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bravura (SMuFL music font, SIL OFL 1.1) — the native score engraver draws its glyphs. Bundled as
         an asset (not a submodule: it's a font, not ProjectReference'd source) and copied beside the
         assembly so WpfScoreRenderer can load a GlyphTypeface from disk (works headless + in-app).
         Flows transitively into the host app's output. License: MusicFonts\Bravura-OFL.txt. -->
    <None Include="Markdown\Music\Assets\Fonts\Bravura.otf" Link="MusicFonts\Bravura.otf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Markdown\Music\Assets\Fonts\OFL.txt" Link="MusicFonts\Bravura-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The score engraver's internals (layout engine, stem/beam rules) are asserted directly by the tests —
         those are the parts a rendered bitmap can't tell you are right. -->
    <InternalsVisibleTo Include="Nexaflow.Tests.Visuals" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <!-- Editor surface (Editor/): the read-write Edit Text host. -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Editor base VM needs IShellServices/IPageViewModel (contracts), the encoding/transform leaves,
         and the shared formatters. None of these reference Visuals.Text, so there is no cycle. -->
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Common\Nexaflow.Features.Common.csproj" />
    <ProjectReference Include="..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
    <!-- The LaTeX parse tree. It is what says a matrix is a table and where each cell is; the
         typesetter's atoms only say what to draw. See docs/latex-parse-tree.md. -->
    <ProjectReference Include="..\Nexaflow.Maths\Nexaflow.Maths.csproj" />
    <ProjectReference Include="..\Nexaflow.Syntax\Nexaflow.Syntax.csproj" />
    <ProjectReference Include="..\Nexaflow.Visuals.Common\Nexaflow.Visuals.Common.csproj" />

    <!-- TeX's typesetting engine, ingested from XAML-Math and now ours: Visuals.Maths for the fonts and
         the renderer interfaces, Maths.Typesetting for the atoms and the box model beneath it. Ingested
         rather than referenced because we build the atoms ourselves now, from our own parse tree, and
         they are internal. See docs/externals.md for the exception that makes to the submodule rule. -->
    <ProjectReference Include="..\Nexaflow.Visuals.Maths\Nexaflow.Visuals.Maths.csproj" />
  </ItemGroup>

</Project>
