<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <!-- Editor surface (Editor/): the read-write Edit Text host. -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Editor base VM needs IShellServices/IPageViewModel (contracts), the encoding/transform leaves,
         and the shared formatters. None of these reference Visuals.Text, so there is no cycle. -->
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Common\Nexaflow.Features.Common.csproj" />
    <ProjectReference Include="..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
    <ProjectReference Include="..\Nexaflow.Syntax\Nexaflow.Syntax.csproj" />
    <ProjectReference Include="..\Nexaflow.Visuals.Common\Nexaflow.Visuals.Common.csproj" />

    <!-- WpfMath (LaTeX math rendering) built from source: the external/xaml-math submodule (smile-forge fork,
         nexaflow branch) replaces the WpfMath NuGet so matrix-delimiter environments can be added upstream.
         Resolves WpfMath's net8.0-windows target; XamlMath.Shared flows in transitively. -->
    <ProjectReference Include="..\..\external\xaml-math\src\WpfMath\WpfMath.csproj" />
  </ItemGroup>

</Project>
