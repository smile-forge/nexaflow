<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bravura (SMuFL music font, SIL OFL 1.1) — the native score engraver draws its glyphs. Bundled as
         an asset (not a submodule: it's a font, not ProjectReference'd source) and copied beside the
         assembly so Smufl can load the font from disk (works headless + in-app).
         Flows transitively into the host app's output. License: MusicFonts\Bravura-OFL.txt. -->
    <None Include="Markdown\Music\Assets\Fonts\Bravura.otf" Link="MusicFonts\Bravura.otf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Markdown\Music\Assets\Fonts\OFL.txt" Link="MusicFonts\Bravura-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engraver's internals (stem and beam rules, staff geometry) are asserted directly by the tests —
         those are the parts a rendered bitmap can't tell you are right. -->
    <InternalsVisibleTo Include="Nexaflow.Tests.Visuals" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <!-- Editor surface (Editor/): the read-write Edit Text host. -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Editor base VM needs IShellServices/IPageViewModel (contracts), the encoding/transform leaves,
         and the shared formatters. None of these reference Visuals.Text, so there is no cycle. -->
    <ProjectReference Include="..\Nexaflow.Features\Nexaflow.Features.Common\Nexaflow.Features.Common.csproj" />
    <ProjectReference Include="..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
        <ProjectReference Include="..\Nexaflow.IO.Documents\Nexaflow.IO.Documents.csproj" />
    <!-- The formal syntax tree every rendered language is read into, and the pipeline of stages that
         re-read it without changing what it prints as. ISourcePart lives here too: the seam asks a part
         where it sits, and that question has nothing to do with WPF. See docs/markdown-ast.md. -->
    <ProjectReference Include="..\Nexaflow.Markdown\Nexaflow.Markdown.csproj" />
    <ProjectReference Include="..\Nexaflow.Syntax\Nexaflow.Syntax.csproj" />
    <ProjectReference Include="..\Nexaflow.Visuals.Common\Nexaflow.Visuals.Common.csproj" />
    <ProjectReference Include="..\Nexaflow.Visuals.Icons\Nexaflow.Visuals.Icons.csproj" />

    </ItemGroup>

    <ItemGroup>
      <!-- The faces TeX's maths is drawn in, from XAML-Math (MIT; see Core's ThirdPartyNotices). The typesetter and what it
           knows of them — their metrics and the glue between classes — are Nexaflow.Markdown's (Typesetting); the faces are
           WPF resources under Tex\Fonts\, the path the WPF font provider opens them from. -->


      <Resource Include="Markdown\Latex\Tex\Fonts\*.ttf" />
      <None Include="Markdown\Latex\Tex\Fonts\LICENSES.md" />
    </ItemGroup>

</Project>
