<UserControl x:Class="Nexaflow.Visuals.Text.Editor.FileTextEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:ed="clr-namespace:Nexaflow.Visuals.Text.Editor"
             xmlns:vc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="TextEditorView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="F5"                    Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ TOOLBAR ══════════════ -->
        <Border x:Name="EditorToolbar" Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: encoding + EOL -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource DarkComboBox}"
                              AutomationProperties.AutomationId="Editor_Encoding"
                              ItemsSource="{Binding AvailableEncodings}"
                              SelectedItem="{Binding SelectedEncoding}"
                              Width="130" Height="28" VerticalAlignment="Center"
                              ToolTip="File encoding (used to read and to save)"/>
                    <ComboBox Style="{StaticResource DarkComboBox}"
                              AutomationProperties.AutomationId="Editor_Eol"
                              ItemsSource="{Binding AvailableEols}"
                              SelectedItem="{Binding SelectedEol}"
                              Width="110" Height="28" VerticalAlignment="Center" Margin="6,0,0,0"
                              ToolTip="Line endings written on save"/>
                </StackPanel>

                <!-- Middle: search chip — what a "?" search found, and how to step through or dismiss it.
                     Placed at the top like the Text and Markdown viewers, for a consistent search indicator. -->
                <vc:SearchStatusChip Grid.Column="1" PagePrefix="Editor"
                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <!-- Right: display toggles + save (command groups live in the floating panel on the right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource TbToggle}"
                                  AutomationProperties.AutomationId="Editor_LineNumbers"
                                  IsChecked="{Binding ShowLineNumbers}"
                                  ToolTip="Toggle line numbers">
                        <TextBlock Text="≡#" FontSize="12"/>
                    </ToggleButton>

                    <Separator Style="{StaticResource TbSep}"/>

                    <Button Style="{StaticResource TbBtn}"
                            AutomationProperties.AutomationId="Editor_Save"
                            Command="{Binding SaveCommand}"
                            ToolTip="Save (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="Save" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ EDITOR (+ minimap match strip) ══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
            </Grid.ColumnDefinitions>

            <avalon:TextEditor x:Name="Editor"
                               Grid.Column="0"
                               IsReadOnly="{Binding IsReadOnlyMode}"
                               ShowLineNumbers="{Binding ShowLineNumbers}"
                               FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                               FontSize="13"
                               Margin="3,3,0,0"
                               UseLayoutRounding="True"
                               Background="{StaticResource BgBrush}"
                               Foreground="{StaticResource TextBrush}">
                <avalon:TextEditor.ContextMenu>
                    <ContextMenu x:Name="EditorContextMenu">
                        <MenuItem Header="Cut"   Command="ApplicationCommands.Cut"/>
                        <MenuItem Header="Copy"  Command="ApplicationCommands.Copy"/>
                        <MenuItem Header="Paste" Command="ApplicationCommands.Paste"/>
                    </ContextMenu>
                </avalon:TextEditor.ContextMenu>
            </avalon:TextEditor>

            <!-- Floating command panel: Lines / Checksum / Encode / Decode (right side, like the file action strip) -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="0,8,16,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <ItemsControl ItemsSource="{Binding CommandGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource TbBtn}"
                                    AutomationProperties.AutomationId="{Binding Name, StringFormat='Editor_Cmd_{0}'}"
                                    Click="CommandGroupButton_Click"
                                    Margin="0,2" MinWidth="104">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="11"/>
                                    <TextBlock Text=" ⌄" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding Commands}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                <Setter Property="Header"  Value="{Binding Name}"/>
                                                <Setter Property="Command" Value="{Binding Run}"/>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Too-large / open-failed banner -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Margin="4,4,4,0"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10,6"
                    Visibility="{Binding IsReadOnlyMode, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding ReadOnlyReason}"
                           AutomationProperties.AutomationId="Editor_ReadOnlyBanner"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- External-change banner -->
            <Border VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Margin="4,4,4,0"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10,5"
                    Visibility="{Binding BannerVisible, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding BannerMessage}"
                           AutomationProperties.AutomationId="Editor_ChangeBanner"
                           Foreground="{StaticResource AccentBrush}" FontSize="12"/>
            </Border>

            <!-- Minimap match strip: proportional tick marks for the current search's matches -->
            <ed:MiniMapStrip x:Name="MiniMapCanvas"
                             Grid.Column="1"
                             Background="{StaticResource DeepBgBrush}"/>
        </Grid>

        <!-- ══════════════ STATUS BAR ══════════════ -->
        <Border x:Name="EditorStatusBar" Grid.Row="2"
                Background="{StaticResource DeepBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: size / dirty / read-only -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileSizeText}"
                               AutomationProperties.AutomationId="Editor_FileSize"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock Text="● unsaved"
                               AutomationProperties.AutomationId="Editor_UnsavedIndicator"
                               Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,0,16,0"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="read-only"
                               AutomationProperties.AutomationId="Editor_ReadOnlyIndicator"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               Visibility="{Binding IsReadOnlyMode, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <!-- Right: line count + line-ending indicator; click opens the Lines command popup -->
                <Button Grid.Column="1" Style="{StaticResource TbBtn}"
                        AutomationProperties.AutomationId="Editor_LineCommands"
                        Click="LineCommandsButton_Click"
                        Padding="8,2" Margin="0"
                        ToolTip="Line operations (EOL conversion, sort, dedupe…)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LineCount, StringFormat='{}{0} lines'}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        <TextBlock Text="  ·  " Foreground="{StaticResource BorderBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding LineEndingLabel}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        <TextBlock Text=" ⌄" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu ItemsSource="{Binding LineCommands}">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Header"  Value="{Binding Name}"/>
                                    <Setter Property="Command" Value="{Binding Run}"/>
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
