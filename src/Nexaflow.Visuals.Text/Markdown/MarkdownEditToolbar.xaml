<UserControl x:Class="Nexaflow.Visuals.Text.Markdown.MarkdownEditToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Icon button: transparent, themed hover wash, dimmed when disabled. -->
        <Style x:Key="FmtBtn" TargetType="Button">
            <Setter Property="Width"      Value="30"/>
            <Setter Property="Height"     Value="26"/>
            <Setter Property="Margin"     Value="1"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="6" Padding="4"
            SnapsToDevicePixels="True">
        <StackPanel>

            <!-- Row 1: clipboard + headings -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CutBtn"   Style="{StaticResource FmtBtn}" Tag="Cut"   Click="OnButtonClick" ToolTip="Cut">✂</Button>
                <Button x:Name="CopyBtn"  Style="{StaticResource FmtBtn}" Tag="Copy"  Click="OnButtonClick" ToolTip="Copy">⧉</Button>
                <Button x:Name="PasteBtn" Style="{StaticResource FmtBtn}" Tag="Paste" Click="OnButtonClick" ToolTip="Paste">📋</Button>
                <Border Width="1" Margin="3,2" Background="{DynamicResource BorderBrush}"/>
                <Button Style="{StaticResource FmtBtn}" Tag="H1" Click="OnButtonClick" ToolTip="Heading 1"><TextBlock Text="H1" FontWeight="SemiBold" FontSize="12"/></Button>
                <Button Style="{StaticResource FmtBtn}" Tag="H2" Click="OnButtonClick" ToolTip="Heading 2"><TextBlock Text="H2" FontWeight="SemiBold" FontSize="12"/></Button>
                <Button Style="{StaticResource FmtBtn}" Tag="H3" Click="OnButtonClick" ToolTip="Heading 3"><TextBlock Text="H3" FontWeight="SemiBold" FontSize="12"/></Button>
            </StackPanel>

            <!-- Row 2: inline + block formatting -->
            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <Button Style="{StaticResource FmtBtn}" Tag="Bold"          Click="OnButtonClick" ToolTip="Bold"><TextBlock Text="B" FontWeight="Bold"/></Button>
                <Button Style="{StaticResource FmtBtn}" Tag="Italic"        Click="OnButtonClick" ToolTip="Italic"><TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia"/></Button>
                <Button Style="{StaticResource FmtBtn}" Tag="Strikethrough" Click="OnButtonClick" ToolTip="Strikethrough"><TextBlock Text="S" TextDecorations="Strikethrough"/></Button>
                <Button Style="{StaticResource FmtBtn}" Tag="InlineCode"    Click="OnButtonClick" ToolTip="Inline code"><TextBlock Text="&lt;/&gt;" FontFamily="Consolas" FontSize="11"/></Button>
                <Border Width="1" Margin="3,2" Background="{DynamicResource BorderBrush}"/>
                <Button Style="{StaticResource FmtBtn}" Tag="Quote"     Click="OnButtonClick" ToolTip="Quote">❝</Button>
                <Button Style="{StaticResource FmtBtn}" Tag="CodeBlock" Click="OnButtonClick" ToolTip="Code block"><TextBlock Text="{}{ }" FontFamily="Consolas" FontSize="12"/></Button>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
