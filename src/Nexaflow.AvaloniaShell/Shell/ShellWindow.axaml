<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Nexaflow.AvaloniaShell.Shell"
        xmlns:theming="clr-namespace:Nexaflow.AvaloniaShell.Theming"
        xmlns:models="clr-namespace:Nexaflow.Session.Models;assembly=Nexaflow.Session"
        xmlns:loc="clr-namespace:Nexaflow.AvaloniaShell.Shell"
        x:Class="Nexaflow.AvaloniaShell.Shell.ShellWindow"
        x:DataType="shell:ShellWindowModel"
        Title="{Binding Title}"
        Width="1280" Height="880" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        AutomationProperties.AutomationId="MainWindow">

  <!-- The WPF shell's MainWindow, row for row (19 / 72 / * / 5 / 90), over the theme's window-wide backdrop. -->
  <Panel Name="Root">
    <theming:ThemedRegion Region="Window" IsHitTestVisible="False" ZIndex="-10" />

    <Grid RowDefinitions="19,72,*,5,90">

      <!-- ── Row 0: the drag bar and the caption buttons ── -->
      <Border Grid.Row="0" Name="DragBar" Background="{DynamicResource Chrome.Deep}">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Classes="caption" Name="MinimiseButton" Content="&#xE921;" ToolTip.Tip="{loc:Str Shell.Caption.Minimise}"
                  AutomationProperties.AutomationId="Chrome_Minimize" />
          <Button Classes="caption" Name="MaximiseButton" Content="&#xE922;" ToolTip.Tip="{loc:Str Shell.Caption.Maximise}"
                  AutomationProperties.AutomationId="Chrome_MaximizeRestore" />
          <Button Classes="caption close" Name="CloseButton" Content="&#xE8BB;" ToolTip.Tip="{loc:Str Shell.Caption.Close}"
                  AutomationProperties.AutomationId="Chrome_Close" />
        </StackPanel>
      </Border>

      <!-- ── Row 1: logo column | ribbon | right action panel ── -->
      <Grid Grid.Row="1" ColumnDefinitions="200,*,180" Background="{DynamicResource Chrome.Panel}">

        <Border Grid.Column="0" Background="{DynamicResource Chrome.Deep}" BorderBrush="{DynamicResource Chrome.Border}"
                BorderThickness="0,0,1,0" ClipToBounds="True">
          <Grid Margin="20,0" RowDefinitions="*,Auto">
            <TextBlock Text="⬡ NexaFlow" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentGradientBrush}" ToolTip.Tip="NexaFlow" />
            <shell:ActivityTicker Grid.Row="1" Margin="0,0,0,10" Tasks="{Binding Activities}" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource Chrome.Bg}" BorderBrush="{DynamicResource Chrome.Border}"
                BorderThickness="0,1,0,0">
          <Panel>
            <!-- The bevel, and the workspace's colour along its first 240 px. -->
            <Border Height="10" VerticalAlignment="Top" Background="{DynamicResource Chrome.Panel}" />
            <Border Width="240" Height="10" VerticalAlignment="Top" HorizontalAlignment="Left" Background="{Binding WorkspaceBrush}" />

            <!-- The workspace selector: the workspace's colour and icon; a click lists the workspaces, a right click acts on this one. -->
            <Border Width="42" HorizontalAlignment="Left" Background="{Binding WorkspaceBrush}" ClipToBounds="True">
              <Button Classes="workspace" Name="WorkspaceButton" Command="{Binding ToggleWorkspacesCommand}"
                      ToolTip.Tip="{Binding WorkspaceTip}" AutomationProperties.AutomationId="Avalonia.WorkspaceSelector">
                <shell:MonoGlyph Text="{Binding WorkspaceIcon}" FontFamily="{x:Static shell:MonoGlyph.Emoji}" FontSize="22" Foreground="Black" />
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy workspace" Command="{Binding CopyWorkspaceCommand}"
                              AutomationProperties.AutomationId="Avalonia.CopyWorkspace" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </Border>
            <Popup IsOpen="{Binding IsWorkspaceListOpen, Mode=TwoWay}" PlacementTarget="{Binding #WorkspaceButton}" Placement="Bottom"
                   IsLightDismissEnabled="True">
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                      CornerRadius="4" MinWidth="180" Padding="0,4">
                <ItemsControl ItemsSource="{Binding Workspaces}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Workspace">
                      <Button Classes="workspaceItem" Command="{Binding $parent[Window].((shell:ShellWindowModel)DataContext).ShowWorkspaceCommand}"
                              CommandParameter="{Binding}" AutomationProperties.AutomationId="{Binding Name, StringFormat='Avalonia.Workspace.{0}'}">
                        <StackPanel Orientation="Horizontal">
                          <Border Width="12" Height="12" CornerRadius="2" Margin="0,0,8,0" Background="{Binding Color, Converter={x:Static shell:ShellConverters.ColourText}}" />
                          <shell:MonoGlyph Text="{Binding Icon}" FontFamily="{x:Static shell:MonoGlyph.Emoji}" FontSize="13" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextBrush}" />
                          <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </Popup>

            <!-- The ribbon itself: its buttons and separators, and the edit toggle. -->
            <Grid Margin="48,10,0,0" ColumnDefinitions="*,Auto,28">
              <ItemsControl ItemsSource="{Binding Ribbon}" ClipToBounds="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                  <DataTemplate DataType="shell:RibbonButton">
                    <Button Classes="ribbon" Command="{Binding PressCommand}" ToolTip.Tip="{Binding Label}"
                            AutomationProperties.AutomationId="{Binding Label, StringFormat='Ribbon_{0}'}">
                      <StackPanel Margin="0,6,0,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <shell:MonoGlyph Text="{Binding Glyph}" FontFamily="{Binding GlyphFont}" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Caption}" Margin="1,4,1,0" HorizontalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                  <DataTemplate DataType="shell:RibbonSeparator">
                    <Rectangle Width="1" Margin="4,14,4,10" Fill="{DynamicResource BorderBrush}" />
                  </DataTemplate>
                </ItemsControl.DataTemplates>
              </ItemsControl>
              <Button Grid.Column="2" Classes="ribbonEdit" Command="{Binding EditRibbonCommand}"
                      ToolTip.Tip="{loc:Str Shell.Ribbon.Customise.Tooltip}" AutomationProperties.AutomationId="Ribbon_Edit">
                <Path Data="M0 0 L6 0 L3 4 Z" Width="6" Height="4" Fill="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
              </Button>
            </Grid>
          </Panel>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource Chrome.RightPanel}" BorderBrush="{DynamicResource Chrome.Border}"
                BorderThickness="1,0,0,0">
          <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,10">
            <Button Classes="topAction" Margin="0,0,0,4" Command="{Binding ToggleHelpCommand}" ToolTip.Tip="{loc:Str Shell.Help.Tooltip}"
                    AutomationProperties.AutomationId="Chrome_HelpButton">
              <Border Width="15" Height="15" CornerRadius="7.5" BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1.2">
                <TextBlock Text="?" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Button>
            <Button Classes="topAction" Margin="0,0,0,6" Command="{Binding ShowOptionsCommand}" AutomationProperties.AutomationId="Chrome_OptionsButton">
              <TextBlock Text="{loc:Str Shell.TopBar.Options}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
            </Button>
            <Button Classes="topAction" Command="{Binding ToggleMessagesCommand}" AutomationProperties.AutomationId="NotificationsButton">
              <StackPanel Orientation="Horizontal">
                <Path Data="M2 2h12v9H9l-3 3V11H2z" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource TextMutedBrush}"
                      Margin="0,0,5,0" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Str Shell.TopBar.Messages}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,4,0" />
                <Border IsVisible="{Binding HasUnread}" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="4,1">
                  <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="9" FontWeight="SemiBold" />
                </Border>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ── Row 2: the pane — its header (breadcrumb | tabs) over the page ── -->
      <Grid Grid.Row="2" RowDefinitions="38,*">
        <Border Background="{DynamicResource TabStrip.Bg}" BorderBrush="{DynamicResource TabStrip.Border}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="0.35*,0.65*">
            <Border BorderBrush="{DynamicResource TabStrip.Border}" BorderThickness="0,0,1,0" Padding="16,0">
              <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="shell:Crumb">
                    <StackPanel Orientation="Horizontal">
                      <Button Classes="crumb" Classes.last="{Binding IsLast}" Content="{Binding Label}" Command="{Binding NavigateCommand}"
                              AutomationProperties.AutomationId="{Binding Label, StringFormat='Crumb_{0}'}" />
                      <TextBlock Text="›" FontSize="12" Margin="2,0,2,0" Foreground="{DynamicResource TextMutedBrush}"
                                 IsVisible="{Binding HasSeparator}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <ItemsControl Grid.Column="1" Name="TabStripItems" ItemsSource="{Binding OpenTabs}" Margin="8,0" ClipToBounds="True">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shell:ShellTab">
                  <Button Classes="tab" Classes.active="{Binding IsActive}" Command="{Binding ActivateCommand}" ToolTip.Tip="{Binding FullTitle}"
                          AutomationProperties.AutomationId="{Binding Page.PageKind, StringFormat='TabItem_{0}'}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <shell:MonoGlyph Text="{Binding Page.Icon}" FontFamily="{x:Static shell:MonoGlyph.Emoji}" FontSize="13" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding Caption}" FontSize="12" VerticalAlignment="Center" />
                      <Button Classes="tabClose" Content="✕" Command="{Binding CloseCommand}"
                              AutomationProperties.AutomationId="{Binding Page.PageKind, StringFormat='CloseTab_{0}'}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>

        <theming:ThemedRegion Grid.Row="1" Region="Page">
          <!-- A page stands on the theme's page colour — translucent where a theme lets its scene show through, as Ocean does. -->
          <ContentControl Content="{Binding SelectedTab.View}" Background="{DynamicResource BgBrush}" />
        </theming:ThemedRegion>
      </Grid>

      <GridSplitter Grid.Row="3" Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

      <!-- ── Row 4: the AI bar ── -->
      <theming:ThemedRegion Grid.Row="4" Region="AiBar">
        <Border BorderBrush="{DynamicResource AiBar.Border}" BorderThickness="0,1,0,0">
          <Grid Name="AiBarGrid" Margin="12,5,12,5" ColumnDefinitions="30,*,56" RowDefinitions="Auto,*">

            <!-- The assistant's line: the status dot, and while a request is under way or answered, what it says. -->
            <Border Name="AiField" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="30" Margin="0,0,0,4"
                    Padding="3,2,3,2" CornerRadius="8" BorderThickness="1" ClipToBounds="True"
                    Background="{DynamicResource AiBar.InputBg}" BorderBrush="{DynamicResource BorderBrush}">
              <DockPanel>
                <Viewbox DockPanel.Dock="Left" Width="22" Height="22" ToolTip.Tip="{Binding DotTip}">
                  <Panel Width="28" Height="28">
                    <Ellipse Classes="dot" Classes.busy="{Binding DotBusy}" Classes.handler="{Binding DotHandler}"
                             Classes.listening="{Binding DotListening}" />
                    <TextBlock Text="{Binding DotSymbol}" IsVisible="{Binding DotHandler}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AiStatus.HandlerText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Panel>
                </Viewbox>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsVisible="{Binding IsOpen}" VerticalAlignment="Center"
                            DataContext="{Binding Bar}" x:DataType="shell:BarSurface">
                  <Button Classes="primary slim" Content="{loc:Str Shell.AiResponse.Accept}" Command="{Binding ApproveCommand}"
                          IsVisible="{Binding HasApproval}" AutomationProperties.AutomationId="AiBar_Allow" />
                  <Button Classes="secondary slim" Content="{loc:Str Shell.AiResponse.Deny}" Command="{Binding DenyCommand}"
                          IsVisible="{Binding HasApproval}" AutomationProperties.AutomationId="AiBar_Deny" />
                  <Button Classes="icon" Content="✕" FontSize="11" Width="22" Height="22" Margin="6,0,0,0" Command="{Binding EndConversationCommand}"
                          ToolTip.Tip="{loc:Str Shell.AiResponse.Dismiss}" AutomationProperties.AutomationId="AiBar_ReplyDismiss" />
                </StackPanel>
                <Panel Margin="8,0" IsVisible="{Binding IsOpen}" VerticalAlignment="Center" DataContext="{Binding Bar}" x:DataType="shell:BarSurface">
                  <TextBlock Text="{Binding Approval}" FontSize="13" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasApproval}"
                             Foreground="{DynamicResource TextBrush}" ToolTip.Tip="{Binding Approval}" />
                  <TextBlock Text="{Binding Progress}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}"
                             IsVisible="{Binding Progress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding Reply}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}"
                             IsVisible="{Binding Progress, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                    <ToolTip.Tip>
                      <SelectableTextBlock Text="{Binding Reply}" TextWrapping="Wrap" MaxWidth="960" FontSize="13" />
                    </ToolTip.Tip>
                  </TextBlock>
                </Panel>
              </DockPanel>
            </Border>

            <!-- The mic: no spoken conversation is wired into this shell, so it stands disabled and says why. -->
            <Button Grid.Row="1" Grid.Column="0" Classes="icon" Width="NaN" Height="NaN" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    IsEnabled="False" ToolTip.ShowOnDisabled="True" ToolTip.Tip="Spoken conversations are not wired into the Avalonia shell yet."
                    AutomationProperties.AutomationId="AiBar_Mic">
              <shell:MonoGlyph Text="🎙" FontFamily="{x:Static shell:MonoGlyph.Emoji}" FontSize="14" />
            </Button>

            <!-- The user's line. -->
            <Border Name="UserField" Classes="userField" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="6,0,0,0" CornerRadius="8"
                    BorderThickness="1" Background="{DynamicResource AiBar.InputBg}" BorderBrush="{DynamicResource BorderBrush}">
              <Panel>
                <TextBox Name="AiInput" Classes="aiInput" Text="{Binding AiInputText}" AcceptsReturn="True" TextWrapping="Wrap"
                         PlaceholderText="{loc:Str Shell.AiBar.Placeholder}" AutomationProperties.AutomationId="AiInputBox" />
                <TextBlock Name="Completion" IsHitTestVisible="False" FontSize="13" Margin="8,3,28,3" TextWrapping="Wrap" />
                <Button Classes="icon clear" Content="✕" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"
                        Command="{Binding ClearInputCommand}" ToolTip.Tip="{loc:Str Shell.AiBar.Clear}" AutomationProperties.AutomationId="AiBar_Clear" />
              </Panel>
            </Border>

            <!-- The page's context goes with a request; while one runs, words sent join it. -->
            <Panel Grid.Row="0" Grid.Column="2" Margin="8,0,0,4">
              <ToggleButton Classes="context" IsChecked="{Binding IncludeContext}" IsVisible="{Binding IsIdle}"
                            ToolTip.Tip="{loc:Str Shell.AiBar.IncludeContext}" AutomationProperties.AutomationId="AiBar_ContextToggle">
                <shell:MonoGlyph Text="🔗" FontFamily="{x:Static shell:MonoGlyph.Emoji}" FontSize="13" />
              </ToggleButton>
              <Button Classes="send" CornerRadius="8" Height="28" IsVisible="{Binding AiIsBusy}" Command="{Binding SendCommand}"
                      ToolTip.Tip="{loc:Str Shell.AiBar.Queue}" AutomationProperties.AutomationId="AiBar_Queue">
                <TextBlock Text="➤＋" FontSize="13" />
              </Button>
            </Panel>
            <Panel Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" MinWidth="48">
              <Button Classes="send" IsVisible="{Binding IsIdle}" Command="{Binding SendCommand}" ToolTip.Tip="{loc:Str Shell.AiBar.Send}"
                      AutomationProperties.AutomationId="AiBar_Send">
                <TextBlock Text="➤" FontSize="16" />
              </Button>
              <Button Classes="send cancel" IsVisible="{Binding AiIsBusy}" Command="{Binding CancelAiCommand}" ToolTip.Tip="{loc:Str Shell.AiBar.Cancel}"
                      AutomationProperties.AutomationId="AiBar_Cancel">
                <TextBlock Text="■" FontSize="16" />
              </Button>
            </Panel>
          </Grid>
        </Border>
      </theming:ThemedRegion>
    </Grid>

    <!-- ── Messages: a click outside closes them ── -->
    <Button Classes="scrim" IsVisible="{Binding IsMessagesOpen}" Command="{Binding ToggleMessagesCommand}" ZIndex="49"
            AutomationProperties.AutomationId="Chrome_NotificationsScrim" />
    <Border Classes="popup" IsVisible="{Binding IsMessagesOpen}" ZIndex="50" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,87,0,0" Width="640" MaxHeight="520" Padding="12">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{loc:Str Shell.Notifications.Header}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:NotificationItem">
                <Border Padding="8" CornerRadius="6" Margin="0,2" Background="{DynamicResource Surface2Brush}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Body}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ── An overlay a page or the session shows over the window ── -->
    <Panel IsVisible="{Binding HasOverlay}" ZIndex="150">
      <Border Background="{DynamicResource ScrimBrush}" />
      <ContentControl Content="{Binding Overlay}" />
    </Panel>

    <!-- ── A confirmation or a prompt for a value ── -->
    <Panel IsVisible="{Binding HasPrompt}" ZIndex="160">
      <Border Background="{DynamicResource ScrimBrush}" />
      <Border Classes="popup" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Padding="20">
        <StackPanel DataContext="{Binding Prompt}" x:DataType="shell:ShellPrompt">
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,18" />
          <TextBox Text="{Binding Value}" IsVisible="{Binding AsksValue}" Padding="8,6" Margin="0,-12,0,18" FontSize="13"
                   AutomationProperties.AutomationId="ShellPromptBox" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Classes="secondary" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" MinWidth="90" Height="32"
                    Margin="0,0,8,0" HorizontalContentAlignment="Center" AutomationProperties.AutomationId="Chrome_ConfirmCancel" />
            <Button Classes="primary" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" MinWidth="90" Height="32"
                    Foreground="White" AutomationProperties.AutomationId="Chrome_ConfirmOk" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>

    <!-- ── The toast: the newest word from the session, fading after a while ── -->
    <Border Name="Toast" Classes="popup" ZIndex="210" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,110"
            MaxWidth="460" Padding="16,14" BorderBrush="{DynamicResource AccentBrush}" IsHitTestVisible="False" Opacity="0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="ℹ" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" />
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding ToastTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ToastBody}" FontSize="11" TextWrapping="Wrap" MaxHeight="120" Foreground="{DynamicResource TextMutedBrush}"
                     IsVisible="{Binding ToastBody, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Panel>
</Window>
