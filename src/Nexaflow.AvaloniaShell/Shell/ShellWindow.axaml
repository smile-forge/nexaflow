<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Nexaflow.AvaloniaShell.Shell"
        xmlns:models="clr-namespace:Nexaflow.Session.Models;assembly=Nexaflow.Session"
        x:Class="Nexaflow.AvaloniaShell.Shell.ShellWindow"
        x:DataType="shell:ShellWindowModel"
        Title="{Binding Title}"
        Width="1200" Height="780"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- The workspace the window shows, the inbox, and the latest word from the session -->
    <DockPanel Grid.Row="0" Margin="10,8" LastChildFill="True">
      <TextBlock DockPanel.Dock="Left" Text="Workspace" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
      <ComboBox DockPanel.Dock="Left" MinWidth="200"
                ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"
                AutomationProperties.AutomationId="Avalonia.WorkspaceSelector">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:Workspace">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button DockPanel.Dock="Left" Content="Copy" Margin="6,0,0,0" Command="{Binding CopyWorkspaceCommand}"
              AutomationProperties.AutomationId="Avalonia.CopyWorkspace" />
      <Button DockPanel.Dock="Right" Command="{Binding ToggleInboxCommand}" AutomationProperties.AutomationId="Avalonia.Inbox">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Inbox" />
          <Border IsVisible="{Binding HasUnread}" CornerRadius="9" Padding="6,0" Background="{DynamicResource SystemAccentColor}">
            <TextBlock Text="{Binding UnreadCount}" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
      </Button>
      <Button DockPanel.Dock="Right" Content="✕" Margin="0,0,8,0" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Command="{Binding DismissStatusCommand}" AutomationProperties.AutomationId="Avalonia.DismissStatus" />
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis" Opacity="0.85" />
    </DockPanel>

    <!-- The workspace's ribbon, as plain buttons -->
    <ItemsControl Grid.Row="1" Margin="6,0" ItemsSource="{Binding Ribbon}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="shell:RibbonButton">
          <Button Margin="4" Command="{Binding PressCommand}" AutomationProperties.AutomationId="{Binding Label, StringFormat='Avalonia.Ribbon.{0}'}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Icon}" />
              <TextBlock Text="{Binding Label}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- The open pages, with the inbox, an overlay and a question over them -->
    <Grid Grid.Row="2">
      <TabControl ItemsSource="{Binding OpenTabs}" SelectedItem="{Binding SelectedTab}" Margin="6,4">
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="shell:ShellTab">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Page.Title}" VerticalAlignment="Center" />
              <Button Content="✕" Padding="4,0" Command="{Binding CloseCommand}" AutomationProperties.AutomationId="Avalonia.CloseTab" />
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.ContentTemplate>
          <DataTemplate x:DataType="shell:ShellTab">
            <ContentControl Content="{Binding View}" />
          </DataTemplate>
        </TabControl.ContentTemplate>
      </TabControl>

      <Border IsVisible="{Binding IsInboxOpen}" HorizontalAlignment="Right" Width="380" Margin="8"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              BorderThickness="1" CornerRadius="6" Padding="8">
        <ListBox ItemsSource="{Binding Messages}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:NotificationItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Opacity="0.8" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <ContentControl IsVisible="{Binding HasOverlay}" Content="{Binding Overlay}" />

      <Border IsVisible="{Binding HasPrompt}" Background="#80000000">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="380" Padding="16" CornerRadius="8"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
          <StackPanel Spacing="10" DataContext="{Binding Prompt}" x:DataType="shell:ShellPrompt">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            <TextBox Text="{Binding Value}" IsVisible="{Binding AsksValue}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" AutomationProperties.AutomationId="Avalonia.PromptConfirm" />
              <Button Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="Avalonia.PromptCancel" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>

    <!-- The bar's reply: the request, the agent's progress, its reply, and what it waits on the user for -->
    <Border Grid.Row="3" IsVisible="{Binding Bar.IsOpen}" Margin="10,4" Padding="10" CornerRadius="6"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <DockPanel DataContext="{Binding Bar}" x:DataType="shell:BarSurface">
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="End" Command="{Binding EndConversationCommand}"
                AutomationProperties.AutomationId="Avalonia.EndConversation" />
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Request}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Progress}" Opacity="0.7" IsVisible="{Binding Progress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <SelectableTextBlock Text="{Binding Reply}" TextWrapping="Wrap" MaxHeight="220" />
          <StackPanel IsVisible="{Binding HasApproval}" Spacing="6">
            <TextBlock Text="{Binding Approval}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Allow" Command="{Binding ApproveCommand}" AutomationProperties.AutomationId="Avalonia.Approve" />
              <Button Content="Deny" Command="{Binding DenyCommand}" AutomationProperties.AutomationId="Avalonia.Deny" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The AI bar -->
    <DockPanel Grid.Row="4" Margin="10,6,10,10">
      <Button DockPanel.Dock="Right" Content="Send" Margin="6,0,0,0" Command="{Binding SendCommand}" AutomationProperties.AutomationId="Avalonia.AiSend" />
      <Button DockPanel.Dock="Right" Content="Stop" Margin="6,0,0,0" IsVisible="{Binding AiIsBusy}" Command="{Binding CancelAiCommand}"
              AutomationProperties.AutomationId="Avalonia.AiStop" />
      <CheckBox DockPanel.Dock="Right" Content="Page context" Margin="6,0,0,0" IsChecked="{Binding IncludeContext}" />
      <TextBlock DockPanel.Dock="Left" Text="{Binding PreviewLine}" MinWidth="40" Margin="0,0,8,0" VerticalAlignment="Center" Opacity="0.7" />
      <TextBox Text="{Binding AiInputText}" PlaceholderText="Ask, or type a command" AutomationProperties.AutomationId="Avalonia.AiInput">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
    </DockPanel>
  </Grid>
</Window>
