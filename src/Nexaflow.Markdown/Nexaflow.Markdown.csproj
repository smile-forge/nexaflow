<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The rendering domain, WPF-free: one formal syntax tree that owns its text, a pipeline of stages that
    re-read it without changing what it prints as, and the per-language parsers that feed it.

    A leaf on purpose, and eventually the home of everything markdown renders — maths, music, barcodes,
    diagrams, and markdown's own text blocks. Each of those is the same four stages: a parser that only
    copies, a pipeline of actors that re-nest, a builder that decides geometry, and a layout tree that
    answers what a click meant. Only the parser and the builder are language-specific.

    Depends on nothing, so it can sit under Visuals.Text (which renders from it) and under anything
    headless that wants to read a formula, a tune or a symbol without a desktop.

    Design: docs/markdown-ast.md. The LaTeX half of the same idea: docs/latex-parse-tree.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>



  <!-- Which glyph an icon a diagram names is drawn with — the Fluent font's names, read without the font. -->
  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.Icons\Nexaflow.Icons.csproj" />
  </ItemGroup>

  <!--
    A diagram's own nodes are what its stages tell its builder, and nobody else: once a tree is laid out, only its source
    references are read. So they are internal, seen by the builders and by the tests of the stages writing them.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Nexaflow.Visuals.Text" />
    <InternalsVisibleTo Include="Nexaflow.Tests.Markdown" />
    <!-- And the codes' encoders: their layouts, codeword tables and fields, which the tests that draw a symbol and read it
         back assert on. -->
    <InternalsVisibleTo Include="Nexaflow.Tests.Visuals" />
    <!-- And what a formula's names mean, which the tests of LaTeX's stages assert on. -->
    <InternalsVisibleTo Include="Nexaflow.Tests.Maths" />
  </ItemGroup>

  <!--
    What LaTeX's names mean: every symbol and its class, and which character stands for which symbol and delimiter. XAML-Math's
    tables (MIT; see Core's ThirdPartyNotices), read by TexVocabulary. How each symbol is drawn stays with the typesetter.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Latex\Data\TexSymbols.xml" LogicalName="Nexaflow.Markdown.Latex.Data.TexSymbols.xml" />
    <EmbeddedResource Include="Latex\Data\TexFormulaSettings.xml" LogicalName="Nexaflow.Markdown.Latex.Data.TexFormulaSettings.xml" />
  </ItemGroup>

  <!--
    How TeX sets maths, from XAML-Math (MIT; see Core's ThirdPartyNotices): the metrics of every glyph of the maths faces and the
    glue between classes, read by the typesetter. The faces themselves are a renderer's to open — a medium is handed their file
    names — so they stay with the renderer that draws them. Manifest names pinned to what the readers ask for.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Typesetting\Tex\Data\DefaultTexFont.xml" LogicalName="XamlMath.Data.DefaultTexFont.xml" />
    <EmbeddedResource Include="Typesetting\Tex\Data\GlueSettings.xml" LogicalName="XamlMath.Data.GlueSettings.xml" />
  </ItemGroup>

</Project>
