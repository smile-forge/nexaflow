<UserControl x:Class="Nexaflow.Features.Projects.Viewlets.AiSummaryViewletView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <!-- Header: title (DoubleBar only) + edit/save buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Content: clipped text or edit TextBox -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header row -->
        <Border Grid.Row="0"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,4">
            <Grid>
                <!-- Small title — only in DoubleBar mode; hidden in Large (ViewletHost banner shows it) -->
                <TextBlock x:Name="TitleText"
                           Text="AI Summary"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="10" FontWeight="SemiBold"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,2"/>

                <!-- Edit / Save buttons always in top-right -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="EditButton"
                            Content="Edit"
                            Padding="8,2"
                            FontSize="10"
                            Cursor="Hand"
                            Click="EditButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="Transparent"/>
                                <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="SaveButton"
                            Content="Save"
                            Padding="8,2"
                            FontSize="10"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            IsEnabled="False"
                            Click="SaveButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content area: clipped, no scrollbar -->
        <Grid x:Name="ContentArea"
              Grid.Row="1"
              ClipToBounds="True"
              SizeChanged="ContentArea_SizeChanged">

            <!-- Read-mode TextBlock (measures full desired height for overflow detection) -->
            <TextBlock x:Name="SummaryText"
                       TextWrapping="Wrap"
                       Padding="10,6"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="12"
                       VerticalAlignment="Top"/>

            <!-- Edit-mode TextBox -->
            <TextBox x:Name="EditTextBox"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Padding="10,6"
                     Foreground="{DynamicResource TextBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="12"
                     VerticalAlignment="Top"
                     Visibility="Collapsed"
                     CaretBrush="{DynamicResource TextBrush}"
                     TextChanged="EditTextBox_TextChanged"/>

            <!-- Overflow indicator: anchored bottom-right, appears when text is clipped -->
            <Button x:Name="OverflowButton"
                    Content="···"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,8,4"
                    Padding="4,1"
                    FontSize="11"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="OverflowButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background"      Value="{DynamicResource Surface2Brush}"/>
                        <Setter Property="Foreground"      Value="{DynamicResource TextMutedBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                            <Setter TargetName="Bd" Property="Opacity"     Value="1.0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
