<UserControl x:Class="Nexaflow.Features.Projects.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Projects.ViewModels"
             xmlns:pv="clr-namespace:Nexaflow.Features.Projects.Views"
             xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown;assembly=Nexaflow.Visuals.Text"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="ProjectDetailView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter   x:Key="BoolVis"/>
        <cv:NullToVisibilityConverter   x:Key="NullVis"/>
        <cv:NullToCollapsedConverter    x:Key="NullCollapsed"/>
        <cv:StringToVisibilityConverter x:Key="StringVis"/>
        <pv:CompletionStatusToBrushConverter   x:Key="CritBrush"/>
        <pv:CompletionStatusToDisplayConverter x:Key="CritDisplay"/>
        <pv:SwatchKeyToBrushConverter          x:Key="SwatchBrush"/>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Background" Value="{StaticResource DangerSubtleBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="BacklogRowStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg" Background="Transparent" CornerRadius="6" Margin="0,2" Padding="12,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="RowBg" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Colored status dropdown: base on the themed combo -->
        <Style x:Key="StatusCombo" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Upgrade banner (legacy schema) -->
            <Border Grid.Row="0" Background="{StaticResource WarningBrush}" Padding="16,10"
                    Visibility="{Binding NeedsUpgrade, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#1A1A1A"
                               Text="This project uses the old format. Upgrade to enable editing — the previous scope / notes / plan fields are rolled into the new markdown fields."/>
                    <Button Grid.Column="1" Content="Upgrade" Style="{StaticResource AccentButton}"
                            AutomationProperties.AutomationId="Projects_Detail_Upgrade"
                            Command="{Binding UpgradeCommand}" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- Tabs -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                        ItemContainerStyle="{StaticResource ThemedTabItem}"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                <!-- ══ Project Details ══════════════════════════════════════════ -->
                <TabItem Header="Project Details" AutomationProperties.AutomationId="Projects_Tab_Details">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,20,28,20" IsEnabled="{Binding IsEditable}">

                            <!-- Name + modified -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ProjectName, UpdateSourceTrigger=LostFocus}"
                                         FontSize="20" FontWeight="Bold" Style="{StaticResource DarkTextBox}"
                                         BorderThickness="0" Background="Transparent" Padding="0" ToolTip="Project name"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Modified" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding LastModified}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- Solution file (read-only, when set) -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding SolutionFile, Converter={StaticResource StringVis}}">
                                <TextBlock Text="SOLUTION FILE" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="{Binding SolutionFile}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Description (markdown) -->
                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionLabel}"/>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" MinHeight="120" Padding="6">
                                    <md:InlineMarkdownEditor Markdown="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             EditOnDoubleClick="False"/>
                                </Border>
                            </StackPanel>

                            <!-- Completion criteria -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="COMPLETION CRITERIA" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="+ Add" Style="{StaticResource GhostButton}" Padding="10,4"
                                        AutomationProperties.AutomationId="Projects_Detail_AddCriterion"
                                        Command="{Binding AddCriterionCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CompletionCriteria}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CompletionCriterionViewModel}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource StatusCombo}"
                                                      ItemsSource="{Binding AllStatuses}" SelectedItem="{Binding Status, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,6,0"
                                                                    Background="{Binding Converter={StaticResource CritBrush}}"/>
                                                            <TextBlock Text="{Binding Converter={StaticResource CritDisplay}}" VerticalAlignment="Center" FontSize="11"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource DarkTextBox}" FontSize="12" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Margin="6,0,0,0"
                                                    ToolTip="Remove criterion"
                                                    Command="{Binding DataContext.RemoveCriterionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ══ Backlog ══════════════════════════════════════════════════ -->
                <TabItem Header="Backlog" AutomationProperties.AutomationId="Projects_Tab_Backlog">
                    <Grid IsEnabled="{Binding IsEditable}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*" MinWidth="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Backlog list -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="16,14,16,8">
                                <Grid>
                                    <TextBlock Text="BACKLOG" Style="{StaticResource SectionLabel}"/>
                                    <!-- Beside the label it narrows: "?" filters this board and nothing else. -->
                                    <vcc:SearchStatusChip PagePrefix="ProjectDetail" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                             AutomationProperties.AutomationId="Projects_Detail_NewTodoTitle">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddTodoCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" Padding="12,7"
                                            AutomationProperties.AutomationId="Projects_Detail_AddTodo"
                                            Command="{Binding AddTodoCommand}">
                                        <TextBlock Text="+ Add"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <ListView Grid.Row="1" ItemsSource="{Binding Backlog}"
                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="Projects_Detail_Backlog"
                                      Background="Transparent" BorderThickness="0"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ItemContainerStyle="{StaticResource BacklogRowStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BacklogItemViewModel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                                    Background="{Binding StatusBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.4"/>
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="{Binding StatusBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="22" Height="22"
                                                    ToolTip="Progress to next stage" Command="{Binding ProgressCommand}"
                                                    Visibility="{Binding CanProgress, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="▶" FontSize="9"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                      Background="{StaticResource BorderBrush}" Cursor="SizeWE"/>

                        <!-- Backlog item editor -->
                        <Grid Grid.Column="2" Background="{StaticResource SurfaceBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"
                                        Visibility="{Binding SelectedItem, Converter={StaticResource NullCollapsed}}">
                                <TextBlock Text="📝" FontSize="36" HorizontalAlignment="Center"/>
                                <TextBlock Text="Select a backlog item" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Grid Visibility="{Binding SelectedItem, Converter={StaticResource NullVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="16,14,16,8" DataContext="{Binding SelectedItem}">

                                        <!-- Status row: badge + progress + any-status dropdown -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" Style="{StaticResource StatusCombo}" MinWidth="150"
                                                      AutomationProperties.AutomationId="Projects_Detail_StatusCombo"
                                                      ItemsSource="{Binding Config.BacklogStatuses}"
                                                      SelectedValuePath="Key" SelectedValue="{Binding StatusKey, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,6,0"
                                                                    Background="{Binding SwatchKey, Converter={StaticResource SwatchBrush}}"/>
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="11"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Grid.Column="1" Text="invalid status" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       Visibility="{Binding IsInvalidStatus, Converter={StaticResource BoolVis}}"/>
                                            <Button Grid.Column="2" Style="{StaticResource AccentButton}" Padding="10,6"
                                                    Command="{Binding ProgressCommand}" IsEnabled="{Binding CanProgress}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▶" FontSize="11" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Progress"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="TITLE" Style="{StaticResource SectionLabel}"/>
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"/>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionLabel}"/>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" MinHeight="120" Padding="6">
                                                <md:InlineMarkdownEditor Markdown="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         EditOnDoubleClick="False"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- AI actions -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                                    AutomationProperties.AutomationId="Projects_Detail_TaskToAi"
                                                    Command="{Binding DataContext.TaskToAiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🤖" FontSize="12" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Task to AI"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}"
                                                    AutomationProperties.AutomationId="Projects_Detail_PlanWithAi"
                                                    Command="{Binding DataContext.PlanWithAiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💬" FontSize="12" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Plan with AI"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Save / Delete -->
                                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="Projects_Detail_SaveItem"
                                                Command="{Binding SaveItemCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x1F4BE;" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="Save"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                                                AutomationProperties.AutomationId="Projects_Detail_DeleteTodo"
                                                Command="{Binding DeleteTodoCommand}" CommandParameter="{Binding SelectedItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#x1F5D1;" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="Delete"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ══ CONFIRMATION OVERLAY ══════════════════════════════════════════ -->
        <Border Visibility="{Binding ConfirmationVisible, Converter={StaticResource BoolVis}}"
                Background="#CC000000" Panel.ZIndex="20">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                    CornerRadius="8" Width="320" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmationTitle}" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ConfirmationPrompt}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Button Content="Delete" Command="{Binding ConfirmActionCommand}" Cursor="Hand" Margin="0,0,0,6"
                            Style="{StaticResource AccentButton}" Background="{StaticResource DangerBrush}" Foreground="White"/>
                    <Button Content="Cancel" Command="{Binding CancelConfirmationCommand}" Cursor="Hand"
                            Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
