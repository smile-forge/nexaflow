<UserControl x:Class="Nexaflow.Features.Projects.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Projects.ViewModels"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter  x:Key="BoolVis"/>
        <cv:NullToVisibilityConverter  x:Key="NullVis"/>
        <cv:NullToCollapsedConverter   x:Key="NullCollapsed"/>
        <cv:StringToVisibilityConverter x:Key="StringVis"/>

        <!-- ── Accent button ──────────────────────────────────────────── -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ghost button ───────────────────────────────────────────── -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Danger button ──────────────────────────────────────────── -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource DangerSubtleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Section label ──────────────────────────────────────────── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

                <!-- ── Multiline textbox: grows with content, no internal scrollbar ── -->
        <Style x:Key="MultiTextBox" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="AcceptsReturn"                Value="True"/>
            <Setter Property="TextWrapping"                 Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility"  Value="Disabled"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="MinHeight"                    Value="60"/>
        </Style>

        <!-- ── Backlog item row ────────────────────────────────────────── -->
        <Style x:Key="BacklogRowStyle" TargetType="ListViewItem">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg" Background="Transparent"
                                CornerRadius="6" Margin="0,2" Padding="12,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="RowBg" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Root grid — all content + confirmation overlay stacked -->
    <Grid>

        <!-- ══ MAIN LAYOUT ═══════════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Full-width header area -->
                <RowDefinition Height="Auto"/>
                                <!-- Full-width fields: description / scope / objectives -->
                <RowDefinition Height="*" MinHeight="120"/>
                <!-- Horizontal splitter -->
                <RowDefinition Height="5"/>
                <!-- 2-column backlog section -->
                <RowDefinition Height="2*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <!-- ── Row 0: project name | status badge | action buttons ── -->
            <Grid Grid.Row="0" Margin="28,20,28,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: name + modified -->
                <StackPanel Grid.Column="0">
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=LostFocus}"
                             FontSize="20" FontWeight="Bold"
                             Style="{StaticResource DarkTextBox}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             ToolTip="Project name"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Modified "
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock Text="{Binding LastModified}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                                <!-- Right: buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Open Files -->
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding OpenFilesCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗁" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Open Files"/>
                        </StackPanel>
                    </Button>
                    <!-- Refresh -->
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Row 1: full-width description / scope / objectives ─── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,0,28,12">

                    <!-- Solution file (read-only, only when set) -->
                    <StackPanel Margin="0,0,0,12"
                                Visibility="{Binding SolutionFile, Converter={StaticResource StringVis}}">
                        <TextBlock Text="SOLUTION FILE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding SolutionFile}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MultiTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="SCOPE" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding Scope, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MultiTextBox}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="OBJECTIVES  (one per line)" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding ObjectivesText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MultiTextBox}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

                        <!-- Horizontal splitter -->
            <GridSplitter Grid.Row="2" Height="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Cursor="SizeNS"/>

            <!-- ── Row 3: backlog — split into list (left) + editor (right) ── -->
            <Grid Grid.Row="3"
                  Background="{StaticResource SurfaceBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="260"/>
                </Grid.ColumnDefinitions>

                <!-- ── Backlog list column ──────────────────────────── -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- section label + add row -->
                        <RowDefinition Height="*"/>     <!-- list -->
                    </Grid.RowDefinitions>

                    <!-- Header + add -->
                    <StackPanel Grid.Row="0" Margin="16,12,16,8">
                        <TextBlock Text="BACKLOG" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,8,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddTodoCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding AddTodoCommand}"
                                    Padding="12,7">
                                <TextBlock Text="+ Add"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- List -->
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Backlog}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              ItemContainerStyle="{StaticResource BacklogRowStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BacklogItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status pip -->
                                    <Border Grid.Column="0"
                                            Width="8" Height="8" CornerRadius="4"
                                            Background="{Binding StatusBrush}"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"/>

                                    <!-- Title + status -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="10"
                                                   Foreground="{Binding StatusBrush}"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Progress button (only when can progress) -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            Width="22" Height="22"
                                            ToolTip="Progress to next stage"
                                            Command="{Binding ProgressCommand}"
                                            Visibility="{Binding CanProgress, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="▶" FontSize="9"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Vertical splitter -->
                <GridSplitter Grid.Column="1" Width="5"
                              HorizontalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}"
                              Cursor="SizeWE"/>

                <!-- ── Right: backlog item editor ──────────────────── -->
                <Grid Grid.Column="2">
                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Opacity="0.3"
                                Visibility="{Binding SelectedItem, Converter={StaticResource NullCollapsed}}">
                        <TextBlock Text="📝" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a backlog item"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" Margin="0,8,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Editor -->
                    <Grid Visibility="{Binding SelectedItem, Converter={StaticResource NullVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,12,16,8"
                                        DataContext="{Binding SelectedItem}">

                                <!-- Status badge + progress -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{Binding StatusBrush}"
                                            CornerRadius="4" Padding="8,4"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource AccentButton}"
                                            Command="{Binding ProgressCommand}"
                                            IsEnabled="{Binding CanProgress}"
                                            Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="▶" FontSize="11" Margin="0,0,5,0"/>
                                            <TextBlock Text="Progress"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="TITLE" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="NOTES" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MultiTextBox}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="IMPLEMENTATION PLAN" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding ImpPlan, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MultiTextBox}"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="TEST PLAN" Style="{StaticResource SectionLabel}"/>
                                    <TextBox Text="{Binding TestPlan, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MultiTextBox}"/>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                                                <!-- Save / Delete buttons -->
                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource AccentButton}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DataContext.SaveItemCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4BE;" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Save"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1"
                                        Style="{StaticResource DangerButton}"
                                        HorizontalAlignment="Right"
                                        Command="{Binding DataContext.DeleteTodoCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding DataContext.SelectedItem,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F5D1;" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Delete"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>

            </Grid>
        </Grid>

        <!-- ══ CONFIRMATION OVERLAY (spans entire view) ══════════════════ -->
        <Border Visibility="{Binding ConfirmationVisible, Converter={StaticResource BoolVis}}"
                Background="#CC000000"
                Panel.ZIndex="20">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="320"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmationTitle}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ConfirmationPrompt}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>
                    <!-- Confirm -->
                    <Button Content="Delete"
                            Command="{Binding ConfirmActionCommand}"
                            Cursor="Hand"
                            Margin="0,0,0,6">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="{StaticResource DangerBrush}"/>
                                <Setter Property="Foreground"      Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding"         Value="0,8"/>
                                <Setter Property="FontSize"        Value="12"/>
                                <Setter Property="FontWeight"      Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Cancel -->
                    <Button Content="Cancel"
                            Command="{Binding CancelConfirmationCommand}"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding"         Value="0,8"/>
                                <Setter Property="FontSize"        Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
