<UserControl x:Class="Nexaflow.Features.Projects.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Projects.ViewModels"
             xmlns:ctrl="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="ProjectsView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:NullToVisibilityConverter  x:Key="NullVis"/>
        <cv:NullToCollapsedConverter   x:Key="NullCollapsed"/>
        <cv:CountToVisibilityConverter x:Key="CountVis"/>
        <cv:ZeroCountToVisibilityConverter x:Key="ZeroVis"/>
        <BooleanToVisibilityConverter  x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>

        <Style x:Key="ProjectRowStyle" TargetType="ListViewItem">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="4,2"
                                Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="RowBg" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>

        <!-- ══ Feature disabled placeholder ════════════════════════════════ -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Projects_DisabledPlaceholder"
                    Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolVis}}">
            <TextBlock Text="🗂" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
            <TextBlock Text="Projects is disabled"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,12,0,0" HorizontalAlignment="Center"/>
            <TextBlock Text="Enable this feature in settings to use it."
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

    <!-- 40/60 split: list left, detail right -->
    <Grid Visibility="{Binding IsEnabled, Converter={StaticResource BoolVis}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="200"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="3*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT: project list ══════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with count -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Projects"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Margin="4,0,0,0">
                            <Run Text="("/>
                            <Run Text="{Binding ProjectCount, Mode=OneWay}"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource IconButton}"
                            AutomationProperties.AutomationId="Projects_Refresh"
                            ToolTip="Refresh"
                            Command="{Binding RefreshCommand}">
                        <TextBlock Text="↻" FontSize="14"/>
                    </Button>
                </Grid>
            </Border>

            <!-- List fills the rest — no fixed width -->
            <Grid Grid.Row="1">
                <TextBlock Text="No projects found"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDimBrush}" FontSize="13"
                           Visibility="{Binding ProjectCount, Converter={StaticResource ZeroVis}}"/>

                <ListView ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                          AutomationProperties.AutomationId="Projects_List"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          ItemContainerStyle="{StaticResource ProjectRowStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectSummaryItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <!-- First 2 lines of description only -->
                                    <TextBlock Text="{Binding DescriptionPreview}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- Mini pie chart -->
                                <ctrl:PieChart Grid.Column="1"
                                               Slices="{Binding PieSlices}"
                                               Diameter="28"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Vertical splitter -->
        <GridSplitter Grid.Column="1" Width="5"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"
                      Cursor="SizeWE"/>

        <!-- ══ RIGHT: detail panel ═════════════════════════════════════════ -->
        <Grid Grid.Column="2">

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Opacity="0.3"
                        Visibility="{Binding SelectedProject, Converter={StaticResource NullCollapsed}}">
                <TextBlock Text="🗂" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a project"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="14" Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Detail: fixed header+footer, scrollable description in middle -->
            <Grid Visibility="{Binding SelectedProject, Converter={StaticResource NullVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- name + meta -->
                    <RowDefinition Height="*"/>     <!-- description — scrolls independently -->
                    <RowDefinition Height="Auto"/>  <!-- pie + legend -->
                    <RowDefinition Height="Auto"/>  <!-- buttons -->
                </Grid.RowDefinitions>

                <!-- Row 0: project name + last modified -->
                <Grid Grid.Row="0" Margin="32,28,32,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectedProject.DisplayName}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,0">
                        <TextBlock Text="Last modified"
                                   FontSize="10"
                                   Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding SelectedProject.LastModified}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: description — scrolls independently -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="32,0,32,0">
                    <TextBlock Text="{Binding SelectedProject.DescriptionDisplay}"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Padding="0,4,0,12"/>
                </ScrollViewer>

                <!-- Row 2: pie chart + legend -->
                <Grid Grid.Row="2" Margin="32,8,32,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ctrl:PieChart Grid.Column="0"
                                   Slices="{Binding SelectedProject.PieSlices}"
                                   Diameter="80"
                                   Margin="0,0,24,0"
                                   VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Swatch.Slate}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="Not started: "/>
                                <Run Text="{Binding SelectedProject.ActiveCount, Mode=OneWay}"
                                     Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Swatch.Blue}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="In progress: "/>
                                <Run Text="{Binding SelectedProject.DoneCount, Mode=OneWay}"
                                     Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Swatch.Green}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="Awaiting finalisation: "/>
                                <Run Text="{Binding SelectedProject.DoneCount, Mode=OneWay}"
                                     Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Swatch.Red}"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="Cancelled: "/>
                                <Run Text="{Binding SelectedProject.CancelledCount, Mode=OneWay}"
                                     Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Row 3: action buttons -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="32,0,32,28">
                    <Button Style="{StaticResource AccentButton}"
                            AutomationProperties.AutomationId="Projects_OpenProject"
                            Command="{Binding OpenProjectCommand}"
                            CommandParameter="{Binding SelectedProject}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Open Project"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}"
                            AutomationProperties.AutomationId="Projects_OpenFiles"
                            Command="{Binding OpenFilesCommand}"
                            CommandParameter="{Binding SelectedProject}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗁" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Open Files"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
