<UserControl x:Class="Nexaflow.Features.Projects.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Projects.ViewModels"
             xmlns:pv="clr-namespace:Nexaflow.Features.Projects.Views"
             xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown;assembly=Nexaflow.Visuals.Text"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="ProjectsView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:NullToVisibilityConverter  x:Key="NullVis"/>
        <cv:NullToCollapsedConverter   x:Key="NullCollapsed"/>
        <cv:ZeroCountToVisibilityConverter x:Key="ZeroVis"/>
        <BooleanToVisibilityConverter  x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
        <pv:EnumMatchConverter x:Key="EnumMatch"/>

        <Style x:Key="ProjectRowStyle" TargetType="ListViewItem">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg" Background="Transparent" CornerRadius="6" Margin="4,2" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="RowBg" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bucket selector tab (radio) -->
        <Style x:Key="BucketTab" TargetType="RadioButton">
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="10,7">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="root" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>

        <!-- ══ Feature disabled placeholder ════════════════════════════════ -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Projects_DisabledPlaceholder"
                    Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolVis}}">
            <TextBlock Text="🗂" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
            <TextBlock Text="Projects is disabled" Foreground="{StaticResource TextBrush}"
                       FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
            <TextBlock Text="Enable this feature in settings to use it." Foreground="{StaticResource TextMutedBrush}"
                       FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 40/60 split: list left, detail right -->
        <Grid Visibility="{Binding IsEnabled, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT: bucket tabs + project list ═══════════════════════════ -->
            <Grid Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bucket tabs + refresh -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource BucketTab}" Content="Projects"
                                         AutomationProperties.AutomationId="Projects_BucketProjects"
                                         IsChecked="{Binding SelectedBucket, Converter={StaticResource EnumMatch},
                                                     ConverterParameter={x:Static vm:ProjectBucket.Projects}, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource BucketTab}" Content="Shelf"
                                         AutomationProperties.AutomationId="Projects_BucketShelf"
                                         IsChecked="{Binding SelectedBucket, Converter={StaticResource EnumMatch},
                                                     ConverterParameter={x:Static vm:ProjectBucket.Shelf}, Mode=TwoWay}"/>
                            <RadioButton Style="{StaticResource BucketTab}" Content="Archives"
                                         AutomationProperties.AutomationId="Projects_BucketArchive"
                                         IsChecked="{Binding SelectedBucket, Converter={StaticResource EnumMatch},
                                                     ConverterParameter={x:Static vm:ProjectBucket.Archive}, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <vcc:SearchStatusChip PagePrefix="Projects" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource IconButton}"
                                    AutomationProperties.AutomationId="Projects_Refresh"
                                    ToolTip="Refresh" Command="{Binding RefreshCommand}">
                                <TextBlock Text="↻" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- List -->
                <Grid Grid.Row="1">
                    <TextBlock Text="No projects here" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                               Visibility="{Binding ProjectCount, Converter={StaticResource ZeroVis}}"/>

                    <ListView ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              AutomationProperties.AutomationId="Projects_List"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              ItemContainerStyle="{StaticResource ProjectRowStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectSummaryItem}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding DescriptionPreview}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding CountsText}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" Cursor="SizeWE"/>

            <!-- ══ RIGHT: detail panel ═════════════════════════════════════════ -->
            <Grid Grid.Column="2">

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"
                            Visibility="{Binding SelectedProject, Converter={StaticResource NullCollapsed}}">
                    <TextBlock Text="🗂" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a project" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Detail -->
                <Grid Visibility="{Binding SelectedProject, Converter={StaticResource NullVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- name + last modified -->
                    <Grid Grid.Row="0" Margin="32,28,32,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding SelectedProject.DisplayName}"
                                   FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,0">
                            <TextBlock Text="Last modified" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding SelectedProject.LastModified}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <!-- status pie (markdown) + description -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="32,0,32,0">
                        <md:SelectableMarkdownView Markdown="{Binding SelectedProject.DetailMarkdown}"/>
                    </ScrollViewer>

                    <!-- action buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="32,12,32,28">
                        <Button Style="{StaticResource AccentButton}" Margin="0,0,10,0"
                                AutomationProperties.AutomationId="Projects_OpenProject"
                                Command="{Binding OpenProjectCommand}" CommandParameter="{Binding SelectedProject}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Open Project"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                AutomationProperties.AutomationId="Projects_OpenFiles"
                                Command="{Binding OpenFilesCommand}" CommandParameter="{Binding SelectedProject}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗁" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Open Files"/>
                            </StackPanel>
                        </Button>

                        <!-- Projects bucket: Archive + Shelf -->
                        <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                AutomationProperties.AutomationId="Projects_Archive"
                                Visibility="{Binding CanArchiveOrShelf, Converter={StaticResource BoolVis}}"
                                Command="{Binding ArchiveCommand}" CommandParameter="{Binding SelectedProject}">
                            <TextBlock Text="Archive"/>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                AutomationProperties.AutomationId="Projects_Shelf"
                                Visibility="{Binding CanArchiveOrShelf, Converter={StaticResource BoolVis}}"
                                Command="{Binding ShelfCommand}" CommandParameter="{Binding SelectedProject}">
                            <TextBlock Text="Shelf"/>
                        </Button>

                        <!-- Shelf / Archive bucket: Reactivate -->
                        <Button Style="{StaticResource GhostButton}"
                                AutomationProperties.AutomationId="Projects_Reactivate"
                                Visibility="{Binding CanReactivate, Converter={StaticResource BoolVis}}"
                                Command="{Binding ReactivateCommand}" CommandParameter="{Binding SelectedProject}">
                            <TextBlock Text="Reactivate"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Moving overlay (replaces the detail while a background move runs) -->
                <Border Background="{StaticResource BgBrush}" Panel.ZIndex="10"
                        Visibility="{Binding IsMoving, Converter={StaticResource BoolVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="{Binding MovingMessage}" Foreground="{StaticResource TextBrush}"
                                   FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
