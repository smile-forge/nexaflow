<UserControl x:Class="Nexaflow.Features.Dotnet.Viewlets.DotnetViewletView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="Dotnet_Viewlet">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="7,3"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <!-- .NET strip -->
            <ColumnDefinition Width="44"/>
            <!-- content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left: .NET strip ─────────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{DynamicResource AccentSubtleBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <TextBlock Text=".NET"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ── Right: toolbar ───────────────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="9,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- target picker / label -->
                <ColumnDefinition Width="Auto"/>  <!-- verb buttons -->
                <ColumnDefinition Width="Auto"/>  <!-- status glyph -->
                <ColumnDefinition Width="*"/>     <!-- running progress / spacer -->
                <ColumnDefinition Width="Auto"/>  <!-- caution -->
            </Grid.ColumnDefinitions>

            <!-- Target: a caret menu-button when there's a choice, a plain label when there isn't — but the
                 open-in-default-app button is always there, so the affordance never moves. -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <Button x:Name="TargetButton"
                        AutomationProperties.AutomationId="Dotnet_TargetButton"
                        Style="{StaticResource FlatBtn}"
                        Padding="4,2"
                        MaxWidth="220"
                        Click="TargetButton_Click"
                        ToolTip="Target solution / project"
                        Visibility="{Binding ShowTargetPicker, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedTarget.DisplayName}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock VerticalAlignment="Center"
                           Margin="4,0,0,0"
                           FontSize="11"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="220"
                           Foreground="{DynamicResource TextBrush}"
                           Text="{Binding SelectedTarget.DisplayName}"
                           ToolTip="{Binding SelectedTarget.Path}"
                           Visibility="{Binding ShowTargetLabel, Converter={StaticResource BoolVis}}"/>

                <Button AutomationProperties.AutomationId="Dotnet_OpenTargetButton"
                        Style="{StaticResource FlatBtn}"
                        Content="↗"
                        FontSize="13"
                        Margin="2,0,0,0"
                        Command="{Binding OpenTargetCommand}"
                        ToolTip="{Binding SelectedTarget.Path}"/>
            </StackPanel>

            <!-- Verb buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource FlatBtn}" Content="Restore"
                        Command="{Binding RestoreCommand}" ToolTip="dotnet restore"/>
                <Button Style="{StaticResource FlatBtn}" Content="Build"
                        Command="{Binding BuildCommand}"   ToolTip="dotnet build"/>
                <Button AutomationProperties.AutomationId="Dotnet_RunButton"
                        Style="{StaticResource FlatBtn}" Content="Run"
                        Command="{Binding RunCommand}"     ToolTip="{Binding RunTooltip}"/>
                <!-- Which project a solution runs is a guess until the user says otherwise — offer the
                     choice only when there is one. -->
                <Button x:Name="StartupButton"
                        AutomationProperties.AutomationId="Dotnet_StartupButton"
                        Style="{StaticResource FlatBtn}"
                        Content="▾"
                        FontSize="9"
                        Padding="3,3"
                        Margin="-5,0,0,0"
                        Click="StartupButton_Click"
                        ToolTip="Choose the project to run"
                        Visibility="{Binding ShowStartupPicker, Converter={StaticResource BoolVis}}"/>
                <Button Style="{StaticResource FlatBtn}" Content="Test"
                        Command="{Binding TestCommand}"    ToolTip="dotnet test"/>
                <Button Style="{StaticResource FlatBtn}" Content="Clean"
                        Command="{Binding CleanCommand}"   ToolTip="dotnet clean"/>
            </StackPanel>

            <!-- Status glyph -->
            <TextBlock Grid.Column="2"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="Bold"
                       Text="{Binding StatusGlyph}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusGlyph}" Value="✓">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusGlyph}" Value="✗">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Running progress: "Building" + animated dots / latest output line -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding RunningLabel}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock x:Name="EllipsisText"
                           Text="..."
                           MinWidth="16"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{Binding ProgressDetail}"
                           Margin="6,0,0,0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <!-- Stop: kills the process tree. The only way out of a `run`, which has no watchdog. -->
                <Button AutomationProperties.AutomationId="Dotnet_StopButton"
                        Style="{StaticResource FlatBtn}"
                        Content="✕"
                        FontSize="11"
                        Margin="6,0,0,0"
                        Foreground="{DynamicResource DangerBrush}"
                        Command="{Binding CancelVerbCommand}"
                        ToolTip="Stop"/>
            </StackPanel>

            <!-- Caution: NuGet updates available -->
            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasUpdates, Converter={StaticResource BoolVis}}">
                <StackPanel.ToolTip>
                    <TextBlock Text="{Binding UpdatesTooltip}" TextAlignment="Left"/>
                </StackPanel.ToolTip>
                <TextBlock Text="⚠"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock Text="Package updates available"
                           Margin="4,0,0,0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
