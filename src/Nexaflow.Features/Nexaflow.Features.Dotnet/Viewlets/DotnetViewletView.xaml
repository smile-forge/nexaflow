<UserControl x:Class="Nexaflow.Features.Dotnet.Viewlets.DotnetViewletView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- Target label rendered as a link: accent-coloured, underline on hover, hand cursor.
             Overrides the default Hyperlink template's hard-coded hover colour to stay theme-correct. -->
        <Style x:Key="TargetLink" TargetType="Hyperlink">
            <Setter Property="Foreground"      Value="{DynamicResource AccentBrush}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="7,3"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <!-- .NET strip -->
            <ColumnDefinition Width="44"/>
            <!-- content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left: .NET strip ─────────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{DynamicResource AccentSubtleBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <TextBlock Text=".NET"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ── Right: toolbar ───────────────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="9,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>  <!-- target picker / label -->
                <ColumnDefinition Width="Auto"/>  <!-- verb buttons -->
                <ColumnDefinition Width="Auto"/>  <!-- status glyph -->
                <ColumnDefinition Width="*"/>     <!-- running progress / spacer -->
                <ColumnDefinition Width="Auto"/>  <!-- caution -->
            </Grid.ColumnDefinitions>

            <!-- Target picker (multiple targets) + open button for the selected file -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Visibility="{Binding ShowTargetPicker, Converter={StaticResource BoolVis}}">
                <ComboBox VerticalAlignment="Center"
                          MinWidth="120" MaxWidth="220"
                          ItemsSource="{Binding Targets}"
                          SelectedItem="{Binding SelectedTarget}"
                          DisplayMemberPath="DisplayName"
                          ToolTip="Target solution / project"/>
                <Button Style="{StaticResource FlatBtn}"
                        Content="↗"
                        FontSize="13"
                        Margin="2,0,0,0"
                        Command="{Binding OpenTargetCommand}"
                        ToolTip="{Binding SelectedTarget.Path}"/>
            </StackPanel>

            <!-- Target label (single target) — a link that opens the file with its default OS handler -->
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="220"
                       Visibility="{Binding ShowTargetLabel, Converter={StaticResource BoolVis}}">
                <Hyperlink Style="{StaticResource TargetLink}"
                           Command="{Binding OpenTargetCommand}"
                           ToolTip="{Binding SelectedTarget.Path}">
                    <Run Text="{Binding SelectedTarget.DisplayName}"/>
                </Hyperlink>
            </TextBlock>

            <!-- Verb buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource FlatBtn}" Content="Restore"
                        Command="{Binding RestoreCommand}" ToolTip="dotnet restore"/>
                <Button Style="{StaticResource FlatBtn}" Content="Build"
                        Command="{Binding BuildCommand}"   ToolTip="dotnet build"/>
                <Button Style="{StaticResource FlatBtn}" Content="Run"
                        Command="{Binding RunCommand}"     ToolTip="dotnet run"/>
                <Button Style="{StaticResource FlatBtn}" Content="Test"
                        Command="{Binding TestCommand}"    ToolTip="dotnet test"/>
                <Button Style="{StaticResource FlatBtn}" Content="Clean"
                        Command="{Binding CleanCommand}"   ToolTip="dotnet clean"/>
            </StackPanel>

            <!-- Status glyph -->
            <TextBlock Grid.Column="2"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="Bold"
                       Text="{Binding StatusGlyph}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusGlyph}" Value="✓">
                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusGlyph}" Value="✗">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Running progress: "Building" + animated dots / latest output line -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding RunningLabel}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock x:Name="EllipsisText"
                           Text="..."
                           MinWidth="16"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{Binding ProgressDetail}"
                           Margin="6,0,0,0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>

            <!-- Caution: NuGet updates available -->
            <StackPanel Grid.Column="4"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasUpdates, Converter={StaticResource BoolVis}}">
                <StackPanel.ToolTip>
                    <TextBlock Text="{Binding UpdatesTooltip}" TextAlignment="Left"/>
                </StackPanel.ToolTip>
                <TextBlock Text="⚠"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"/>
                <TextBlock Text="Package updates available"
                           Margin="4,0,0,0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
