<UserControl x:Class="Nexaflow.Features.Web.Views.HtmlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="Web_View"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <Style x:Key="ToolbarBtnStyle" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="8,5"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent button used on the WebView-unavailable fallback panel -->
        <Style x:Key="AccentBtnStyle" TargetType="Button">
            <Setter Property="Background"  Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"  Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="Padding"     Value="16,8"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>    <!-- WebView2 -->
        </Grid.RowDefinitions>

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- nav buttons  -->
                    <ColumnDefinition Width="*"/>      <!-- url bar      -->
                    <ColumnDefinition Width="Auto"/>   <!-- reload       -->
                </Grid.ColumnDefinitions>

                <!-- Back / Forward -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="BackButton"
                            Style="{StaticResource ToolbarBtnStyle}"
                            AutomationProperties.AutomationId="Web_Back"
                            Click="Back_Click"
                            ToolTip="Back"
                            Margin="0,0,4,0">
                        <TextBlock Text="◀" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                    <Button x:Name="ForwardButton"
                            Style="{StaticResource ToolbarBtnStyle}"
                            AutomationProperties.AutomationId="Web_Forward"
                            Click="Forward_Click"
                            ToolTip="Forward">
                        <TextBlock Text="▶" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </StackPanel>

                <!-- URL bar -->
                <Border Grid.Column="1"
                        Background="{StaticResource DeepBgBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,0"
                        Margin="0,6">
                    <TextBlock x:Name="UrlBar"
                               AutomationProperties.AutomationId="Web_Address"
                               Text="{Binding CurrentUrl}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- Reload + open-in-default-browser -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Style="{StaticResource ToolbarBtnStyle}"
                            AutomationProperties.AutomationId="Web_Reload"
                            Click="Reload_Click"
                            ToolTip="Reload">
                        <TextBlock Text="↺" FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtnStyle}"
                            AutomationProperties.AutomationId="Web_OpenExternal"
                            Click="OpenExternal_Click"
                            ToolTip="Open in your default browser"
                            Margin="6,0,0,0">
                        <TextBlock Text="↗" FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading indicator -->
        <Border Grid.Row="1"
                Background="{StaticResource BgBrush}"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="10">
            <TextBlock Text="Loading…"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- WebView2.
             • Visibility collapses while a shell overlay covers the page (WebViewVisible) — the WebView's
               native HWND renders above all WPF content, so the AI/Options overlays would otherwise be hidden.
             • Left/right margin keeps the WebView's HWND clear of the window's WindowChrome resize border,
               which it would otherwise swallow (making the window's side edges un-draggable). -->
        <wv2:WebView2 x:Name="WebView"
                      Grid.Row="1"
                      Margin="8,0"
                      Visibility="{Binding WebViewVisible, Converter={StaticResource BoolToVis}}"
                      NavigationStarting="WebView_NavigationStarting"
                      NavigationCompleted="WebView_NavigationCompleted"/>

        <!-- Fallback shown when the embedded browser can't be created on this machine -->
        <Border Grid.Row="1"
                Background="{StaticResource BgBrush}"
                Panel.ZIndex="20"
                Visibility="{Binding WebViewAvailable, Converter={StaticResource InvBoolVis}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">
                <TextBlock Text="🌐"
                           FontSize="40"
                           HorizontalAlignment="Center"
                           Opacity="0.6"
                           Margin="0,0,0,12"/>
                <TextBlock Text="Can't show the embedded browser"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding FailureMessage}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CurrentUrl}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12"
                           Opacity="0.8"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="40"
                           TextAlignment="Center"
                           Margin="0,0,0,18"/>
                <Button Style="{StaticResource AccentBtnStyle}"
                        HorizontalAlignment="Center"
                        Click="OpenExternal_Click"
                        Content="Open in your default browser"/>

                <!-- Only shown when the failure is a missing WebView2 runtime -->
                <TextBlock HorizontalAlignment="Center"
                           FontSize="12"
                           Margin="0,16,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding RuntimeMissing, Converter={StaticResource BoolToVis}}">
                    <Hyperlink NavigateUri="https://developer.microsoft.com/en-us/microsoft-edge/webview2/consumer/"
                               Foreground="{StaticResource AccentBrush}"
                               RequestNavigate="InstallRuntime_RequestNavigate">
                        Install the Microsoft Edge WebView2 runtime
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
