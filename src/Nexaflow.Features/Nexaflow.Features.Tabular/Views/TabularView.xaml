<UserControl x:Class="Nexaflow.Features.Tabular.Views.TabularView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nexaflow.Features.Tabular.Views"
             xmlns:vm="clr-namespace:Nexaflow.Features.Tabular.ViewModels"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <cv:NullToCollapsedConverter  x:Key="NullVis"/>

        <Style x:Key="TbBtn" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="8,5"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground"                  Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TbToggle" TargetType="ToggleButton">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="8,5"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground"                  Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground"                  Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar -->
            <RowDefinition Height="*"/>     <!-- grid + filter slide-out -->
            <RowDefinition Height="Auto"/>  <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ══ Toolbar ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <TextBlock Text="{Binding DetectedShapeLabel}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="2,0,12,0"
                           FontSize="11"/>
                <TextBlock Text="Click a column header to select it; right-click for column actions."
                           Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           FontSize="11"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource OrangeBrush}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- ══ Grid + filter side panel ══════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <local:VirtualizedRowsControl Grid.Column="0"
                                          x:Name="GridControl"
                                          Columns="{Binding Columns}"
                                          Rows="{Binding Window}"
                                          TotalRowCount="{Binding TotalRowCount, FallbackValue=150}"
                                          IsSortable="{Binding IsSmallMode}"
                                          CommentTooltip="{Binding CommentTooltip}"/>

            <!-- Filter side panel — slides in when IsFilterPanelOpen=true -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Width="280"
                    Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,12">
                        <TextBlock Text="Filters" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="FiltersHost"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══ Footer ═════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="8,4">
                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="{Binding FileName, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="12,0,0,0">
                    <Run Text="rows: "/>
                    <Run Text="{Binding KnownRowCount, Mode=OneWay, TargetNullValue=counting…}"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="12,0,0,0">
                    <Run Text="encoding: "/>
                    <Run Text="{Binding EncodingName, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="12,0,0,0"
                           Visibility="{Binding IsSmallMode, Converter={StaticResource BoolVis}}">
                    <Run Text="(small — sort enabled)"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{StaticResource OrangeBrush}" Margin="12,0,0,0"
                           Visibility="{Binding IsCountingRows, Converter={StaticResource BoolVis}}">
                    <Run Text="⟳ counting rows…"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
