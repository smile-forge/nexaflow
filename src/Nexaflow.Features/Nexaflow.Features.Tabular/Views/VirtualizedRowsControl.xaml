<UserControl x:Class="Nexaflow.Features.Tabular.Views.VirtualizedRowsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header strip -->
            <RowDefinition Height="*"/>     <!-- body + vertical scrollbar -->
            <RowDefinition Height="Auto"/>  <!-- horizontal scrollbar -->
        </Grid.RowDefinitions>

        <!-- Column header strip -->
        <Border Grid.Row="0"
                Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer x:Name="HeaderScroller"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel x:Name="HeaderHost" Orientation="Horizontal"/>
            </ScrollViewer>
        </Border>

        <!-- Body: vertically stacked rows + dedicated vertical scrollbar that represents the
             whole file's row range (rows show the current 150-row window slice from focal). -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          x:Name="BodyScroller"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          ScrollChanged="OnBodyScrollChanged">
                <StackPanel x:Name="RowsHost"
                            Orientation="Vertical"
                            VerticalAlignment="Top"/>
            </ScrollViewer>

            <ScrollBar Grid.Column="1"
                       x:Name="VScroll"
                       Orientation="Vertical"
                       Minimum="0"
                       SmallChange="1"
                       LargeChange="10"
                       ValueChanged="OnVScrollValueChanged"/>
        </Grid>

        <ScrollBar Grid.Row="2"
                   x:Name="HScroll"
                   Orientation="Horizontal"
                   Minimum="0"
                   SmallChange="20"
                   LargeChange="200"
                   ValueChanged="OnHScrollValueChanged"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
