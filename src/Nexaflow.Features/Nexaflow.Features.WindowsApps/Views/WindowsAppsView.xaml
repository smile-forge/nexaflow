<UserControl x:Class="Nexaflow.Features.WindowsApps.Views.WindowsAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.WindowsApps.ViewModels"
             xmlns:conv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="WindowsAppsView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Right-edge filler header -->
        <ControlTemplate x:Key="GvColHeaderPaddingTemplate" TargetType="GridViewColumnHeader">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"/>
        </ControlTemplate>

        <!-- Column header style -->
        <Style x:Key="GvColHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper"
                                   HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0"
                                   Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Role" Value="Padding">
                    <Setter Property="Template" Value="{StaticResource GvColHeaderPaddingTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sortable header (DataContext = vm:SortableHeader); click handled at ListView level -->
        <DataTemplate x:Key="SortHeaderTemplate" DataType="{x:Type vm:SortableHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{x:Static conv:SortBrushConverter.Instance}">
                            <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=ListView}"/>
                            <Binding Path="Key"/>
                        </MultiBinding>
                    </TextBlock.Foreground>
                    <TextBlock.Text>
                        <MultiBinding Converter="{x:Static conv:SortGlyphConverter.Instance}">
                            <Binding Path="DataContext.SortColumn"    RelativeSource="{RelativeSource AncestorType=ListView}"/>
                            <Binding Path="DataContext.SortAscending" RelativeSource="{RelativeSource AncestorType=ListView}"/>
                            <Binding Path="Key"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- Row style: themed selection / hover -->
        <Style x:Key="AppRowStyle" TargetType="ListViewItem">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"                    Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg" Background="Transparent" CornerRadius="4" Margin="2,1">
                            <GridViewRowPresenter
                                Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="RowBg" Property="Background"      Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="RowBg" Property="BorderBrush"     Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="RowBg" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected"  Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain text cell -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Foreground"     Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming"   Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header bar: status + refresh (filtering is driven by the shell query handler) ── -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Discovering… (animated dots) while loading -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Discovering" Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                <TextBlock Width="20" Foreground="{StaticResource TextMutedBrush}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="DotsStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <StringAnimationUsingKeyFrames
                                                        Storyboard.TargetProperty="Text" Duration="0:0:1.2">
                                                    <DiscreteStringKeyFrame Value=""    KeyTime="0:0:0"/>
                                                    <DiscreteStringKeyFrame Value="."   KeyTime="0:0:0.3"/>
                                                    <DiscreteStringKeyFrame Value=".."  KeyTime="0:0:0.6"/>
                                                    <DiscreteStringKeyFrame Value="..." KeyTime="0:0:0.9"/>
                                                </StringAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="DotsStoryboard"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- App count once loaded -->
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="{Binding Apps.Count, StringFormat={}{0} applications}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                    AutomationProperties.AutomationId="WindowsApps_Refresh"
                    Foreground="{StaticResource TextBrush}" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="12,5" Cursor="Hand"/>
        </Grid>

        <!-- ── App list ─────────────────────────────────────────────────────── -->
        <ListView Grid.Row="1" x:Name="AppListView"
                  AutomationProperties.AutomationId="WindowsApps_List"
                  ItemsSource="{Binding Apps}"
                  ItemContainerStyle="{StaticResource AppRowStyle}"
                  Background="{StaticResource BgBrush}" BorderThickness="0"
                  SelectionMode="Extended"
                  SelectionChanged="AppListView_SelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource GvColHeaderStyle}">

                    <!-- Name -->
                    <GridViewColumn Width="320" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                        <GridViewColumn.Header>
                            <vm:SortableHeader Label="Name" Key="Name"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:InstalledAppItem}">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                           FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Publisher -->
                    <GridViewColumn Width="200" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                        <GridViewColumn.Header>
                            <vm:SortableHeader Label="Publisher" Key="Publisher"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:InstalledAppItem}">
                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Version -->
                    <GridViewColumn Width="110" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                        <GridViewColumn.Header>
                            <vm:SortableHeader Label="Version" Key="Version"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:InstalledAppItem}">
                                <TextBlock Text="{Binding Version}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Install Date -->
                    <GridViewColumn Width="110" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                        <GridViewColumn.Header>
                            <vm:SortableHeader Label="Installed" Key="InstallDate"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:InstalledAppItem}">
                                <TextBlock Text="{Binding InstallDateText}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Size -->
                    <GridViewColumn Width="90" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                        <GridViewColumn.Header>
                            <vm:SortableHeader Label="Size" Key="SizeBytes"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:InstalledAppItem}">
                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Source -->
                    <GridViewColumn Width="70" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                        <GridViewColumn.Header>
                            <vm:SortableHeader Label="Source" Key="SourceLabel"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:InstalledAppItem}">
                                <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!-- Actions dropdown -->
                    <GridViewColumn Width="44" Header="">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:InstalledAppItem}">
                                <Button Content="⋯" Click="RowMenu_Click"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Background="Transparent" BorderThickness="0"
                                        FontSize="16" Padding="6,0" Cursor="Hand"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        ToolTip="Actions">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open Location" Click="OpenLocationMenuItem_Click"
                                                      IsEnabled="{Binding HasLocation}"
                                                      Foreground="{StaticResource TextBrush}"/>
                                            <MenuItem Header="Remove from list" Click="DeleteRecordMenuItem_Click"
                                                      Visibility="{Binding IsOrphaned, Converter={StaticResource BoolToVis}}"
                                                      Foreground="{StaticResource WarningBrush}"/>
                                            <Separator/>
                                            <MenuItem Header="Uninstall" Click="UninstallMenuItem_Click"
                                                      Foreground="{StaticResource DangerBrush}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
