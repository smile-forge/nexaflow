<UserControl x:Class="Nexaflow.Features.WindowsApps.Views.AppAdvancedOptionsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.WindowsApps.ViewModels"
             xmlns:m="clr-namespace:Nexaflow.Features.WindowsApps.Models"
             xmlns:conv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="WindowsApps_AdvancedPane">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- Section heading -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- Explanatory body copy under a heading -->
        <Style x:Key="SectionBody" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,0,0,8"/>
        </Style>

        <!-- One card per section -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="12"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
        </Style>

        <!-- Action button inside a card -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reset is the destructive one — same shape, danger outline -->
        <Style x:Key="DangerCardButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Foreground"  Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- "label / value" lines in the identity card -->
        <Style x:Key="FactLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,0,10,2"/>
        </Style>
        <Style x:Key="FactValue" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Margin"       Value="0,0,0,2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- "no add-ons" — only claimed once the scan has actually run -->
        <Style x:Key="NoAddOns" TargetType="TextBlock" BasedOn="{StaticResource SectionBody}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding AddOnsScanned}" Value="True"/>
                        <Condition Binding="{Binding AddOns.Count}"  Value="0"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Pane header ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="12,10,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Advanced options" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="{Binding Item.Name}" FontSize="11" Margin="0,2,0,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource TbBtn}" VerticalAlignment="Top"
                    AutomationProperties.AutomationId="WindowsApps_AdvancedClose"
                    Command="{Binding CloseCommand}" ToolTip="Close advanced options">
                <TextBlock Text="✕" FontSize="12"/>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="12,0,12,12">
            <StackPanel>

                <!-- ── Identity ─────────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Publisher" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Item.Publisher}" Style="{StaticResource FactValue}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Item.Version}" Style="{StaticResource FactValue}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Installed" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Item.InstallDateText}" Style="{StaticResource FactValue}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Size" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Item.SizeText}" Style="{StaticResource FactValue}"/>
                    </Grid>
                </Border>

                <!-- ── Background execution ─────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Background apps permissions" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Let this app run in background" Style="{StaticResource SectionBody}"/>

                        <ComboBox Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                  AutomationProperties.AutomationId="WindowsApps_BackgroundMode"
                                  ItemsSource="{Binding BackgroundModes}"
                                  SelectedItem="{Binding SelectedBackgroundMode, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BackgroundModeOption}">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{Binding SelectedBackgroundMode.Description}"
                                   Style="{StaticResource SectionBody}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── Terminate ────────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Terminate" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource SectionBody}"
                                   Text="Immediately stop this app and its background processes. Anything it hasn't saved is lost."/>
                        <Button Content="Terminate" Style="{StaticResource CardButton}"
                                AutomationProperties.AutomationId="WindowsApps_Terminate"
                                Command="{Binding TerminateCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ── Repair ───────────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Repair" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource SectionBody}"
                                   Text="Re-register the app from its own files. Your data stays where it is — try this first."/>
                        <Button Content="Repair" Style="{StaticResource CardButton}"
                                AutomationProperties.AutomationId="WindowsApps_Repair"
                                Command="{Binding RepairCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ── Reset ────────────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Reset" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource SectionBody}"
                                   Text="Delete the app's data, settings and sign-in details, then reinstall it from scratch. This can't be undone."/>
                        <Button Content="Reset" Style="{StaticResource DangerCardButton}"
                                AutomationProperties.AutomationId="WindowsApps_Reset"
                                Command="{Binding ResetCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ── Move ─────────────────────────────────────────────────── -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <!-- Opened via the row's "Move…" entry — mark the card the user came for. -->
                                <DataTrigger Binding="{Binding MoveHighlighted}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Move" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource SectionBody}"
                                   Text="Relocate this app's files to another drive. Its data and settings move with it."/>

                        <StackPanel Visibility="{Binding HasMoveTarget, Converter={StaticResource BoolToVis}}">
                            <ComboBox Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      AutomationProperties.AutomationId="WindowsApps_MoveVolume"
                                      ItemsSource="{Binding Volumes}"
                                      SelectedItem="{Binding SelectedVolume, Mode=TwoWay}"
                                      DisplayMemberPath="Display"
                                      HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                            <Button Content="Move" Style="{StaticResource CardButton}"
                                    AutomationProperties.AutomationId="WindowsApps_Move"
                                    Command="{Binding MoveCommand}"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionBody}" Margin="0,2,0,0"
                                   Visibility="{Binding HasMoveTarget, Converter={StaticResource InvBoolToVis}}"
                                   Text="This PC has only one drive that can hold apps, so there's nowhere to move it."/>
                    </StackPanel>
                </Border>

                <!-- ── Add-ons ──────────────────────────────────────────────── -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="App add-ons &amp; downloadable content"
                                       Style="{StaticResource SectionTitle}"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Style="{StaticResource TbBtn}"
                                    AutomationProperties.AutomationId="WindowsApps_RefreshAddOns"
                                    Command="{Binding RefreshAddOnsCommand}" ToolTip="Rescan for add-ons">
                                <TextBlock Text="⟳" FontSize="12"/>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding AddOns}"
                                      AutomationProperties.AutomationId="WindowsApps_AddOns">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:AppAddOn}">
                                    <Border Background="{StaticResource Surface2Brush}"
                                            CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource StringToVis}}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="8,0"
                                                       Foreground="{StaticResource TextMutedBrush}"/>

                                            <Button Grid.Column="2" Content="Remove" FontSize="11"
                                                    Style="{StaticResource CardButton}" Padding="8,3"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.RemoveAddOnCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource NoAddOns}" Margin="0,2,0,0"
                                   AutomationProperties.AutomationId="WindowsApps_NoAddOns"
                                   Text="This app has no add-ons or downloadable content."/>
                    </StackPanel>
                </Border>

                <!-- ── Last operation's outcome ─────────────────────────────── -->
                <TextBlock Text="{Binding Status}" Style="{StaticResource SectionBody}"
                           AutomationProperties.AutomationId="WindowsApps_AdvancedStatus"
                           Foreground="{StaticResource SuccessBrush}"
                           Visibility="{Binding Status, Converter={StaticResource StringToVis}}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Busy veil over the body only, so the pane can still be closed while an operation runs. -->
        <Border Grid.Row="1" Background="{StaticResource BgBrush}" Opacity="0.55"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>
