<UserControl x:Class="Nexaflow.Features.Rtf.Views.RtfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown;assembly=Nexaflow.Visuals.Text"
             xmlns:ed="clr-namespace:Nexaflow.Visuals.Text.Editor;assembly=Nexaflow.Visuals.Text"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:vc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="RtfView"
             Background="{StaticResource BgBrush}">

    <UserControl.InputBindings>
        <KeyBinding Key="D0"       Modifiers="Control" Command="{Binding Zoom.ResetZoomCommand}"/>
        <KeyBinding Key="OemPlus"  Modifiers="Control" Command="{Binding Zoom.ZoomInCommand}"/>
        <KeyBinding Key="Add"      Modifiers="Control" Command="{Binding Zoom.ZoomInCommand}"/>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding Zoom.ZoomOutCommand}"/>
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding Zoom.ZoomOutCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- search chip, while a search is shown -->
            <RowDefinition Height="*"/>    <!-- document -->
            <RowDefinition Height="28"/>   <!-- footer   -->
        </Grid.RowDefinitions>

        <!-- What a "?" search found, and how to step through or dismiss it: there only while there is a search to show. -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6"
                Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVis}}">
            <vc:SearchStatusChip PagePrefix="Rtf" HorizontalAlignment="Left"/>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             DOCUMENT — drawn by the shared renderer's RTF language, in the theme's colours wherever the document leaves
             them to the reader (+ minimap match strip)
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
            </Grid.ColumnDefinitions>

            <!-- The reading inset is ContentPadding, not a Margin, so the scrollbar sits flush against the minimap. -->
            <md:MarkdownSurface x:Name="Document"
                                Grid.Column="0"
                                ContentPadding="48,32,48,56"
                                IsReadOnly="True"
                                VerticalScrollBarVisibility="Auto"
                                BaseFontSize="{Binding Zoom.FontSize}"
                                AutomationProperties.AutomationId="Rtf_Document"
                                WrittenIn="{Binding Language, Mode=OneTime}"
                                Markdown="{Binding Document}"/>

            <!-- Shown in place of the document when there is none to show, and why. -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16,12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap" MaxWidth="420"/>
            </Border>

            <ed:MiniMapStrip x:Name="MiniMapCanvas"
                             Grid.Column="1"
                             Background="{StaticResource DeepBgBrush}"/>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             FOOTER
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource DeepBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <TextBlock Text="{loc:Str Rtf.Footer.Kind}"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding WordCount, StringFormat={loc:Str Rtf.Footer.WordsFormat}}"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding ParagraphCount, StringFormat={loc:Str Rtf.Footer.ParagraphsFormat}}"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding FileSizeText}"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
