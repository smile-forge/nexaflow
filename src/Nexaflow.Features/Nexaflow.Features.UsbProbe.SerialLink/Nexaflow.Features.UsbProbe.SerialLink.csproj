<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The device page's serial link (Phase 2, H5), as a subfeature plugin: found by its [Subfeature("usbprobe", ...)]
    attribute, so the device page references none of it. It names a CDC function's COM port and opens the Serial page
    on it by page kind — the terminal is that feature's, and this references no feature.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Nexaflow.IO.Usb\Nexaflow.IO.Usb.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Plugins.Contracts\Nexaflow.Plugins.Contracts.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Visuals.Common\Nexaflow.Visuals.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexaflow.Tests.Features.WindowsOS" />
  </ItemGroup>

</Project>
