<UserControl x:Class="Nexaflow.Features.SystemInfo.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexaflow.Features.SystemInfo.Converters"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Margin"          Value="0,0,4,0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header: title + status + search + refresh ── -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Windows Services"
                       Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1" Text="Gathering…" Margin="14,0,0,0"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <!-- Left of the box it drives, so the count and the query it came from read together. -->
            <vcc:SearchStatusChip Grid.Column="2" PagePrefix="Services"
                                  HorizontalAlignment="Left" Margin="14,0,0,0"/>

            <TextBox Grid.Column="2" Margin="14,0,8,0" MaxWidth="320" HorizontalAlignment="Right"
                     VerticalContentAlignment="Center" Padding="8,4"
                     Background="{StaticResource DeepBgBrush}" Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter by name or display name"/>

            <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}"
                    Foreground="{StaticResource TextBrush}" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="12,5" Cursor="Hand"/>
        </Grid>

        <!-- ── Services grid ── -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding ServicesView}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                      SelectionUnit="FullRow" FontSize="12" Foreground="{StaticResource TextBrush}"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      ColumnHeaderHeight="32" RowHeight="34"
                      VirtualizingPanel.IsVirtualizing="True"
                      ScrollViewer.CanContentScroll="True">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"          Value="{StaticResource DeepBgBrush}"/>
                        <Setter Property="Foreground"          Value="{StaticResource TextMutedBrush}"/>
                        <Setter Property="FontSize"            Value="11"/>
                        <Setter Property="FontWeight"          Value="SemiBold"/>
                        <Setter Property="Padding"             Value="8,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush"         Value="{StaticResource BorderBrush}"/>
                        <Setter Property="BorderThickness"     Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                        <Setter Property="Background"      Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Service" Width="2*" CanUserSort="True"
                                            SortMemberPath="DisplayName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Description}"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Margin="8,0" VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={x:Static conv:ServiceStatusToBrushConverter.Instance}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Startup Type" Width="170" SortMemberPath="StartMode">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Margin="6,4" FontSize="11"
                                          ItemsSource="{Binding DataContext.StartModes,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding StartMode, Mode=OneWay}"
                                          SelectionChanged="StartMode_SelectionChanged"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Actions" Width="2*" MinWidth="280">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                    <Button Content="Start" Style="{StaticResource RowButton}"
                                            IsEnabled="{Binding CanStart}"
                                            CommandParameter="{Binding}"
                                            Command="{Binding DataContext.StartServiceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Content="Stop" Style="{StaticResource RowButton}"
                                            IsEnabled="{Binding CanStop}"
                                            CommandParameter="{Binding}"
                                            Command="{Binding DataContext.StopServiceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Content="Restart" Style="{StaticResource RowButton}"
                                            IsEnabled="{Binding CanStop}"
                                            CommandParameter="{Binding}"
                                            Command="{Binding DataContext.RestartServiceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Content="Pause" Style="{StaticResource RowButton}"
                                            IsEnabled="{Binding CanPause}"
                                            CommandParameter="{Binding}"
                                            Command="{Binding DataContext.PauseServiceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    <Button Content="Resume" Style="{StaticResource RowButton}"
                                            IsEnabled="{Binding CanResume}"
                                            CommandParameter="{Binding}"
                                            Command="{Binding DataContext.ResumeServiceCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
