<UserControl x:Class="Nexaflow.Features.SystemInfo.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexaflow.Features.SystemInfo.Converters"
             xmlns:model="clr-namespace:Nexaflow.Features.SystemInfo.Models"
             AutomationProperties.AutomationId="SystemInfoView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One fact row: label on the left, value (status-coloured) on the right. -->
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type model:SystemInfoItem}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"
                           Foreground="{Binding Status, Converter={x:Static conv:StatusToBrushConverter.Instance}}"
                           TextWrapping="Wrap" VerticalAlignment="Top"
                           TextAlignment="Left"/>
            </Grid>
        </DataTemplate>

        <!-- One dashboard card per section. -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type model:SystemInfoSection}">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" Margin="0,0,12,12" Width="{Binding Width}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemTemplate}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header bar: title + status + refresh ── -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="System Information"
                       Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <!-- "Gathering…" with animated dots while loading -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Gathering" Foreground="{StaticResource TextMutedBrush}" FontSize="13"/>
                <TextBlock Width="20" Foreground="{StaticResource TextMutedBrush}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="DotsStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <StringAnimationUsingKeyFrames
                                                        Storyboard.TargetProperty="Text" Duration="0:0:1.2">
                                                    <DiscreteStringKeyFrame Value=""    KeyTime="0:0:0"/>
                                                    <DiscreteStringKeyFrame Value="."   KeyTime="0:0:0.3"/>
                                                    <DiscreteStringKeyFrame Value=".."  KeyTime="0:0:0.6"/>
                                                    <DiscreteStringKeyFrame Value="..." KeyTime="0:0:0.9"/>
                                                </StringAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="DotsStoryboard"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}"
                    AutomationProperties.AutomationId="SysInfo_Refresh"
                    Foreground="{StaticResource TextBrush}" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="12,5" Cursor="Hand"/>
        </Grid>

        <!-- ── Dashboard: cards flow into rows ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
