<UserControl x:Class="Nexaflow.Features.SystemInfo.Views.EnvironmentVariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin"  Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Themed variable-name list rows -->
        <Style x:Key="NameItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding"    Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header: title + status + scope + search + add + refresh ── -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Environment Variables"
                       Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1" Text="Gathering…" Margin="14,0,0,0"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <!-- Left of the box it drives, so the count and the query it came from read together. -->
            <vcc:SearchStatusChip Grid.Column="2" PagePrefix="EnvVars"
                                  HorizontalAlignment="Left" Margin="14,0,0,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="14,0,8,0">
                <TextBlock Text="Scope:" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="120" ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}"/>
            </StackPanel>

            <TextBox Grid.Column="3" Width="200" Margin="0,0,8,0"
                     VerticalContentAlignment="Center" Padding="8,4"
                     Background="{StaticResource DeepBgBrush}" Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filter by name or value"/>

            <Button Grid.Column="4" Content="Add" Command="{Binding AddNewCommand}" Style="{StaticResource ActionButton}"/>
            <Button Grid.Column="5" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButton}"/>
        </Grid>

        <!-- ── Master / detail ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Names -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
                <ListBox ItemsSource="{Binding VariablesView}" SelectedItem="{Binding SelectedVariable}"
                         Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NameItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Detail -->
            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Background="{StaticResource SurfaceBrush}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selected name + scope -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="{Binding SelectedVariable.Name, FallbackValue='(no variable selected)'}"
                                   Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"/>
                        <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="3"
                                Background="{StaticResource DeepBgBrush}" VerticalAlignment="Center"
                                Visibility="{Binding CanEditSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedVariable.Scope}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Value" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" Margin="0,0,0,4"/>

                    <!-- Generous multiline value editor -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Background="{StaticResource DeepBgBrush}">
                        <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsEditorReadOnly}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent" Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="12" Padding="8" MinHeight="120"/>
                    </Border>

                    <!-- PATH-style entry editor -->
                    <Border Grid.Row="3" Margin="0,10,0,0" MaxHeight="260"
                            Visibility="{Binding IsEditingList, Converter={StaticResource BoolToVis}}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                            Background="{StaticResource DeepBgBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Entries (one per ';' segment)"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="8,6,8,4"/>

                            <!-- Add entry row -->
                            <Grid DockPanel.Dock="Bottom" Margin="8,4,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,6,0" Padding="6,3"
                                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                                         CaretBrush="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                         Text="{Binding NewEntry, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEditSelection}"
                                         ToolTip="Add a new entry"/>
                                <Button Grid.Column="1" Content="Add entry" Style="{StaticResource MiniButton}"
                                        IsEnabled="{Binding CanEditSelection}"
                                        Command="{Binding AddEntryCommand}"/>
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EditEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="8,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource TextBrush}" FontFamily="Consolas"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="▲" Style="{StaticResource MiniButton}"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.MoveEntryUpCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <Button Content="▼" Style="{StaticResource MiniButton}"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.MoveEntryDownCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <Button Content="✕" Style="{StaticResource MiniButton}"
                                                            CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.RemoveEntryCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Save / Delete -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource ActionButton}"/>
                        <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource ActionButton}"/>
                        <TextBlock Text="Machine-scope changes prompt for administrator approval."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="{Binding CanEditSelection, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
