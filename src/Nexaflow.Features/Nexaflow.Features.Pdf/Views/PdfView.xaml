<UserControl x:Class="Nexaflow.Features.Pdf.Views.PdfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:paged="clr-namespace:Nexaflow.Visuals.Text.Editing.Paged;assembly=Nexaflow.Visuals.Text"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:pages="clr-namespace:Nexaflow.Visuals.Text.Pages;assembly=Nexaflow.Visuals.Text"
             xmlns:bh="clr-namespace:Nexaflow.Visuals.Common.Behaviors;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="PdfView"
             PreviewKeyDown="View_PreviewKeyDown"
             Background="{StaticResource BgBrush}"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <cv:StringToVisibilityConverter x:Key="StringVis"/>

        <!-- WPF falls back to SystemColors for selection the moment focus leaves the control or the window
             deactivates — a grey wash that ignores the theme entirely. Retheme all four keys so a selected
             row keeps its colours while the user is copying from it, or looking at another window. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="{DynamicResource Surface2Color}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="{DynamicResource TextColor}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="{DynamicResource Surface2Color}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TextColor}"/>

        <Style x:Key="PdfToolbarBtn" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="8,5"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PdfAccentBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            <Setter Property="Padding"    Value="16,8"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A Contents row.
             Its text is a TextBlock rather than a SelectableText box on purpose: a TextBox inside the row
             swallows the click that jumps to the page, and jumping is the row's whole point. Copying is
             offered through the context menu instead, which also gives the more useful "with page" and
             "whole outline" forms.
             Selection is what keeps the reader's place: the row they picked stays lit so they can see where
             they are in the document instead of losing it the moment the click finishes. It stays lit while
             the panel is unfocused and while the window is inactive, which is the state most of this reading
             actually happens in. -->
        <Style x:Key="PdfOutlineRow" TargetType="ListBoxItem">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Padding"             Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

            <!-- Pinned to the viewport width, explicitly, rather than trusting the ScrollViewer to constrain
                 it. Letting the row size to its content is what pushed long titles past the panel edge: the
                 star column then had infinite room, so the title never trimmed and the page number - the last
                 column - ended up off-screen entirely. -->
            <Setter Property="MaxWidth"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"/>

            <!-- Button-DOWN, on the container, and left unhandled.
                 A ListBoxItem captures the mouse on button-down, so a handler on a child never sees the
                 matching button-up at all; and the up that does reach the container gets eaten while the
                 list takes focus, which is why the row appeared to need clicking twice. Down always arrives.
                 It must not be marked handled, or the list would never select the row and the highlight
                 would never appear. -->
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OutlineRow_Click"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- A row with no destination is a grouping heading, not a link. It can still be selected and
                     copied, but it must not offer the hand cursor that promises a jump. -->
                <DataTrigger Binding="{Binding CanJump}" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A page in the Pages tab. Selection is the page's own (IsSelected is its view-model's), so a page selected
             keeps its selection however far it is scrolled out of view, and wherever an edit moves it. A click with
             no keys held goes to the page; a drag moves the selected pages. -->
        <Style x:Key="PdfThumbnailRow" TargetType="ListBoxItem">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Padding"                    Value="6,2"/>
            <Setter Property="Margin"                     Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="IsSelected"                 Value="{Binding IsSelected, Mode=TwoWay}"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ThumbnailRow_MouseUp"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PanelColumn" Width="300" MinWidth="220"/>
            <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
            <ColumnDefinition x:Name="ReaderColumn" Width="*" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Document panel ══════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                x:Name="PanelHost"
                AutomationProperties.AutomationId="Pdf_Panel"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Panel status: loading, unreadable, or oversize. The only thing shown when there is
                     nothing else to show. -->
                <TextBox Grid.Row="0"
                         AutomationProperties.AutomationId="Pdf_PanelStatus"
                         Style="{StaticResource SelectableText}"
                         Margin="12,12,12,0"
                         FontSize="12"
                         Foreground="{DynamicResource TextMutedBrush}"
                         Text="{Binding PanelStatus, Mode=OneWay}"
                         Visibility="{Binding PanelStatus, Converter={StaticResource StringVis}}"/>

                <TabControl Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ThemedTabItem}">

                    <!-- Pages: a thumbnail of every page in the order the document now has, the page being read
                    outlined. Pages are dragged into a new order, deleted, split into the pages printed on them, or have
                         a picture or another PDF inserted between them from the right-click menu; every edit is staged until
                         Save. The list virtualises: a row's picture is asked for as it comes into view. -->
                    <TabItem x:Name="PagesTab"
                             Header="{loc:Str Pdf.Tab.Pages}"
                             AutomationProperties.AutomationId="Pdf_Tab_Pages">
                        <Grid DataContext="{Binding PagesPanel}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0"
                                     Style="{StaticResource SelectableText}"
                                     Margin="12,10,12,0"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     Text="{Binding NotEditableMessage, Mode=OneWay}"
                                     Visibility="{Binding NotEditableMessage, Converter={StaticResource StringVis}}"/>

                                     <!-- Split: the selected pages cut into the pages printed on them. While it is set up, the lines they would be
                                          cut along are drawn on their thumbnails, and a line crossing a page's artwork is marked and the page named. -->
                                     <Border Grid.Row="1"
                                             Margin="8,8,8,0"
                                             Padding="10,8"
                                             CornerRadius="4"
                                             Background="{DynamicResource Surface2Brush}"
                                             Visibility="{Binding IsSplitting, Converter={StaticResource BoolToVis}}">
                                         <StackPanel>
                                             <TextBlock Text="{loc:Str Pdf.Split.Heading}"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextBrush}"/>
                                             <ComboBox Margin="0,8,0,0"
                                                       Style="{StaticResource DarkComboBox}"
                                                       ItemsSource="{Binding SplitCounts}"
                                                       SelectedItem="{Binding SplitCount, Mode=TwoWay}"
                                                       DisplayMemberPath="Label"
                                                       ToolTip="{loc:Str Pdf.Split.PartsTip}"
                                                       AutomationProperties.AutomationId="Pdf_Split_Parts"/>
                                             <ComboBox Margin="0,6,0,0"
                                                       Style="{StaticResource DarkComboBox}"
                                                       ItemsSource="{Binding SplitDirections}"
                                                       SelectedItem="{Binding SplitDirection, Mode=TwoWay}"
                                                       DisplayMemberPath="Label"
                                                       ToolTip="{loc:Str Pdf.Split.DirectionTip}"
                                                       AutomationProperties.AutomationId="Pdf_Split_Direction"/>
                                             <CheckBox Margin="0,8,0,0"
                                                       Content="{loc:Str Pdf.Split.Booklet}"
                                                       ToolTip="{loc:Str Pdf.Split.BookletTip}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       IsChecked="{Binding SplitBooklet, Mode=TwoWay}"
                                                       IsEnabled="{Binding CanUnfoldBooklet}"
                                                       AutomationProperties.AutomationId="Pdf_Split_Booklet"/>
                                             <TextBlock Margin="0,8,0,0"
                                                        FontSize="12"
                                                        TextWrapping="Wrap"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        Text="{loc:Str Pdf.Split.Checking}"
                                                        Visibility="{Binding IsCheckingCuts, Converter={StaticResource BoolToVis}}"/>
                                             <TextBlock Margin="0,8,0,0"
                                                        FontSize="12"
                                                        TextWrapping="Wrap"
                                                        Foreground="{DynamicResource WarningBrush}"
                                                        Text="{Binding SplitWarning}"
                                                        Visibility="{Binding SplitWarning, Converter={StaticResource StringVis}}"/>
                                             <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                                 <Button Style="{StaticResource PdfToolbarBtn}"
                                                         Content="{loc:Str Pdf.Split.Cancel}"
                                                         Command="{Binding CancelSplitCommand}"
                                                         AutomationProperties.AutomationId="Pdf_Split_Cancel"/>
                                                 <Button Style="{StaticResource PdfAccentBtn}"
                                                         Margin="8,0,0,0"
                                                         Padding="14,5"
                                                         FontSize="12"
                                                         Content="{loc:Str Pdf.Split.Apply}"
                                                         Command="{Binding ApplySplitCommand}"
                                                         AutomationProperties.AutomationId="Pdf_Split_Apply"/>
                                             </StackPanel>
                                         </StackPanel>
                                     </Border>

                            <ListBox Grid.Row="2"
                                     x:Name="Thumbnails"
                                     AutomationProperties.AutomationId="Pdf_Thumbnails"
                                     ItemsSource="{Binding Pages}"
                                     SelectionMode="Extended"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="0,6"
                                     ItemContainerStyle="{StaticResource PdfThumbnailRow}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     bh:DragReorder.Command="{Binding ReorderCommand}"
                                     bh:DragReorder.ShowsInsertion="True"
                                     bh:DragReorder.AutoScrolls="True"
                                     bh:DragReorder.MovesSelection="True"
                                     ContextMenuOpening="Thumbnails_ContextMenuOpening"
                                     PreviewKeyDown="Thumbnails_PreviewKeyDown">
                                <ListBox.ContextMenu>
                                    <!-- Filled as it opens: on a page, its own edits; between two, what can go there. -->
                                    <ContextMenu Closed="ThumbnailsMenu_Closed"/>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4"
                                                    DataContextChanged="Thumbnail_DataContextChanged"
                                                    Unloaded="Thumbnail_Unloaded">
                                            <Grid Width="{Binding SheetWidth}"
                                                  Height="{Binding SheetHeight}"
                                                  HorizontalAlignment="Center">
                                                <Border x:Name="Sheet"
                                                        Background="{DynamicResource Pdf.Paper}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1">
                                                    <Image Source="{Binding Picture}" Stretch="Uniform"/>
                                                </Border>
                                                <!-- The lines the page would be cut along while a split is set up; one crossing the artwork is marked. -->
                                                <ItemsControl ItemsSource="{Binding Cuts}"
                                                              IsHitTestVisible="False"
                                                              Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Canvas/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Line x:Name="Cut"
                                                                  X1="{Binding X1}"
                                                                  Y1="{Binding Y1}"
                                                                  X2="{Binding X2}"
                                                                  Y2="{Binding Y2}"
                                                                  Stroke="{DynamicResource AccentBrush}"
                                                                  StrokeThickness="1.5"
                                                                  StrokeDashArray="3 2"/>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding CrossesInk}" Value="True">
                                                                    <Setter TargetName="Cut" Property="Stroke"          Value="{DynamicResource WarningBrush}"/>
                                                                    <Setter TargetName="Cut" Property="StrokeThickness" Value="2"/>
                                                                    <Setter TargetName="Cut" Property="StrokeDashArray" Value="{x:Null}"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                            <TextBlock Text="{Binding Number}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="Sheet" Property="BorderBrush"     Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Sheet" Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{loc:Str Pdf.Tab.Properties}" AutomationProperties.AutomationId="Pdf_Tab_Properties">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Properties}"
                                          AutomationProperties.AutomationId="Pdf_Properties"
                                          Margin="12,10,12,12">
                                <ItemsControl.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:Str Pdf.Menu.CopyAllProperties}"
                                                  Command="{Binding PlacementTarget.DataContext.CopyAllPropertiesCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </ItemsControl.ContextMenu>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Label and value are both SelectableText: everything the panel
                                                 displays can be selected and copied (Ctrl+C or right-click). -->
                                            <TextBox Grid.Row="0"
                                                     Style="{StaticResource SelectableText}"
                                                     Text="{Binding Label, Mode=OneWay}"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBox Grid.Row="1"
                                                     Style="{StaticResource SelectableText}"
                                                     Text="{Binding Value, Mode=OneWay}"
                                                     FontSize="13"
                                                     Margin="0,1,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{loc:Str Pdf.Tab.Contents}" AutomationProperties.AutomationId="Pdf_Tab_Contents">
                        <Grid>
                            <TextBox Style="{StaticResource SelectableText}"
                                     AutomationProperties.AutomationId="Pdf_ContentsEmpty"
                                     Margin="12,12,12,0"
                                     VerticalAlignment="Top"
                                     FontSize="12"
                                     Foreground="{DynamicResource TextMutedBrush}"
                                     Text="{Binding ContentsEmptyMessage, Mode=OneWay}"
                                     Visibility="{Binding HasContents, Converter={StaticResource InvBoolVis}}"/>

                            <!-- A ListBox rather than an ItemsControl, so the row the reader picked stays
                                 selected and they can see where they are. Its own ScrollViewer replaces the
                                 outer one; nesting them would give the panel two scrollbars. -->
                            <ListBox ItemsSource="{Binding Contents}"
                                     SelectedItem="{Binding SelectedOutlineItem, Mode=TwoWay}"
                                     AutomationProperties.AutomationId="Pdf_Contents"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="6,8,6,12"
                                     ItemContainerStyle="{StaticResource PdfOutlineRow}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Visibility="{Binding HasContents, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="Transparent"
                                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Str Pdf.Menu.CopyTitle}"
                                                              Command="{Binding PlacementTarget.Tag.CopyTextCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding CopyText}"/>
                                                    <MenuItem Header="{loc:Str Pdf.Menu.CopyTitleAndPage}"
                                                              Command="{Binding PlacementTarget.Tag.CopyTextCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding CopyWithPage}"/>
                                                    <MenuItem Header="{loc:Str Pdf.Menu.CopyOutline}"
                                                              Command="{Binding PlacementTarget.Tag.CopyOutlineCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <Grid.ColumnDefinitions>
                                                <!-- Indent, title, page. The nesting indent lives INSIDE the
                                                     row rather than as a margin on it, so every row is exactly
                                                     as wide as the panel: a margin made deep rows wider than
                                                     the viewport, which stopped titles being trimmed and let
                                                     selecting one scroll the whole list sideways.
                                                     The page number sits in an Auto column and the title in
                                                     the star column, so the title is what gives when space
                                                     runs short - the page number a row exists to tell you
                                                     must never be the part pushed out of sight. -->
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="{Binding IndentWidth}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ShowDuration="30000"
                                                       ToolTip="{Binding Title}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PageLabel}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      x:Name="PanelSplitter"
                      AutomationProperties.AutomationId="Pdf_Splitter"
                      Width="4"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext"
                      Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVis}}"/>

        <!-- ══ Reader ══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- The reader's own controls: where you are, how large, what to find, and out to print or another
                 application. The pages below are drawn here, so every one of these knows the page being read. -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource PdfToolbarBtn}"
                            AutomationProperties.AutomationId="Pdf_TogglePanel"
                            Command="{Binding TogglePanelCommand}"
                            ToolTip="{loc:Str Pdf.Toolbar.PanelTip}">
                        <TextBlock Text="▤" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>

                    <TextBox Grid.Column="1"
                             Style="{StaticResource SelectableText}"
                             AutomationProperties.AutomationId="Pdf_FileName"
                             Margin="10,0"
                             VerticalAlignment="Center"
                             FontSize="12"
                             TextWrapping="NoWrap"
                             Foreground="{DynamicResource TextMutedBrush}"
                             Text="{Binding FileName, Mode=OneWay}"/>

                    <!-- Pages: back, the page being read (type a number and press Enter to go there), forward. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0">
                        <Button Style="{StaticResource PdfToolbarBtn}"
                                AutomationProperties.AutomationId="Pdf_PreviousPage"
                                Click="PreviousPage_Click"
                                ToolTip="{loc:Str Pdf.Toolbar.PreviousPageTip}">
                            <TextBlock Text="‹" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <TextBox x:Name="PageBox"
                                 Style="{StaticResource DarkTextBox}"
                                 AutomationProperties.AutomationId="Pdf_PageNumber"
                                 Width="44" Margin="4,0" Padding="4,2" VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center" FontSize="12"
                                 Text="{Binding CurrentPage, Mode=OneWay}"
                                 ToolTip="{loc:Str Pdf.Toolbar.PageTip}"
                                 KeyDown="PageBox_KeyDown"/>
                        <TextBlock AutomationProperties.AutomationId="Pdf_PageCount"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding PageCountText}"/>
                        <Button Style="{StaticResource PdfToolbarBtn}" Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Pdf_NextPage"
                                Click="NextPage_Click"
                                ToolTip="{loc:Str Pdf.Toolbar.NextPageTip}">
                            <TextBlock Text="›" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Size: smaller, how large, larger, then fitted to the width or to the whole page. -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0">
                        <Button Style="{StaticResource PdfToolbarBtn}"
                                AutomationProperties.AutomationId="Pdf_ZoomOut"
                                Click="ZoomOut_Click"
                                ToolTip="{loc:Str Pdf.Toolbar.ZoomOutTip}">
                            <TextBlock Text="−" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <TextBlock AutomationProperties.AutomationId="Pdf_Zoom"
                                   Width="44" TextAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding Zoom, ElementName=Pages, StringFormat={}{0:P0}}"/>
                        <Button Style="{StaticResource PdfToolbarBtn}"
                                AutomationProperties.AutomationId="Pdf_ZoomIn"
                                Click="ZoomIn_Click"
                                ToolTip="{loc:Str Pdf.Toolbar.ZoomInTip}">
                            <TextBlock Text="+" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource PdfToolbarBtn}" Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Pdf_FitWidth"
                                Click="FitWidth_Click"
                                ToolTip="{loc:Str Pdf.Toolbar.FitWidthTip}">
                            <TextBlock Text="↔" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource PdfToolbarBtn}" Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Pdf_FitPage"
                                Click="FitPage_Click"
                                ToolTip="{loc:Str Pdf.Toolbar.FitPageTip}">
                            <TextBlock Text="⤢" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </StackPanel>

                    <!-- Find: Enter for the next hit, Shift+Enter the previous, Escape to clear. -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0">
                        <TextBox x:Name="FindBox"
                                 Style="{StaticResource DarkTextBox}"
                                 AutomationProperties.AutomationId="Pdf_Find"
                                 Width="160" Padding="6,2" VerticalAlignment="Center" FontSize="12"
                                 Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Str Pdf.Find.Tip}"
                                 KeyDown="FindBox_KeyDown"/>
                        <Button Style="{StaticResource PdfToolbarBtn}" Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Pdf_FindPrevious"
                                Command="{Binding FindPreviousCommand}"
                                ToolTip="{loc:Str Pdf.Find.PreviousTip}">
                            <TextBlock Text="↑" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource PdfToolbarBtn}" Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Pdf_FindNext"
                                Command="{Binding FindNextCommand}"
                                ToolTip="{loc:Str Pdf.Find.NextTip}">
                            <TextBlock Text="↓" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <TextBlock AutomationProperties.AutomationId="Pdf_FindStatus"
                                   Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding FindStatus}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <!-- Page edits: undo and redo them, save them over the file or as another. -->
                        <Button Style="{StaticResource PdfToolbarBtn}" Margin="0,0,4,0"
                                AutomationProperties.AutomationId="Pdf_Undo"
                                Command="{Binding UndoCommand}"
                                ToolTip="{loc:Str Pdf.Toolbar.UndoTip}">
                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource PdfToolbarBtn}" Margin="0,0,4,0"
                                AutomationProperties.AutomationId="Pdf_Redo"
                                Command="{Binding RedoCommand}"
                                ToolTip="{loc:Str Pdf.Toolbar.RedoTip}">
                            <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource PdfToolbarBtn}" Margin="0,0,4,0"
                                AutomationProperties.AutomationId="Pdf_Save"
                                Command="{Binding SaveCommand}"
                                ToolTip="{loc:Str Pdf.Toolbar.SaveTip}">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource PdfToolbarBtn}" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="Pdf_SaveAs"
                                Command="{Binding SaveAsCommand}"
                                ToolTip="{loc:Str Pdf.Toolbar.SaveAsTip}">
                            <TextBlock Text="&#xE792;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource PdfToolbarBtn}" Margin="0,0,4,0"
                                AutomationProperties.AutomationId="Pdf_ConvertDocument"
                                Command="{Binding ConvertDocumentCommand}"
                                Visibility="{Binding Conversion.Available, Converter={StaticResource BoolToVis}}"
                                ToolTip="{loc:Str Pdf.Toolbar.ConvertTip}">
                            <TextBlock Text="M↓" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource PdfToolbarBtn}"
                                AutomationProperties.AutomationId="Pdf_Print"
                                Click="Print_Click"
                                ToolTip="{loc:Str Pdf.Toolbar.PrintTip}">
                            <TextBlock Text="⎙" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                        <Button Style="{StaticResource PdfToolbarBtn}" Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Pdf_OpenExternal"
                                Click="OpenExternal_Click"
                                ToolTip="{loc:Str Pdf.Toolbar.OpenExternalTip}">
                            <TextBlock Text="↗" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

<!-- Scanned pages: that their text can't be searched or copied, and converting the document to Markdown; then how
     the conversion is getting on. -->
<StackPanel Grid.Row="1">
    <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="12,6" Visibility="{Binding ShowsScansNotice, Converter={StaticResource BoolToVis}}">
        <DockPanel>
            <Button DockPanel.Dock="Right" Command="{Binding DismissScansNoticeCommand}" Style="{StaticResource RowButton}" Margin="8,0,0,0"
                    ToolTip="{loc:Str Pdf.Scans.DismissTip}" AutomationProperties.Name="{loc:Str Pdf.Scans.DismissTip}"
                    AutomationProperties.AutomationId="Pdf_ScansNoticeDismiss">
                <TextBlock Text="✕" FontSize="11"/>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding ConvertDocumentCommand}" Style="{StaticResource RowButton}" Margin="12,0,0,0"
                    ToolTip="{loc:Str Pdf.Scans.ConvertTip}" AutomationProperties.AutomationId="Pdf_ConvertScans">
                <TextBlock Text="{loc:Str Pdf.Scans.Convert}"/>
            </Button>
            <TextBlock Text="{Binding ScansSummary}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Border>
    <pages:PageConversionBar DataContext="{Binding Conversion}"/>
</StackPanel>

<!-- The pages, drawn natively from the document: a paged host over the shared layout tree, scrolling itself
     so only the pages near the viewport are read and laid. -->
<ScrollViewer Grid.Row="2"
              CanContentScroll="True"
              Focusable="False"
              HorizontalScrollBarVisibility="Auto"
              VerticalScrollBarVisibility="Auto">
    <paged:PagedLayoutElement x:Name="Pages"
                              AutomationProperties.AutomationId="Pdf_Pages"
                              Source="{Binding Pages}"
                              Background="{DynamicResource BgBrush}"
                              Paper="{DynamicResource Pdf.Paper}"
                              Selection="{DynamicResource Pdf.Selection}"
                              Highlight="{DynamicResource Pdf.FindHit}"
                              CurrentHighlight="{DynamicResource Pdf.FindCurrent}"/>
</ScrollViewer>
            <Border Grid.Row="2"
                    AutomationProperties.AutomationId="Pdf_FallbackPanel"
                    Background="{DynamicResource BgBrush}"
                    Panel.ZIndex="20"
                    Visibility="{Binding IsUnreadable, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="📕" FontSize="40" HorizontalAlignment="Center"
                               Opacity="0.6" Margin="0,0,0,12"/>
                    <TextBox Style="{StaticResource SelectableText}"
                             Text="{loc:Str Pdf.Fallback.Title}"
                             Foreground="{DynamicResource TextBrush}"
                             FontSize="16" FontWeight="SemiBold"
                             TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource SelectableText}"
                             Text="{Binding FailureMessage, Mode=OneWay}"
                             Foreground="{DynamicResource TextMutedBrush}"
                             FontSize="13" TextAlignment="Center" Margin="0,0,0,18"/>
                    <Button Style="{StaticResource PdfAccentBtn}"
                            AutomationProperties.AutomationId="Pdf_FallbackOpenExternal"
                            HorizontalAlignment="Center"
                            Click="OpenExternal_Click"
                            Content="{loc:Str Pdf.Fallback.OpenExternal}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
