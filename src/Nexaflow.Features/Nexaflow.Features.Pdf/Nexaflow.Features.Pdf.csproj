<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Optional image codecs the base package leaves unhandled: DCTDecode (JPEG, by far the most
         common), JBIG2Decode (what document scanners emit) and JPXDecode (JPEG 2000, archival scans).
         Each depends on PdfPig alone. Without them TryGetPng declines those images and "extract
         images" quietly skips most of a scanned document. -->
    <PackageReference Include="PdfPig.Filters.Dct.JpegLibrary" Version="0.1.16.1" />
    <PackageReference Include="PdfPig.Filters.Jbig2.PdfboxJbig2" Version="0.1.16.1" />
    <PackageReference Include="PdfPig.Filters.Jpx.OpenJpeg" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.Features.Common\Nexaflow.Features.Common.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Visuals.Common\Nexaflow.Visuals.Common.csproj" />
    <!-- The reader renders the document with the same chrome-free browser host the Web tab uses. -->
    <ProjectReference Include="..\..\Nexaflow.Visuals.Web\Nexaflow.Visuals.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexaflow.Tests.Features.Viewers" />
  </ItemGroup>

</Project>
