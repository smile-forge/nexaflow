<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- PdfPig is built from its smile-forge fork (docs/externals.md): the published package draws an embedded
         TrueType font whose Unicode cmap is not the Windows (3,1) one with the wrong glyphs, and the fix lives on
         the fork's nexaflow branch until upstream takes it. DocumentLayoutAnalysis is the reading order. -->
    <ProjectReference Include="..\..\..\external\PdfPig\src\UglyToad.PdfPig\UglyToad.PdfPig.csproj" />
    <ProjectReference Include="..\..\..\external\PdfPig\src\UglyToad.PdfPig.DocumentLayoutAnalysis\UglyToad.PdfPig.DocumentLayoutAnalysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.Features.Common\Nexaflow.Features.Common.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
    <!-- The image codecs PdfPig leaves unhandled, Nexaflow.Media's own decoders: JPEG for DCTDecode (by far the most
         common), JBIG2 for JBIG2Decode (what document scanners emit) and JPEG 2000 for JPXDecode (archival scans),
         through Reading/PdfDctFilter, PdfJbig2Filter and PdfJpxFilter. Without them TryGetPng declines those images
         and "extract images" quietly skips most of a scanned document. -->
    <ProjectReference Include="..\..\Nexaflow.Media\Nexaflow.Media.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Visuals.Common\Nexaflow.Visuals.Common.csproj" />

<!-- Pages are laid as the shared layout tree every document is drawn from and shown by its paged host; scanned
     pages are converted to Markdown by the page reading the image viewer shares. -->
<ProjectReference Include="..\..\Nexaflow.Visuals.Text\Nexaflow.Visuals.Text.csproj" />  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexaflow.Tests.Features.Viewers" />
  </ItemGroup>

</Project>
