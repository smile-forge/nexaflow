<UserControl x:Class="Nexaflow.Features.ProductManager.Views.ProductViewletView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="🧭" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Product" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SummaryText" Text="…" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Button x:Name="OpenButton" Grid.Column="2" VerticalAlignment="Center" Cursor="Hand"
                Click="OpenButton_Click"
                Background="Transparent" Foreground="{StaticResource AccentBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,5">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <TextBlock Text="Open" FontSize="11"/>
        </Button>
    </Grid>
</UserControl>
