<UserControl x:Class="Nexaflow.Features.ProductManager.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.ProductManager.ViewModels"
             xmlns:local="clr-namespace:Nexaflow.Features.ProductManager.Views"
             xmlns:ctrl="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- SectionLabel / GhostButton — shared with the Integrity page. Absolute pack URI: feature
                     assemblies are Assembly.LoadFrom-ed, where a relative dictionary URI can misresolve. -->
                <ResourceDictionary Source="pack://application:,,,/Nexaflow.Features.ProductManager;component/Views/ProductStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolVis"/>
            <local:StatusDisplayConverter x:Key="StatusDisplay"/>
            <local:StatusToBrushConverter x:Key="StatusBrush"/>

            <Style x:Key="StatusCombo" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource StatusDisplay}}"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- BasedOn requires StaticResource, which a standalone merged dictionary cannot resolve — so
                 this one stays here rather than in ProductStyles.xaml. -->
            <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1.15*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- ── Version bar + sunburst ──────────────────────────────────── -->
            <Grid Grid.Column="0" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar: version dropdown (left) + ⋮ menu (right) -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Style="{StaticResource DarkComboBox}" Width="170" HorizontalAlignment="Left"
                              ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                              ToolTip="Product version — Current maps to the repo's working tree"/>
                    <Button Grid.Column="1" x:Name="VersionMenuButton" Style="{StaticResource IconBtn}"
                            Width="28" Height="28" Click="VersionMenu_Click" ToolTip="Version actions">
                        <TextBlock Text="⋮" FontSize="16"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <ctrl:SunburstControl x:Name="Sunburst"
                                          Root="{Binding SunburstRoot}"
                                          Visibility="{Binding HasNodes, Converter={StaticResource BoolVis}}"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNodes}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="🧭" FontSize="40" HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="No components yet" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13" Margin="0,8,0,12" HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource GhostButton}" Click="AddRoot_Click" HorizontalAlignment="Center">
                            <TextBlock Text="+ Add root node"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}" Cursor="SizeWE"/>

            <!-- ── Details ──────────────────────────────────────────────── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,18,22,22">

                    <!-- Header (the navigation path is the tab's own breadcrumb bar) -->
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="Medium"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>

                    <!-- Stacked status bar -->
                    <Border Height="8" CornerRadius="4" ClipToBounds="True" Margin="0,14,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding DoneStar}"/>
                                <ColumnDefinition Width="{Binding ShouldStar}"/>
                                <ColumnDefinition Width="{Binding FaultedStar}"/>
                                <ColumnDefinition Width="{Binding ShouldntStar}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Status.Done}"/>
                            <Border Grid.Column="1" Background="{DynamicResource Status.Should}"/>
                            <Border Grid.Column="2" Background="{DynamicResource Status.Faulted}"/>
                            <Border Grid.Column="3" Background="{DynamicResource Status.Shouldnt}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                    <!-- Cross-cutting concern boxes (replace the old stat cards) -->
                    <StackPanel x:Name="ConcernsArea" Visibility="{Binding IsNodeSelected, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding ConcernBoxes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConcernBox}">
                                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="12,8"
                                            Margin="0,0,10,10" MinWidth="118">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Tag}" FontSize="12"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="1" Command="{Binding RemoveCommand}" IsEnabled="{Binding IsEditable}"
                                                        Width="16" Height="16" ToolTip="Remove concern">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="✕" FontSize="8"/>
                                                </Button>
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding CycleCommand}" IsEnabled="{Binding IsEditable}"
                                                        HorizontalAlignment="Left" Cursor="Hand" ToolTip="Click to cycle status">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{Binding StatusBrush}" CornerRadius="4" Padding="8,3">
                                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusDisplay}}"
                                                                           Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Grid.Column="1" Click="ConcernAttach_Click" Tag="{Binding}"
                                                        Width="18" Height="18" Margin="6,0,0,0" ToolTip="Snaplinks">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                                            <!-- persistent once it has snaplinks; otherwise revealed (dim) on hover, to add the first -->
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasSnaplinks}" Value="False"/>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Opacity" Value="0.55"/>
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding HasSnaplinks}" Value="True">
                                                                    <Setter Property="Opacity" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="🔗" FontSize="9"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Click="AddConcern_Click" HorizontalAlignment="Left" Margin="0,0,0,4" IsEnabled="{Binding IsEditable}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AddableConcerns.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="+ concern"/>
                        </Button>
                    </StackPanel>

                    <!-- Needs your attention (collapses entirely when nothing is faulted) -->
                    <StackPanel Visibility="{Binding HasNeedsAttention, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="NEEDS YOUR ATTENTION" Style="{StaticResource SectionLabel}"
                                   Foreground="{StaticResource DangerBrush}"/>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="2">
                            <ItemsControl ItemsSource="{Binding NeedsAttention}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.NavigateToNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Id}" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                ToolTip="Go to this item">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="r" Background="Transparent" CornerRadius="6">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="r" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid Margin="10,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Top"
                                                        Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusDisplay}}"
                                                               FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- Snapshot indicator (hidden on the live working state) -->
                    <TextBlock Text="{Binding VersionInfoLine}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,0"
                               Visibility="{Binding ShowVersionInfo, Converter={StaticResource BoolVis}}"/>

                    <!-- ── Product-root sections: count widgets, where a node shows PROPERTIES ──
                         Open-ended strip: integrity is the first tile; more metrics slot in via RootWidgets. -->
                    <StackPanel Visibility="{Binding IsRootSelected, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="CHECKS" Style="{StaticResource SectionLabel}"/>
                        <ItemsControl ItemsSource="{Binding RootWidgets}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding OpenCommand}" Cursor="Hand" Margin="0,0,8,8">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card" Background="{StaticResource Surface2Brush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                        CornerRadius="8" Padding="14,10" MinWidth="150">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Count}" FontSize="20" FontWeight="SemiBold"
                                                                       Foreground="{Binding CountBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="11" Margin="0,2,0,0"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding IntegrityCheckedLine}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- ── Node-only sections ─────────────────────────────── -->
                    <StackPanel Visibility="{Binding IsNodeSelected, Converter={StaticResource BoolVis}}"
                                IsEnabled="{Binding IsEditable}">

                        <!-- Properties (grouped panel; attachments via the 🔗 at the bottom-right) -->
                        <TextBlock Text="PROPERTIES" Style="{StaticResource SectionLabel}"/>
                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,2,0,0">
                            <StackPanel>
                                <!-- Title + click-to-cycle status pill -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Title" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBox Text="{Binding DetailTitle, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkTextBox}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0">
                                        <Button Command="{Binding CycleDetailStatusCommand}" IsEnabled="{Binding CanCycleStatus}"
                                                HorizontalAlignment="Right" Cursor="Hand" ToolTip="Click to cycle status">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{Binding DetailStatusBrush}" CornerRadius="4" Padding="10,5">
                                                        <TextBlock Text="{Binding DetailStatus, Converter={StaticResource StatusDisplay}}"
                                                                   Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- a parent's status is rolled up from its children — read-only -->
                                        <TextBlock Text="derived" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Right" Margin="0,2,2,0"
                                                   Visibility="{Binding IsStatusDerived, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Description" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding DetailDescription, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" Margin="0,2,0,8"/>
                                <TextBlock Text="Note (rationale / repro)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding DetailNote, UpdateSourceTrigger=LostFocus}" Style="{StaticResource DarkTextBox}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" Margin="0,2,0,0"/>

                                <!-- attachments (snaplinks): count + 🔗 — shown when present, else revealed on hover -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding NodeSnaplinkCount}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,4,0"
                                               Visibility="{Binding HasNodeSnaplinks, Converter={StaticResource BoolVis}}"/>
                                    <Button Click="NodeAttach_Click" Width="22" Height="22" ToolTip="Attachments (snaplinks)">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                                                <Setter Property="Opacity" Value="0"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasNodeSnaplinks}" Value="False"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding HasNodeSnaplinks}" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="🔗" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Confirmation overlay (shared Visuals.Common dialog) -->
        <ctrl:ConfirmationDialog Request="{Binding Confirmation}" Panel.ZIndex="40"/>

        <!-- Take-snapshot overlay -->
        <Border Visibility="{Binding TakeSnapshotVisible, Converter={StaticResource BoolVis}}"
                Background="#CC000000" Panel.ZIndex="21">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Width="360" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Take snapshot" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="Exports the current tree to the export folder and, if the folder is a git repo, commits it and creates a tag."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Version number (also the git tag)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox Text="{Binding NewSnapshotVersion, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,2,0,16">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ConfirmTakeSnapshotCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Take snapshot" Command="{Binding ConfirmTakeSnapshotCommand}"
                            Style="{StaticResource GhostButton}" Margin="0,0,0,6"/>
                    <Button Content="Cancel" Command="{Binding CancelTakeSnapshotCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Settings overlay -->
        <Border Visibility="{Binding SettingsVisible, Converter={StaticResource BoolVis}}"
                Background="#CC000000" Panel.ZIndex="21">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Width="360" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Product settings" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Export folder (relative to the product root)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox Text="{Binding SettingsExportDir, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DarkTextBox}" Margin="0,2,0,16">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ConfirmSettingsCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="Cross-cutting concerns  (✓ = auto-added to new nodes · 🔗 = needs a snaplink when done)" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding SettingsConcerns}" MaxHeight="180">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConcernDefRow}">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsDefault}" VerticalAlignment="Center"
                                              ToolTip="Default — auto-added to new nodes as 'should'"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Margin="8,0,0,0"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="2" Content="🔗" IsChecked="{Binding RequiresSnaplink}" VerticalAlignment="Center" Margin="8,0,0,0"
                                              ToolTip="Requires a snaplink — validation fails if a node marks this concern done/faulted with no snaplink"/>
                                    <Button Grid.Column="3" Command="{Binding RemoveCommand}" Style="{StaticResource IconBtn}" ToolTip="Remove concern" Margin="8,0,0,0">
                                        <TextBlock Text="✕" FontSize="9"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                                 Text="{Binding NewSettingsConcern, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddSettingsConcernCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding AddSettingsConcernCommand}">
                            <TextBlock Text="+ Add"/>
                        </Button>
                    </Grid>
                    <Button Content="Save" Command="{Binding ConfirmSettingsCommand}"
                            Style="{StaticResource GhostButton}" Margin="0,0,0,6"/>
                    <Button Content="Cancel" Command="{Binding CancelSettingsCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Concern snaplinks overlay -->
        <Border Visibility="{Binding ConcernSnaplinksVisible, Converter={StaticResource BoolVis}}"
                Background="#CC000000" Panel.ZIndex="22">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Width="600" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Resources>
                    <!-- The default WPF selection highlight (esp. when unfocused) is light → unreadable on the
                         dark text. Retune the picker tree/list selection to theme tokens. -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource Surface2Color}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource Surface2Color}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource TextColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TextColor}"/>
                </Border.Resources>
                <StackPanel>
                    <!-- header: title + close ✕ -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ConcernSnaplinksTitle}" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Command="{Binding CloseConcernSnaplinksCommand}" ToolTip="Close">
                            <TextBlock Text="✕" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- existing snaplinks: open ↗ / remove ✕ -->
                    <ItemsControl ItemsSource="{Binding ConcernSnaplinkRows}" MaxHeight="120" Margin="0,0,0,12">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SnaplinkRow}">
                                <Border Background="{StaticResource Surface2Brush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Style="{StaticResource IconBtn}" Command="{Binding OpenCommand}" ToolTip="Open in a new tab">
                                            <TextBlock Text="↗" FontSize="11"/>
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource IconBtn}" Command="{Binding RemoveCommand}" ToolTip="Remove" Margin="2,0,0,0">
                                            <TextBlock Text="✕" FontSize="9"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- add: two tabs — link a file (heading / class / method) or link a URL -->
                    <TabControl Background="Transparent" BorderThickness="0" Margin="0,0,0,12">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="bd" Padding="12,6" Margin="0,0,4,0" CornerRadius="6,6,0,0"
                                                    Background="Transparent">
                                                <ContentPresenter ContentSource="Header" TextElement.Foreground="{StaticResource TextMutedBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                                    <Setter TargetName="bd" Property="TextElement.Foreground" Value="{StaticResource TextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- ── Link file ── -->
                        <TabItem Header="Link file">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Pick a file, then a heading / class / method" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <Grid Height="230" DataContext="{Binding Picker}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <TreeView x:Name="PickerTree" ItemsSource="{Binding Roots}" Background="Transparent" BorderThickness="0"
                                                  SelectedItemChanged="PickerTree_SelectedItemChanged">
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="TreeViewItem">
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                            <TreeView.Resources>
                                                <HierarchicalDataTemplate DataType="{x:Type vm:FileNode}" ItemsSource="{Binding Children}">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextBrush}"/>
                                                </HierarchicalDataTemplate>
                                            </TreeView.Resources>
                                        </TreeView>
                                    </Border>
                                    <Border Grid.Column="2" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <ListBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SnaplinkTarget}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="{Binding Indent}"/>
                                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Picker.SelectedFileLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,6,0,8"/>
                                <Button Command="{Binding AddPickedSnaplinkCommand}" HorizontalAlignment="Left">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Picker.SelectedTarget}" Value="{x:Null}">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="+ Add selected"/>
                                </Button>
                            </StackPanel>
                        </TabItem>

                        <!-- ── Link URL ── -->
                        <TabItem Header="Link URL">
                            <StackPanel Margin="0,10,0,0">
                                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"
                                         Text="{Binding NewSnaplinkUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <Border AllowDrop="True" DragOver="UrlDrop_DragOver" Drop="UrlDrop_Drop"
                                        Height="150" CornerRadius="6" Background="{StaticResource BgBrush}"
                                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Margin="0,0,0,8">
                                    <TextBlock Text="Drop a URL here" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Border>
                                <Button Command="{Binding AddConcernUrlCommand}" HorizontalAlignment="Left">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewSnaplinkUrl}" Value="">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="🔗 Add URL"/>
                                </Button>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <Button Content="Close" Command="{Binding CloseConcernSnaplinksCommand}" Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Restructure overlay — drag-drop the whole tree to re-parent -->
        <Border Visibility="{Binding RestructureVisible, Converter={StaticResource BoolVis}}"
                Background="#CC000000" Panel.ZIndex="23">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Width="460" MaxHeight="640" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource Surface2Color}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource Surface2Color}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource TextColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TextColor}"/>
                </Border.Resources>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Restructure" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource IconBtn}" Command="{Binding CloseRestructureCommand}" ToolTip="Close">
                            <TextBlock Text="✕" FontSize="12"/>
                        </Button>
                    </Grid>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"
                               Text="Drag a node onto another to re-parent it. Drop on the product (or empty space) to make it top-level."/>
                    <Button DockPanel.Dock="Bottom" Content="Done" Margin="0,10,0,0"
                            Command="{Binding CloseRestructureCommand}" Style="{StaticResource GhostButton}"/>
                    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                        <TreeView ItemsSource="{Binding RestructureRoots}" Background="Transparent" BorderThickness="0"
                                  AllowDrop="True" MinHeight="280"
                                  PreviewMouseLeftButtonDown="RestructureTree_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="RestructureTree_PreviewMouseMove"
                                  MouseRightButtonUp="RestructureTree_MouseRightButtonUp"
                                  DragOver="RestructureTree_DragOver"
                                  Drop="RestructureTree_Drop">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:RestructureNode}" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Title}" FontSize="12" Padding="2,1"
                                               Foreground="{StaticResource TextBrush}"/>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Border>
                </DockPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
