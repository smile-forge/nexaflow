<UserControl x:Class="Nexaflow.Features.ProductManager.Views.ProductSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="ProductSearchView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <!-- One result row: kind badge, what matched, where it is, and the two ways in. -->
        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Query bar ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Graph search" VerticalAlignment="Center"
                       Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold"/>

            <TextBox Grid.Column="1" Margin="14,0,8,0" MaxWidth="520" HorizontalAlignment="Left"
                     MinWidth="260" VerticalContentAlignment="Center" Padding="8,5"
                     AutomationProperties.AutomationId="ProductSearch_Query"
                     Background="{StaticResource DeepBgBrush}" Foreground="{StaticResource TextBrush}"
                     CaretBrush="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Node names and the source behind them">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding RefreshCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <vcc:SearchStatusChip Grid.Column="2" PagePrefix="ProductSearch" Margin="0,0,10,0"/>

            <Button Grid.Column="3" Content="Search" Style="{StaticResource RowBtn}" Padding="14,6"
                    AutomationProperties.AutomationId="ProductSearch_Run"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- ── Status ────────────────────────────────────────────────────── -->
        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="0,0,0,8"
                   AutomationProperties.AutomationId="ProductSearch_Status"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>

        <!-- ── Results ───────────────────────────────────────────────────── -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Results}"
                 AutomationProperties.AutomationId="ProductSearch_Results"
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="10,7" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kind badge: which of the graph's four worlds this row is from. -->
                            <Border Grid.Column="0" VerticalAlignment="Top" Margin="0,1,10,0"
                                    Background="{StaticResource Surface2Brush}" CornerRadius="3" Padding="5,1">
                                <TextBlock Text="{Binding Kind}" FontSize="10"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Label}" FontSize="13"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,1,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- The matched line, shown only for a source hit — for a name hit it would
                                     just repeat the id above it. -->
                                <TextBlock Text="{Binding Text}" FontSize="11" Margin="0,3,0,0"
                                           FontFamily="Cascadia Code, Consolas, monospace"
                                           Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding IsSourceHit, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource RowBtn}"
                                        Content="{Binding OpenLabel}"
                                        IsEnabled="{Binding CanOpen}"
                                        Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}"
                                        ToolTip="Open this result where it lives"
                                        Command="{Binding DataContext.OpenCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource RowBtn}" Content="In graph"
                                        ToolTip="Select this node in the graph viewer"
                                        Command="{Binding DataContext.ShowInGraphCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
