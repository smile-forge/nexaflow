<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════ Product status colour bank ════
         The four node/statustag colours, shipped as an IThemeContribution so they merge BELOW the active
         theme (a fallback): every theme gets these defaults and any theme may retune a key by name without
         Core or the feature referencing each other. Resolved at paint time (sunburst arcs, status pills,
         stacked bar); never hard-coded in code. -->

    <SolidColorBrush x:Key="Product.Status.Done"     Color="#639922"/>  <!-- done    — green  -->
    <SolidColorBrush x:Key="Product.Status.Faulted"  Color="#E24B4A"/>  <!-- faulted — red    -->
    <SolidColorBrush x:Key="Product.Status.Should"   Color="#EF9F27"/>  <!-- should  — amber  -->
    <SolidColorBrush x:Key="Product.Status.Shouldnt" Color="#B4B2A9"/>  <!-- shouldn't — grey -->

</ResourceDictionary>
