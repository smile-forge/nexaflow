<UserControl x:Class="Nexaflow.Features.Git.Viewlets.GitViewletView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexaflow.Features.Git.Converters"
             AutomationProperties.AutomationId="Git_Viewlet">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:GitToneToBrushConverter x:Key="ToneToBrush"/>
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Danger variant of FlatBtn — used by the worktree Remove button -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.ColumnDefinitions>
            <!-- Git logo strip -->
            <ColumnDefinition x:Name="LogoColumn" Width="38"/>
            <!-- Info content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left: git logo strip ─────────────────────────────────────── -->
        <Border x:Name="LogoBorder"
                Grid.Column="0"
                Background="{DynamicResource Git.LogoSurface}"
                BorderBrush="{DynamicResource Git.LogoBorder}"
                BorderThickness="0,0,1,0">
            <Viewbox Width="22" Height="22"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <!-- Canvas matches the SVG coordinate space (icon only, no text) -->
                <Canvas Width="110" Height="110">
                    <Path Fill="{DynamicResource Git.LogoFill}">
                        <!-- SVG: transform="scale(1.179487) translate(10 10) rotate(-45 29 29)"
                             WPF TransformGroup applies left-to-right, so reverse order:
                             rotate first, then translate, then scale -->
                        <Path.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="-45" CenterX="29" CenterY="29"/>
                                <TranslateTransform X="16" Y="16"/>
                                <ScaleTransform ScaleX="1.179487" ScaleY="1.179487"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                        <Path.Data>M5,58c-2.76142,0 -5,-2.23858 -5,-5v-48c0,-2.76142 2.23858,-5 5,-5h33v12.54404c-2.06553,0.94801 -3.5,3.03446 -3.5,5.45596c0,0.73514 0.13221,1.43941 0.37415,2.09031l-15.28384,15.28384c-0.6509,-0.24194 -1.35517,-0.37415 -2.09031,-0.37415c-3.31371,0 -6,2.68629 -6,6c0,3.31371 2.68629,6 6,6c3.31371,0 6,-2.68629 6,-6c0,-0.73514 -0.13221,-1.43941 -0.37415,-2.09031l14.87415,-14.87415l0,11.50851c-2.06553,0.94801 -3.5,3.03446 -3.5,5.45596c0,3.31371 2.68629,6 6,6c3.31371,0 6,-2.68629 6,-6c0,-2.42149 -1.43447,-4.50795 -3.5,-5.45596l0,-12.08808c2.06553,-0.94801 3.5,-3.03446 3.5,-5.45596c0,-2.42149 -1.43447,-4.50795 -3.5,-5.45596l0,-12.54404h10c2.76142,0 5,2.23858 5,5v48c0,2.76142 -2.23858,5 -5,5z</Path.Data>
                    </Path>
                </Canvas>
            </Viewbox>
        </Border>

        <!-- ── Right: info area ─────────────────────────────────────────── -->
        <Grid Grid.Column="1" Margin="9,5,8,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Branch + Pull -->
                <RowDefinition Height="Auto"/>  <!-- Status counts -->
            </Grid.RowDefinitions>

            <!-- Row 0: Branch label + dropdown + worktree badge + action buttons -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- "Branch" label -->
                    <ColumnDefinition Width="Auto"/>  <!-- branch dropdown -->
                    <ColumnDefinition Width="Auto"/>  <!-- worktree badge -->
                    <ColumnDefinition Width="*"/>     <!-- spacer -->
                    <ColumnDefinition Width="Auto"/>  <!-- action buttons -->
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource LabelText}"
                           Text="Branch"
                           Margin="0,0,5,0"/>

                <Button x:Name="BranchButton"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="Git_BranchButton"
                        Style="{StaticResource FlatBtn}"
                        HorizontalAlignment="Left"
                        Padding="4,2"
                        IsEnabled="{Binding IsInteractive}"
                        Click="BranchButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding BranchName}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" ▾"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Worktree badge — shown only when the folder is a linked worktree -->
                <Border Grid.Column="2"
                        AutomationProperties.AutomationId="Git_WorktreeBadge"
                        Visibility="{Binding IsWorktree, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding WorktreeTooltip}"
                        Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="3"
                        Padding="5,1"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="worktree"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="3" HorizontalAlignment="Right">
                    <Button AutomationProperties.AutomationId="Git_PullButton"
                        Style="{StaticResource FlatBtn}"
                        Content="{Binding PullCaption}"
                        Command="{Binding PullCommand}"
                        Padding="6,2"
                        FontSize="10"/>

                    <!-- Remove-worktree button — shown only for a linked worktree -->
                    <Button AutomationProperties.AutomationId="Git_RemoveWorktreeButton"
                        Style="{StaticResource DangerBtn}"
                        Content="Remove"
                        Command="{Binding RemoveWorktreeCommand}"
                        Padding="6,2"
                        FontSize="10"
                        Visibility="{Binding IsWorktree, Converter={StaticResource BoolToVis}}"
                        ToolTip="Remove this worktree (delete its folder and branch)"/>

                    <!-- Open-in-git-manager button — anchored bottom-right of the info column -->
                    <Button AutomationProperties.AutomationId="Git_ManagerButton"
                    Style="{StaticResource FlatBtn}"
                    Content="Open"
                    Command="{Binding OpenGitManagerCommand}"
                    Padding="6,2"
                    FontSize="10"
                    Visibility="{Binding ShowGitManager, Converter={StaticResource BoolToVis}}"
                    ToolTip="Open in Git Manager"/>
                </StackPanel>

            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- "Branch" label -->
                    <ColumnDefinition Width="*"/>
                    <!-- branch dropdown -->
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,5,0">
                    <!-- col 1: Last commit (hidden in SingleBar) -->
                    <TextBlock AutomationProperties.AutomationId="Git_LastCommitLine"
                       Text="{Binding LastCommitLine}"
                       FontSize="10"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis"/>

                    <!-- col 2: Status counts — one run per segment, tone resolved to a theme brush -->
                    <ItemsControl AutomationProperties.AutomationId="Git_StatusLine"
                       ItemsSource="{Binding StatusSegments}"
                       Margin="6,3,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           Foreground="{Binding Tone, Converter={StaticResource ToneToBrush}}"
                                           FontSize="10"
                                           Margin="0,0,6,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Row 3: Pull result — hidden until a pull runs, then fades out -->
                <TextBlock x:Name="PullResultText"
                       AutomationProperties.AutomationId="Git_ActionResult"
                       Grid.Column="1"
                       Text="{Binding ActionResult}"
                       FontSize="10"
                       FontStyle="Italic"
                       Margin="0,3,0,0"
                       Visibility="Collapsed"/>

                </Grid>
            </Grid>
    </Grid>
</UserControl>
