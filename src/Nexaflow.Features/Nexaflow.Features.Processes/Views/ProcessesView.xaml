<UserControl x:Class="Nexaflow.Features.Processes.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Processes.ViewModels"
             xmlns:conv="clr-namespace:Nexaflow.Features.Processes.Converters"
             xmlns:vc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Row context menu. Defined as a resource with Command bindings (NOT Click handlers in a Style
             setter, which breaks WPF's connection-id wiring). The row's ListViewItem carries the page
             view-model in its Tag, so PlacementTarget.Tag → VM and PlacementTarget.DataContext → the row. -->
        <ContextMenu x:Key="RowMenu" x:Shared="False">
            <MenuItem Header="View details"
                      Command="{Binding PlacementTarget.Tag.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Open file location"
                      Command="{Binding PlacementTarget.Tag.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Copy name"
                      Command="{Binding PlacementTarget.Tag.CopyNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Copy PID"
                      Command="{Binding PlacementTarget.Tag.CopyPidCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Copy path"
                      Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Copy details"
                      Command="{Binding PlacementTarget.Tag.CopyDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Kill process" Foreground="{StaticResource DangerBrush}"
                      Command="{Binding PlacementTarget.Tag.KillCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Kill process tree" Foreground="{StaticResource DangerBrush}"
                      Command="{Binding PlacementTarget.Tag.KillTreeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <!-- Sortable GridView header (themed like the rest of the app: DeepBg, muted, resizable) -->
        <Style x:Key="GvHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background"      Value="{StaticResource DeepBgBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="8,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right"
                                   Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SortHeader" DataType="{x:Type vm:SortableHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{x:Static conv:SortBrushConverter.Instance}">
                            <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=ListView}"/>
                            <Binding Path="Key"/>
                        </MultiBinding>
                    </TextBlock.Foreground>
                    <TextBlock.Text>
                        <MultiBinding Converter="{x:Static conv:SortGlyphConverter.Instance}">
                            <Binding Path="DataContext.SortColumn"    RelativeSource="{RelativeSource AncestorType=ListView}"/>
                            <Binding Path="DataContext.SortAscending" RelativeSource="{RelativeSource AncestorType=ListView}"/>
                            <Binding Path="Key"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- Row: themed hover/selection + an accent strip on the selected (actionable) row + right-click menu -->
        <Style x:Key="ProcRow" TargetType="ListViewItem">
            <Setter Property="Foreground"                 Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"                    Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="3,0,0,0">
                            <GridViewRowPresenter VerticalAlignment="Center"
                                Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg" Property="Background"  Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected"  Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBg" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Tag"
                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}"/>
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="NumCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin"              Value="0,0,8,0"/>
            <Setter Property="FontFamily"          Value="Consolas, Cascadia Mono, Menlo, monospace"/>
        </Style>

        <!-- ListView template with a PINNED header: the vertical scrollbar spans only the items area,
             so the thumb no longer rides up alongside the column headers. -->
        <Style x:Key="GridListView" TargetType="ListView">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListView">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <GridViewHeaderRowPresenter Grid.Row="0"
                                    Columns="{Binding View.Columns, RelativeSource={RelativeSource TemplatedParent}}"
                                    ColumnHeaderContainerStyle="{Binding View.ColumnHeaderContainerStyle, RelativeSource={RelativeSource TemplatedParent}}"
                                    AllowsColumnReorder="{Binding View.AllowsColumnReorder, RelativeSource={RelativeSource TemplatedParent}}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                <ScrollViewer Grid.Row="1" Focusable="False" CanContentScroll="True"
                                              Padding="{TemplateBinding Padding}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0: title + counts + system graphs ── -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Processes" Foreground="{StaticResource TextBrush}"
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Bottom" Margin="10,0,0,2"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                           Text="{Binding Rows.Count, StringFormat={}{0} shown}"/>
                <TextBlock VerticalAlignment="Bottom" Margin="4,0,0,2"
                           Foreground="{StaticResource TextDimBrush}" FontSize="12"
                           Text="{Binding ProcessCount, StringFormat={}· {0} total}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="CPU" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Background="{StaticResource DeepBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Width="84" Height="28">
                        <vc:SparklineChart Values="{Binding CpuHistory}" Maximum="100"
                                           Stroke="{StaticResource AccentBrush}"
                                           Fill="{StaticResource AccentSubtleBrush}" Margin="2"/>
                    </Border>
                    <TextBlock Text="{Binding SystemCpuPercent, StringFormat={}{0:0}%}"
                               Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0,0,0" Width="34"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RAM" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Background="{StaticResource DeepBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Width="84" Height="28">
                        <vc:SparklineChart Values="{Binding MemoryHistory}" Maximum="100"
                                           Stroke="{StaticResource Swatch.Teal}" Margin="2"/>
                    </Border>
                    <TextBlock Text="{Binding MemoryLoadPercent, StringFormat={}{0:0}%}"
                               Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0,0,0" Width="34"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ── Row 1: search + view controls ── -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search (≈ as wide as the Name column). Icon / text / clear each get their own column so
                 the caret sits right after the icon — no padding-vs-icon guesswork. -->
            <Border Grid.Column="0" MinWidth="320" MaxWidth="460" HorizontalAlignment="Left"
                    Background="{StaticResource Surface2Brush}" BorderThickness="1" CornerRadius="7">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Margin="10,0,6,0"
                               VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0,7"
                                 AutomationProperties.AutomationId="Proc_Filter"
                                 Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}"
                                 VerticalContentAlignment="Center" FontSize="13"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Search name, PID, company or path…" VerticalAlignment="Center" Margin="2,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" IsHitTestVisible="False"
                                   Visibility="{Binding FilterText, Converter={x:Static conv:EmptyToVisibleConverter.Instance}}"/>
                    </Grid>
                    <Button Grid.Column="2" Content="✕" Command="{Binding ClearFilterCommand}" Style="{StaticResource TbBtn}"
                            AutomationProperties.AutomationId="Proc_ClearFilter"
                            Margin="0,0,4,0" Padding="6,2" FontSize="11"
                            Visibility="{Binding FilterText, Converter={x:Static conv:NonEmptyToVisibleConverter.Instance}}"/>
                </Grid>
            </Border>

            <!-- View controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Content="Tree" IsChecked="{Binding TreeMode}" Style="{StaticResource TbToggle}"
                              AutomationProperties.AutomationId="Proc_ToggleTree"
                              ToolTip="Group processes by parent → child"/>
                <Button Content="Expand all" Command="{Binding ExpandAllCommand}" Style="{StaticResource TbBtn}"
                        AutomationProperties.AutomationId="Proc_ExpandAll"
                        Visibility="{Binding TreeMode, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Collapse all" Command="{Binding CollapseAllCommand}" Style="{StaticResource TbBtn}"
                        AutomationProperties.AutomationId="Proc_CollapseAll"
                        Visibility="{Binding TreeMode, Converter={StaticResource BoolToVis}}"/>
                <Separator Style="{StaticResource TbSep}"/>
                <ToggleButton Content="● Live" IsChecked="{Binding AutoRefreshEnabled}" Style="{StaticResource TbToggle}"
                              AutomationProperties.AutomationId="Proc_ToggleLive"
                              ToolTip="Auto-refresh once per second while this tab is active"/>
                <Button Content="↻" Command="{Binding RefreshNowCommand}" Style="{StaticResource TbBtn}"
                        AutomationProperties.AutomationId="Proc_Refresh"
                        FontSize="14" ToolTip="Refresh now"/>
            </StackPanel>
        </Grid>

        <!-- ── Row 2: process list ── -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
            <ListView x:Name="ProcList"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      SelectionMode="Single"
                      ItemContainerStyle="{StaticResource ProcRow}"
                      Style="{StaticResource GridListView}"
                      Background="Transparent" BorderThickness="0"
                      MouseDoubleClick="ProcList_MouseDoubleClick"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource GvHeader}">
                        <GridViewColumn Width="300" HeaderTemplate="{StaticResource SortHeader}">
                            <GridViewColumn.Header><vm:SortableHeader Label="Name" Key="Name"/></GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                    <StackPanel Orientation="Horizontal"
                                                Margin="{Binding Depth, Converter={x:Static conv:DepthToMarginConverter.Instance}}">
                                        <!-- Expander only in tree mode; flat mode has no hierarchy to expand. -->
                                        <Button Width="16" Height="16" Padding="0" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Visibility="{Binding DataContext.TreeMode,
                                                             RelativeSource={RelativeSource AncestorType=ListView},
                                                             Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.ToggleExpandCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListView}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#x25B6;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Text" Value="&#x25BC;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccessDenied}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="66" HeaderTemplate="{StaticResource SortHeader}">
                            <GridViewColumn.Header><vm:SortableHeader Label="CPU" Key="CpuPercent"/></GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                    <TextBlock Text="{Binding CpuText}" Style="{StaticResource NumCell}"
                                               Foreground="{Binding CpuPercent, Converter={x:Static conv:CpuToBrushConverter.Instance}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="96" HeaderTemplate="{StaticResource SortHeader}">
                            <GridViewColumn.Header><vm:SortableHeader Label="Private" Key="PrivateBytes"/></GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                    <TextBlock Text="{Binding PrivateBytes, Converter={x:Static vcc:BytesToTextConverter.Instance}}"
                                               Style="{StaticResource NumCell}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="96" HeaderTemplate="{StaticResource SortHeader}">
                            <GridViewColumn.Header><vm:SortableHeader Label="Memory" Key="WorkingSet"/></GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                    <TextBlock Text="{Binding WorkingSet, Converter={x:Static vcc:BytesToTextConverter.Instance}}"
                                               Style="{StaticResource NumCell}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="64" HeaderTemplate="{StaticResource SortHeader}">
                            <GridViewColumn.Header><vm:SortableHeader Label="PID" Key="Pid"/></GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                    <TextBlock Text="{Binding Pid}" Style="{StaticResource NumCell}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="230" HeaderTemplate="{StaticResource SortHeader}">
                            <GridViewColumn.Header><vm:SortableHeader Label="Description" Key="Description"/></GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Cell}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="170" HeaderTemplate="{StaticResource SortHeader}">
                            <GridViewColumn.Header><vm:SortableHeader Label="Company" Key="Company"/></GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
                                    <TextBlock Text="{Binding Company}" Style="{StaticResource Cell}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
