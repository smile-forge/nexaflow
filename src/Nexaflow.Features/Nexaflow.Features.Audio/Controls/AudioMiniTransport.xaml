<UserControl x:Class="Nexaflow.Features.Audio.Controls.AudioMiniTransport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ToolTip="{Binding NowPlayingText}">
    <UserControl.Resources>
        <!-- Compact chrome transport button. DynamicResource so it retints with the theme like the
             activity ticker it sits beside (both live on the chrome panel). -->
        <Style x:Key="MiniTransportButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button Style="{StaticResource MiniTransportButton}"
                Content="{Binding PlayPauseGlyph}"
                Command="{Binding PlayPauseCommand}"
                ToolTip="Play / pause"
                AutomationProperties.AutomationId="Audio_Chrome_PlayPause"/>
        <Button Style="{StaticResource MiniTransportButton}"
                Content="⏭"
                Command="{Binding NextCommand}"
                ToolTip="Next track"
                AutomationProperties.AutomationId="Audio_Chrome_Next"/>
    </StackPanel>
</UserControl>
