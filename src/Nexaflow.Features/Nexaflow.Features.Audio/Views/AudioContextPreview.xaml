<UserControl x:Class="Nexaflow.Features.Audio.Views.AudioContextPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Read-only reminder of the Audio page for the conversation context panel: the track's cover, its title
         and artist, and where it sits in the queue. Built fresh each time the chip is selected; it binds to the
         page's now-playing state but owns nothing. -->
    <StackPanel Margin="8">
        <Border Width="160" Height="160" HorizontalAlignment="Left" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock Text="🎵" FontSize="56" Opacity="0.4"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <Image Source="{Binding AlbumArt}" Stretch="UniformToFill"/>
            </Grid>
        </Border>

        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}"
                   Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Text="{Binding Artist}" Margin="0,2,0,0" FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock Text="{Binding QueueText}" Margin="0,4,0,0" FontSize="11"
                   Foreground="{DynamicResource TextMutedBrush}"/>
    </StackPanel>
</UserControl>
