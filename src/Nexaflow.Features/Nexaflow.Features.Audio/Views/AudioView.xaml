<UserControl x:Class="Nexaflow.Features.Audio.Views.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:Nexaflow.Features.Audio.Controls"
             xmlns:conv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="AudioView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- Lyric line: muted by default, highlighted + bold when active. -->
        <Style x:Key="LyricLineStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Audio.Lyrics.Inactive}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Audio.Lyrics.Active}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Playlist rows: selection-free, hover wash, current track accented. -->
        <Style x:Key="PlaylistItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selection-free lyric list rows. -->
        <Style x:Key="LyricItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular transport buttons. -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Volume slider (no app-wide standard exists) ══ -->
        <Style x:Key="VolumeRail" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeRailFilled" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource AccentBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{StaticResource AccentBrush}" Stroke="{StaticResource BgBrush}" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VolumeSlider" TargetType="Slider">
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource Surface2Brush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource VolumeRailFilled}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource VolumeThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource VolumeRail}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Top bar: panel toggles (right-aligned) ────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <ToggleButton Style="{StaticResource TbToggle}" Content="☰  Playlist" HorizontalAlignment="Left"
                              Visibility="{Binding HasPlaylist, Converter={StaticResource BoolToVis}}"
                              Command="{Binding TogglePlaylistCommand}"
                              IsChecked="{Binding IsPlaylistOpen, Mode=OneWay}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton Style="{StaticResource TbToggle}" Content="Tags"
                                  Command="{Binding TogglePanelCommand}" CommandParameter="Tags"
                                  IsChecked="{Binding IsTagsButtonActive, Mode=OneWay}"/>
                    <ToggleButton Style="{StaticResource TbToggle}" Content="Lyrics"
                                  Command="{Binding TogglePanelCommand}" CommandParameter="Lyrics"
                                  IsChecked="{Binding IsLyricsButtonActive, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Content: playlist drawer (left) + player + tags/lyrics drawer (right) ─── -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Playlist drawer (left) — width animates so it pushes the player -->
            <Border Grid.Column="0" x:Name="PlaylistDrawer" Width="0" ClipToBounds="True" Visibility="Collapsed"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Width="300">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Playlist" FontWeight="SemiBold" Margin="14,14,14,10"
                               Foreground="{StaticResource TextBrush}"/>
                    <ListBox Grid.Row="1" x:Name="PlaylistList" ItemsSource="{Binding Playlist}"
                             Background="Transparent" BorderThickness="0" Padding="8,0,8,14" AllowDrop="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource PlaylistItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Main player -->
            <Grid Grid.Column="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: album art + track info -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="120" Height="120" CornerRadius="6"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="🎵" FontSize="44" Opacity="0.4"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <Image Source="{Binding AlbumArt}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding Artist}" FontSize="15" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Album}" FontSize="13" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding QueueText}" FontSize="12" Margin="0,8,0,0"
                                   Visibility="{Binding HasQueue, Converter={StaticResource BoolToVis}}"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Spectrum analyser -->
                <Border Grid.Row="1" MinHeight="140" CornerRadius="6" Padding="6"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ctl:SpectrumAnalyzerControl Bands="{Binding SpectrumBands}"
                                                 LowBrush="{DynamicResource Audio.Spectrum.Low}"
                                                 HighBrush="{DynamicResource Audio.Spectrum.High}"/>
                </Border>

                <!-- Waveform / seek bar + time -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <ctl:WaveformControl x:Name="Waveform" Height="64"
                                         Peaks="{Binding WaveformPeaks}"
                                         Progress="{Binding ProgressFraction}"
                                         PlayedBrush="{DynamicResource Audio.Waveform.Played}"
                                         UnplayedBrush="{DynamicResource Audio.Waveform.Unplayed}"/>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="{Binding PositionText}" HorizontalAlignment="Left" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding DurationText}" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </StackPanel>

                <!-- Transport controls -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource TransportButton}" Content="⏮"
                                Command="{Binding PreviousCommand}" ToolTip="Previous"
                                Visibility="{Binding HasQueue, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource TransportButton}" Content="{Binding PlayPauseGlyph}"
                                Command="{Binding PlayPauseCommand}" FontSize="24" ToolTip="Play / Pause"/>
                        <Button Style="{StaticResource TransportButton}" Content="⏹"
                                Command="{Binding StopCommand}" ToolTip="Stop"/>
                        <Button Style="{StaticResource TransportButton}" Content="⏭"
                                Command="{Binding NextCommand}" ToolTip="Next"
                                Visibility="{Binding HasQueue, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <Slider Style="{StaticResource VolumeSlider}" Width="120" Minimum="0" Maximum="1"
                                VerticalAlignment="Center" Value="{Binding Volume, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Slide-out drawer (Tags / Lyrics) — column width animates so it pushes the player -->
            <Border Grid.Column="2" x:Name="Drawer" Width="340" ClipToBounds="True"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Width="340">
                    <!-- Tags editor (Visibility binds to the AudioViewModel; only the content uses TagEditor) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowTagsPanel, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="14" DataContext="{Binding TagEditor}">
                            <TextBlock Text="Tags" FontWeight="SemiBold" Margin="0,0,0,10"
                                       Foreground="{StaticResource TextBrush}"/>

                            <Border Width="140" Height="140" CornerRadius="6" Margin="0,0,0,8"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Image Source="{Binding ArtPreview}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource TbBtn}" Content="Change art…" Command="{Binding PickArtCommand}"/>
                                <Button Style="{StaticResource TbBtn}" Content="Remove" Command="{Binding RemoveArtCommand}"/>
                            </StackPanel>

                            <TextBlock Text="Title" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="Artist" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="Album" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Year" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Track" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Track, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Genre" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <TextBlock Text="Comment" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Margin="0,0,0,12"/>

                            <Button Style="{StaticResource TbBtn}" Content="Save tags" HorizontalAlignment="Right"
                                    Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Lyrics -->
                    <Grid Visibility="{Binding ShowLyricsPanel, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Lyrics" FontWeight="SemiBold" Margin="14,14,14,10"
                                   Foreground="{StaticResource TextBrush}"/>
                        <Grid Grid.Row="1">
                            <TextBlock Text="No lyrics found." Margin="14,0" Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding Lyrics.HasLyrics, Converter={StaticResource InvBoolToVis}}"/>
                            <ListBox x:Name="LyricsList" ItemsSource="{Binding Lyrics.Lines}"
                                     Background="Transparent" BorderThickness="0" Padding="14,0,14,14"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource LyricItemStyle}"
                                     Visibility="{Binding Lyrics.HasLyrics, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Style="{StaticResource LyricLineStyle}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
