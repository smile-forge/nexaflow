<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- fo-dicom: DICOM parser + model + core rendering (RawImage BGRA32, no System.Drawing). -->
    <PackageReference Include="fo-dicom" Version="5.2.6" />
    <!-- Native cross-platform codecs (JPEG-Lossless/JPEG-LS/JPEG 2000) so real CDs decode. x64 native
         binaries resolve because the solution is x64-pinned (Directory.Build.props). -->
    <PackageReference Include="fo-dicom.Codecs" Version="5.16.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.Features.Common\Nexaflow.Features.Common.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Visuals.Common\Nexaflow.Visuals.Common.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexaflow.Tests.Features.Viewers" />
    <InternalsVisibleTo Include="Nexaflow.Tests.Features.WindowsOS" />
  </ItemGroup>

</Project>
