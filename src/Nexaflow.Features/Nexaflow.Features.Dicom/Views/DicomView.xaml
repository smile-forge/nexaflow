<UserControl x:Class="Nexaflow.Features.Dicom.Views.DicomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Dicom.ViewModels"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="DicomView"
             Background="{StaticResource BgBrush}"
             d:DataContext="{d:DesignInstance vm:DicomViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cv:EnumToBoolConverter x:Key="EnumToBool"/>

        <Style x:Key="TbBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TbToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="200"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- ── Contents tree ─────────────────────────────────────────────── -->
        <Grid Grid.Column="0" Background="{StaticResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: "Contents" on the left, the Hide-patient toggle in line on the right. -->
            <Grid Grid.Row="0" Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Contents" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" Content="Hide patient" VerticalAlignment="Top" Margin="8,0,0,0"
                              Style="{StaticResource TbToggle}"
                              IsChecked="{Binding HidePatientInfo, Mode=TwoWay}"
                              ToolTip="Mask patient name / ID / date of birth in the tree and overlay"/>
            </Grid>

            <TreeView x:Name="Tree" Grid.Row="1" ItemsSource="{Binding Patients}"
                      SelectedItemChanged="OnTreeSelectionChanged"
                      TreeViewItem.Selected="OnTreeItemSelected"
                      Background="Transparent" BorderThickness="0"
                      Foreground="{StaticResource TextBrush}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.Resources>
                    <!-- Accent the selection so it's clearly visible whether or not the tree has focus. -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource AccentColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource TextColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource AccentColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TextColor}"/>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding Glyph}" Margin="0,0,6,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Display}" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Detail}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"/>

        <!-- ── Image pane ────────────────────────────────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="8,6">
                <WrapPanel Orientation="Horizontal" IsEnabled="{Binding HasImage}">
                    <Button Content="Fit" Style="{StaticResource TbBtn}" Click="OnFit" ToolTip="Fit image to window"/>
                    <Button Content="1:1" Style="{StaticResource TbBtn}" Click="OnActualSize" ToolTip="Actual size"/>
                    <ToggleButton Content="Invert" Style="{StaticResource TbToggle}" IsChecked="{Binding Invert, Mode=TwoWay}"
                                  ToolTip="Invert greyscale"/>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,2"/>

                    <RadioButton GroupName="tool" Content="Pan" Style="{StaticResource TbToggle}"
                                 IsChecked="{Binding Measure.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=None}"
                                 ToolTip="Pan (drag) — no measurement"/>
                    <RadioButton GroupName="tool" Content="Length" Style="{StaticResource TbToggle}"
                                 IsChecked="{Binding Measure.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Length}"
                                 ToolTip="Measure a length (2 clicks)"/>
                    <RadioButton GroupName="tool" Content="Angle" Style="{StaticResource TbToggle}"
                                 IsChecked="{Binding Measure.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Angle}"
                                 ToolTip="Measure an angle (3 clicks)"/>
                    <RadioButton GroupName="tool" Content="Rect" Style="{StaticResource TbToggle}"
                                 IsChecked="{Binding Measure.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Rectangle}"
                                 ToolTip="Rectangular ROI"/>
                    <RadioButton GroupName="tool" Content="Ellipse" Style="{StaticResource TbToggle}"
                                 IsChecked="{Binding Measure.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Ellipse}"
                                 ToolTip="Elliptical ROI"/>
                    <RadioButton GroupName="tool" Content="Probe" Style="{StaticResource TbToggle}"
                                 IsChecked="{Binding Measure.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Probe}"
                                 ToolTip="Pixel value / HU probe (hover)"/>
                    <Button Content="Clear" Style="{StaticResource TbBtn}" Command="{Binding ClearMeasurementsCommand}"
                            ToolTip="Clear measurements on this frame"/>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,2"/>

                    <!-- Window presets: the active one highlights; "Default" restores the image's native W/L. -->
                    <RadioButton GroupName="wl" Content="Default" Style="{StaticResource TbToggle}"
                                 Command="{Binding ApplyWindowPresetCommand}" CommandParameter="default"
                                 IsChecked="{Binding ActivePreset, Converter={StaticResource EnumToBool}, ConverterParameter=default, Mode=OneWay}"
                                 ToolTip="Restore the image's original window/level"/>
                    <RadioButton GroupName="wl" Content="Bone" Style="{StaticResource TbToggle}"
                                 Command="{Binding ApplyWindowPresetCommand}" CommandParameter="bone"
                                 IsChecked="{Binding ActivePreset, Converter={StaticResource EnumToBool}, ConverterParameter=bone, Mode=OneWay}"/>
                    <RadioButton GroupName="wl" Content="Lung" Style="{StaticResource TbToggle}"
                                 Command="{Binding ApplyWindowPresetCommand}" CommandParameter="lung"
                                 IsChecked="{Binding ActivePreset, Converter={StaticResource EnumToBool}, ConverterParameter=lung, Mode=OneWay}"/>
                    <RadioButton GroupName="wl" Content="Soft" Style="{StaticResource TbToggle}"
                                 Command="{Binding ApplyWindowPresetCommand}" CommandParameter="soft"
                                 IsChecked="{Binding ActivePreset, Converter={StaticResource EnumToBool}, ConverterParameter=soft, Mode=OneWay}"/>
                    <RadioButton GroupName="wl" Content="Brain" Style="{StaticResource TbToggle}"
                                 Command="{Binding ApplyWindowPresetCommand}" CommandParameter="brain"
                                 IsChecked="{Binding ActivePreset, Converter={StaticResource EnumToBool}, ConverterParameter=brain, Mode=OneWay}"/>
                </WrapPanel>
            </Border>

            <!-- Stage: rendered frame + measurement overlay + text overlays -->
            <Grid x:Name="Stage" Grid.Row="1" Background="{DynamicResource Dicom.Viewport}" ClipToBounds="True"
                  MouseLeftButtonDown="OnStageLeftDown" MouseLeftButtonUp="OnStageLeftUp"
                  MouseRightButtonDown="OnStageRightDown" MouseRightButtonUp="OnStageRightUp"
                  MouseMove="OnStageMouseMove" MouseWheel="OnStageWheel">
                <!-- Host the image on a Canvas so an image LARGER than the viewport keeps its full natural size
                     (a Grid/aligned element clamps oversized content to the viewport, so the render transform
                     then only shows — and scales — a small top-left crop). The Canvas clip does the clipping
                     after the transform. -->
                <Canvas ClipToBounds="True">
                    <Image x:Name="Frame" Source="{Binding CurrentBitmap}" Stretch="None"
                           Canvas.Left="0" Canvas.Top="0"
                           RenderTransformOrigin="0,0" SnapsToDevicePixels="True"/>
                </Canvas>
                <Canvas x:Name="Overlay" IsHitTestVisible="False"/>

                <TextBlock Text="{Binding TechOverlay}" Foreground="{DynamicResource Dicom.OverlayText}" FontSize="11.5"
                           VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,8" IsHitTestVisible="False"/>
                <TextBlock Text="{Binding PatientOverlay}" Foreground="{DynamicResource Dicom.OverlayText}" FontSize="11.5"
                           VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10,8" TextAlignment="Right"
                           IsHitTestVisible="False"
                           Visibility="{Binding PatientOverlayVisible, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding ProbeText}" Foreground="{DynamicResource Dicom.OverlayText}" FontSize="11.5"
                           VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,8" IsHitTestVisible="False"/>

                <!-- Loading / empty state -->
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- Cine transport -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="8,5"
                    Visibility="{Binding MultiFrame, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Content="▶" Style="{StaticResource TbToggle}" IsChecked="{Binding IsCine, Mode=TwoWay}"
                                  ToolTip="Play / pause cine"/>
                    <Button Content="◀" Style="{StaticResource TbBtn}" Command="{Binding PrevFrameCommand}"/>
                    <Button Content="▶|" Style="{StaticResource TbBtn}" Command="{Binding NextFrameCommand}"/>
                    <Slider Width="240" VerticalAlignment="Center" Margin="8,0" Minimum="0"
                            Maximum="{Binding FrameCount}" Value="{Binding FrameIndex, Mode=TwoWay}"
                            SmallChange="1" IsSnapToTickEnabled="True" TickFrequency="1"/>
                </StackPanel>
            </Border>

            <!-- Warnings -->
            <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}"
                       FontSize="10.5" Margin="10,4" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</UserControl>
