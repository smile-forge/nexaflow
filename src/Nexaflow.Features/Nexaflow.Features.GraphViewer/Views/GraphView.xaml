<UserControl x:Class="Nexaflow.Features.GraphViewer.Views.GraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexaflow.Features.GraphViewer.Converters"
             AutomationProperties.AutomationId="GraphView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:CommunityBrushConverter x:Key="CommunityBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- canvas -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource TbBtn}" Content="Reset view" Click="OnResetClick"
                        AutomationProperties.AutomationId="Graph_ResetView" ToolTip="Fit the current neighbourhood to the window"/>
                <Button Style="{StaticResource TbBtn}" Content="← Back" Command="{Binding BackCommand}"
                        AutomationProperties.AutomationId="Graph_Back" ToolTip="Go back to the previous focus"/>
                <Button Style="{StaticResource TbBtn}" Content="◎ Root" Command="{Binding ResetFocusCommand}"
                        AutomationProperties.AutomationId="Graph_ResetFocus" ToolTip="Re-centre on the product root"/>
                <TextBlock Text="Depth" VerticalAlignment="Center" Margin="12,0,4,0" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <Slider Minimum="1" Maximum="10" Value="{Binding HopRadius}" Width="90" VerticalAlignment="Center"
                        IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.AutomationId="Graph_Depth"
                        ToolTip="How many edges out from the focused node to show"/>
                <TextBlock Text="{Binding HopRadius}" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Conf ≥" VerticalAlignment="Center" Margin="14,0,4,0" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding MinConfidence}" Width="80" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Graph_MinConfidence"
                        ToolTip="Hide inferred edges below this confidence (calls/instantiates are name-resolved)"/>
                <TextBlock Text="{Binding FocusLabel, StringFormat='· focus: {0}'}" VerticalAlignment="Center"
                           Margin="12,0,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                <TextBlock Text="{Binding CapNote}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                           Foreground="{StaticResource WarningBrush}"
                           AutomationProperties.AutomationId="Graph_CapNote"/>
            </StackPanel>
        </Border>

        <!-- Canvas + property drawer -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300" MinWidth="220"/>
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0" x:Name="Host" ClipToBounds="True" Background="{StaticResource SurfaceBrush}" Focusable="True"
                MouseWheel="OnWheel"
                MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp"
                SizeChanged="OnHostSizeChanged">
            <Grid>
                <Canvas x:Name="Surface">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="Scale"/>
                            <TranslateTransform x:Name="Translate"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- Edges (drawn under nodes) -->
                    <ItemsControl ItemsSource="{Binding Edges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Line X1="{Binding From.CenterX}" Y1="{Binding From.CenterY}"
                                      X2="{Binding To.CenterX}" Y2="{Binding To.CenterY}"
                                      Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.4"
                                      Opacity="{Binding StrokeOpacity}" StrokeDashArray="{Binding DashArray}"
                                      Visibility="{Binding LodVisible, Converter={StaticResource BoolToVis}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Hyperedges (n-ary: a connector glyph at the endpoint centroid + a spoke to each endpoint) -->
                    <ItemsControl ItemsSource="{Binding HyperEdges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas Visibility="{Binding LodVisible, Converter={StaticResource BoolToVis}}">
                                    <!-- spokes -->
                                    <ItemsControl ItemsSource="{Binding Spokes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Line X1="{Binding DataContext.CenterX, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      Y1="{Binding DataContext.CenterY, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      X2="{Binding Node.CenterX}" Y2="{Binding Node.CenterY}"
                                                      Stroke="{Binding DataContext.GlyphBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      StrokeThickness="1" StrokeDashArray="2 2"
                                                      Opacity="{Binding DataContext.StrokeOpacity, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- connector glyph at the centroid -->
                                    <Path Fill="{Binding GlyphBrush}" Stroke="{StaticResource BgBrush}" StrokeThickness="1"
                                          Opacity="{Binding StrokeOpacity}" ToolTip="{Binding Tooltip}">
                                        <Path.Data>
                                            <EllipseGeometry Center="{Binding Center}" RadiusX="5" RadiusY="5"/>
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Nodes -->
                    <ItemsControl ItemsSource="{Binding Nodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas IsItemsHost="True"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                                <Setter Property="UIElement.Visibility" Value="{Binding LodVisible, Converter={StaticResource BoolToVis}}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" MouseLeftButtonUp="OnNodeClick" Loaded="OnNodeLoaded"
                                            Background="Transparent" ToolTip="{Binding Label}">
                                    <Border Width="{Binding Size}" Height="{Binding Size}" CornerRadius="7"
                                            Background="{Binding Community, Converter={StaticResource CommunityBrush}}"
                                            BorderBrush="{StaticResource BgBrush}" BorderThickness="1"/>
                                    <TextBlock Text="{Binding Label}" Margin="4,0,0,0" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>

                <!-- Error overlay -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16,12"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap" MaxWidth="360"/>
                </Border>

                <!-- Segments rail — floats over the top-left of the canvas; toggles communities on/off -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" MinWidth="180" MaxWidth="248"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Opacity="0.96"
                        AutomationProperties.AutomationId="Graph_SegmentsRail"
                        Visibility="{Binding ShowSegmentsRail, Converter={StaticResource BoolToVis}}"
                        MouseLeftButtonDown="OnOverlayMouseDown" PreviewMouseWheel="OnOverlayWheel">
                    <StackPanel>
                        <!-- header: collapse chevron · title (count) · show-all -->
                        <Grid Margin="8,6,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="0" IsChecked="{Binding IsSegmentsRailExpanded}"
                                          Background="Transparent" BorderThickness="0" Padding="2,0" Cursor="Hand"
                                          VerticalAlignment="Center" Focusable="False"
                                          AutomationProperties.AutomationId="Graph_SegmentsToggle"
                                          ToolTip="Collapse / expand the segment list">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <TextBlock x:Name="Gly" Text="▾" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Gly" Property="Text" Value="▸"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       Text="{Binding Communities.Count, StringFormat='Segments ({0})'}"/>
                            <Button Grid.Column="2" Content="All" Style="{StaticResource TbBtn}"
                                    Command="{Binding ShowAllCommunitiesCommand}"
                                    AutomationProperties.AutomationId="Graph_ShowAllSegments"
                                    ToolTip="Show every community"/>
                        </Grid>

                        <!-- hyperedges toggle -->
                        <CheckBox Margin="10,0,8,6" IsChecked="{Binding ShowHyperEdges}"
                                  Visibility="{Binding HasHyperEdges, Converter={StaticResource BoolToVis}}"
                                  AutomationProperties.AutomationId="Graph_ToggleHyperEdges"
                                  ToolTip="Draw the n-ary hyperedges (signature / annotated / calls)">
                            <TextBlock Text="⬡ Hyperedges" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                        </CheckBox>

                        <!-- community rows -->
                        <ScrollViewer x:Name="SegmentsScroller" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsSegmentsRailExpanded, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Communities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" Background="Transparent" ToolTip="{Binding Label}">
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                          VerticalAlignment="Center"/>
                                                <Border Width="11" Height="11" CornerRadius="3" Margin="4,0,6,0"
                                                        VerticalAlignment="Center" Background="{Binding Swatch}"/>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                           FontSize="11" MaxWidth="128" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource TextBrush}"/>
                                                <TextBlock Text="{Binding Count}" VerticalAlignment="Center"
                                                           FontSize="10" Margin="6,0,0,0"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"/>

        <!-- Property drawer -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock Text="Select a node to inspect it." Margin="16" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding ShowNodePlaceholder, Converter={StaticResource BoolToVis}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="14" DataContext="{Binding SelectedNode}">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding Kind}" FontSize="11" Margin="0,2,0,10"
                                   Foreground="{StaticResource TextMutedBrush}"/>

                        <TextBlock Text="{Binding Id}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{StaticResource TextMutedBrush}"/>

                        <TextBlock Text="{Binding FilePath, StringFormat='File: {0}'}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}"
                                   Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Language, StringFormat='Language: {0}'}" FontSize="11"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding ConfidenceText, StringFormat='Confidence: {0}'}" FontSize="11"
                                   Foreground="{StaticResource TextBrush}"/>

                        <ItemsControl ItemsSource="{Binding MetadataPairs}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding Key, StringFormat='{}{0}: '}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap" Text="{Binding Value}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Open in Code" Margin="0,12,0,0" HorizontalAlignment="Left"
                                Style="{StaticResource TbBtn}"
                                Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.OpenInCodeCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
