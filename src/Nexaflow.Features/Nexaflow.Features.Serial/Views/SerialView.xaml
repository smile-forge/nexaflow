<UserControl x:Class="Nexaflow.Features.Serial.Views.SerialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Serial.ViewModels"
             xmlns:conv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             xmlns:b="clr-namespace:Nexaflow.Visuals.Common.Behaviors;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="SerialView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,4,0" />
        </Style>

        <Style x:Key="SettingCombo" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}">
            <Setter Property="IsEnabled" Value="{Binding IsDisconnected}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="LineRow" TargetType="ListViewItem" BasedOn="{StaticResource FileListRowStyle}">
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- A transcript line: time, direction, then its text or its hex, as the view toggles say. -->
        <DataTemplate x:Key="LineTemplate" DataType="{x:Type vm:SerialLine}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="92" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding DataContext.ShowTimes, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Arrow}" Width="18" FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" />
                <Grid>
                    <TextBlock Text="{Binding Text}" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                               Visibility="{Binding DataContext.ShowHex, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource InvBoolToVis}}" />
                    <TextBlock Text="{Binding Hex}" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                               Visibility="{Binding DataContext.ShowHex, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The port and how it is set: fixed while connected, as both ends must agree. -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
            <WrapPanel>
                <ComboBox Width="260" Style="{StaticResource SettingCombo}" AutomationProperties.AutomationId="Serial_Port"
                          ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="Serial_RefreshPorts" Command="{Binding RefreshPortsCommand}"
                        ToolTip="{loc:Str Serial.Toolbar.RefreshTip}">
                    <TextBlock Text="⟳" />
                </Button>

                <TextBlock Text="{loc:Str Serial.Label.Baud}" Style="{StaticResource Label}" />
                <ComboBox Width="100" Style="{StaticResource SettingCombo}" AutomationProperties.AutomationId="Serial_Baud"
                          ItemsSource="{Binding BaudRates}" SelectedItem="{Binding BaudRate, Mode=TwoWay}" />
                <TextBlock Text="{loc:Str Serial.Label.DataBits}" Style="{StaticResource Label}" />
                <ComboBox Width="50" Style="{StaticResource SettingCombo}" AutomationProperties.AutomationId="Serial_DataBits"
                          ItemsSource="{Binding DataBitsChoices}" SelectedItem="{Binding DataBits, Mode=TwoWay}" />
                <TextBlock Text="{loc:Str Serial.Label.Parity}" Style="{StaticResource Label}" />
                <ComboBox Width="80" Style="{StaticResource SettingCombo}" AutomationProperties.AutomationId="Serial_Parity"
                          ItemsSource="{Binding Parities}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Parity, Mode=TwoWay}" />
                <TextBlock Text="{loc:Str Serial.Label.StopBits}" Style="{StaticResource Label}" />
                <ComboBox Width="55" Style="{StaticResource SettingCombo}" AutomationProperties.AutomationId="Serial_StopBits"
                          ItemsSource="{Binding StopBitsChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding StopBits, Mode=TwoWay}" />
                <TextBlock Text="{loc:Str Serial.Label.Handshake}" Style="{StaticResource Label}" />
                <ComboBox Width="120" Style="{StaticResource SettingCombo}" AutomationProperties.AutomationId="Serial_Handshake"
                          ItemsSource="{Binding Handshakes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Handshake, Mode=TwoWay}" />

                <Separator Style="{StaticResource TbSep}" />
                <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="Serial_Connect" Command="{Binding ConnectCommand}"
                        Visibility="{Binding IsConnected, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="{loc:Str Serial.Toolbar.Connect}" />
                </Button>
                <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="Serial_Disconnect" Command="{Binding DisconnectCommand}"
                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Str Serial.Toolbar.Disconnect}" />
                </Button>
                <ToggleButton Style="{StaticResource TbToggle}" Margin="8,0,0,0" AutomationProperties.AutomationId="Serial_Dtr"
                              IsChecked="{Binding Dtr, Mode=TwoWay}" ToolTip="{loc:Str Serial.Toolbar.DtrTip}" Content="DTR" />
                <ToggleButton Style="{StaticResource TbToggle}" AutomationProperties.AutomationId="Serial_Rts"
                              IsChecked="{Binding Rts, Mode=TwoWay}" ToolTip="{loc:Str Serial.Toolbar.RtsTip}" Content="RTS" />
            </WrapPanel>
        </Border>

        <ListView Grid.Row="1" x:Name="TranscriptList" AutomationProperties.AutomationId="Serial_Transcript" b:ListCopy.Enabled="True"
                  ItemsSource="{Binding Transcript}" ItemTemplate="{StaticResource LineTemplate}" ItemContainerStyle="{StaticResource LineRow}"
                  Background="{StaticResource SurfaceBrush}" BorderThickness="0" Padding="4"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" />

        <!-- Sending, and how the transcript reads. -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,5">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <ComboBox Width="80" Style="{StaticResource DarkComboBox}" Margin="6,0,0,0" AutomationProperties.AutomationId="Serial_LineEnding"
                              ItemsSource="{Binding LineEndings}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LineEnding, Mode=TwoWay}"
                              ToolTip="{loc:Str Serial.Toolbar.LineEndingTip}" />
                    <ToggleButton Style="{StaticResource TbToggle}" Margin="6,0,0,0" AutomationProperties.AutomationId="Serial_SendHex"
                                  IsChecked="{Binding SendHex, Mode=TwoWay}" ToolTip="{loc:Str Serial.Toolbar.SendHexTip}" Content="{loc:Str Serial.Toolbar.SendHex}" />
                    <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="Serial_Send" Command="{Binding SendCommand}">
                        <TextBlock Text="{loc:Str Serial.Toolbar.Send}" />
                    </Button>
                    <Separator Style="{StaticResource TbSep}" />
                    <ToggleButton Style="{StaticResource TbToggle}" AutomationProperties.AutomationId="Serial_ShowHex"
                                  IsChecked="{Binding ShowHex, Mode=TwoWay}" Content="{loc:Str Serial.Toolbar.ShowHex}" />
                    <ToggleButton Style="{StaticResource TbToggle}" AutomationProperties.AutomationId="Serial_Times"
                                  IsChecked="{Binding ShowTimes, Mode=TwoWay}" Content="{loc:Str Serial.Toolbar.Times}" />
                    <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="Serial_Clear" Command="{Binding ClearCommand}">
                        <TextBlock Text="{loc:Str Serial.Toolbar.Clear}" />
                    </Button>
                    <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="Serial_Save" Command="{Binding SaveCommand}">
                        <TextBlock Text="{loc:Str Serial.Toolbar.Save}" />
                    </Button>
                </WrapPanel>
                <TextBox Style="{StaticResource DarkTextBox}" FontFamily="Consolas" AutomationProperties.AutomationId="Serial_SendText"
                         Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsConnected}" VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,3">
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="11">
                    <Run Text="↓" /> <Run Text="{Binding BytesIn, Mode=OneWay}" /> · <Run Text="↑" /> <Run Text="{Binding BytesOut, Mode=OneWay}" />
                </TextBlock>
                <TextBox Style="{StaticResource SelectableText}" Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="NoWrap" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
