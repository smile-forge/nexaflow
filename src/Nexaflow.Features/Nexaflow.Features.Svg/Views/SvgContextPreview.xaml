<UserControl x:Class="Nexaflow.Features.Svg.Views.SvgContextPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    </UserControl.Resources>

    <!-- Read-only reminder of the SVG page for the conversation context panel: the artwork, the file's name and
         its size. Built fresh each time the chip is selected; it binds to the page's frozen drawing, crisp at
         any size, but owns nothing. The art can be transparent, so the placeholder shows only without it. -->
    <StackPanel Margin="8">
        <Border MaxHeight="200" HorizontalAlignment="Left" CornerRadius="6" Padding="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock Text="🖼" FontSize="44" Opacity="0.4" Margin="42,22"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Artifact, Converter={StaticResource NullToCollapsed}}"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <Image Source="{Binding Artifact}" Stretch="Uniform"/>
            </Grid>
        </Border>

        <TextBlock Text="{Binding FileName}" ToolTip="{Binding FileName}"
                   Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Text="{Binding DimensionsText}" Margin="0,2,0,0" FontSize="12"
                   Foreground="{DynamicResource TextMutedBrush}"/>
    </StackPanel>
</UserControl>
