<UserControl x:Class="Nexaflow.Features.Video.Views.VideoContextPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- Read-only reminder of the Video page for the conversation context panel: the first frame and how long
         it runs; the panel's header names the file. Built fresh each time the chip is selected; it binds to the
         page's poster and duration but owns nothing — never the live frame, which only the playing page draws. -->
    <StackPanel Margin="8">
        <Border MaxHeight="200" HorizontalAlignment="Left" CornerRadius="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock Text="🎬" FontSize="44" Opacity="0.4" Margin="48,28"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <Image Source="{Binding PosterImage}" Stretch="Uniform"/>
            </Grid>
        </Border>

        <TextBlock Text="{Binding DurationDisplay}" Margin="0,8,0,0" FontSize="12"
                   Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}"
                   Foreground="{DynamicResource TextMutedBrush}"/>
    </StackPanel>
</UserControl>
