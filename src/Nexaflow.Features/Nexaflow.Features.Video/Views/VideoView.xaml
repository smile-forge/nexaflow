<UserControl x:Class="Nexaflow.Features.Video.Views.VideoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nexaflow.Features.Video.Views"
             AutomationProperties.AutomationId="VideoView"
             Focusable="True"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Nexaflow.Features.Video;component/Views/VideoControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ── Video surface (a plain WPF image — no native window/airspace) + overlays ── -->
        <Grid Grid.Row="0" Grid.Column="0" Background="Black">
            <Image Source="{Binding VideoFrame}" Stretch="Uniform"/>

            <!-- Click anywhere on the picture toggles play/pause. -->
            <Button x:Name="ClickCatcher" Style="{StaticResource ClickCatcherStyle}"
                    Command="{Binding TogglePlayPauseCommand}"/>

            <!-- First-frame poster (until the user first presses play). Non-interactive. -->
            <Image Source="{Binding PosterImage}" Stretch="Uniform" IsHitTestVisible="False"
                   Visibility="{Binding ShowPoster, Converter={StaticResource BoolToVis}}"/>

            <!-- Loading placeholder -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="22,14"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎬" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Loading…" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Error state -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="20,16"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" IsHitTestVisible="False"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource DangerBrush}" TextAlignment="Center"/>
            </Border>

            <!-- Centre play affordance -->
            <Button Style="{StaticResource TransportButton}" Command="{Binding TogglePlayPauseCommand}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    FontSize="48" Padding="22,14" Content="▶"
                    Visibility="{Binding ShowBigPlayButton, Converter={StaticResource BoolToVis}}"/>

            <!-- Transport bar (shared template) -->
            <ContentControl VerticalAlignment="Bottom" ContentTemplate="{StaticResource TransportBarTemplate}"
                            Content="{Binding}"/>
        </Grid>

        <!-- ── Info panel (codec / metadata) ── -->
        <Border Grid.Row="0" Grid.Column="1" Width="300"
                Visibility="{Binding IsInfoPanelVisible, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Media Info" Margin="14,12,14,6"
                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MediaInfo.Sections}" Margin="14,0,14,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,8">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,4"
                                               Foreground="{StaticResource AccentBrush}"/>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                               Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Scene strip (keyframes) ── -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="112"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding ShowSceneStrip, Converter={StaticResource BoolToVis}}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="6,8">
                <ItemsControl ItemsSource="{Binding Keyframes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource KeyframeButton}"
                                    Command="{Binding DataContext.SeekToKeyframeCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" ToolTip="{Binding TimeLabel}">
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Width="160" Height="90" Stretch="UniformToFill"/>
                                    <Border VerticalAlignment="Bottom" Background="{StaticResource SurfaceBrush}"
                                            Opacity="0.85" Padding="4,1">
                                        <TextBlock Text="{Binding TimeLabel}" FontSize="11"
                                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
