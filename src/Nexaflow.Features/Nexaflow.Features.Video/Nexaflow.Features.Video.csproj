<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- The app is win-x64 only (Core pins RuntimeIdentifier=win-x64). Under the "Any CPU" solution
         platform VideoLAN.LibVLC.Windows would otherwise copy x64 + x86 + arm64 native trees (~120 MB+).
         Disable the two we never load so only libvlc\win-x64 lands in the output (mirrors Core's
         StripNonWinX64Runtimes intent, done up-front via the package's own switches). -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp" Version="4.0.0-alpha-20260626-10076" />
    <PackageReference Include="LibVLCSharp.WPF" Version="4.0.0-alpha-20260626-10076" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="4.0.0-alpha-20260625" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.Features.Common\Nexaflow.Features.Common.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Visuals.Common\Nexaflow.Visuals.Common.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Common\Nexaflow.IO.Common.csproj" />
  </ItemGroup>

</Project>
