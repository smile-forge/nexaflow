<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:r="clr-namespace:Nexaflow.Features.UsbProbe.RawTools"
                    xmlns:conv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
                    xmlns:b="clr-namespace:Nexaflow.Visuals.Common.Behaviors;assembly=Nexaflow.Visuals.Common"
                    xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">

    <!-- How the device page draws raw access: the take-over tile (R1, R2) and the raw access tile (R3-R6). -->

    <Style x:Key="RawTools.Muted" TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RawTools.Warning" TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RawTools.Heading" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>

    <Style x:Key="RawTools.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style x:Key="RawTools.Field" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,8,6" />
    </Style>

    <Style x:Key="RawTools.Hex" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
        <Setter Property="FontFamily" Value="Consolas" />
    </Style>

    <BooleanToVisibilityConverter x:Key="RawTools.BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="RawTools.InvBoolToVis" />
    <conv:NullToVisibilityConverter x:Key="RawTools.NullToVis" />

    <!-- R1, R2: the driver it has, what taking it over stops, and the way back. -->
    <DataTemplate DataType="{x:Type r:UsbTakeOverTool}">
        <StackPanel>
            <TextBlock Text="{loc:Str RawTools.TakeOver.Section.Driver}" Style="{StaticResource RawTools.Label}" />
            <TextBox Style="{StaticResource SelectableText}" Text="{Binding Driver, Mode=OneWay}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />

            <StackPanel Visibility="{Binding IsTakenOver, Converter={StaticResource RawTools.BoolToVis}}" Margin="0,8,0,0">
                <TextBox Style="{StaticResource RawTools.Muted}" Text="{Binding BindingState, Mode=OneWay}" />
                <WrapPanel Margin="0,6,0,0">
                    <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbTakeOver_Restore" Command="{Binding RestoreCommand}"
                            IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="{loc:Str RawTools.TakeOver.Button.Restore}" />
                    </Button>
                </WrapPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding CanTakeOver, Converter={StaticResource RawTools.BoolToVis}}" Margin="0,8,0,0">
                <TextBlock Text="{loc:Str RawTools.TakeOver.Section.Impact}" Style="{StaticResource RawTools.Label}" />
                <TextBox Style="{StaticResource RawTools.Muted}" Text="{Binding Impact, Mode=OneWay}" />
                <WrapPanel Margin="0,6,0,0">
                    <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbTakeOver_TakeOver" Command="{Binding TakeOverCommand}"
                            IsEnabled="{Binding IsIdle}">
                        <TextBlock Text="{loc:Str RawTools.TakeOver.Button.TakeOver}" />
                    </Button>
                </WrapPanel>
            </StackPanel>

            <DockPanel Margin="0,8,0,0" Visibility="{Binding HasOtherBindings, Converter={StaticResource RawTools.BoolToVis}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbTakeOver_RestoreAll" Command="{Binding RestoreAllCommand}"
                        IsEnabled="{Binding IsIdle}">
                    <TextBlock Text="{loc:Str RawTools.TakeOver.Button.RestoreAll}" />
                </Button>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                    <Run Text="{Binding OtherBindings, Mode=OneWay}" /> <Run Text="{loc:Str RawTools.TakeOver.Others}" />
                </TextBlock>
            </DockPanel>

            <TextBox Style="{StaticResource RawTools.Muted}" Text="{Binding Outcome, Mode=OneWay}" Margin="0,6,0,0"
                     Visibility="{Binding Outcome, Converter={StaticResource RawTools.NullToVis}}" />
        </StackPanel>
    </DataTemplate>

    <!-- R3-R6: the console, the reader, the writer and the session log. -->
    <DataTemplate DataType="{x:Type r:UsbRawTool}">
        <StackPanel>
            <TextBox Style="{StaticResource RawTools.Warning}" Text="{loc:Str RawTools.Raw.Warning}" />
            <DockPanel Margin="0,6,0,0" Visibility="{Binding IsOpen, Converter={StaticResource RawTools.BoolToVis}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbRaw_LetGo" Command="{Binding LetGoCommand}">
                    <TextBlock Text="{loc:Str RawTools.Raw.Button.LetGo}" />
                </Button>
                <TextBlock VerticalAlignment="Center" Text="{loc:Str RawTools.Raw.Held}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
            </DockPanel>

            <TextBlock Text="{loc:Str RawTools.Raw.Section.Endpoints}" Style="{StaticResource RawTools.Heading}" />
            <ListView ItemsSource="{Binding Pipes}" MaxHeight="130" AutomationProperties.AutomationId="UsbRaw_Pipes" b:ListCopy.Enabled="True"
                      Background="{StaticResource Surface2Brush}" BorderThickness="0" ItemContainerStyle="{StaticResource FileListRowStyle}">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource GridColumnHeaderStyle}">
                        <GridViewColumn Header="{loc:Str RawTools.Raw.Column.Endpoint}" Width="80">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Endpoint}" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{loc:Str RawTools.Raw.Field.Direction}" Width="80">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Direction}" Foreground="{StaticResource TextMutedBrush}" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{loc:Str RawTools.Raw.Field.Type}" Width="100">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Type}" Foreground="{StaticResource TextMutedBrush}" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{loc:Str RawTools.Raw.Column.MaxPacket}" Width="110">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MaxPacketSize}" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{loc:Str RawTools.Raw.Column.Interface}" Width="90">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding InterfaceNumber}" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- R3: a control transfer, from a ready-made standard read or typed in. OUT asks first. -->
            <TextBlock Text="{loc:Str RawTools.Raw.Section.Console}" Style="{StaticResource RawTools.Heading}" />
            <WrapPanel>
                <StackPanel Style="{StaticResource RawTools.Field}">
                    <TextBlock Text="{loc:Str RawTools.Raw.Field.Template}" Style="{StaticResource RawTools.Label}" />
                    <ComboBox Style="{StaticResource DarkComboBox}" Width="230" AutomationProperties.AutomationId="UsbRaw_Template"
                              ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Style="{StaticResource RawTools.Field}">
                    <TextBlock Text="{loc:Str RawTools.Raw.Field.Direction}" Style="{StaticResource RawTools.Label}" />
                    <ComboBox Style="{StaticResource DarkComboBox}" Width="70" AutomationProperties.AutomationId="UsbRaw_Direction"
                              ItemsSource="{Binding Directions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Direction, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Style="{StaticResource RawTools.Field}">
                    <TextBlock Text="{loc:Str RawTools.Raw.Field.Type}" Style="{StaticResource RawTools.Label}" />
                    <ComboBox Style="{StaticResource DarkComboBox}" Width="95" AutomationProperties.AutomationId="UsbRaw_Type"
                              ItemsSource="{Binding RequestTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding RequestType, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Style="{StaticResource RawTools.Field}">
                    <TextBlock Text="{loc:Str RawTools.Raw.Field.Recipient}" Style="{StaticResource RawTools.Label}" />
                    <ComboBox Style="{StaticResource DarkComboBox}" Width="95" AutomationProperties.AutomationId="UsbRaw_Recipient"
                              ItemsSource="{Binding Recipients}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Recipient, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Style="{StaticResource RawTools.Field}">
                    <TextBlock Text="bRequest" Style="{StaticResource RawTools.Label}" />
                    <TextBox Style="{StaticResource RawTools.Hex}" Width="80" AutomationProperties.AutomationId="UsbRaw_Request"
                             Text="{Binding Request, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Str RawTools.Raw.NumberTip}" />
                </StackPanel>
                <StackPanel Style="{StaticResource RawTools.Field}">
                    <TextBlock Text="wValue" Style="{StaticResource RawTools.Label}" />
                    <TextBox Style="{StaticResource RawTools.Hex}" Width="100" AutomationProperties.AutomationId="UsbRaw_Value"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Str RawTools.Raw.NumberTip}" />
                </StackPanel>
                <StackPanel Style="{StaticResource RawTools.Field}">
                    <TextBlock Text="wIndex" Style="{StaticResource RawTools.Label}" />
                    <TextBox Style="{StaticResource RawTools.Hex}" Width="100" AutomationProperties.AutomationId="UsbRaw_Index"
                             Text="{Binding Index, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Str RawTools.Raw.NumberTip}" />
                </StackPanel>
                <StackPanel Style="{StaticResource RawTools.Field}" Visibility="{Binding IsOut, Converter={StaticResource RawTools.InvBoolToVis}}">
                    <TextBlock Text="wLength" Style="{StaticResource RawTools.Label}" />
                    <TextBox Style="{StaticResource RawTools.Hex}" Width="80" AutomationProperties.AutomationId="UsbRaw_Length"
                             Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Str RawTools.Raw.NumberTip}" />
                </StackPanel>
            </WrapPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbRaw_SendControl" Command="{Binding SendControlCommand}">
                    <TextBlock Text="{loc:Str RawTools.Raw.Button.SendControl}" />
                </Button>
                <TextBox Style="{StaticResource RawTools.Hex}" Margin="0,0,6,0" AutomationProperties.AutomationId="UsbRaw_Data"
                         Text="{Binding Data, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Str RawTools.Raw.HexTip}"
                         Visibility="{Binding IsOut, Converter={StaticResource RawTools.BoolToVis}}" />
            </DockPanel>
            <TextBox Style="{StaticResource RawTools.Warning}" Text="{loc:Str RawTools.Raw.VendorWarning}" Margin="0,4,0,0"
                     Visibility="{Binding NeedsWarning, Converter={StaticResource RawTools.BoolToVis}}" />
            <TextBox Style="{StaticResource RawTools.Muted}" Text="{Binding ControlResult, Mode=OneWay}" FontFamily="Consolas" Margin="0,4,0,0"
                     Visibility="{Binding ControlResult, Converter={StaticResource RawTools.NullToVis}}" />

            <!-- R4: an IN endpoint, read until paused. -->
            <StackPanel Visibility="{Binding HasInPipes, Converter={StaticResource RawTools.BoolToVis}}">
                <TextBlock Text="{loc:Str RawTools.Raw.Section.Reader}" Style="{StaticResource RawTools.Heading}" />
                <WrapPanel>
                    <ComboBox Style="{StaticResource DarkComboBox}" Width="260" Margin="0,0,6,0" AutomationProperties.AutomationId="UsbRaw_ReadPipe"
                              ItemsSource="{Binding InPipes}" SelectedItem="{Binding ReadPipe, Mode=TwoWay}" DisplayMemberPath="Label"
                              IsEnabled="{Binding CanChooseReadPipe}" />
                    <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbRaw_StartRead" Command="{Binding StartReadingCommand}"
                            Visibility="{Binding IsReading, Converter={StaticResource RawTools.InvBoolToVis}}">
                        <TextBlock Text="{loc:Str RawTools.Raw.Button.Read}" />
                    </Button>
                    <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbRaw_StopRead" Command="{Binding StopReadingCommand}"
                            Visibility="{Binding IsReading, Converter={StaticResource RawTools.BoolToVis}}">
                        <TextBlock Text="{loc:Str RawTools.Raw.Button.Pause}" />
                    </Button>
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="{Binding ReadCount, Mode=OneWay}" /> <Run Text="{loc:Str RawTools.Raw.Packets}" />
                    </TextBlock>
                </WrapPanel>
            </StackPanel>

            <!-- R5: an OUT endpoint, written once or repeatedly; asks first. -->
            <StackPanel Visibility="{Binding HasOutPipes, Converter={StaticResource RawTools.BoolToVis}}">
                <TextBlock Text="{loc:Str RawTools.Raw.Section.Writer}" Style="{StaticResource RawTools.Heading}" />
                <WrapPanel>
                    <ComboBox Style="{StaticResource DarkComboBox}" Width="260" Margin="0,0,6,6" AutomationProperties.AutomationId="UsbRaw_WritePipe"
                              ItemsSource="{Binding OutPipes}" SelectedItem="{Binding WritePipe, Mode=TwoWay}" DisplayMemberPath="Label"
                              IsEnabled="{Binding CanChooseWritePipe}" />
                    <ToggleButton Style="{StaticResource TbToggle}" Margin="0,0,6,6" AutomationProperties.AutomationId="UsbRaw_PayloadText"
                                  IsChecked="{Binding PayloadIsText, Mode=TwoWay}" Content="{loc:Str RawTools.Raw.Field.AsText}" ToolTip="{loc:Str RawTools.Raw.TextTip}" />
                    <TextBlock Text="{loc:Str RawTools.Raw.Field.Repeat}" VerticalAlignment="Center" Margin="0,0,4,6" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Style="{StaticResource RawTools.Hex}" Width="60" Margin="0,0,6,6" AutomationProperties.AutomationId="UsbRaw_Repeat"
                             Text="{Binding Repeat, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{loc:Str RawTools.Raw.Field.Interval}" VerticalAlignment="Center" Margin="0,0,4,6" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Style="{StaticResource RawTools.Hex}" Width="60" Margin="0,0,6,6" AutomationProperties.AutomationId="UsbRaw_Interval"
                             Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                </WrapPanel>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right">
                        <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbRaw_Write" Command="{Binding WriteCommand}"
                                Visibility="{Binding IsWriting, Converter={StaticResource RawTools.InvBoolToVis}}">
                            <TextBlock Text="{loc:Str RawTools.Raw.Button.Write}" />
                        </Button>
                        <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbRaw_StopWrite" Command="{Binding StopWritingCommand}"
                                Visibility="{Binding IsWriting, Converter={StaticResource RawTools.BoolToVis}}">
                            <TextBlock Text="{loc:Str RawTools.Raw.Button.StopWrite}" />
                        </Button>
                    </WrapPanel>
                    <TextBox Style="{StaticResource RawTools.Hex}" Margin="0,0,6,0" AutomationProperties.AutomationId="UsbRaw_Payload"
                             Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Str RawTools.Raw.HexTip}" />
                </DockPanel>
                <TextBox Style="{StaticResource RawTools.Muted}" Text="{Binding WriteResult, Mode=OneWay}" Margin="0,4,0,0"
                         Visibility="{Binding WriteResult, Converter={StaticResource RawTools.NullToVis}}" />
            </StackPanel>

            <!-- R6: every transfer, newest first; the whole session is saved as text. -->
            <DockPanel Margin="0,10,0,4">
                <WrapPanel DockPanel.Dock="Right">
                    <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbRaw_ClearSession" Command="{Binding ClearSessionCommand}">
                        <TextBlock Text="{loc:Str RawTools.Raw.Button.Clear}" />
                    </Button>
                    <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbRaw_SaveSession" Command="{Binding SaveSessionCommand}">
                        <TextBlock Text="{loc:Str RawTools.Raw.Button.Save}" />
                    </Button>
                </WrapPanel>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{loc:Str RawTools.Raw.Section.Session}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <Run Text="{Binding TransferCount, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                </TextBlock>
            </DockPanel>
            <ListView ItemsSource="{Binding Transfers}" Height="200" AutomationProperties.AutomationId="UsbRaw_Session" b:ListCopy.Enabled="True"
                      Background="{StaticResource Surface2Brush}" BorderThickness="0" ItemContainerStyle="{StaticResource FileListRowStyle}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource GridColumnHeaderStyle}">
                        <GridViewColumn Header="{loc:Str RawTools.Raw.Column.Time}" Width="90">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Time}" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" Width="40">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Direction}" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{loc:Str RawTools.Raw.Column.Target}" Width="240">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Target}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{loc:Str RawTools.Raw.Column.Size}" Width="70">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Size}" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{loc:Str RawTools.Raw.Column.Result}" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="Result" Text="{Binding Result}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Result}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Failed}" Value="True">
                                            <Setter TargetName="Result" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{loc:Str RawTools.Raw.Column.Bytes}" Width="360">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Hex}" FontFamily="Consolas" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hex}" /></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
