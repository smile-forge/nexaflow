<UserControl x:Class="Nexaflow.Features.Console.Controls.ConsoleEnvironmentsEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="12">

        <!-- Toolbar: Add / Remove buttons -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Add"
                    Click="AddEnv_Click"
                    Padding="12,4"
                    Margin="0,0,6,0"
                    Foreground="{StaticResource TextBrush}"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"/>
            <Button Content="Remove"
                    Click="RemoveEnv_Click"
                    Padding="12,4"
                    Foreground="{StaticResource TextBrush}"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"/>
        </StackPanel>

        <!-- Environments grid -->
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="EnvGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="Transparent"
                      FontSize="12"
                      Foreground="{StaticResource TextBrush}"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      ColumnHeaderHeight="28"
                      RowHeight="28">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"      Value="{StaticResource DeepBgBrush}"/>
                        <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
                        <Setter Property="FontSize"        Value="11"/>
                        <Setter Property="Padding"         Value="8,0"/>
                        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                        <Setter Property="Background"      Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding"         Value="8,0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        Width="140"/>
                    <DataGridTextColumn Header="Tab Title"
                                        Binding="{Binding TabTitle, UpdateSourceTrigger=PropertyChanged}"
                                        Width="120"/>
                    <DataGridTextColumn Header="Location Filter"
                                        Binding="{Binding LocationFilter, UpdateSourceTrigger=PropertyChanged}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Initial Command"
                                        Binding="{Binding InitialCommand, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>
                    <DataGridTemplateColumn Header="Default" Width="64" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsDefault, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Checked="IsDefault_Checked"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </DockPanel>
</UserControl>
