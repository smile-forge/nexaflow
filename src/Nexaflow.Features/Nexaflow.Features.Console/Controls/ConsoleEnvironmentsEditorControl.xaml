<UserControl x:Class="Nexaflow.Features.Console.Controls.ConsoleEnvironmentsEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>

        <!-- Field label above each input -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,8,0,3"/>
        </Style>

        <!-- One-line helper text under a field -->
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,3,0,0"/>
        </Style>

        <!-- Collapsible-section header (chevron flips with IsChecked) -->
        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin"              Value="0,12,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Chev" Text="▸" Margin="0,0,6,0"
                                       Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextBlock.Foreground="{StaticResource AccentBrush}"
                                              TextBlock.FontSize="12" TextBlock.FontWeight="SemiBold"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chev" Property="Text" Value="▾"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round "?" help affordance with a wrapped tooltip -->
        <Style x:Key="HelpDot" TargetType="Border">
            <Setter Property="Width"           Value="18"/>
            <Setter Property="Height"          Value="18"/>
            <Setter Property="CornerRadius"    Value="9"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Cursor"          Value="Help"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">

        <!-- Intro -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{loc:Str Console.Environments.Title}"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Margin="0,3,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                       Text="{loc:Str Console.Environments.Intro}"/>
        </StackPanel>

        <!-- Default environment by location (saved from the launch picker) -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ToggleButton Grid.Column="0" Style="{StaticResource SectionToggle}"
                              IsChecked="{Binding LocationsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              AutomationProperties.AutomationId="ConsoleEnv_LocationsToggle">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Str Console.Environments.Locations.Header}"
                                   Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LocationsCount" Margin="6,0,0,0"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="Normal"/>
                    </StackPanel>
                </ToggleButton>

                <Border Grid.Column="1" Style="{StaticResource HelpDot}">
                    <Border.ToolTip>
                        <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                   Text="{loc:Str Console.Environments.Locations.Help}"/>
                    </Border.ToolTip>
                    <TextBlock Text="?" FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <StackPanel Visibility="{Binding LocationsExpanded, RelativeSource={RelativeSource AncestorType=UserControl},
                                              Converter={StaticResource BoolVis}}">
                <TextBlock Style="{StaticResource FieldHint}" Margin="20,4,0,6"
                           Text="{loc:Str Console.Environments.Locations.Hint}"/>

                <!-- Empty state -->
                <TextBlock x:Name="NoBindingsText" Margin="20,2,0,4"
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                           Text="{loc:Str Console.Environments.Locations.Empty}"/>

                <Border x:Name="BindingsBorder" Margin="20,0,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="150" Padding="6,4">
                        <ItemsControl x:Name="BindingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FolderPath}"
                                                   ToolTip="{Binding FolderPath}"
                                                   Foreground="{StaticResource TextBrush}" FontSize="11"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="2,0,8,0"/>
                                        <Border Grid.Column="1" Margin="0,0,6,0"
                                                BorderThickness="1.5" CornerRadius="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <ComboBox ItemsSource="{Binding EnvNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding EnvName, Mode=OneWay}"
                                                      SelectionChanged="BindingEnv_SelectionChanged"
                                                      ToolTip="{loc:Str Console.Environments.Locations.EnvTip}"
                                                      Style="{StaticResource DarkComboBox}" FontSize="11"/>
                                        </Border>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                ToolTip="{loc:Str Console.Environments.Locations.RemoveTip}"
                                                Tag="{Binding}" Click="RemoveBinding_Click" AutomationProperties.AutomationId="ConsoleEnv_RemoveBinding">
                                            <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Master / detail: environments -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" MinWidth="130"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: environment list + add/remove -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="{loc:Str Console.Environments.Add}" MinWidth="56" Margin="0,0,4,0"
                            Style="{StaticResource IconButton}" Click="AddEnv_Click" AutomationProperties.AutomationId="ConsoleEnv_Add"/>
                    <Button x:Name="RemoveButton" Content="{loc:Str Console.Environments.Remove}" MinWidth="72"
                            Style="{StaticResource IconButton}" Click="RemoveEnv_Click" AutomationProperties.AutomationId="ConsoleEnv_Remove"/>
                </StackPanel>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <ListBox x:Name="EnvList"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="EnvList_SelectionChanged"
                             AutomationProperties.AutomationId="ConsoleEnv_List">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding Summary}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- Right: detail form -->
            <Grid Grid.Column="2" Margin="10,0,0,0">

                <TextBlock Text="{loc:Str Console.Environments.NoSelection}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{Binding HasSelectedEnv, RelativeSource={RelativeSource AncestorType=UserControl},
                                                Converter={StaticResource InverseBoolVis}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasSelectedEnv, RelativeSource={RelativeSource AncestorType=UserControl},
                                                   Converter={StaticResource BoolVis}}"
                              DataContext="{Binding SelectedEnv, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <StackPanel Margin="0,0,4,0">

                        <!-- Name -->
                        <TextBlock Text="{loc:Str Console.Environments.Field.Name}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3">
                            <TextBlock.ToolTip>
                                <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                           Text="{loc:Str Console.Environments.Field.NameTip}"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <Border BorderThickness="1.5" CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNameError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" FontSize="11"/>
                        </Border>
                        <TextBlock Style="{StaticResource FieldHint}" Foreground="{StaticResource DangerBrush}"
                                   Text="{loc:Str Console.Environments.Field.NameError}"
                                   Visibility="{Binding HasNameError, Converter={StaticResource BoolVis}}"/>

                        <!-- Tab title -->
                        <TextBlock Text="{loc:Str Console.Environments.Field.TabTitle}" Style="{StaticResource FieldLabel}">
                            <TextBlock.ToolTip>
                                <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                           Text="{loc:Str Console.Environments.Field.TabTitleTip}"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBox Text="{Binding TabTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" FontSize="11"/>

                        <!-- Initial command -->
                        <TextBlock Text="{loc:Str Console.Environments.Field.InitialCommand}" Style="{StaticResource FieldLabel}">
                            <TextBlock.ToolTip>
                                <TextBlock MaxWidth="320" TextWrapping="Wrap"
                                           Text="{loc:Str Console.Environments.Field.InitialCommandTip}"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="…" MinWidth="28" Margin="4,0,0,0"
                                    Style="{StaticResource IconButton}" Click="InitialCmdBrowse_Click" AutomationProperties.AutomationId="ConsoleEnv_BrowseInitialCommand"/>
                            <TextBox Text="{Binding InitialCommand, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" FontSize="11"
                                     FontFamily="Consolas, Courier New"/>
                        </DockPanel>

                        <!-- Environment variables -->
                        <TextBlock Text="{loc:Str Console.Environments.Field.Variables}" Style="{StaticResource FieldLabel}">
                            <TextBlock.ToolTip>
                                <TextBlock MaxWidth="340" TextWrapping="Wrap"
                                           Text="{loc:Str Console.Environments.Field.VariablesTip}"/>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBox Text="{Binding OverridesText, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource DarkTextBox}" FontSize="11"
                                 FontFamily="Consolas, Courier New"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" MinHeight="64"/>
                        <TextBlock Style="{StaticResource FieldHint}"
                                   Text="{loc:Str Console.Environments.Field.VariablesHint}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
