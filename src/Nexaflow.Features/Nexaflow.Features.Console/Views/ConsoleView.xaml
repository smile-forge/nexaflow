<UserControl x:Class="Nexaflow.Features.Console.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Console.ViewModels"
             xmlns:m="clr-namespace:Nexaflow.Features.Console.Models"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <!--
            Read-only selectable transparent TextBox for all console text output.
            Custom Template gives PART_ContentHost a transparent background with no
            scrollbars of its own; the outer ScrollViewer handles scrolling.
        -->
        <Style x:Key="ConsoleTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily"      Value="Consolas, Courier New, monospace"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="TextWrapping"    Value="Wrap"/>
            <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsReadOnly"      Value="True"/>
            <Setter Property="IsTabStop"       Value="False"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Cursor"          Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One command entry: selectable header + single selectable output block -->
        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type m:ConsoleEntry}">
            <StackPanel Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBox Text="&gt; "
                             Foreground="{StaticResource AccentBrush}"
                             FontFamily="Consolas, Courier New" FontSize="13" FontWeight="SemiBold"
                             Style="{StaticResource ConsoleTextBoxStyle}"
                             IsTabStop="False"/>
                    <TextBox Text="{Binding Command, Mode=OneWay}"
                             Foreground="{StaticResource AccentBrush}"
                             FontFamily="Consolas, Courier New" FontSize="13" FontWeight="SemiBold"
                             Style="{StaticResource ConsoleTextBoxStyle}"
                             TextWrapping="Wrap"/>
                    <TextBlock Text=" running..."
                               Foreground="{StaticResource OrangeBrush}"
                               FontSize="10" VerticalAlignment="Center"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <TextBox Style="{StaticResource ConsoleTextBoxStyle}"
                         Text="{Binding OutputText, Mode=OneWay}"
                         Margin="16,0,0,0"
                         TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <!--
            Environment variable row.
            The name column uses SharedSizeGroup="EnvName" so all rows share the same
            width (set to the longest name). Grid.IsSharedSizeScope="True" must be
            set on the containing ItemsControl.
        -->
        <DataTemplate x:Key="EnvVarTemplate" DataType="{x:Type m:EnvVar}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="EnvName"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           FontSize="11" FontFamily="Consolas, Courier New"
                           Foreground="{StaticResource AccentBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}"
                           Padding="0,0,8,0"/>
                <!--
                    Tag carries the UserControl DataContext (ConsoleViewModel) so the
                    ContextMenu can bind commands via PlacementTarget.Tag.
                -->
                <TextBlock Grid.Column="1"
                           Text="{Binding Value}"
                           FontSize="11" FontFamily="Consolas, Courier New"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextTrimming="CharacterEllipsis"
                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="600" FontFamily="Consolas, Courier New" FontSize="11"
                                 Content="{Binding Value}"/>
                    </TextBlock.ToolTip>
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy"
                                      Command="{Binding PlacementTarget.Tag.CopyEnvVarCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Edit value..."
                                      Command="{Binding PlacementTarget.Tag.EditEnvVarCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.DataContext,
                                                                 RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top path bar -->
        <Border Grid.Row="0"
                Background="{StaticResource DeepBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <TextBlock Text="&#x2B21;" Foreground="{StaticResource AccentBrush}"
                           FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentPath}"
                           Foreground="{StaticResource TextBrush}"
                           FontFamily="Consolas, Courier New" FontSize="13"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  [running...]"
                           Foreground="{StaticResource OrangeBrush}" FontSize="11"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </Border>

        <!-- Three-column main area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="120"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"   MinWidth="200"/>
                <ColumnDefinition Width="180" MinWidth="100"/>
            </Grid.ColumnDefinitions>

            <!-- Left: environment variables -->
            <Border Grid.Column="0"
                    Background="{StaticResource DeepBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="Environment"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="10,8">
                        <ItemsControl ItemsSource="{Binding EnvVars}"
                                      ItemTemplate="{StaticResource EnvVarTemplate}"
                                      Grid.IsSharedSizeScope="True"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Center: console output + input-prompt overlay -->
            <Grid Grid.Column="2">
                <Border Background="{StaticResource BgBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="10,6">
                            <TextBlock Text="Console"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Top"
                                   x:Name="EmptyHint"
                                   Text="Type a command prefixed with &gt; in the input bar below"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDimBrush}" FontSize="13"
                                   Margin="0,40"/>
                        <ScrollViewer x:Name="ConsoleScroller"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="14,10"
                                      Background="Transparent">
                            <ItemsControl x:Name="EntriesList"
                                          ItemsSource="{Binding Entries}"
                                          ItemTemplate="{StaticResource EntryTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Input-prompt overlay for env-var editing -->
                <Border Visibility="{Binding InputPromptVisible, Converter={StaticResource BoolVis}}"
                        Background="#CC000000"
                        Panel.ZIndex="20">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Width="320" Padding="16"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding InputPromptTitle}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding InputPromptLabel}"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" Margin="0,0,0,4"/>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="3" Margin="0,0,0,12">
                                <TextBox x:Name="InputPromptTextBox"
                                         Text="{Binding InputPromptValue, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource Surface2Brush}"
                                         Foreground="{StaticResource TextBrush}"
                                         CaretBrush="{StaticResource TextBrush}"
                                         BorderThickness="0" FontSize="12" Padding="8,6"
                                         GotFocus="InputPromptTextBox_GotFocus"
                                         KeyDown="InputPromptTextBox_KeyDown"/>
                            </Border>
                            <Button Content="OK"
                                    Command="{Binding ConfirmInputPromptCommand}"
                                    Cursor="Hand" Margin="0,0,0,6">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding"         Value="0,7"/>
                                        <Setter Property="FontSize"        Value="12"/>
                                        <Setter Property="FontWeight"      Value="SemiBold"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Cancel"
                                    Command="{Binding CancelInputPromptCommand}"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
                                        <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding"         Value="0,7"/>
                                        <Setter Property="FontSize"        Value="12"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background"
                                                                    Value="{StaticResource BorderBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <!-- Right: command history -->
            <Border Grid.Column="3"
                    Background="{StaticResource DeepBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="10,6">
                        <TextBlock Text="History"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,6">
                        <ItemsControl ItemsSource="{Binding CommandHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,5" Margin="0,2" CornerRadius="4"
                                            Background="{StaticResource Surface2Brush}"
                                            Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.RerunCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="Consolas, Courier New"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
