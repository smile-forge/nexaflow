<UserControl x:Class="Nexaflow.Features.WindowsSearch.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Row 0 — Top bar ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding SearchRoot}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SearchRoot}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SearchQuery}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock Text="&#xE72C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,6,0"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Row 1 — Results + Action strip ════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Result list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Verification banner: a content regex can't be answered by the index alone, so results
                     appear speculatively and this reports the background pass that settles them. -->
                <Border Grid.Row="0"
                        x:Name="VerificationBannerHost"
                        AutomationProperties.AutomationId="VerificationBanner"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VerificationPhase}" Value="Running">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding VerificationPhase}" Value="Prompt">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding VerificationPhase}" Value="Done">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding VerificationPhase}" Value="OfferScan">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding VerificationPhase}" Value="Scanning">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding VerificationPhase}" Value="OfferNewSearch">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <DockPanel LastChildFill="True">
                        <!-- Only the Prompt phase asks a question; the others just report. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VerificationPhase}" Value="Prompt">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="Check them"
                                    Style="{StaticResource TbBtn}"
                                    AutomationProperties.AutomationId="VerifyRemaining"
                                    Command="{Binding VerifyRemainingCommand}"
                                    Margin="8,0,4,0"/>
                            <Button Content="Skip"
                                    Style="{StaticResource TbBtn}"
                                    AutomationProperties.AutomationId="SkipVerification"
                                    Command="{Binding SkipVerificationCommand}"/>
                        </StackPanel>

                        <!-- The scan offer and its running state. A separate pair of buttons from the
                             verification prompt above: this one costs minutes, not seconds. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VerificationPhase}" Value="OfferScan">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="Scan"
                                    Style="{StaticResource TbBtn}"
                                    AutomationProperties.AutomationId="ScanFolder"
                                    Command="{Binding ScanFolderCommand}"
                                    Margin="8,0,4,0"/>
                            <Button Content="No thanks"
                                    Style="{StaticResource TbBtn}"
                                    AutomationProperties.AutomationId="DeclineScan"
                                    Command="{Binding StopScanCommand}"/>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VerificationPhase}" Value="Scanning">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="Stop"
                                    Style="{StaticResource TbBtn}"
                                    AutomationProperties.AutomationId="StopScan"
                                    Command="{Binding StopScanCommand}"
                                    Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- Refining an empty result set: offer it as a fresh search instead. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VerificationPhase}" Value="OfferNewSearch">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="Yes"
                                    Style="{StaticResource TbBtn}"
                                    AutomationProperties.AutomationId="RunAsNewSearch"
                                    Command="{Binding RunAsNewSearchCommand}"
                                    Margin="8,0,4,0"/>
                            <Button Content="No"
                                    Style="{StaticResource TbBtn}"
                                    AutomationProperties.AutomationId="DeclineNewSearch"
                                    Command="{Binding DeclineNewSearchCommand}"/>
                        </StackPanel>

                        <!-- The Border carries an AutomationId too, but a Border is not a UIA control and
                             is not reliably discoverable; the text is. -->
                        <TextBlock Text="{Binding VerificationBanner}"
                                   AutomationProperties.AutomationId="VerificationBannerText"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <ListView x:Name="ResultList"
                          Grid.Row="1"
                          ItemsSource="{Binding Results}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          ItemContainerStyle="{StaticResource FileListRowStyle}"
                          Background="{StaticResource BgBrush}"
                          BorderThickness="0"
                          SelectionMode="Single"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          GridViewColumnHeader.Click="OnColumnHeaderClick"
                          Padding="4,4,4,4">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource GridColumnHeaderStyle}">

                            <!-- Name -->
                            <GridViewColumn Header="Name" Width="340">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Icon with a verification badge sitting ON it (fixed cell +
                                                 an opaque disc), not beside it — a mark floating next to
                                                 the icon reads as separate content rather than status. -->
                                            <Grid Width="22" Height="18" Margin="4,0,6,0" VerticalAlignment="Center">
                                                <TextBlock FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="📄"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="Text" Value="📁"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <Border Width="12" Height="12"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        BorderThickness="1"
                                                        BorderBrush="{StaticResource BgBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <!-- Not looked at yet: muted, so a list mid-sweep
                                                                     doesn't shout at the user. -->
                                                                <DataTrigger Binding="{Binding IsUnverified}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource TextMutedBrush}"/>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="ToolTip" Value="Queued — not checked yet"/>
                                                                </DataTrigger>
                                                                <!-- Found, but in a file type we can't read properly.
                                                                     Amber "?": a real hit that deserves a look. -->
                                                                <DataTrigger Binding="{Binding IsUncertain}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="ToolTip" Value="Probably matches — found in a file type we can't read properly, so it may be incidental"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsUnreadable}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource TextMutedBrush}"/>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="ToolTip" Value="Couldn't be checked — this file's text is compressed or unreadable, so it may still match"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="ToolTip" Value="Checked — does not match"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock FontSize="9"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource OnAccentBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="?"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                                        <Setter Property="Text" Value="✕"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding FileName}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRejected}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsUnverified}" Value="True">
                                                                <Setter Property="Opacity" Value="0.75"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Location (relative to root) -->
                            <GridViewColumn Header="Location" Width="240">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Directory}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Directory}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Size -->
                            <GridViewColumn Header="Size" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeDisplay}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,0,8,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Modified -->
                            <GridViewColumn Header="Modified" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedDisplay}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Empty-state overlay. Grid.Row="1" is load-bearing: without it this lands in row 0 and
                     sits on top of the banner, which is where it collided with the banner's own text. It
                     belongs over the LIST — that is the area that is empty. -->
                <TextBlock Grid.Row="1"
                           Text="No results found."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSearching}" Value="False"/>
                                        <Condition Binding="{Binding ResultCount}"  Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Action strip — matches FileSystemView's action strip exactly -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Width="120"
                    MinWidth="120"
                    MaxWidth="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <UniformGrid Columns="2" Margin="4,6,4,6" VerticalAlignment="Top">

                        <!-- Open Location -->
                        <Button Command="{Binding OpenLocationCommand}"
                                ToolTip="Open containing folder in a new Files tab"
                                Width="54" Height="58" Margin="1" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
                                    <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Padding="2">
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="📁" FontSize="18"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Location" FontSize="9"
                                                                   HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Margin="0,3,0,0" MaxWidth="48"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{StaticResource Surface2Brush}"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Open File -->
                        <Button Command="{Binding OpenFileCommand}"
                                ToolTip="Open file with default application"
                                Width="54" Height="58" Margin="1" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
                                    <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Padding="2">
                                                    <StackPanel VerticalAlignment="Center"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="📄" FontSize="18"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Open" FontSize="9"
                                                                   HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Margin="0,3,0,0" MaxWidth="48"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{StaticResource Surface2Brush}"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                    </UniformGrid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══ Row 2 — Status bar ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
