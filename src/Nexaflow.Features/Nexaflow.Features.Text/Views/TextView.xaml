<UserControl x:Class="Nexaflow.Features.Text.Views.TextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:local="clr-namespace:Nexaflow.Features.Text.Views"
             AutomationProperties.AutomationId="TextView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             TOOLBAR
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: encoding selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding AvailableEncodings}"
                              SelectedItem="{Binding SelectedEncoding}"
                              DisplayMemberPath="Name"
                              Width="110"
                              VerticalAlignment="Center"
                              FontSize="11"/>
                </StackPanel>

                <!-- Right: tool buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <ToggleButton Style="{StaticResource TbToggle}"
                                  IsChecked="{Binding ShowLineNumbers}"
                                  ToolTip="Toggle line numbers">
                        <TextBlock Text="≡#" FontSize="12"/>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource TbToggle}"
                                  IsChecked="{Binding WordWrap}"
                                  ToolTip="Toggle word wrap">
                        <TextBlock Text="⇔" FontSize="12"/>
                    </ToggleButton>

                    <Separator Style="{StaticResource TbSep}"/>

                    <Button x:Name="CutButton"   Style="{StaticResource TbBtn}" ToolTip="Cut (Ctrl+X)">
                        <TextBlock Text="✂" FontSize="12"/>
                    </Button>
                    <Button x:Name="CopyButton"  Style="{StaticResource TbBtn}" ToolTip="Copy (Ctrl+C)">
                        <TextBlock Text="⎘" FontSize="12"/>
                    </Button>
                    <Button x:Name="PasteButton" Style="{StaticResource TbBtn}" ToolTip="Paste (Ctrl+V)">
                        <TextBlock Text="📋" FontSize="11"/>
                    </Button>

                    <Separator Style="{StaticResource TbSep}"/>

                    <Button Style="{StaticResource TbBtn}"
                            Command="{Binding ToggleMonitoringCommand}"
                            ToolTip="Toggle file monitoring">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="11" Margin="0,0,4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="👁"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="False">
                                                <Setter Property="Text" Value="🚫"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Monitor" FontSize="11"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
                <!-- Centered search indicator (overlays both columns when active) -->
                <Border Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVis}}"
                        Background="{StaticResource Surface2Brush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding CurrentSearchTerm}"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   MaxWidth="200"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SearchMatchCount, StringFormat=' ({0})'}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                        <Button Style="{StaticResource TbBtn}"
                                Command="{Binding FindPreviousCommand}"
                                ToolTip="Find previous (Shift+F3)"
                                Padding="5,3"
                                Margin="0,0,2,0">
                            <TextBlock Text="←" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource TbBtn}"
                                Command="{Binding FindNextCommand}"
                                ToolTip="Find next (F3)"
                                Padding="5,3"
                                Margin="0,0,6,0">
                            <TextBlock Text="→" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource TbBtn}"
                                Command="{Binding CancelSearchCommand}"
                                ToolTip="Clear search"
                                Padding="5,3"
                                Margin="0">
                            <TextBlock Text="✕" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             CONTENT: editor + minimap
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
            </Grid.ColumnDefinitions>

            <avalon:TextEditor x:Name="Editor"
                               Grid.Column="0"
                               IsReadOnly="True"
                               FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                               FontSize="13"
                               Margin="3,3,0,0"
                               UseLayoutRounding="True"
                               Background="{StaticResource BgBrush}"
                               Foreground="{StaticResource TextBrush}"
                               ScrollViewer.ScrollChanged="Editor_ScrollChanged">
                <avalon:TextEditor.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Cut"   Command="ApplicationCommands.Cut"/>
                        <MenuItem Header="Copy"  Command="ApplicationCommands.Copy"/>
                        <MenuItem Header="Paste" Command="ApplicationCommands.Paste"/>
                    </ContextMenu>
                </avalon:TextEditor.ContextMenu>
            </avalon:TextEditor>

            <local:MiniMapStrip x:Name="MiniMapCanvas"
                                Grid.Column="1"
                                Background="{StaticResource DeepBgBrush}"/>

            <!-- File-changed banner overlaid at top of editor -->
            <Border Grid.Column="0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Margin="4,4,4,0"
                    Background="#CC2A2A00"
                    CornerRadius="4"
                    Padding="10,5"
                    Visibility="{Binding FileChangedBannerVisible, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding FileChangedMessage}"
                           Foreground="#FFFF00"
                           FontSize="12"/>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             STATUS BAR
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource DeepBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="14,0">
                <TextBlock Text="{Binding FileSizeText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           Margin="0,0,16,0"/>
                <TextBlock Text="{Binding LineCount, StringFormat='{}{0} lines'}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           Margin="0,0,16,0"/>
                <TextBlock Text="{Binding SearchMatchCount, StringFormat='{}{0} matches'}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           Margin="0,0,16,0"
                           Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="Streaming"
                           Foreground="{StaticResource WarningBrush}"
                           FontSize="11"
                           Visibility="{Binding IsLargeFile, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
