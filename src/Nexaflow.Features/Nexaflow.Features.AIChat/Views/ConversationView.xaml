<UserControl x:Class="Nexaflow.Features.AIChat.Views.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.AIChat.ViewModels"
             xmlns:tl="clr-namespace:Nexaflow.Features.AIChat.ViewModels.Timeline"
             xmlns:conv="clr-namespace:Nexaflow.Features.AIChat.Converters"
             xmlns:m="clr-namespace:Nexaflow.Features.Common;assembly=Nexaflow.Features.Common"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown;assembly=Nexaflow.Visuals.Text"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
        <cv:MissingPathToVisibilityConverter x:Key="MissingPathVis"/>
        <conv:ContextRiskToVisibilityConverter x:Key="RiskBadgeVis"/>

        <!-- ── Timeline item templates (rendered by the conversation thread) ── -->

        <DataTemplate DataType="{x:Type tl:TimelineUserMessage}">
            <StackPanel HorizontalAlignment="Right" MaxWidth="720">
                <!-- A "?" search marks bubbles in place: a thread is read in order, so hiding the ones
                     that missed would leave replies with nothing to reply to. -->
                <Border CornerRadius="14,14,4,14" Padding="14,10" Margin="0,6,0,0"
                        HorizontalAlignment="Right">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource UserBubbleBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Search.RowWash}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <md:SelectableMarkdownView Markdown="{Binding Text}"/>
                </Border>

                <!-- Timestamp, and (newest message only) the rewind affordance. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,4,6">
                    <TextBlock Text="{Binding TimestampDisplay}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <Button Margin="7,0,0,0"
                            Padding="6,1"
                            Cursor="Hand"
                            Content="↺ Rewind"
                            FontSize="10"
                            Visibility="{Binding IsLast, Converter={StaticResource BoolVis}}"
                            ToolTip="Rewind to here — deletes this message and everything after it, and puts the text back in the AI box."
                            Command="{Binding DataContext.RewindToCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      TextElement.Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background"
                                                Value="{StaticResource Surface2Brush}"/>
                                        <Setter TargetName="bg" Property="BorderBrush"
                                                Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type tl:TimelineAssistantMessage}">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="14,14,14,4" Padding="14,10" Margin="0,6"
                    MaxWidth="720" HorizontalAlignment="Left">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Search.RowWash}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <md:SelectableMarkdownView Markdown="{Binding Text}"/>
            </Border>
        </DataTemplate>

        <!-- The model ended a turn saying nothing. Reported, not rendered as an empty bubble. -->
        <DataTemplate DataType="{x:Type tl:TimelineNotice}">
            <TextBlock Text="{Binding Text}"
                       Margin="2,8"
                       FontSize="12" FontStyle="Italic"
                       HorizontalAlignment="Left"
                       Foreground="{StaticResource TextMutedBrush}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type tl:TimelineToolBatch}">
            <StackPanel Margin="0,4" HorizontalAlignment="Left" MaxWidth="720">
                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}" Cursor="Hand" HorizontalAlignment="Left">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Chev" Text="▸" Margin="0,0,7,0"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="🛠" Margin="0,0,7,0" FontSize="12"/>
                                    <TextBlock Text="{Binding Header}" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chev" Property="Text" Value="▾"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ItemsControl ItemsSource="{Binding Tools}" Margin="20,4,0,0"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type tl:TimelineToolRun}">
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="{Binding Tool}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="Sum" Text="{Binding Summary}" FontSize="11" Margin="8,0,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="540"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="Sum" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type tl:TimelineApproval}">
            <Border Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,6"
                    MaxWidth="720" HorizontalAlignment="Left">
                <StackPanel>
                    <!-- The model's reason for wanting the tools. Computed all along but never shown, so an
                         approval prompt used to arrive with no stated purpose. Collapses when it gave none. -->
                    <md:SelectableMarkdownView Markdown="{Binding Explanation}"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding HasExplanation, Converter={StaticResource BoolVis}}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Summary}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>

                        <!-- Buttons inline to the right of the question (while unresolved) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="14,0,0,0"
                                    Visibility="{Binding Resolved, Converter={StaticResource InvBoolVis}}">
                            <Button Style="{StaticResource RibbonButton}" Padding="12,6" Margin="0,0,8,0"
                                    Content="Deny" Command="{Binding DenyCommand}"/>
                            <Button Style="{StaticResource RibbonButton}" Padding="12,6"
                                    Content="Accept" Command="{Binding ApproveCommand}"/>
                        </StackPanel>

                        <!-- Resolved outcome takes the buttons' place -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                              Visibility="{Binding Resolved, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="✓ Approved" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                       Visibility="{Binding Approved, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="✕ Declined" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding Approved, Converter={StaticResource InvBoolVis}}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type tl:TimelineActivity}">
            <StackPanel Orientation="Horizontal" Margin="2,8" HorizontalAlignment="Left">
                <TextBlock Text="{Binding Text}" FontStyle="Italic" FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="…" Width="20" FontStyle="Italic" FontSize="14"
                           Foreground="{StaticResource TextMutedBrush}">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Text" Duration="0:0:1.2">
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0"   Value=""/>
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="."/>
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.6" Value=".."/>
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.9" Value="..."/>
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65*" MinWidth="320"/>   <!-- conversation (never crushed by the drag) -->
            <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0"/>   <!-- drag handle -->
            <!-- Preview: 35% of the width while a context item is selected, collapsed to nothing otherwise.
                 Width + MinWidth are driven from code so the column can both collapse (MinWidth 0) and, when
                 open, resist being dragged to nothing. -->
            <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>   <!-- context banner -->
            <RowDefinition Height="*"/>     <!-- conversation  -->
            <RowDefinition Height="32"/>    <!-- token footer  -->
        </Grid.RowDefinitions>

        <!-- ── Context Items banner ─────────────────────────────────────── -->
        <Border Grid.Row="0"
                x:Name="ContextBanner"
                Margin="12,12,12,0"
                Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                AllowDrop="True">
            <Grid Margin="16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Context Items"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <!-- Items area: transparent background so drags fall through to the
                     outer Border, with content centred both axes. -->
                <Grid Grid.Row="1" Background="Transparent">
                    <!-- Empty-state placeholder, centred. Non-hit-testable so it
                         doesn't interfere with drop targeting. -->
                    <Border Visibility="{Binding HasContextItems, Converter={StaticResource InvBoolVis}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            IsHitTestVisible="False">
                        <TextBlock Text="Drag tabs or files here"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12"/>
                    </Border>

                    <!-- Items, centred and laid out from the centre outwards. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Background="Transparent">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding ContextItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ContextItemViewModel}">
                                        <!-- The chip is a button: clicking it selects the item and opens the
                                             preview panel; clicking the selected one closes it again. -->
                                        <Button Command="{Binding DataContext.SelectContextItemCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Chip"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="14,12"
                                                            Margin="6,0"
                                                            MinWidth="140"
                                                            MinHeight="68">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <!-- Icon + bottom-right security-risk badge -->
                                                                <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Page.Icon}" FontSize="22"
                                                                               Foreground="{StaticResource TextBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                    <!-- Medium risk: whole (non-system) drive -->
                                                                    <Border Width="14" Height="14" CornerRadius="7"
                                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                            Margin="0,0,-4,-2"
                                                                            Background="{StaticResource WarningBrush}"
                                                                            ToolTip="Elevated risk: the AI can make broad changes within this tab's scope."
                                                                            Visibility="{Binding Page.SecurityRisk, Converter={StaticResource RiskBadgeVis}, ConverterParameter=Medium}">
                                                                        <TextBlock Text="!" FontSize="9" FontWeight="Bold"
                                                                                   Foreground="{StaticResource OnAccentBrush}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <!-- High risk: unconfined / system-critical -->
                                                                    <Border Width="14" Height="14" CornerRadius="7"
                                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                            Margin="0,0,-4,-2"
                                                                            Background="{StaticResource DangerBrush}"
                                                                            ToolTip="High risk: this tab's scope is broad and sensitive — the AI could read or change critical parts of your system."
                                                                            Visibility="{Binding Page.SecurityRisk, Converter={StaticResource RiskBadgeVis}, ConverterParameter=High}">
                                                                        <TextBlock Text="!" FontSize="9" FontWeight="Bold"
                                                                                   Foreground="{StaticResource OnAccentBrush}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Page.Title}" FontSize="13"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <Button x:Name="RemoveBtn"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="0,-6,-6,0"
                                                                    Width="18" Height="18"
                                                                    Opacity="0"
                                                                    Cursor="Hand"
                                                                    ToolTip="Remove"
                                                                    Command="{Binding DataContext.RemoveContextItemCmdCommand,
                                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="bg"
                                                                                Background="{StaticResource Surface2Brush}"
                                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="9">
                                                                            <TextBlock Text="✕" FontSize="9"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"
                                                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="bg" Property="Background"
                                                                                        Value="{StaticResource AccentBrush}"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chip" Property="BorderBrush"
                                                                    Value="{StaticResource AccentBrush}"/>
                                                            <Setter TargetName="RemoveBtn" Property="Opacity" Value="1"/>
                                                        </Trigger>

                                                        <!-- Selected: the chip whose preview is open. -->
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Chip" Property="BorderBrush"
                                                                    Value="{StaticResource AccentBrush}"/>
                                                            <Setter TargetName="Chip" Property="BorderThickness" Value="2"/>
                                                            <Setter TargetName="Chip" Property="Background"
                                                                    Value="{StaticResource Surface2Brush}"/>
                                                        </DataTrigger>

                                                        <!-- Re-added while already pinned: pulse, so the answer to
                                                             "why did nothing happen?" is visible. Swaps the brush
                                                             outright — the literal Transparent brush is frozen, so
                                                             animating BorderBrush.Color on it would throw. -->
                                                        <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="FlashSb">
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <ObjectAnimationUsingKeyFrames
                                                                            Storyboard.TargetName="Chip"
                                                                            Storyboard.TargetProperty="BorderBrush"
                                                                            Duration="0:0:0.4">
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0"
                                                                                Value="{StaticResource AccentBrush}"/>
                                                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.2"
                                                                                Value="{StaticResource BorderBrush}"/>
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="FlashSb"/>
                                                            </DataTrigger.ExitActions>
                                                            <Setter TargetName="Chip" Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="AttChip"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,12"
                                                Margin="6,0"
                                                MinWidth="140"
                                                MinHeight="68">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="📎" FontSize="20"
                                                               Foreground="{StaticResource TextBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding}" FontSize="13"
                                                               Foreground="{StaticResource TextBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="260"/>
                                                </StackPanel>

                                                <!-- Missing-file marker: the attachment is just a reference,
                                                     so flag it when the file no longer exists on disk. -->
                                                <TextBlock Text="⚠" FontSize="14"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                                           Margin="-4,-6,0,0"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           ToolTip="File not found — it may have been moved or deleted."
                                                           Visibility="{Binding Converter={StaticResource MissingPathVis}}"/>
                                                <Button x:Name="AttRemoveBtn"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-6,-6,0"
                                                        Width="18" Height="18"
                                                        Opacity="0"
                                                        Cursor="Hand"
                                                        ToolTip="Remove"
                                                        Command="{Binding DataContext.RemoveAttachmentCmdCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg"
                                                                    Background="{StaticResource Surface2Brush}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="9">
                                                                <TextBlock Text="✕" FontSize="9"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background"
                                                                            Value="{StaticResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="AttChip" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AttChip" Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="AttRemoveBtn" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Conversation messages + queued-interjection strip ──────────── -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          x:Name="MessageScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,16">
                <ItemsControl x:Name="MessageList" ItemsSource="{Binding Timeline}"/>
            </ScrollViewer>

            <!-- Messages typed while the agent works, awaiting delivery at the next turn boundary. -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding PendingInterjections}"
                          Margin="24,2,24,6"
                          Visibility="{Binding PendingInterjections.Count, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="8,3" Margin="0,2,6,2" Opacity="0.75">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏳" FontSize="10" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- ── Footer (token budget) ────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <!-- Left of the token count: the chip is about the thread, the count about the budget. -->
                <vcc:SearchStatusChip PagePrefix="Conversation" HorizontalAlignment="Left"/>
                <TextBlock x:Name="TokenFooter"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>

        <!-- Drag handle between the thread and the preview. Only hit-testable while the preview is open. -->
        <GridSplitter Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      Cursor="SizeWE"
                      Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolVis}}"/>

        <!-- ── Context preview panel ─────────────────────────────────────
             Opens when a context chip is selected. Shows the page's own read-only view when it implements
             IContextPreview; otherwise an identity placeholder with the context text the AI actually sees
             (a live tab's content is already parented in the tab host and cannot be re-hosted here). -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: title + the collapse button (which also deselects the chip) -->
                <Grid Grid.Row="0" Margin="12,10,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding PreviewTitle}"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}"/>

                    <Button Grid.Column="1"
                            Width="22" Height="22"
                            Cursor="Hand"
                            ToolTip="Close preview"
                            Command="{Binding ClosePreviewCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <TextBlock Text="✕" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background"
                                                Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- The page's own preview -->
                <ContentControl Grid.Row="1"
                                Content="{Binding PreviewContent}"
                                Visibility="{Binding HasPreviewContent, Converter={StaticResource BoolVis}}"/>

                <!-- …or the placeholder, for a page that offers no IContextPreview -->
                <ScrollViewer Grid.Row="1"
                              Margin="12,0,12,12"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasPreviewContent, Converter={StaticResource InvBoolVis}}">
                    <StackPanel>
                        <TextBlock Text="This tab has no preview of its own."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="What the AI sees:"
                                   Margin="0,12,0,4"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <Border Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10">
                            <TextBlock Text="{Binding PreviewFallbackText}"
                                       FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
