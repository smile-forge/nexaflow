<UserControl x:Class="Nexaflow.Features.AIChat.Views.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.AIChat.ViewModels"
             xmlns:m="clr-namespace:Nexaflow.Features.Common;assembly=Nexaflow.Features.Common"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="160"/>   <!-- context banner -->
            <RowDefinition Height="*"/>     <!-- conversation  -->
            <RowDefinition Height="32"/>    <!-- token footer  -->
        </Grid.RowDefinitions>

        <!-- ── Context Items banner ─────────────────────────────────────── -->
        <Border Grid.Row="0"
                x:Name="ContextBanner"
                Margin="12,12,12,0"
                Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                AllowDrop="True">
            <Grid Margin="16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Context Items"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <!-- Items area: transparent background so drags fall through to the
                     outer Border, with content centred both axes. -->
                <Grid Grid.Row="1" Background="Transparent">
                    <!-- Empty-state placeholder, centred. Non-hit-testable so it
                         doesn't interfere with drop targeting. -->
                    <Border Visibility="{Binding ContextItems.Count, Converter={StaticResource InvBoolVis}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            IsHitTestVisible="False">
                        <TextBlock Text="Drag tabs or files here"
                                   Foreground="{StaticResource TextDimBrush}"
                                   FontSize="12"/>
                    </Border>

                    <!-- Items, centred and laid out from the centre outwards. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Background="Transparent">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding ContextItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:Page}">
                                        <Border x:Name="Chip"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,12"
                                                Margin="6,0"
                                                MinWidth="140"
                                                MinHeight="68">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}" FontSize="22"
                                                               Foreground="{StaticResource TextBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               Foreground="{StaticResource TextBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button x:Name="RemoveBtn"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-6,-6,0"
                                                        Width="18" Height="18"
                                                        Opacity="0"
                                                        Cursor="Hand"
                                                        ToolTip="Remove"
                                                        Command="{Binding DataContext.RemoveContextItemCmdCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg"
                                                                    Background="{StaticResource Surface2Brush}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="9">
                                                                <TextBlock Text="✕" FontSize="9"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background"
                                                                            Value="{StaticResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chip" Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="RemoveBtn" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="AttChip"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14,12"
                                                Margin="6,0"
                                                MinWidth="140"
                                                MinHeight="68">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="📎" FontSize="20"
                                                               Foreground="{StaticResource TextBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding}" FontSize="13"
                                                               Foreground="{StaticResource TextBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="260"/>
                                                </StackPanel>
                                                <Button x:Name="AttRemoveBtn"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-6,-6,0"
                                                        Width="18" Height="18"
                                                        Opacity="0"
                                                        Cursor="Hand"
                                                        ToolTip="Remove"
                                                        Command="{Binding DataContext.RemoveAttachmentCmdCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg"
                                                                    Background="{StaticResource Surface2Brush}"
                                                                    BorderBrush="{StaticResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="9">
                                                                <TextBlock Text="✕" FontSize="9"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background"
                                                                            Value="{StaticResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="AttChip" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="AttChip" Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="AttRemoveBtn" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Conversation messages ────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1"
                      x:Name="MessageScroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,16">
            <ItemsControl x:Name="MessageList"/>
        </ScrollViewer>

        <!-- ── Footer (token budget) ────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="TokenFooter"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="20,0"
                       FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"/>
        </Border>
    </Grid>
</UserControl>
