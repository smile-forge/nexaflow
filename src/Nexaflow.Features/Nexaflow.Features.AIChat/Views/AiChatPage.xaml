<UserControl x:Class="Nexaflow.Features.AIChat.Views.AiChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.AIChat.ViewModels"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <Style x:Key="SummaryHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,12,0,3"/>
        </Style>
        <Style x:Key="SummaryBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- One conversation row -->
        <DataTemplate x:Key="ConversationRowTemplate" DataType="{x:Type vm:ConversationRowViewModel}">
            <Border Padding="12,10" Margin="0,3" CornerRadius="8"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>  <!-- title + meta -->
                        <ColumnDefinition Width="*"/>    <!-- summary -->
                        <ColumnDefinition Width="Auto"/> <!-- actions -->
                    </Grid.ColumnDefinitions>

                    <!-- Delete (x) — top-right corner -->
                    <Button Grid.ColumnSpan="3"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource RibbonButton}"
                            Padding="5,1" Margin="0,-4,-4,0"
                            ToolTip="Delete conversation"
                            Command="{Binding DataContext.DeleteConversationCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <TextBlock Text="&#x2715;" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                    </Button>

                    <!-- Left: title + start/end + message count -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0">
                            <Run Text="{Binding StartDisplay, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding EndDisplay, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="10" Foreground="{StaticResource TextDimBrush}" Margin="0,1,0,0">
                            <Run Text="{Binding MessageCount, Mode=OneWay}"/><Run Text=" messages"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Middle: summary -->
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Text="{Binding SummaryText}"
                               FontSize="12" TextWrapping="Wrap" MaxHeight="60"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMutedBrush}"/>

                    <!-- Right: Open + Analysis -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource RibbonButton}"
                                Padding="12,6" Margin="0,0,6,0"
                                Command="{Binding DataContext.OpenConversationCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4AC;" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Open" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RibbonButton}"
                                Padding="9,6" ToolTip="View analysis"
                                Command="{Binding DataContext.ShowAnalysisCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="&#x1F50D;" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- header -->
            <RowDefinition Height="*"/>    <!-- list -->
        </Grid.RowDefinitions>

        <!-- Header: title + New conversation -->
        <Grid Grid.Row="0" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Conversations"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"/>
                <ComboBox Style="{StaticResource DarkComboBox}"
                          Width="130" Margin="12,0,0,0" VerticalAlignment="Center"
                          ToolTip="Filter by date"
                          ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding SelectedFilter}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource RibbonButton}" Padding="12,6"
                    ToolTip="Start a new conversation"
                    Command="{Binding NewConversationCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2795;" FontSize="12" Margin="0,0,6,0"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="New conversation" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Conversation list -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,12">
            <ItemsControl x:Name="ConversationList"
                          ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource ConversationRowTemplate}"/>
        </ScrollViewer>

        <!-- ── Analysis detail overlay (modal: backdrop blocks the list) ── -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#CC0B0B0F"
                Visibility="{Binding IsAnalysisOverlayOpen, Converter={StaticResource BoolVis}}">
            <Border Width="640" MaxHeight="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- header -->
                        <RowDefinition Height="*"/>    <!-- body -->
                        <RowDefinition Height="Auto"/> <!-- footer -->
                    </Grid.RowDefinitions>

                    <!-- Header: title + close -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding AnalysisOverlayItem.Title}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Style="{StaticResource RibbonButton}"
                                Padding="9,5" ToolTip="Close"
                                Command="{Binding CloseAnalysisCommand}">
                            <TextBlock Text="&#x2715;" FontSize="13"/>
                        </Button>
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <!-- No analysis yet / disabled -->
                            <TextBlock Text="{Binding AnalysisOverlayItem.SummaryText}"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding AnalysisOverlayItem.HasAnalysis, Converter={StaticResource InvBoolVis}}"/>

                            <!-- Structured analysis (outer keeps VM context for Visibility;
                                 inner rebinds to the analysis object) -->
                            <StackPanel Visibility="{Binding AnalysisOverlayItem.HasAnalysis, Converter={StaticResource BoolVis}}">
                              <StackPanel DataContext="{Binding AnalysisOverlayItem.Analysis}">
                                <TextBlock Text="{Binding Summary}"
                                           FontSize="14" TextWrapping="Wrap" FontWeight="Medium"
                                           Foreground="{StaticResource TextBrush}"/>

                                <TextBlock Text="Topic" Style="{StaticResource SummaryHeading}"/>
                                <TextBlock Text="{Binding Topic}" Style="{StaticResource SummaryBody}"/>

                                <TextBlock Text="Tone" Style="{StaticResource SummaryHeading}"/>
                                <TextBlock Text="{Binding Tone}" Style="{StaticResource SummaryBody}"/>

                                <TextBlock Text="Tone Evolution" Style="{StaticResource SummaryHeading}"/>
                                <TextBlock Text="{Binding ToneEvolution}" Style="{StaticResource SummaryBody}"/>

                                <TextBlock Text="Understanding of User" Style="{StaticResource SummaryHeading}"/>
                                <TextBlock Text="{Binding UnderstandingOfUser}" Style="{StaticResource SummaryBody}"/>

                                <TextBlock Text="Understanding of Agent" Style="{StaticResource SummaryHeading}"/>
                                <TextBlock Text="{Binding UnderstandingOfAgent}" Style="{StaticResource SummaryBody}"/>

                                <TextBlock Text="Key Decision Points" Style="{StaticResource SummaryHeading}"/>
                                <ItemsControl ItemsSource="{Binding KeyDecisionPoints}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource SummaryBody}" Margin="8,1,0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Important Facts" Style="{StaticResource SummaryHeading}"/>
                                <ItemsControl ItemsSource="{Binding ImportantFacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource SummaryBody}" Margin="8,1,0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Valuable Attachments" Style="{StaticResource SummaryHeading}"/>
                                <ItemsControl ItemsSource="{Binding ValuableAttachments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource SummaryBody}" Margin="8,1,0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Footer: Open -->
                    <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Style="{StaticResource RibbonButton}" Padding="14,7"
                            Command="{Binding OpenConversationCommand}"
                            CommandParameter="{Binding AnalysisOverlayItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4AC;" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Open conversation" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
