<UserControl x:Class="Nexaflow.Features.AIChat.Views.AiChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.AIChat.ViewModels"
             xmlns:m="clr-namespace:Nexaflow.Features.Common;assembly=Nexaflow.Features.Common"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <!-- Conversation history item template (left panel) -->
        <DataTemplate x:Key="ConversationItemTemplate" DataType="{x:Type m:ConversationRecord}">
            <Border Padding="10,8" Margin="0,2" CornerRadius="6"
                    Background="{StaticResource Surface2Brush}"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectConversationCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontSize="12" FontWeight="Medium"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DateDisplay}"
                               FontSize="10" Foreground="{StaticResource TextDimBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Chat message template — ordered by timestamp, user right / Aria left -->
        <DataTemplate x:Key="ChatMessageTemplate" DataType="{x:Type m:ConversationMessage}">
            <Grid Margin="0,6">
                <!-- User message (right-aligned) -->
                <StackPanel HorizontalAlignment="Right"
                            Visibility="{Binding IsUser, Converter={StaticResource BoolVis}}">
                    <Border CornerRadius="14,14,4,14" Padding="14,10" MaxWidth="520"
                            HorizontalAlignment="Right">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2a4a8a" Offset="0"/>
                                <GradientStop Color="#1e3570" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding Text}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="{Binding TimestampDisplay}"
                               FontSize="10" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Right" Margin="4,3,4,0"/>
                </StackPanel>

                <!-- Aria message (left-aligned) -->
                <StackPanel HorizontalAlignment="Left"
                            Visibility="{Binding IsUser, Converter={StaticResource InvBoolVis}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="18" Height="18" Margin="0,0,6,0">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F8EF7" Offset="0"/>
                                    <GradientStop Color="#7C5CFC" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="Aria" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="14,14,14,4" Padding="14,10" MaxWidth="620"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Text}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="{Binding TimestampDisplay}"
                               FontSize="10" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Left" Margin="4,3,4,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="140"/>  <!-- sidebar -->
            <ColumnDefinition Width="4"/>                   <!-- splitter -->
            <ColumnDefinition Width="*"/>                   <!-- chat area -->
        </Grid.ColumnDefinitions>

        <!-- ── Left: conversation history sidebar ── -->
        <Grid Grid.Column="0" Background="{StaticResource DeepBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- New conversation button -->
            <Button Grid.Row="0"
                    Style="{StaticResource RibbonButton}"
                    Command="{Binding NewConversationCommand}"
                    Margin="8,10,8,6" Padding="10,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" FontSize="14" Margin="0,0,6,0"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="New conversation" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Button>

            <!-- History list -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8,0">
                <ItemsControl x:Name="ConversationList"
                              ItemsSource="{Binding Conversations}"
                              ItemTemplate="{StaticResource ConversationItemTemplate}"/>
            </ScrollViewer>
        </Grid>

        <!-- ── Column splitter ── -->
        <GridSplitter Grid.Column="1"
                      Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      Cursor="SizeWE"/>

        <!-- ── Right: chat area ── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- messages -->
                <RowDefinition Height="Auto"/> <!-- empty hint -->
            </Grid.RowDefinitions>

            <!-- Message list -->
            <ScrollViewer Grid.Row="0"
                          x:Name="MessageScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,12">
                <ItemsControl x:Name="MessageList"
                              ItemTemplate="{StaticResource ChatMessageTemplate}"
                              ItemsSource="{Binding Messages}"/>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel Grid.Row="0"
                        x:Name="EmptyState"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        Opacity="0.35">
                <TextBlock Text="&#x1F4AC;" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Start a conversation" FontSize="15" FontWeight="Medium"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Use the input bar at the bottom, or press Enter"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
