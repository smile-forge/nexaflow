<UserControl x:Class="Nexaflow.Features.Executable.Views.ExecutableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Executable.ViewModels"
             xmlns:model="clr-namespace:Nexaflow.Features.Executable.Models"
             xmlns:ctl="clr-namespace:Nexaflow.Features.Executable.Controls"
             xmlns:vc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown;assembly=Nexaflow.Visuals.Text"
             xmlns:ae="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             AutomationProperties.AutomationId="ExecutableView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- WPF greys out a selection when the window loses focus, and its stock inactive colours
             are a light grey that swallows dark-theme text entirely. Override both so a highlighted
             thumbprint stays readable while the user alt-tabs away to paste it. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                         Color="{DynamicResource AccentColor}" Opacity="0.45"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                         Color="{DynamicResource TextColor}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                         Color="{DynamicResource AccentColor}" Opacity="0.55"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                         Color="{DynamicResource TextColor}"/>

        <!--
            A splitter you can see and grab. It sits in a fixed-width column and stretches to fill
            it: in an Auto column a centre-aligned splitter reports a zero-width slot, so WPF
            recomputes the star shares on the next measure and the drag springs back.
        -->
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment"   Value="Stretch"/>
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="ResizeDirection"     Value="Columns"/>
            <Setter Property="ResizeBehavior"      Value="PreviousAndNext"/>
            <Setter Property="Cursor"              Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Rectangle Width="1" HorizontalAlignment="Center"
                                       Fill="{StaticResource BorderBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A pane surface, so two lists side by side read as two panes rather than one wall. -->
        <Style x:Key="Pane" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="10,8"/>
        </Style>

        <!--
            The app-wide ScrollViewer style uses HorizontalScrollBarVisibility="Hidden", which still
            lets content scroll sideways — it only hides the bar. Focusing a value box then scrolled
            the page horizontally with nothing on screen to show it had happened, which is what hid
            the label column. Disabled (not Hidden) constrains content to the viewport width so
            there is no horizontal extent to scroll at all.
        -->
        <Style x:Key="PageScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>


        <!-- The context menu is not in the visual tree, so it cannot inherit the page DataContext.
             Every element that carries one therefore stashes the view-model in its Tag, and the menu
             reaches the commands through PlacementTarget.Tag. Without that the bindings silently
             resolve to nothing and the items do nothing at all. -->
        <Style x:Key="RowHost" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding"    Value="8,4"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin"     Value="0,1"/>
            <Setter Property="Tag"
                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="View in hex"
                      Command="{Binding PlacementTarget.Tag.ViewInHexCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Copy value"
                      Command="{Binding PlacementTarget.Tag.CopyValueCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <!-- A selectable value that also carries the page's own context menu. Without this the
             TextBox falls back to WPF's built-in editing menu — unthemed, and offering Cut and
             Paste on a read-only field. -->
        <Style x:Key="ValueBox" TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Courier New"/>
            <Setter Property="Tag"
                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
        </Style>

        <!-- Values render as a read-only TextBox rather than a TextBlock so a thumbprint, a hash or
             a PDB path can be selected and copied — the only reason to show them at all.
             The label column is sized by a shared-size group per card, so labels line up with each
             other without a fixed width that either truncates them or strands the values far right. -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type model:InspectorRow}">
            <Border Style="{StaticResource RowHost}" ContextMenu="{StaticResource RowMenu}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="RowLabel"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                               VerticalAlignment="Top" Margin="0,0,14,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}"
                             Style="{StaticResource ValueBox}"/>
                    <!-- Selectable too: the detail column carries offsets, certificate subjects and
                         chain status — exactly the text someone wants to copy. It wraps rather than
                         being trimmed, so a long signer DN stays readable. -->
                    <TextBox Grid.Column="2" Text="{Binding Detail, Mode=OneWay}" Margin="12,0,0,0"
                             Style="{StaticResource ValueBox}" FontSize="11" MaxWidth="380"
                             Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type model:InspectorCard}">
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12"
                    Grid.IsSharedSizeScope="True">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}"/>
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11" Margin="8,6,0,0"
                               Foreground="{StaticResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Rows must stretch, or a ListBox lays its items out at their natural width and the
             content ends up hard against the left edge with the scrollbar floating short. -->
        <Style x:Key="StretchRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"    Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!--
            Setting ScrollViewer.HorizontalScrollBarVisibility on an ItemsControl is not enough: the
            control passes it to its internal ScrollViewer with a TemplateBinding, and a style setter
            outranks a template binding — so the app-wide ScrollViewer style's "Hidden" wins and the
            content keeps unbounded width. A very long string then pushed the offset and encoding
            columns off the right with no bar to scroll back. Styling the inner ScrollViewer directly
            is what actually constrains the row.
        -->
        <Style x:Key="NoHorizontalScroll" TargetType="ScrollViewer"
               BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Strings get their own shape: the text is the point, so it takes the star column and
             wraps, while the offset and encoding stay fixed-width on the right. -->
        <DataTemplate x:Key="StringTemplate" DataType="{x:Type model:InspectorRow}">
            <Border Style="{StaticResource RowHost}" ContextMenu="{StaticResource RowMenu}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- NoWrap is deliberate. Wrapping a very long run across a narrow column makes
                         text layout build a huge visual per row, and re-arranging those during fast
                         scrolling was crashing the process inside TextBoxView. One clipped line
                         costs nothing and reads the same. -->
                    <TextBox Grid.Column="0" Text="{Binding Label, Mode=OneWay}"
                             Style="{StaticResource ValueBox}" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Hidden"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" Margin="12,0,0,0"
                               FontFamily="Consolas, Cascadia Mono, Courier New"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Margin="12,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <HierarchicalDataTemplate x:Key="NodeTemplate" DataType="{x:Type model:InspectorNode}"
                                  ItemsSource="{Binding Children}">
            <Border Padding="4,2" CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSearchHit}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextBrush}"
                               FontFamily="Consolas, Cascadia Mono, Courier New"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="10,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>

        <!-- Tree menus act on the clicked row, which the code-behind selects first. -->
        <ContextMenu x:Key="TreeMenu">
            <MenuItem Header="View in hex"
                      Command="{Binding PlacementTarget.Tag.ViewInHexCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Copy value"
                      Command="{Binding PlacementTarget.Tag.CopyValueCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <ContextMenu x:Key="ImportMenu">
            <MenuItem Header="Locate on disk"
                      Command="{Binding PlacementTarget.Tag.LocateModuleCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="View in hex"
                      Command="{Binding PlacementTarget.Tag.ViewInHexCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Copy value"
                      Command="{Binding PlacementTarget.Tag.CopyValueCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <ContextMenu x:Key="DependencyMenu">
            <MenuItem Header="Expand this module"
                      Command="{Binding PlacementTarget.Tag.ExpandModuleNodeCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Collapse this module"
                      Command="{Binding PlacementTarget.Tag.CollapseModuleNodeCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="Inspect in a new tab"
                      Command="{Binding PlacementTarget.Tag.OpenDependencyNodeCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="Locate on disk"
                      Command="{Binding PlacementTarget.Tag.LocateModuleCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>

        <ContextMenu x:Key="ResourceMenu">
            <MenuItem Header="Extract…"
                      Command="{Binding PlacementTarget.Tag.ExtractResourceCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <Separator/>
            <MenuItem Header="View in hex"
                      Command="{Binding PlacementTarget.Tag.ViewInHexCommand,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header banner ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Padding="16,12" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="{Binding IconImage}" Width="40" Height="40"
                       Margin="0,0,14,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality"/>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox Text="{Binding FilePath, Mode=OneWay}" Style="{StaticResource SelectableText}"
                             FontSize="11" Margin="0,2,0,0" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding LoadError}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoadError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Parsing…" FontSize="12" Margin="0,0,12,0"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    <vc:SearchStatusChip PagePrefix="Executable"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Sections ───────────────────────────────────────────────────────── -->
        <vc:VerticalTabControl Grid.Row="1" Margin="16,12,16,16" RailWidth="168"
                               SelectedValue="{Binding SelectedSection, Mode=TwoWay}">

            <!-- 1 · Overview -->
            <vc:VerticalTabItem Header="Overview" Tag="Overview">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel>
                        <!-- Until the parse lands the page has nothing but headings, which reads as
                             an empty inspector rather than a busy one. -->
                        <TextBlock Text="Scanning file, please wait…" FontSize="13" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding OverviewCards}"
                                      ItemTemplate="{StaticResource CardTemplate}"/>

                        <TextBlock Text="Sections" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,6"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Right-click a section to open it in the hex viewer."
                                   FontSize="11" Margin="0,0,0,6"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <!-- The tree's own scroll viewer is switched off. A nested scrollable control
                             swallows the wheel as soon as the pointer is over it, which is why the
                             page stopped scrolling part-way down; with no inner viewport the tree
                             grows to its full height and the page scrolls as one. -->
                        <TreeView x:Name="SectionTree" ItemsSource="{Binding SectionNodes}" Tag="{Binding}"
                                  AutomationProperties.AutomationId="Executable_SectionTree"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ItemContainerStyle="{StaticResource TreeItemStyle}"
                                  ItemTemplate="{StaticResource NodeTemplate}"
                                  ContextMenu="{StaticResource TreeMenu}"
                                  PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"/>

                        <TextBlock Text="Relocations" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,4"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding RelocationSummary}" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,0,0,6" Foreground="{StaticResource TextMutedBrush}"/>
                        <ItemsControl ItemsSource="{Binding RelocationRows}"
                                      ItemTemplate="{StaticResource RowTemplate}"
                                      Grid.IsSharedSizeScope="True"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </vc:VerticalTabItem>

            <!-- 2 · Imports / exports -->
            <vc:VerticalTabItem Header="Imports / Exports" Tag="ImportsExports">
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Pane}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Imports" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ImportSummary}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,6"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ComSummary}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Right-click a module to locate it on disk."/>
                            <TreeView ItemsSource="{Binding ImportNodes}" ScrollViewer.HorizontalScrollBarVisibility="Auto" Background="Transparent" Tag="{Binding}"
                                      AutomationProperties.AutomationId="Executable_ImportTree"
                                      BorderThickness="0" ItemContainerStyle="{StaticResource TreeItemStyle}"
                                      ItemTemplate="{StaticResource NodeTemplate}"
                                      ContextMenu="{StaticResource ImportMenu}"
                                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}"/>

                    <Border Grid.Column="2" Style="{StaticResource Pane}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Exports" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ExportSummary}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,6"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <ListBox x:Name="ExportList" ItemsSource="{Binding ExportRows}"
                                     Background="Transparent" BorderThickness="0"
                                     AutomationProperties.AutomationId="Executable_ExportList"
                                     ItemTemplate="{StaticResource RowTemplate}"
                                     ItemContainerStyle="{StaticResource StretchRow}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ListBox.Resources>
                                    <Style TargetType="ScrollViewer" BasedOn="{StaticResource NoHorizontalScroll}"/>
                                </ListBox.Resources>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </vc:VerticalTabItem>

            <!-- 3 · Dependencies -->
            <vc:VerticalTabItem Header="Dependencies" Tag="Dependencies">
                <DockPanel Margin="16,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <ToggleButton Content="Tree" Style="{StaticResource TbToggle}"
                                      AutomationProperties.AutomationId="Executable_DependencyTreeToggle"
                                      IsChecked="{Binding ShowDependencyTree, Mode=TwoWay}"
                                      ToolTip="Switch between the diagram and the tree"/>
                        <Button Content="Collapse all" Style="{StaticResource TbBtn}" Margin="8,0,0,0"
                                Command="{Binding CollapseDependenciesCommand}"/>
                        <TextBlock Text="Mapping…" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding DependenciesLoading, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding DependencySummary}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <!-- One or the other, each getting the whole width. Side by side, neither the
                         diagram nor the tree had room to be readable. -->
                    <Grid>
                        <!-- No ScrollViewer wrapper: the view is a RichTextBox that scrolls itself,
                             and nesting it gave the document infinite width to measure against, so
                             the diagram laid out to nothing. ScrollWideDiagrams is the supported way
                             to let an oversized diagram scroll inside it. -->
                        <Border Style="{StaticResource Pane}" Padding="4"
                                Visibility="{Binding ShowDependencyDiagram, Converter={StaticResource BoolToVis}}">
                            <md:SelectableMarkdownView x:Name="DependencyDiagram"
                                                       Markdown="{Binding DependencyMarkdown}"
                                                       ScrollWideDiagrams="True"/>
                        </Border>

                        <Border Style="{StaticResource Pane}"
                                Visibility="{Binding ShowDependencyTree, Converter={StaticResource BoolToVis}}">
                            <TreeView ItemsSource="{Binding DependencyNodes}" Tag="{Binding}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      AutomationProperties.AutomationId="Executable_DependencyTree"
                                      Background="Transparent" BorderThickness="0"
                                      ItemContainerStyle="{StaticResource TreeItemStyle}"
                                      ItemTemplate="{StaticResource NodeTemplate}"
                                      ContextMenu="{StaticResource DependencyMenu}"
                                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                                      MouseDoubleClick="DependencyTree_MouseDoubleClick"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </vc:VerticalTabItem>

            <!-- 4 · Resources -->
            <vc:VerticalTabItem Header="Resources" Tag="Resources">
                <DockPanel Margin="16,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ResourceSummary}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <Button Content="Extract all…" Style="{StaticResource TbBtn}" Margin="16,0,0,0"
                                Command="{Binding ExtractAllResourcesCommand}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Right-click an entry to extract it, or to open its bytes in the hex viewer."/>
                    <TreeView ItemsSource="{Binding ResourceNodes}" ScrollViewer.HorizontalScrollBarVisibility="Auto" Background="Transparent" Tag="{Binding}"
                              BorderThickness="0"
                              AutomationProperties.AutomationId="Executable_ResourceTree"
                              ItemContainerStyle="{StaticResource TreeItemStyle}"
                              ItemTemplate="{StaticResource NodeTemplate}"
                              ContextMenu="{StaticResource ResourceMenu}"
                              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"/>
                </DockPanel>
            </vc:VerticalTabItem>

            <!-- 5 · Manifest -->
            <vc:VerticalTabItem Header="Manifest" Tag="Manifest">
                <DockPanel Margin="16,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <ToggleButton Content="Show raw XML" Style="{StaticResource TbToggle}"
                                      AutomationProperties.AutomationId="Executable_RawManifest"
                                      IsChecked="{Binding ShowRawManifest, Mode=TwoWay}"/>
                    </StackPanel>

                    <Grid>
                        <TextBlock Text="This binary has no application manifest."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasManifest}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowRawManifest}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasManifest}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding ManifestCards}"
                                          ItemTemplate="{StaticResource CardTemplate}"/>
                        </ScrollViewer>

                        <!-- AvalonEdit brings its own light default palette, so the surface colours are
                             set from the theme here rather than left to the control. -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Background="{StaticResource Surface2Brush}"
                                Visibility="{Binding ShowRawManifest, Converter={StaticResource BoolToVis}}">
                            <ae:TextEditor x:Name="ManifestEditor" IsReadOnly="True" ShowLineNumbers="True"
                                           Padding="8,6" BorderThickness="0" Background="Transparent"
                                           Foreground="{StaticResource TextBrush}"
                                           LineNumbersForeground="{StaticResource TextMutedBrush}"
                                           FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12"
                                           AutomationProperties.AutomationId="Executable_ManifestXml"/>
                        </Border>
                    </Grid>
                </DockPanel>
            </vc:VerticalTabItem>

            <!-- 6 · .NET — present only for a managed image; a native binary has nothing to show. -->
            <vc:VerticalTabItem Header=".NET" Tag="Dotnet"
                                Visibility="{Binding IsManaged, Converter={StaticResource BoolToVis}}">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <ItemsControl ItemsSource="{Binding DotnetCards}"
                                  ItemTemplate="{StaticResource CardTemplate}"/>
                </ScrollViewer>
            </vc:VerticalTabItem>

            <!-- 7 · Strings -->
            <vc:VerticalTabItem Header="Strings" Tag="Strings">
                <DockPanel Margin="16,14">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Minimum length" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding MinimumStringLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" Width="52"
                                 AutomationProperties.AutomationId="Executable_StringLength"/>
                        <Button Content="Rescan" Style="{StaticResource TbBtn}" Margin="8,0,0,0"
                                Command="{Binding RefreshStringsCommand}"/>
                        <TextBlock Text="Scanning…" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding StringsLoading, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StringSummary}" VerticalAlignment="Center" Margin="16,0,0,0"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Search with ? to narrow the list. Right-click a row to copy it or open it in the hex viewer."/>
                    <ListBox x:Name="StringList" ItemsSource="{Binding StringView}"
                             Background="Transparent" BorderThickness="0"
                             AutomationProperties.AutomationId="Executable_StringList"
                             ItemTemplate="{StaticResource StringTemplate}"
                             ItemContainerStyle="{StaticResource StretchRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Standard">
                        <ListBox.Resources>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource NoHorizontalScroll}"/>
                        </ListBox.Resources>
                    </ListBox>
                </DockPanel>
            </vc:VerticalTabItem>

            <!-- 8 · Analysis -->
            <vc:VerticalTabItem Header="Analysis" Tag="Analysis">
                <ScrollViewer Style="{StaticResource PageScroll}">
                    <StackPanel>
                        <TextBlock Text="Entropy across the file" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="{Binding EntropySummary}" FontSize="11" Margin="0,2,0,2"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="Click anywhere on the strip to open those bytes in the hex viewer."
                                   FontSize="11" Margin="0,0,0,6"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                            <ctl:EntropyHeatmap Height="90" Buckets="{Binding EntropyBuckets}"
                                                AutomationProperties.AutomationId="Executable_EntropyHeatmap"
                                                BucketCommand="{Binding ViewEntropyBucketInHexCommand}"
                                                LowBrush="{DynamicResource Executable.Entropy.Low}"
                                                MidBrush="{DynamicResource Executable.Entropy.Mid}"
                                                HighBrush="{DynamicResource Executable.Entropy.High}"
                                                ThresholdBrush="{DynamicResource Executable.Entropy.Threshold}"/>
                        </Border>

                        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Antivirus" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding AntivirusProduct}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Scan this file" Style="{StaticResource TbBtn}"
                                            AutomationProperties.AutomationId="Executable_ScanButton"
                                            Command="{Binding ScanWithAntivirusCommand}"/>
                                    <TextBlock Text="{Binding ScanResult}" VerticalAlignment="Center"
                                               Margin="12,0,0,0" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Verifying signature…" FontSize="12" Margin="0,0,0,8"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding SignatureLoading, Converter={StaticResource BoolToVis}}"/>

                        <ItemsControl ItemsSource="{Binding AnalysisCards}"
                                      ItemTemplate="{StaticResource CardTemplate}"/>

                        <TextBlock Text="Parse diagnostics" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,6"
                                   Foreground="{StaticResource TextBrush}"
                                   Visibility="{Binding HasDiagnostics, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Diagnostics}"
                                      ItemTemplate="{StaticResource RowTemplate}"/>
                    </StackPanel>
                </ScrollViewer>
            </vc:VerticalTabItem>
        </vc:VerticalTabControl>
    </Grid>
</UserControl>
