<UserControl x:Class="Nexaflow.Features.Compressed.Views.CompressedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="CompressedView"
             AllowDrop="True"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ── Left: metadata pane ─────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextBrush}"
                               FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Format}" Foreground="{StaticResource AccentBrush}"
                               FontSize="12" Margin="0,2,0,14"/>

                    <TextBlock Text="ENTRIES"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                    <TextBlock Text="{Binding EntryCountText}" Foreground="{StaticResource TextBrush}" FontSize="13"/>

                    <TextBlock Text="UNCOMPRESSED" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                    <TextBlock Text="{Binding TotalSizeText}" Foreground="{StaticResource TextBrush}" FontSize="13"/>

                    <TextBlock Text="COMPRESSED" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                    <TextBlock Text="{Binding CompressedSizeText}" Foreground="{StaticResource TextBrush}" FontSize="13"/>

                    <TextBlock Text="SAVED" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                    <TextBlock Text="{Binding RatioText}" Foreground="{StaticResource TextBrush}" FontSize="13"/>

                    <TextBlock Text="ENCRYPTION" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                    <TextBlock Text="{Binding EncryptionText}" Foreground="{StaticResource TextBrush}" FontSize="13"/>

                    <TextBlock Text="SIGNATURE" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                    <TextBlock Text="{Binding SignatureText}" Foreground="{StaticResource TextBrush}" FontSize="13"/>

                    <StackPanel Visibility="{Binding HasComment, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="COMMENT" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                        <TextBlock Text="{Binding Comment}" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── Center: entry tree-list ─────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Column header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="Size" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="Packed" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Grid.Column="3" Text="Ratio" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <TextBlock Grid.Column="4" Text="Modified" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                </Grid>
            </Border>

            <ListBox x:Name="EntryList" Grid.Row="1"
                     ItemsSource="{Binding VisibleRows}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="EntryList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,3"/>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource DeepBgBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" SharedSizeGroup="NameCol"/>
                                <ColumnDefinition Width="90" SharedSizeGroup="SizeCol"/>
                                <ColumnDefinition Width="90" SharedSizeGroup="CompCol"/>
                                <ColumnDefinition Width="58" SharedSizeGroup="RatioCol"/>
                                <ColumnDefinition Width="140" SharedSizeGroup="DateCol"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="{Binding Indent}">
                                <TextBlock Text="{Binding Chevron}" Width="14" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" Opacity="0.85"/>
                            <TextBlock Grid.Column="2" Text="{Binding CompressedText}" FontSize="12" Opacity="0.85"/>
                            <TextBlock Grid.Column="3" Text="{Binding RatioText}" FontSize="12" Opacity="0.85"/>
                            <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" FontSize="12" Opacity="0.7"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- ── Right: action bar ───────────────────────────────────────── -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <StackPanel Width="150" Margin="10,12">
                <Button Style="{StaticResource TbBtn}" Content="Extract…" Margin="0,0,0,6"
                        HorizontalContentAlignment="Left" Command="{Binding ExtractCommand}"/>
                <Button Style="{StaticResource TbBtn}" Content="Add file…" Margin="0,0,0,6"
                        HorizontalContentAlignment="Left" Command="{Binding AddFileCommand}"/>
                <Button Style="{StaticResource TbBtn}" Content="Test archive" Margin="0,0,0,6"
                        HorizontalContentAlignment="Left" Command="{Binding TestCommand}"/>

                <Separator Margin="0,8" Background="{StaticResource BorderBrush}"/>

                <Button Style="{StaticResource TbBtn}" Content="Encrypt…" Margin="0,0,0,6"
                        HorizontalContentAlignment="Left" IsEnabled="False" ToolTip="Available once the SecureZip provider lands"/>
                <Button Style="{StaticResource TbBtn}" Content="Decrypt…" Margin="0,0,0,6"
                        HorizontalContentAlignment="Left" IsEnabled="False"/>
                <Button Style="{StaticResource TbBtn}" Content="Sign" Margin="0,0,0,6"
                        HorizontalContentAlignment="Left" IsEnabled="False"/>
                <Button Style="{StaticResource TbBtn}" Content="Verify signature" Margin="0,0,0,6"
                        HorizontalContentAlignment="Left" IsEnabled="False"/>
                <Button Style="{StaticResource TbBtn}" Content="Recompress…" Margin="0,0,0,6"
                        HorizontalContentAlignment="Left" IsEnabled="False"/>
                <Button Style="{StaticResource TbBtn}" Content="Convert…" Margin="0,0,0,6"
                        HorizontalContentAlignment="Left" IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
