<UserControl x:Class="Nexaflow.Features.Compressed.Views.CompressedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="CompressedView"
             AllowDrop="True"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <!-- Action-strip button: icon over a small label, matching the file browser's strip. -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="2">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="17"
                                           Foreground="{StaticResource TextBrush}"
                                           FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="48" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Entry row: transparent → hover SurfaceBrush → selected Surface2Brush + accent border (readable). -->
        <Style x:Key="EntryRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ── Main 3-column layout ───────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: metadata pane ─────────────────────────────────── -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextBrush}"
                                   FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Format}" Foreground="{StaticResource AccentBrush}"
                                   FontSize="12" Margin="0,2,0,14"/>

                        <TextBlock Text="ENTRIES" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                        <TextBlock Text="{Binding EntryCountText}" Foreground="{StaticResource TextBrush}" FontSize="13"/>

                        <TextBlock Text="UNCOMPRESSED" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                        <TextBlock Text="{Binding TotalSizeText}" Foreground="{StaticResource TextBrush}" FontSize="13"/>

                        <TextBlock Text="COMPRESSED" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                        <TextBlock Text="{Binding CompressedSizeText}" Foreground="{StaticResource TextBrush}" FontSize="13"/>

                        <TextBlock Text="SAVED" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                        <TextBlock Text="{Binding RatioText}" Foreground="{StaticResource TextBrush}" FontSize="13"/>

                        <TextBlock Text="ENCRYPTION" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                        <TextBlock Text="{Binding EncryptionText}" Foreground="{StaticResource TextBrush}" FontSize="13"/>

                        <TextBlock Text="SIGNATURE" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                        <TextBlock Text="{Binding SignatureText}" Foreground="{StaticResource TextBrush}" FontSize="13" TextWrapping="Wrap"/>

                        <StackPanel Visibility="{Binding HasComment, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="COMMENT" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,1"/>
                            <TextBlock Text="{Binding Comment}" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── Center: entry tree-list ─────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Column header -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="9,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Size" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Packed" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Ratio" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Modified" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                    </Grid>
                </Border>

                <ListBox x:Name="EntryList" Grid.Row="1"
                         ItemsSource="{Binding VisibleRows}"
                         ItemContainerStyle="{StaticResource EntryRow}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="EntryList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="{Binding Indent}">
                                    <!-- Chevron: single-click toggles the folder (like the file-browser tree). -->
                                    <Button Width="16" Command="{Binding DataContext.ActivateRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Focusable="False"
                                            Visibility="{Binding HasChildren, Converter={StaticResource BoolVis}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <TextBlock Text="{Binding Chevron}" FontSize="11"
                                                               Foreground="{StaticResource TextDimBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Placeholder so file rows align under folder rows -->
                                    <Border Width="16">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Margin="2,0,5,0" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="📄"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="Text" Value="📁"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" FontSize="13"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CompressedText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding RatioText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Status bar -->
                <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>

            <!-- ── Right: action bar (2-column icon buttons) ─────────────── -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Width="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <UniformGrid Columns="2" Margin="4,6" VerticalAlignment="Top">
                        <Button Style="{StaticResource ActionBtn}" Tag="&#xE896;" Content="Extract"   Command="{Binding ExtractCommand}"/>
                        <Button Style="{StaticResource ActionBtn}" Tag="&#xE710;" Content="Add file"  Command="{Binding AddFileCommand}"/>
                        <Button Style="{StaticResource ActionBtn}" Tag="&#xE721;" Content="Test"      Command="{Binding TestCommand}"/>
                        <Button Style="{StaticResource ActionBtn}" Tag="&#xE72E;" Content="Encrypt"   Command="{Binding EncryptCommand}"/>
                        <Button Style="{StaticResource ActionBtn}" Tag="&#xE785;" Content="Decrypt"   Command="{Binding DecryptCommand}"/>
                        <Button Style="{StaticResource ActionBtn}" Tag="&#xE70F;" Content="Sign"      Command="{Binding SignCommand}"/>
                        <Button Style="{StaticResource ActionBtn}" Tag="&#xE73E;" Content="Sig Check" Command="{Binding VerifyCommand}"/>
                        <Button Style="{StaticResource ActionBtn}" Tag="&#xE72C;" Content="Recompress" Command="{Binding RecompressCommand}"/>
                        <Button Style="{StaticResource ActionBtn}" Tag="&#xE895;" Content="Convert"    Command="{Binding ConvertCommand}"/>
                    </UniformGrid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── Choice overlay (Recompress level / Convert format) ──────── -->
        <Border Visibility="{Binding ChoiceVisible, Converter={StaticResource BoolVis}}"
                Background="#CC000000" Panel.ZIndex="20">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1" CornerRadius="8" Width="300" Padding="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ChoiceTitle}" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding ChoiceOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}"
                                        Command="{Binding DataContext.PickChoiceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Left" Cursor="Hand" Margin="0,0,0,6"
                                        Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,7"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Cancel" Command="{Binding CancelChoiceCommand}" Cursor="Hand"
                            HorizontalAlignment="Right" Margin="0,6,0,0"
                            Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                            BorderThickness="0" Padding="8,4"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ── Password overlay (Encrypt / Decrypt) ────────────────────── -->
        <Border Visibility="{Binding PasswordVisible, Converter={StaticResource BoolVis}}"
                Background="#CC000000" Panel.ZIndex="21">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1" CornerRadius="8" Width="320" Padding="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding PasswordTitle}" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,12">
                        <PasswordBox x:Name="PasswordEntry"
                                     Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}"
                                     CaretBrush="{StaticResource TextBrush}" BorderThickness="0" FontSize="12" Padding="8,6"
                                     KeyDown="PasswordEntry_KeyDown"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelPasswordCommand}" Cursor="Hand"
                                Background="Transparent" Foreground="{StaticResource TextMutedBrush}"
                                BorderThickness="0" Padding="10,6" Margin="0,0,8,0"/>
                        <Button Content="OK" Click="PasswordOk_Click" Cursor="Hand"
                                Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                                BorderThickness="0" Padding="18,6" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
