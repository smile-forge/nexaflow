<UserControl x:Class="Nexaflow.Features.Code.Views.CodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown;assembly=Nexaflow.Visuals.Text"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="CodeView"
             Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="PanelColumn" Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Editor (a CodeEditorView is inserted here in code-behind) -->
        <ContentControl Grid.Column="0" x:Name="EditorHost"/>

        <!-- Splitter between editor and intelligence panel -->
        <GridSplitter Grid.Column="1" x:Name="Splitter"
                      Width="5" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"/>

        <!-- Code-intelligence panel -->
        <Border Grid.Column="2" x:Name="PanelHost"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="10,0,6,0">
                    <TextBlock Text="{loc:Str Code.Map.Title}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource TbBtn}"
                            AutomationProperties.AutomationId="Code_MapToggle"
                            Command="{Binding TogglePanelCommand}"
                            ToolTip="{loc:Str Code.Map.HideTip}">
                        <TextBlock Text="⟩" FontSize="12"/>
                    </Button>
                </Grid>

                <md:MarkdownSurface x:Name="Md" Grid.Row="1"
                                           AutomationProperties.AutomationId="Code_Map"
                                           Margin="10,0,10,10"
                                           VerticalScrollBarVisibility="Auto"
                                           Markdown="{Binding IntelligenceMarkdown}"/>
            </Grid>
        </Border>

        <!-- Collapsed-panel reopen tab (shown only when there is something to show but the panel is hidden) -->
        <Button x:Name="ReopenButton" Grid.Column="2"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"
                Style="{StaticResource TbBtn}"
                AutomationProperties.AutomationId="Code_MapReopen"
                Command="{Binding TogglePanelCommand}"
                ToolTip="{loc:Str Code.Map.ShowTip}"
                Visibility="Collapsed">
            <TextBlock Text="⟨" FontSize="12"/>
        </Button>
    </Grid>
</UserControl>
