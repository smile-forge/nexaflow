<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:a="clr-namespace:Nexaflow.Features.UsbProbe.AudioTools"
                    xmlns:conv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
                    xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">

    <!-- How the device page draws the audio tools: an output tester per playback endpoint, a meter per recording one. -->

    <!-- What the tile says can be selected and copied. -->
    <Style x:Key="AudioTools.Text" TargetType="TextBox" BasedOn="{StaticResource SelectableText}" />
    <Style x:Key="AudioTools.Muted" TargetType="TextBox" BasedOn="{StaticResource SelectableText}">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    </Style>

    <BooleanToVisibilityConverter x:Key="AudioTools.BoolToVis" />
    <conv:NullToVisibilityConverter x:Key="AudioTools.NullToVis" />

    <!-- A thin accent slider (no app-wide one exists). -->
    <Style x:Key="AudioTools.Rail" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AudioTools.RailFilled" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{StaticResource AccentBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AudioTools.Slider" TargetType="Slider">
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{StaticResource Surface2Brush}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource AudioTools.RailFilled}" Command="Slider.DecreaseLarge" /></Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource AccentBrush}" Stroke="{StaticResource BgBrush}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource AudioTools.Rail}" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AudioTools.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <DataTemplate DataType="{x:Type a:AudioOutputTool}">
        <StackPanel>
            <TextBox Style="{StaticResource AudioTools.Muted}" TextWrapping="NoWrap" Margin="0,0,0,6">
                <TextBox.Text>
                    <MultiBinding StringFormat="{}{0} · {1}" Mode="OneWay">
                        <Binding Path="EndpointName" />
                        <Binding Path="Format" />
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Str AudioTools.Label.Signal}" Style="{StaticResource AudioTools.Label}" />
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource DarkComboBox}" Margin="0,2"
                          AutomationProperties.AutomationId="UsbAudio_Signal"
                          ItemsSource="{Binding Signals}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Signal, Mode=TwoWay}" />

                <TextBlock Grid.Row="1" Text="{loc:Str AudioTools.Label.Frequency}" Style="{StaticResource AudioTools.Label}" />
                <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource AudioTools.Slider}" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                        AutomationProperties.AutomationId="UsbAudio_Frequency" Value="{Binding FrequencyPosition, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FrequencyText}" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center" />

                <TextBlock Grid.Row="2" Text="{loc:Str AudioTools.Label.Level}" Style="{StaticResource AudioTools.Label}" />
                <Slider Grid.Row="2" Grid.Column="1" Style="{StaticResource AudioTools.Slider}" Minimum="-60" Maximum="0" SmallChange="1" LargeChange="6"
                        AutomationProperties.AutomationId="UsbAudio_Level" Value="{Binding Level, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LevelText}" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center" />

                <TextBlock Grid.Row="3" Text="{loc:Str AudioTools.Label.Channel}" Style="{StaticResource AudioTools.Label}" />
                <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource DarkComboBox}" Margin="0,2"
                          AutomationProperties.AutomationId="UsbAudio_Channel"
                          ItemsSource="{Binding Channels}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Channel, Mode=TwoWay}" />

                <TextBlock Grid.Row="4" Text="{loc:Str AudioTools.Label.File}" Style="{StaticResource AudioTools.Label}"
                           Visibility="{Binding IsFile, Converter={StaticResource AudioTools.BoolToVis}}" />
                <DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2" Visibility="{Binding IsFile, Converter={StaticResource AudioTools.BoolToVis}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbAudio_PickFile" Command="{Binding PickFileCommand}">
                        <TextBlock Text="{loc:Str AudioTools.Button.PickFile}" />
                    </Button>
                    <TextBox Style="{StaticResource AudioTools.Text}" Text="{Binding File, Mode=OneWay}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                </DockPanel>
            </Grid>

            <WrapPanel Margin="0,8,0,0">
                <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbAudio_Play" Command="{Binding PlayCommand}">
                    <TextBlock Text="{loc:Str AudioTools.Button.Play}" />
                </Button>
                <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbAudio_Stop" Command="{Binding StopCommand}">
                    <TextBlock Text="{loc:Str AudioTools.Button.Stop}" />
                </Button>
                <Separator Style="{StaticResource TbSep}" />
                <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbAudio_Identify" Command="{Binding IdentifyChannelsCommand}"
                        ToolTip="{loc:Str AudioTools.Button.IdentifyTip}">
                    <TextBlock Text="{loc:Str AudioTools.Button.Identify}" />
                </Button>
            </WrapPanel>

            <TextBox Style="{StaticResource AudioTools.Text}" Text="{Binding Sounding, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"
                     Visibility="{Binding Sounding, Converter={StaticResource AudioTools.NullToVis}}" />
            <TextBox Style="{StaticResource AudioTools.Muted}" Text="{Binding Status, Mode=OneWay}" Margin="0,4,0,0" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type a:AudioInputTool}">
        <StackPanel>
            <TextBox Style="{StaticResource AudioTools.Muted}" TextWrapping="NoWrap" Margin="0,0,0,6">
                <TextBox.Text>
                    <MultiBinding StringFormat="{}{0} · {1}" Mode="OneWay">
                        <Binding Path="EndpointName" />
                        <Binding Path="Format" />
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>

            <ItemsControl ItemsSource="{Binding Meters}" AutomationProperties.AutomationId="UsbAudio_Meters">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type a:AudioMeterRow}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                                <ProgressBar Style="{StaticResource NexaProgressBar}" Minimum="0" Maximum="1" Value="{Binding PeakFill, Mode=OneWay}" Opacity="0.45" />
                                <ProgressBar Style="{StaticResource NexaProgressBar}" Minimum="0" Maximum="1" Value="{Binding RmsFill, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{StaticResource TextBrush}" FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel Margin="0,8,0,0">
                <ComboBox Style="{StaticResource DarkComboBox}" Width="90" Margin="0,0,6,0" AutomationProperties.AutomationId="UsbAudio_Duration"
                          ItemsSource="{Binding Durations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Seconds, Mode=TwoWay}" />
                <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbAudio_Record" Command="{Binding RecordCommand}">
                    <TextBlock Text="{loc:Str AudioTools.Button.Record}" />
                </Button>
                <Button Style="{StaticResource TbBtn}" AutomationProperties.AutomationId="UsbAudio_StopRecording" Command="{Binding StopRecordingCommand}"
                        Visibility="{Binding IsRecording, Converter={StaticResource AudioTools.BoolToVis}}">
                    <TextBlock Text="{loc:Str AudioTools.Button.StopRecording}" />
                </Button>
            </WrapPanel>

            <TextBox Style="{StaticResource AudioTools.Muted}" Text="{Binding Status, Mode=OneWay}" Margin="0,4,0,0" />
            <TextBox Style="{StaticResource AudioTools.Text}" Text="{Binding LastRecording, Mode=OneWay}" Margin="0,2,0,0"
                     Visibility="{Binding LastRecording, Converter={StaticResource AudioTools.NullToVis}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
