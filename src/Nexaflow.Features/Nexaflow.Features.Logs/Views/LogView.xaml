<UserControl x:Class="Nexaflow.Features.Logs.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:vc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="LogView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <!-- ── Compact toolbar TextBox ── -->
        <Style x:Key="TbInput" TargetType="TextBox">
            <Setter Property="Background"        Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"        Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth"          Value="120"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="CaretBrush"        Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- editor + side panel -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ══ Row 0 — Toolbar ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel Orientation="Horizontal" Margin="4,3">

                    <!-- Level highlight toggles (each has a coloured dot indicator) -->
                    <ToggleButton Style="{StaticResource TbToggle}"
                                  AutomationProperties.AutomationId="Log_HighlightFatal"
                                  IsChecked="{Binding HighlightFatal}"
                                  ToolTip="Highlight FATAL lines">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Log.Fatal.Pip}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="FATAL"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource TbToggle}"
                                  AutomationProperties.AutomationId="Log_HighlightError"
                                  IsChecked="{Binding HighlightError}"
                                  ToolTip="Highlight ERROR lines">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Log.Error.Pip}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ERROR"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource TbToggle}"
                                  AutomationProperties.AutomationId="Log_HighlightWarning"
                                  IsChecked="{Binding HighlightWarning}"
                                  ToolTip="Highlight WARN lines">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Log.Warning.Pip}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="WARN"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource TbToggle}"
                                  AutomationProperties.AutomationId="Log_HighlightInfo"
                                  IsChecked="{Binding HighlightInfo}"
                                  ToolTip="Highlight INFO lines">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Log.Info.Pip}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="INFO"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource TbToggle}"
                                  AutomationProperties.AutomationId="Log_HighlightDebug"
                                  IsChecked="{Binding HighlightDebug}"
                                  ToolTip="Highlight DEBUG/TRACE lines">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Log.Debug.Pip}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="DEBUG"/>
                        </StackPanel>
                    </ToggleButton>

                    <Separator Style="{StaticResource TbSep}"/>

                    <!-- Custom highlight term -->
                    <TextBox x:Name="HighlightTermBox"
                             AutomationProperties.AutomationId="Log_HighlightTerm"
                             Text="{Binding CustomHighlightTerm, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="100"
                             ToolTip="Highlight all occurrences of this term">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TbInput}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush AlignmentX="Left" Stretch="None">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Highlight…"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Margin="6,4"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Separator Style="{StaticResource TbSep}"/>

                    <!-- Monitoring controls -->
                    <ToggleButton Style="{StaticResource TbToggle}"
                                  AutomationProperties.AutomationId="Log_Pause"
                                  IsChecked="{Binding IsPaused}"
                                  ToolTip="Pause / resume auto-update from file">
                        <TextBlock Text="⏸ Pause"/>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource TbToggle}"
                                  AutomationProperties.AutomationId="Log_Follow"
                                  IsChecked="{Binding IsAutoScrolling}"
                                  ToolTip="Auto-scroll to bottom on new content">
                        <TextBlock Text="↓ Follow"/>
                    </ToggleButton>

                    <Separator Style="{StaticResource TbSep}"/>

                    <!-- Line selection actions -->
                    <Button Style="{StaticResource TbBtn}"
                            AutomationProperties.AutomationId="Log_CopySelected"
                            Command="{Binding CopySelectedLinesCommand}"
                            ToolTip="Copy selected lines to clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 Copy "/>
                            <TextBlock Text="{Binding SelectedLineCount}"/>
                            <TextBlock Text=" line(s)"/>
                        </StackPanel>
                    </Button>

                    <Separator Style="{StaticResource TbSep}"/>

                    <!-- Encoding selector -->
                    <ComboBox AutomationProperties.AutomationId="Log_Encoding"
                              ItemsSource="{Binding AvailableEncodings}"
                              SelectedItem="{Binding SelectedEncoding}"
                              VerticalAlignment="Center"
                              Padding="6,4"
                              MinWidth="80"
                              FontSize="12"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ Row 1 — Editor + side panel ══════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- AvalonEdit -->
            <avalon:TextEditor x:Name="Editor"
                               Grid.Column="0"
                               IsReadOnly="True"
                               FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                               FontSize="13"
                               Background="{StaticResource BgBrush}"
                               Foreground="{StaticResource TextBrush}"
                               ScrollViewer.HorizontalScrollBarVisibility="Auto"
                               ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <!-- Filter side panel (always visible) -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Width="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,12">

                        <!-- ── Regex filter ── -->
                        <TextBlock Text="Filter"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="Pattern (regex)"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     AutomationProperties.AutomationId="Log_FilterRegex"
                                     Text="{Binding FilterRegex, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Fade lines not matching this regex">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource TbInput}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush AlignmentX="Left" Stretch="None">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="regex…"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="6,4"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Style="{StaticResource TbBtn}"
                                    Content="✕"
                                    Command="{Binding ClearFilterCommand}"
                                    Visibility="{Binding IsFilterActive, Converter={StaticResource BoolVis}}"
                                    Padding="6,4"
                                    ToolTip="Clear filter"/>
                        </Grid>

                        <!-- ── Time range filter (shown only when timestamps detected) ── -->
                        <StackPanel Visibility="{Binding HasTimestamps, Converter={StaticResource BoolVis}}">

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,8,0,8"/>

                            <TextBlock Text="Time Range"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,0,0,6"/>

                            <TextBlock Text="From"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding FilterStartDate}"
                                        Margin="0,0,0,4"
                                        FontSize="12"/>
                            <TextBox Text="{Binding FilterStartTime, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="0"
                                     Margin="0,0,0,10"
                                     ToolTip="Time (HH:mm:ss)">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource TbInput}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush AlignmentX="Left" Stretch="None">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="HH:mm:ss"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="6,4"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <TextBlock Text="To"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding FilterEndDate}"
                                        Margin="0,0,0,4"
                                        FontSize="12"/>
                            <TextBox Text="{Binding FilterEndTime, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="0"
                                     Margin="0,0,0,12"
                                     ToolTip="Time (HH:mm:ss)">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource TbInput}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush AlignmentX="Left" Stretch="None">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="HH:mm:ss"
                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                           Margin="6,4"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <Button Style="{StaticResource TbBtn}"
                                    Command="{Binding ApplyTimeFilterCommand}"
                                    Content="Apply"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,4"/>

                            <Button Style="{StaticResource TbBtn}"
                                    Command="{Binding ClearTimeFilterCommand}"
                                    Content="Clear"
                                    HorizontalAlignment="Stretch"/>

                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══ Row 2 — Status bar ════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="8,3">

                <!-- Loading indicator -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsLoadingHead, Converter={StaticResource BoolVis}}"
                            Margin="0,0,12,0">
                    <TextBlock Text="⟳ Loading history…"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"/>
                </StackPanel>

                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                    <Run Text="{Binding LineCount, Mode=OneWay}"/>
                    <Run Text=" lines"/>
                </TextBlock>

                <Separator Style="{StaticResource TbSep}"/>

                <TextBlock Text="{Binding FileSizeText}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <Separator Style="{StaticResource TbSep}"/>

                <TextBlock Text="{Binding ActiveParser.FormatName}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>

                <Separator Style="{StaticResource TbSep}"
                           Visibility="{Binding IsFilterActive, Converter={StaticResource BoolVis}}"/>

                <TextBlock Foreground="{StaticResource WarningBrush}"
                           FontSize="11"
                           Visibility="{Binding IsFilterActive, Converter={StaticResource BoolVis}}">
                    <Run Text="Filter: "/><Run Text="{Binding FilterRegex, Mode=OneWay}"/>
                </TextBlock>

                <!-- What a "?" search found. Sits beside the filter indicator because both answer
                     "why does the log look like this" — but they are independent layers. -->
                <Separator Style="{StaticResource TbSep}"
                           Visibility="{Binding IsSearchActive, Converter={StaticResource BoolVis}}"/>
                <vc:SearchStatusChip PagePrefix="Log" VerticalAlignment="Center"/>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
