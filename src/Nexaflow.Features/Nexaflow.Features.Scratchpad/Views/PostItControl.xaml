<UserControl x:Class="Nexaflow.Features.Scratchpad.Views.PostItControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexaflow.Features.Scratchpad.Converters"
             xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown;assembly=Nexaflow.Visuals.Text"
             Width="{Binding Width}" Height="{Binding Height}"
             RenderTransformOrigin="0.5,0.5"
             UseLayoutRounding="True">

    <UserControl.RenderTransform>
        <RotateTransform Angle="{Binding Rotation}"/>
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <conv:PostItColorToBrushConverter       x:Key="ColorBrush"/>
        <conv:PostItColorToHeaderBrushConverter x:Key="HeaderBrush"/>
        <conv:PostItColorToTailBrushConverter   x:Key="TailBrush"/>
        <conv:ShapeToClipConverter              x:Key="ShapeClip"/>
    </UserControl.Resources>

    <!-- Outer wrapper carries the shadow so it spans body + speech-bubble tail as one shape. -->
    <Grid x:Name="OuterGrid">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="315"
                              Color="#40000000" Opacity="0.55"/>
        </Grid.Effect>

        <!-- Speech-bubble tail: a protrusion bolted onto the body's bottom edge, drawn
             behind the body. Geometry + visibility set in code-behind. Hosting it in a
             Canvas lets it render below the note bounds without affecting layout, so the
             body stays a plain rounded rectangle with full resize + text area. -->
        <Canvas IsHitTestVisible="False">
            <Path x:Name="TailPath"
                  Fill="{Binding Color, Converter={StaticResource TailBrush}}"
                  Visibility="Collapsed"/>
        </Canvas>

        <Grid x:Name="RootGrid">

        <!-- Background fill (shape clip applied in code-behind) -->
        <Rectangle x:Name="BgRect"
                   Fill="{Binding Color, Converter={StaticResource ColorBrush}}"/>

        <!-- Content layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
            </Grid.RowDefinitions>

            <!-- Header / drag handle — right-click here opens the mini ribbon -->
            <Border x:Name="Header" Grid.Row="0"
                    Background="{Binding Color, Converter={StaticResource HeaderBrush}}"
                    Cursor="SizeAll"
                    MouseDown="Header_MouseDown"
                    MouseMove="Header_MouseMove"
                    MouseUp="Header_MouseUp"
                    MouseRightButtonUp="Header_RightClick">
                <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Rotation handle -->
                    <Border Grid.Column="0"
                            Width="14" Height="14"
                            CornerRadius="7"
                            Background="#30000000"
                            Cursor="Hand"
                            ToolTip="Drag to rotate"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            MouseDown="RotateHandle_MouseDown"
                            MouseMove="RotateHandle_MouseMove"
                            MouseUp="RotateHandle_MouseUp">
                        <TextBlock Text="↻" FontSize="9" Foreground="#80000000"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Drag area -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- Timer badge — MouseLeftButtonDown stops event bubbling to header drag -->
                    <Border x:Name="TimerBadge"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Margin="0,0,4,0"
                            Padding="3,1"
                            CornerRadius="3"
                            ToolTip="Click to pin/unpin"
                            MouseLeftButtonDown="TimerBadge_MouseDown"
                            MouseLeftButtonUp="TimerBadge_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#20000000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding TimeRemainingText}"
                                   FontSize="10"
                                   Foreground="#99000000"/>
                    </Border>

                    <!-- Close button -->
                    <Button Grid.Column="3"
                            Command="{Binding RemoveCommand}"
                            Width="18" Height="18"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip="Remove note">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Foreground" Value="#80000000"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="3" Padding="0">
                                                <TextBlock Text="✕" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontSize="{TemplateBinding FontSize}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#40000000"/>
                                                    <Setter Property="Foreground" Value="#CC000000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Inline markdown editor: one surface; caret's block shows as source,
                 the rest render. Native caret/selection/copy span the whole note. -->
            <md:InlineMarkdownEditor x:Name="Editor" Grid.Row="1"
                                     Margin="8,6"
                                     Palette="{x:Static md:MarkdownPalette.Light}"
                                     Placeholder="Type to add a note…"
                                     BaseDirectory="{Binding AttachmentDirectory}"
                                     Markdown="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Bottom grip -->
            <Border Grid.Row="2"
                    Background="Transparent"
                    Cursor="SizeAll"
                    MouseDown="Header_MouseDown"
                    MouseMove="Header_MouseMove"
                    MouseUp="Header_MouseUp"/>
        </Grid>

        <!-- ── Resize handles ── -->
        <Rectangle Height="6" VerticalAlignment="Top"    Cursor="SizeNS"   Fill="Transparent" Tag="N"  MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
        <Rectangle Height="6" VerticalAlignment="Bottom" Cursor="SizeNS"   Fill="Transparent" Tag="S"  MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
        <Rectangle Width="6"  HorizontalAlignment="Left" Cursor="SizeWE"   Fill="Transparent" Tag="W"  MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
        <Rectangle Width="6"  HorizontalAlignment="Right" Cursor="SizeWE"  Fill="Transparent" Tag="E"  MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
        <Rectangle Width="10" Height="10" HorizontalAlignment="Left"  VerticalAlignment="Top"    Cursor="SizeNWSE" Fill="Transparent" Tag="NW" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
        <Rectangle Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"    Cursor="SizeNESW" Fill="Transparent" Tag="NE" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
        <Rectangle Width="10" Height="10" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Cursor="SizeNESW" Fill="Transparent" Tag="SW" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
        <Rectangle Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Fill="Transparent" Tag="SE" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
        </Grid>
    </Grid>
</UserControl>
