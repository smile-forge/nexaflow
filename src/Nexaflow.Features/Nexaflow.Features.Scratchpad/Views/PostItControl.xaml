<UserControl x:Class="Nexaflow.Features.Scratchpad.Views.PostItControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexaflow.Features.Scratchpad.Converters"
             Width="{Binding Width}" Height="{Binding Height}"
             RenderTransformOrigin="0.5,0.5"
             UseLayoutRounding="True"
             MouseRightButtonUp="OnRightClick">

    <UserControl.RenderTransform>
        <RotateTransform Angle="{Binding Rotation}"/>
    </UserControl.RenderTransform>

    <UserControl.Resources>
        <conv:PostItColorToBrushConverter       x:Key="ColorBrush"/>
        <conv:PostItColorToHeaderBrushConverter x:Key="HeaderBrush"/>
        <conv:ShapeToClipConverter              x:Key="ShapeClip"/>
        <conv:BoolToVisibilityConverter         x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter  x:Key="InvBoolVis"/>

        <!-- ── Mini-ribbon button ── -->
        <Style x:Key="RibbonBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#C8D0E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active/selected state for shape buttons -->
        <Style x:Key="RibbonBtnActive" TargetType="Button" BasedOn="{StaticResource RibbonBtn}">
            <Setter Property="Background" Value="#40A0E0FF"/>
            <Setter Property="Foreground" Value="#A0E0FF"/>
        </Style>

        <!-- Color dot button -->
        <Style x:Key="ColorDotBtn" TargetType="Button">
            <Setter Property="Width"   Value="22"/>
            <Setter Property="Height"  Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin"  Value="2,0"/>
            <Setter Property="Cursor"  Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Padding="2"
                                BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Mini ribbon Popup (defined outside the clipped RootGrid) -->
        <Popup x:Name="MiniRibbon"
               AllowsTransparency="True"
               StaysOpen="False"
               Placement="MousePoint">
            <Border Background="#1A1F2F"
                    BorderBrush="#2A3047"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                      Color="#000000" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Color selection dots -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource ColorDotBtn}" Tag="Yellow" Click="ColorBtn_Click" ToolTip="Yellow">
                            <Ellipse Width="16" Height="16" Fill="#FFF59D"/>
                        </Button>
                        <Button Style="{StaticResource ColorDotBtn}" Tag="Blue" Click="ColorBtn_Click" ToolTip="Blue">
                            <Ellipse Width="16" Height="16" Fill="#90CAF9"/>
                        </Button>
                        <Button Style="{StaticResource ColorDotBtn}" Tag="Green" Click="ColorBtn_Click" ToolTip="Green">
                            <Ellipse Width="16" Height="16" Fill="#A5D6A7"/>
                        </Button>
                        <Button Style="{StaticResource ColorDotBtn}" Tag="Pink" Click="ColorBtn_Click" ToolTip="Pink">
                            <Ellipse Width="16" Height="16" Fill="#F48FB1"/>
                        </Button>
                        <Button Style="{StaticResource ColorDotBtn}" Tag="Orange" Click="ColorBtn_Click" ToolTip="Orange">
                            <Ellipse Width="16" Height="16" Fill="#FFCC80"/>
                        </Button>
                        <Button Style="{StaticResource ColorDotBtn}" Tag="Purple" Click="ColorBtn_Click" ToolTip="Purple">
                            <Ellipse Width="16" Height="16" Fill="#CE93D8"/>
                        </Button>
                        <Button Style="{StaticResource ColorDotBtn}" Tag="White" Click="ColorBtn_Click" ToolTip="White">
                            <Ellipse Width="16" Height="16" Fill="#FAFAFA" Stroke="#CCCCCC" StrokeThickness="1"/>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Background="#2A3047" Margin="4,2" VerticalAlignment="Stretch"/>

                    <!-- Shape selection -->
                    <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                        <Button x:Name="ShapeBtnSquare"  Tag="Square"  Click="ShapeBtn_Click" ToolTip="Square"  Style="{StaticResource RibbonBtn}">
                            <TextBlock Text="⬜" FontSize="14"/>
                        </Button>
                        <Button x:Name="ShapeBtnRounded" Tag="Rounded" Click="ShapeBtn_Click" ToolTip="Rounded" Style="{StaticResource RibbonBtn}">
                            <Border Width="14" Height="14" CornerRadius="4"
                                    BorderBrush="#C8D0E8" BorderThickness="2"/>
                        </Button>
                        <Button x:Name="ShapeBtnStar"    Tag="Star"    Click="ShapeBtn_Click" ToolTip="Star"    Style="{StaticResource RibbonBtn}">
                            <TextBlock Text="⭐" FontSize="14"/>
                        </Button>
                        <Button x:Name="ShapeBtnHeart"   Tag="Heart"   Click="ShapeBtn_Click" ToolTip="Heart"   Style="{StaticResource RibbonBtn}">
                            <TextBlock Text="♥" FontSize="14"/>
                        </Button>
                        <Button x:Name="ShapeBtnCloud"   Tag="Cloud"   Click="ShapeBtn_Click" ToolTip="Cloud"   Style="{StaticResource RibbonBtn}">
                            <TextBlock Text="☁" FontSize="14"/>
                        </Button>
                    </StackPanel>

                    <Border Width="1" Background="#2A3047" Margin="4,2" VerticalAlignment="Stretch"/>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                        <Button x:Name="PinBtn" Click="PinToggle_Click" Style="{StaticResource RibbonBtn}"
                                ToolTip="Pin / Unpin note">
                            <TextBlock x:Name="PinBtnText" Text="📌 Pin"/>
                        </Button>
                        <Button Command="{Binding BringToFrontCommand}" Style="{StaticResource RibbonBtn}" ToolTip="Bring to front">
                            <TextBlock Text="⬆"/>
                        </Button>
                        <Button Command="{Binding SendToBackCommand}" Style="{StaticResource RibbonBtn}" ToolTip="Send to back">
                            <TextBlock Text="⬇"/>
                        </Button>
                        <Button Command="{Binding RemoveCommand}" Style="{StaticResource RibbonBtn}" ToolTip="Remove note">
                            <TextBlock Text="🗑" Foreground="#FF6B6B"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ── Main note body ── -->
        <Grid x:Name="RootGrid">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="315"
                                  Color="#40000000" Opacity="0.55"/>
            </Grid.Effect>

            <!-- Background fill (clip applied to this in code-behind) -->
            <Rectangle x:Name="BgRect"
                       Fill="{Binding Color, Converter={StaticResource ColorBrush}}"/>

            <!-- Content layout -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="6"/>
                </Grid.RowDefinitions>

                <!-- Header / drag handle -->
                <Border x:Name="Header" Grid.Row="0"
                        Background="{Binding Color, Converter={StaticResource HeaderBrush}}"
                        Cursor="SizeAll"
                        MouseDown="Header_MouseDown"
                        MouseMove="Header_MouseMove"
                        MouseUp="Header_MouseUp">
                    <Grid Margin="6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Rotation handle (drag to rotate) -->
                        <Border Grid.Column="0"
                                Width="14" Height="14"
                                CornerRadius="7"
                                Background="#30000000"
                                Cursor="Hand"
                                ToolTip="Drag to rotate"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                MouseDown="RotateHandle_MouseDown"
                                MouseMove="RotateHandle_MouseMove"
                                MouseUp="RotateHandle_MouseUp">
                            <TextBlock Text="↻" FontSize="9" Foreground="#80000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Drag area (blank space, grabs drag) -->
                        <Border Grid.Column="1" Background="Transparent"/>

                        <!-- Timer badge / click to pin-toggle -->
                        <Border Grid.Column="2"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                Margin="0,0,4,0"
                                Padding="3,1"
                                CornerRadius="3"
                                ToolTip="Click to pin/unpin"
                                MouseLeftButtonUp="TimerBadge_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#20000000"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TimeRemainingText}"
                                       FontSize="10"
                                       Foreground="#99000000"/>
                        </Border>

                        <!-- Close button -->
                        <Button Grid.Column="3"
                                Command="{Binding RemoveCommand}"
                                Width="18" Height="18"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                ToolTip="Remove note">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Foreground" Value="#80000000"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                        CornerRadius="3" Padding="0">
                                                    <TextBlock Text="✕" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontSize="{TemplateBinding FontSize}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#40000000"/>
                                                        <Setter Property="Foreground" Value="#CC000000"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content: rich text area -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0">
                    <RichTextBox x:Name="ContentBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Foreground="#CC1C1C1C"
                                 Padding="8,6"
                                 VerticalAlignment="Stretch"
                                 MinHeight="40"
                                 AcceptsReturn="True"
                                 AcceptsTab="False"
                                 SpellCheck.IsEnabled="True"
                                 IsDocumentEnabled="True"/>
                </ScrollViewer>

                <!-- Bottom grip (also draggable for complex shapes) -->
                <Border Grid.Row="2"
                        Background="Transparent"
                        Cursor="SizeAll"
                        MouseDown="Header_MouseDown"
                        MouseMove="Header_MouseMove"
                        MouseUp="Header_MouseUp"/>
            </Grid>

            <!-- ── Resize handles ── -->
            <Rectangle Height="6" VerticalAlignment="Top"    Cursor="SizeNS"   Fill="Transparent" Tag="N"  MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
            <Rectangle Height="6" VerticalAlignment="Bottom" Cursor="SizeNS"   Fill="Transparent" Tag="S"  MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
            <Rectangle Width="6"  HorizontalAlignment="Left" Cursor="SizeWE"   Fill="Transparent" Tag="W"  MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
            <Rectangle Width="6"  HorizontalAlignment="Right" Cursor="SizeWE"  Fill="Transparent" Tag="E"  MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
            <Rectangle Width="10" Height="10" HorizontalAlignment="Left"  VerticalAlignment="Top"    Cursor="SizeNWSE" Fill="Transparent" Tag="NW" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
            <Rectangle Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"    Cursor="SizeNESW" Fill="Transparent" Tag="NE" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
            <Rectangle Width="10" Height="10" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Cursor="SizeNESW" Fill="Transparent" Tag="SW" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
            <Rectangle Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Fill="Transparent" Tag="SE" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp"/>
        </Grid>
    </Grid>
</UserControl>
