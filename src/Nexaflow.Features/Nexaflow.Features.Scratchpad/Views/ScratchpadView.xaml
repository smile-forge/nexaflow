<UserControl x:Class="Nexaflow.Features.Scratchpad.Views.ScratchpadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Nexaflow.Features.Scratchpad.Converters"
             xmlns:local="clr-namespace:Nexaflow.Features.Scratchpad.Views"
             Background="{StaticResource BgBrush}"
             Focusable="True">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <!-- Toolbar button style -->
        <Style x:Key="TbBtn" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="8,5"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground"                  Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active toolbar button -->
        <Style x:Key="TbBtnActive" TargetType="Button" BasedOn="{StaticResource TbBtn}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>  <!-- toolbar -->
            <RowDefinition Height="*"/>   <!-- canvas -->
            <RowDefinition Height="22"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ── Toolbar ── -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0">

                <!-- Left: New + Zoom to Fit -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="＋ New" Style="{StaticResource TbBtn}"
                            Click="AddNote_Click" ToolTip="Add a new post-it (or double-click canvas)"/>
                    <Button Content="⤡ Fit" Style="{StaticResource TbBtn}"
                            Click="ZoomToFit_Click" ToolTip="Zoom to fit all notes"/>
                </StackPanel>

                <!-- Right: Recycle Bin toggle button -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Click="ToggleBin_Click"
                            ToolTip="View / hide Recycle Bin">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TbBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowingRecycleBin}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="🗑 Recycle Bin" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <!-- Spacer -->
                <StackPanel/>
            </DockPanel>
        </Border>

        <!-- ── Main canvas area ── -->
        <Grid Grid.Row="1">

            <!-- Canvas container -->
            <Border x:Name="CanvasHost"
                    ClipToBounds="True"
                    AllowDrop="True"
                    MouseWheel="CanvasHost_MouseWheel"
                    MouseDown="CanvasHost_MouseDown"
                    MouseMove="CanvasHost_MouseMove"
                    MouseUp="CanvasHost_MouseUp"
                    DragOver="CanvasHost_DragOver"
                    Drop="CanvasHost_Drop">

                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#08FFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,40,40"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#0CFFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,1,40"/>
                                            <RectangleGeometry Rect="0,0,40,1"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>

                <Canvas x:Name="InfiniteCanvas">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CanvasScaleTransform"/>
                            <TranslateTransform x:Name="CanvasTranslateTransform"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <ItemsControl x:Name="NotesControl" ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="Canvas.Left"  Value="{Binding X}"/>
                                <Setter Property="Canvas.Top"   Value="{Binding Y}"/>
                                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:PostItControl/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Border>

            <!-- ── Minimap (top-right overlay) ── -->
            <Border x:Name="MiniMapBorder"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Width="160" Height="100"
                    Background="#CC141824"
                    BorderBrush="#334060"
                    BorderThickness="1"
                    CornerRadius="4"
                    Panel.ZIndex="100"
                    Visibility="Collapsed"
                    ToolTip="Overview — current viewport shown in blue">
                <Canvas x:Name="MiniMapCanvas" Width="158" Height="98"/>
            </Border>

            <!-- ── Recycle Bin overlay panel ── -->
            <Border Visibility="{Binding ShowingRecycleBin, Converter={StaticResource BoolVis}}"
                    HorizontalAlignment="Right"
                    Width="300"
                    Panel.ZIndex="50"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header with Empty Bin button inside the window -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,6">
                        <DockPanel>
                            <TextBlock Text="🗑 Recycle Bin"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right"
                                    Content="Empty Bin"
                                    Style="{StaticResource TbBtn}"
                                    Command="{Binding EmptyRecycleBinCommand}"
                                    HorizontalAlignment="Right"
                                    Margin="0"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding RecycleBinNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8,4"
                                            Background="{StaticResource Surface2Brush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding Content}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="12"
                                                       MaxHeight="60"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"/>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                                        HorizontalAlignment="Right" Margin="0,6,0,0">
                                                <Button Content="↩ Restore"
                                                        Style="{StaticResource TbBtn}"
                                                        Command="{Binding DataContext.RestoreNoteCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,4,0"/>
                                                <Button Content="✕ Delete"
                                                        Style="{StaticResource TbBtn}"
                                                        Command="{Binding DataContext.DeleteFromBinCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <StackPanel>
                                        <ItemsPresenter/>
                                        <TextBlock Text="No items in recycle bin"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,24"
                                                   Visibility="{Binding HasItems,
                                                       RelativeSource={RelativeSource TemplatedParent},
                                                       Converter={StaticResource InvBoolVis}}"/>
                                    </StackPanel>
                                </ControlTemplate>
                            </ItemsControl.Template>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Status bar ── -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ZoomLabel"
                           DockPanel.Dock="Right"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
