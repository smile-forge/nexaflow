<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What a user can do to one device, as plugins. Same story as the discovery layers next door: these are
    found by their [Subfeature] attributes and the Network page references none of them, so a new device
    action is a new assembly rather than another button welded onto the page.

    UseWPF off. An action decides and acts; the page renders it, and an action that wanted a window of its
    own would be a page in its own right.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- What an action puts on the wire, where it is a protocol rather than a socket call. Content, not
         code: Wake-on-LAN's magic packet is wol.json, and the action only decides where it goes. -->
    <Content Include="Protocols\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Nexaflow.IO.Network\Nexaflow.IO.Network.csproj" />
    <ProjectReference Include="..\..\Nexaflow.IO.Protocol\Nexaflow.IO.Protocol.csproj" />
    <ProjectReference Include="..\..\Nexaflow.Plugins.Contracts\Nexaflow.Plugins.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexaflow.Tests.Features" />
  </ItemGroup>

</Project>
