<UserControl x:Class="Nexaflow.Features.Images.Views.ImageStartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nexaflow.Features.Images.Views"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="Images_Start">

    <!-- New picture: what an Images tab holding no picture shows, bound to an ImageStartViewModel. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
            <cv:InverseBoolToVisibilityConverter x:Key="NotBoolVis"/>
            <cv:ZeroCountToVisibilityConverter x:Key="NoneVis"/>
            <Style x:Key="StartHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Style>
            <Style x:Key="StartCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource BgBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="980" Margin="24">
            <TextBlock Text="{loc:Str Images.Start.Title}" FontSize="20" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- A blank canvas: its size and background, made as a draft and opened for editing. -->
                <Border Grid.Column="0" Style="{StaticResource StartCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Images.Start.Canvas}" Style="{StaticResource StartHeading}"/>
                        <views:CanvasSetupView DataContext="{Binding Setup}"/>
                        <Button Command="{Binding CreateCommand}" Style="{StaticResource ToolbarPrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="16,5"
                                ToolTip="{loc:Str Images.Start.CreateTip}" AutomationProperties.AutomationId="Images_StartCreate">
                            <icons:IconLabel Icon="fluent:add" Text="{loc:Str Images.Start.Create}"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- A picture drawn into such a canvas, its proportions the canvas's nearest. -->
                <Border Grid.Column="2" Style="{StaticResource StartCard}">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Images.Start.Generate}" Style="{StaticResource StartHeading}"/>
                        <StackPanel Visibility="{Binding OffersGeneration, Converter={StaticResource BoolVis}}">
                            <ContentControl Content="{Binding Generation.View}" Focusable="False"/>
                            <Button Command="{Binding GenerateCommand}" Style="{StaticResource ToolbarPrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="16,5"
                                    ToolTip="{loc:Str Images.Start.GenerateTip}" AutomationProperties.AutomationId="Images_StartGenerate">
                                <icons:IconLabel Icon="fluent:sparkle" Text="{loc:Str Images.Start.GenerateGo}"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Visibility="{Binding OffersGeneration, Converter={StaticResource NotBoolVis}}">
                            <TextBlock Text="{loc:Str Images.Start.NoModel}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                            <Button Command="{Binding OpenAiSettingsCommand}" Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4"
                                    AutomationProperties.AutomationId="Images_StartAiSettings">
                                <icons:IconLabel Icon="fluent:settings" Text="{loc:Str Images.Start.AiSettings}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Command="{Binding PasteCommand}" Style="{StaticResource ToolbarButtonStyle}" Padding="12,5" Margin="0,0,8,0"
                        Visibility="{Binding ClipboardHoldsPicture, Converter={StaticResource BoolVis}}"
                        ToolTip="{loc:Str Images.Start.PasteTip}" AutomationProperties.AutomationId="Images_StartPaste">
                    <icons:IconLabel Icon="fluent:clipboard_paste" Text="{loc:Str Images.Start.Paste}"/>
                </Button>
                <Button Command="{Binding OpenPictureCommand}" Style="{StaticResource ToolbarButtonStyle}" Padding="12,5"
                        ToolTip="{loc:Str Images.Start.OpenTip}" AutomationProperties.AutomationId="Images_StartOpen">
                    <icons:IconLabel Icon="fluent:folder_open" Text="{loc:Str Images.Start.Open}"/>
                </Button>
            </StackPanel>

            <!-- The canvases opened here lately: the last .ora files, and drafts not saved yet. -->
            <TextBlock Text="{loc:Str Images.Start.Recent}" Style="{StaticResource StartHeading}" Margin="0,20,0,6"/>
            <TextBlock Text="{loc:Str Images.Start.NoRecent}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       Visibility="{Binding Recent.Count, Converter={StaticResource NoneVis}}"/>
            <ItemsControl ItemsSource="{Binding Recent}" AutomationProperties.AutomationId="Images_StartRecentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,5" Margin="0,0,0,4"
                                Background="{StaticResource SurfaceBrush}" ToolTip="{Binding Path}"
                                AutomationProperties.AutomationId="Images_StartRecent" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
