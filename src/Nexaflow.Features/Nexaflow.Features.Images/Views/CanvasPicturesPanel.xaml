<UserControl x:Class="Nexaflow.Features.Images.Views.CanvasPicturesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="Image_LayersPictures">

    <!-- Above the layers: Generate layer, and the pictures being drawn for the canvas with their progress and Stop.
         Bound to a CanvasPictures. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
            <cv:InverseBoolToVisibilityConverter x:Key="NotBoolVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="8,8,8,0">
        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AskForLayerCommand}" HorizontalAlignment="Left"
                ToolTip="{loc:Str Images.Layers.GenerateTip}" AutomationProperties.AutomationId="Image_LayersGenerate"
                Visibility="{Binding OffersGeneration, Converter={StaticResource BoolVis}}">
            <icons:IconLabel Icon="fluent:sparkle" Text="{loc:Str Images.Layers.Generate}"/>
        </Button>

        <!-- Generate layer, being set up: what the model offers, the proportions the canvas's nearest. -->
        <Border Margin="0,6,0,0" Padding="8" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding IsAsking, Converter={StaticResource BoolVis}}">
            <StackPanel>
                <ContentControl Content="{Binding Options.View}" Focusable="False"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Command="{Binding GenerateLayerCommand}" Style="{StaticResource ToolbarPrimaryButtonStyle}" Padding="12,4" Margin="0,0,6,0"
                            AutomationProperties.AutomationId="Image_LayersGenerateGo">
                        <icons:IconLabel Icon="fluent:sparkle" Text="{loc:Str Images.Layers.GenerateGo}"/>
                    </Button>
                    <Button Command="{Binding CancelAskingCommand}" Style="{StaticResource ToolbarButtonStyle}" Padding="12,4"
                            AutomationProperties.AutomationId="Image_LayersGenerateCancel">
                        <icons:IconLabel Icon="fluent:dismiss" Text="{loc:Str Images.Layers.GenerateCancel}"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The pictures being drawn: each a layer once it arrives. -->
        <ItemsControl ItemsSource="{Binding Pending}" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,4" Padding="6" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding StopCommand}" VerticalAlignment="Center"
                                    ToolTip="{loc:Str Images.Layers.PendingStopTip}" AutomationProperties.AutomationId="Image_LayersPendingStop"
                                    AutomationProperties.Name="{loc:Str Images.Layers.PendingStopTip}">
                                <icons:IconLabel Icon="fluent:stop"/>
                            </Button>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Job.Progress, TargetNullValue={loc:Str Images.Layers.Drawing}}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
