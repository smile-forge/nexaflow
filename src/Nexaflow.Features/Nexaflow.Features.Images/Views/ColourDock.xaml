<UserControl x:Class="Nexaflow.Features.Images.Views.ColourDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="Image_ColourDock">

    <!-- The colour Markup, Paint and Haze share, and the palette kept beside it, bound to a PictureColours: down the canvas's
         left edge, the current colour on top — a click opens the picker over the canvas — the palette beneath, and + to add. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PaletteChip" TargetType="Button">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ring" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="ring" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="ring" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CurrentChip" TargetType="ToggleButton">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ring" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="ring" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="ring" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
        <StackPanel>
            <Grid>
                <ToggleButton x:Name="CurrentChip" Style="{StaticResource CurrentChip}" Background="{Binding CurrentBrush}"
                              IsChecked="{Binding IsPickerOpen, Mode=TwoWay}"
                              ToolTip="{loc:Str Images.Colour.CurrentTip}" AutomationProperties.Name="{loc:Str Images.Colour.Current}"
                              AutomationProperties.AutomationId="Image_ColourCurrent"/>
                <Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=CurrentChip}"
                       Placement="Right" HorizontalOffset="10" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="12" Width="280">
                        <vcc:ColorPicker AutomationPrefix="Image_Colour" AllowDefault="False" AllowScreenSample="False" Value="{Binding Current, Mode=TwoWay}"/>
                    </Border>
                </Popup>
            </Grid>

            <Border Height="1" Margin="2,6" Background="{StaticResource BorderBrush}"/>

            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding Palette}" Focusable="False" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PaletteChip}" Background="{Binding Brush}" ToolTip="{Binding Tip}"
                                    Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                    AutomationProperties.AutomationId="Image_ColourSwatch" AutomationProperties.Name="{Binding Name}">
                                <Button.InputBindings>
                                    <MouseBinding Gesture="RightClick" CommandParameter="{Binding}"
                                                  Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </Button.InputBindings>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Center" Command="{Binding AddCommand}"
                    ToolTip="{loc:Str Images.Colour.AddTip}" AutomationProperties.Name="{loc:Str Images.Colour.Add}"
                    AutomationProperties.AutomationId="Image_ColourAdd">
                <icons:IconGlyph Icon="fluent:add" FontSize="14"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
