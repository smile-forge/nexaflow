<UserControl x:Class="Nexaflow.Features.Images.Views.ArtistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nexaflow.Features.Images.Views"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:drafts="clr-namespace:Nexaflow.Visuals.Common.Drafts;assembly=Nexaflow.Visuals.Common"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="ArtistView"
             Focusable="True"
             KeyDown="OnViewKeyDown"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <cv:InverseBoolToVisibilityConverter x:Key="NotBoolToVis"/>
            <cv:NullToVisibilityConverter x:Key="NullToCollapsed"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Top toolbar: a picture's, so not there on the start screen ══ -->
        <Border Grid.Row="0" Height="42" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Grid Margin="12,0">
                <!-- Print (Ctrl+P): the picture as edited, or the canvas -->
                <views:PicturePrintView DataContext="{Binding Printing}" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <!-- The picture's history, layers made from it, and saving it -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- A photo's first layer, which makes it a layered picture kept apart from it; a layered one adds its layers in its own panel. -->
                    <Button Command="{Binding AddLayerCommand}" ToolTip="{loc:Str Images.Edit.AddLayerTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,0"
                            Visibility="{Binding IsLayered, Converter={StaticResource NotBoolToVis}}"
                            AutomationProperties.AutomationId="Image_EditAddLayer">
                        <icons:IconLabel Icon="fluent:layer_diagonal_add" Text="{loc:Str Images.Edit.AddLayer}"/>
                    </Button>
                    <Button Command="{Binding PasteAsLayerCommand}" ToolTip="{loc:Str Images.Edit.PasteLayerTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,10,0"
                            AutomationProperties.AutomationId="Image_EditPasteLayer">
                        <icons:IconLabel Icon="fluent:clipboard_paste" Text="{loc:Str Images.Edit.PasteLayer}"/>
                    </Button>
                    <Button Command="{Binding UndoEditCommand}" ToolTip="{loc:Str Images.Edit.UndoTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,0"
                            AutomationProperties.AutomationId="Image_EditUndo" AutomationProperties.Name="{loc:Str Images.Edit.UndoTip}">
                        <icons:IconLabel Icon="fluent:arrow_undo"/>
                    </Button>
                    <Button Command="{Binding RedoEditCommand}" ToolTip="{loc:Str Images.Edit.RedoTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,10,0"
                            AutomationProperties.AutomationId="Image_EditRedo" AutomationProperties.Name="{loc:Str Images.Edit.RedoTip}">
                        <icons:IconLabel Icon="fluent:arrow_redo"/>
                    </Button>
                    <ToggleButton IsChecked="{Binding Editor.ShowOriginal, Mode=TwoWay}" ToolTip="{loc:Str Images.Edit.CompareTip}" Style="{StaticResource ToolbarToggleStyle}" Margin="0,0,4,0"
                                  Visibility="{Binding IsLayered, Converter={StaticResource NotBoolToVis}}"
                                  AutomationProperties.AutomationId="Image_EditCompare">
                        <icons:IconLabel Icon="fluent:split_vertical" Text="{loc:Str Images.Edit.Compare}"/>
                    </ToggleButton>
                    <Button Command="{Binding Stage.RevertEditsCommand}" ToolTip="{loc:Str Images.Edit.RevertTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,10,0"
                            AutomationProperties.AutomationId="Image_EditRevert">
                        <icons:IconLabel Icon="fluent:arrow_reset" Text="{loc:Str Images.Edit.Revert}"/>
                    </Button>
                    <Button Command="{Binding Editor.SaveCommand}" ToolTip="{loc:Str Images.Edit.SaveTip}" Style="{StaticResource ToolbarPrimaryButtonStyle}" Margin="0,0,4,0"
                            AutomationProperties.AutomationId="Image_EditSave">
                        <icons:IconLabel Icon="fluent:save" Text="{loc:Str Images.Edit.Save}"/>
                    </Button>
                    <Button Command="{Binding Editor.SaveCopyCommand}" ToolTip="{loc:Str Images.Edit.SaveCopyTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,0"
                            AutomationProperties.AutomationId="Image_EditSaveCopy">
                        <icons:IconLabel Icon="fluent:save_copy" Text="{loc:Str Images.Edit.SaveCopy}"/>
                    </Button>
                    <!-- Save options: what a save keeps and the quality it writes — decided where saving is, not among the tools -->
                    <Grid>
                        <Button x:Name="SaveOptionsButton" Command="{Binding Editor.OpenSaveOptionsCommand}" ToolTip="{loc:Str Images.Edit.SaveOptions.Tip}"
                                Style="{StaticResource ToolbarButtonStyle}"
                                AutomationProperties.AutomationId="Image_EditSaveOptions" AutomationProperties.Name="{loc:Str Images.Edit.SaveOptions.Title}">
                            <Grid>
                                <icons:IconGlyph Icon="fluent:settings" FontSize="14"/>
                                <!-- What Save will not do is said inside: marked here so it is not missed. -->
                                <Ellipse Width="6" Height="6" Fill="{StaticResource WarningBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-5,0"
                                         Visibility="{Binding Editor.SaveNote, Converter={StaticResource NullToCollapsed}}"/>
                            </Grid>
                        </Button>
                        <Popup IsOpen="{Binding Editor.IsSaveOptionsOpen, Mode=TwoWay}" StaysOpen="False"
                                PlacementTarget="{Binding ElementName=SaveOptionsButton}" Placement="Bottom" HorizontalOffset="-288"
                               AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,6,0,0" Padding="14,0,14,14" Width="320"
                                    Thumb.DragStarted="SaveOptions_DragStarted" Thumb.DragCompleted="SaveOptions_DragCompleted">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EditPanelTitle}" Text="{loc:Str Images.Edit.SaveOptions.Title}"/>
                                    <TextBlock Style="{StaticResource EditCaption}" Text="{loc:Str Images.Edit.Export.Hint}"/>

                                    <TextBlock Style="{StaticResource EditSectionHeader}" Text="{loc:Str Images.Edit.Export.MetadataHeader}"/>
                                    <CheckBox Style="{StaticResource EditCheckBox}" IsChecked="{Binding Editor.StripMetadata, Mode=TwoWay}"
                                              Content="{loc:Str Images.Edit.Export.Strip}" AutomationProperties.AutomationId="Image_EditStripMetadata"/>
                                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,4,0,0" Text="{loc:Str Images.Edit.Export.StripHint}"/>

                                    <TextBlock Style="{StaticResource EditSectionHeader}" Text="{loc:Str Images.Edit.Export.Quality}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <views:AdjustmentSlider Minimum="50" Maximum="100" SmallChange="1" LargeChange="5" DefaultValue="92" VerticalAlignment="Center"
                                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                                Value="{Binding Editor.Quality, Mode=TwoWay}" AutomationProperties.AutomationId="Image_EditQuality"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource EditCaption}" Margin="8,0,0,0" Text="{Binding Editor.Quality}"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,4,0,0" Text="{loc:Str Images.Edit.Export.QualityHint}"/>

                                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,14,0,0" Foreground="{StaticResource WarningBrush}"
                                               Text="{Binding Editor.SaveNote}" Visibility="{Binding Editor.SaveNote, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Notices ══ -->
        <StackPanel Grid.Row="1">
            <!-- A picture made for the user and not saved yet; Save asks where it goes, so the strip carries no Save as of its own. -->
            <drafts:DraftBanner DataContext="{Binding Draft}" OffersSaveAs="False"/>
            <views:PictureNotices DataContext="{Binding Stage}"/>
            <!-- A layered picture opened on the look the application that wrote it saved: which layers cannot be drawn, and the two ways on. -->
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding ShowsSavedLookBar, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding UseSavedLookCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0"
                                ToolTip="{loc:Str Images.Layers.UseSavedLookTip}" AutomationProperties.AutomationId="Image_SavedLookUse">
                            <icons:IconLabel Icon="fluent:image" Text="{loc:Str Images.Layers.UseSavedLook}"/>
                        </Button>
                        <Button Command="{Binding EditTheLayersCommand}" Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="{loc:Str Images.Layers.EditTheLayersTip}" AutomationProperties.AutomationId="Image_SavedLookEditLayers">
                            <icons:IconLabel Icon="fluent:layer_diagonal" Text="{loc:Str Images.Layers.EditTheLayers}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding SavedLookNotice}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <!-- The open panel's tools wait for models not here yet: their download, offered once. -->
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding Editor.PickingModels.ShowsOffer, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding Editor.PickingModels.DownloadCommand}" Style="{StaticResource ToolbarButtonStyle}"
                            Visibility="{Binding Editor.PickingModels.CanDownload, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="Image_PickingModelsDownload" AutomationProperties.Name="{loc:Str Images.Models.Download}">
                        <icons:IconLabel Icon="fluent:arrow_download" Text="{loc:Str Images.Models.Download}"/>
                    </Button>
                    <TextBlock Text="{Binding Editor.PickingModels.Notice}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding Editor.ErasingModels.ShowsOffer, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding Editor.ErasingModels.DownloadCommand}" Style="{StaticResource ToolbarButtonStyle}"
                            Visibility="{Binding Editor.ErasingModels.CanDownload, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="Image_ErasingModelsDownload" AutomationProperties.Name="{loc:Str Images.Models.Download}">
                        <icons:IconLabel Icon="fluent:arrow_download" Text="{loc:Str Images.Models.Download}"/>
                    </Button>
                    <TextBlock Text="{Binding Editor.ErasingModels.Notice}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding Editor.RestoringModels.ShowsOffer, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding Editor.RestoringModels.DownloadCommand}" Style="{StaticResource ToolbarButtonStyle}"
                            Visibility="{Binding Editor.RestoringModels.CanDownload, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="Image_RestoringModelsDownload" AutomationProperties.Name="{loc:Str Images.Models.Download}">
                        <icons:IconLabel Icon="fluent:arrow_download" Text="{loc:Str Images.Models.Download}"/>
                    </Button>
                    <TextBlock Text="{Binding Editor.RestoringModels.Notice}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ══ The picture on the editing canvas, with the tools beside it ══ -->
        <views:ImageEditView x:Name="EditSurface" Grid.Row="2" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>

        <!-- ══ The start screen: the tab holds no picture ══ -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding IsStarting, Converter={StaticResource BoolToVis}}">
            <views:ImageStartView DataContext="{Binding Start}"/>
        </Grid>
    </Grid>
</UserControl>
