<UserControl x:Class="Nexaflow.Features.Images.Views.LayersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Images.ViewModels"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             xmlns:views="clr-namespace:Nexaflow.Features.Images.Views"
             AutomationProperties.AutomationId="Image_LayersPanel">

    <!-- The layers panel of a layered picture, bound to its LayersViewModel: the layers top first, the active one's settings,
         and what is done to layers, masks, the canvas and a selection. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <cv:NullToVisibilityConverter x:Key="NullToCollapsed"/>
            <cv:EnumToBoolConverter x:Key="EnumToBool"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="10,6,10,10">
        <!-- The heading, and what adds, groups, copies, removes and reorders layers — one row of icons, each named by its tooltip. -->
        <DockPanel Margin="0,4,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource FloatingToolButtonStyle}" Padding="5" Command="{Binding AddPixelLayerCommand}"
                        ToolTip="{loc:Str Images.Layers.AddPixelTip}" AutomationProperties.AutomationId="Image_LayersAddPixel" AutomationProperties.Name="{loc:Str Images.Layers.AddPixel}">
                    <icons:IconGlyph Icon="fluent:layer_diagonal_add" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource FloatingToolButtonStyle}" Padding="5" Command="{Binding AddMarkupLayerCommand}"
                        ToolTip="{loc:Str Images.Layers.AddMarkupTip}" AutomationProperties.AutomationId="Image_LayersAddMarkup" AutomationProperties.Name="{loc:Str Images.Layers.AddMarkup}">
                    <icons:IconGlyph Icon="fluent:note_add" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource FloatingToolButtonStyle}" Padding="5" Command="{Binding GroupCommand}"
                        ToolTip="{loc:Str Images.Layers.GroupTip}" AutomationProperties.AutomationId="Image_LayersGroup" AutomationProperties.Name="{loc:Str Images.Layers.Group}">
                    <icons:IconGlyph Icon="fluent:group" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource FloatingToolButtonStyle}" Padding="5" Command="{Binding DuplicateCommand}"
                        ToolTip="{loc:Str Images.Layers.DuplicateTip}" AutomationProperties.AutomationId="Image_LayersDuplicate" AutomationProperties.Name="{loc:Str Images.Layers.Duplicate}">
                    <icons:IconGlyph Icon="fluent:copy_add" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource FloatingToolButtonStyle}" Padding="5" Command="{Binding MoveUpCommand}"
                        ToolTip="{loc:Str Images.Layers.MoveUpTip}" AutomationProperties.AutomationId="Image_LayersMoveUp" AutomationProperties.Name="{loc:Str Images.Layers.MoveUpTip}">
                    <icons:IconGlyph Icon="fluent:arrow_up" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource FloatingToolButtonStyle}" Padding="5" Command="{Binding MoveDownCommand}"
                        ToolTip="{loc:Str Images.Layers.MoveDownTip}" AutomationProperties.AutomationId="Image_LayersMoveDown" AutomationProperties.Name="{loc:Str Images.Layers.MoveDownTip}">
                    <icons:IconGlyph Icon="fluent:arrow_down" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource FloatingToolButtonStyle}" Padding="5" Command="{Binding DeleteCommand}"
                        ToolTip="{loc:Str Images.Layers.DeleteTip}" AutomationProperties.AutomationId="Image_LayersDelete" AutomationProperties.Name="{loc:Str Images.Layers.Delete}">
                    <icons:IconGlyph Icon="fluent:delete" FontSize="15"/>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource EditSectionHeader}" Margin="0" VerticalAlignment="Center" Text="{loc:Str Images.Layers.Title}"/>
        </DockPanel>

        <!-- The layers, top first: drag one onto another to move it — onto a group's middle to put it inside. It scrolls on its
             own, so it keeps its room however much is open beneath it. -->
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
        <ListBox x:Name="LayerList" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" MinHeight="72" MaxHeight="280"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                 AutomationProperties.AutomationId="Image_LayersList" AutomationProperties.Name="{loc:Str Images.Layers.Title}"
                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove" Drop="List_Drop">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LayerItem}">
                    <Border x:Name="Row" Padding="2,3" CornerRadius="4" Background="Transparent">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="{Binding Indent}"/>
                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0" Style="{StaticResource LayerVisibilityToggle}"
                                      IsChecked="{Binding Visible, Mode=OneWay}" Command="{Binding DataContext.ToggleVisibleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                      CommandParameter="{Binding}" ToolTip="{loc:Str Images.Layers.VisibleTip}" AutomationProperties.AutomationId="Image_LayersVisible"
                                      AutomationProperties.Name="{loc:Str Images.Layers.VisibleTip}"/>
                            <Button DockPanel.Dock="Left" Click="Thumbnail_Click" Style="{StaticResource ThumbnailButtonStyle}" Margin="0,0,3,0" ToolTip="{loc:Str Images.Layers.ThumbnailTip}" AutomationProperties.AutomationId="Image_LayersThumbnail"
                                    AutomationProperties.Name="{Binding Name}" Background="{StaticResource SwatchChecker}">
                                <Image Source="{Binding Thumbnail}" Width="36" Height="28" Stretch="Uniform"/>
                            </Button>
                            <Button DockPanel.Dock="Left" Click="MaskThumbnail_Click" Style="{StaticResource ThumbnailButtonStyle}" Margin="0,0,4,0" ToolTip="{loc:Str Images.Layers.MaskThumbnailTip}" AutomationProperties.AutomationId="Image_LayersMaskThumbnail"
                                    AutomationProperties.Name="{loc:Str Images.Layers.Mask}" Visibility="{Binding HasMask, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Image Source="{Binding MaskThumbnail}" Width="28" Height="28" Stretch="Uniform"/>
                                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Visibility="{Binding IsMaskActive, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>
                            <icons:IconGlyph DockPanel.Dock="Right" Icon="fluent:lock_closed" FontSize="11" VerticalAlignment="Center" Margin="4,0,2,0"
                                             Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding Locked, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface2Brush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Border>

        <!-- The active layer's own settings, under the list they belong to: its name, how much and how it shows, and what
             is held fixed in it — the last as icon toggles, named by their tooltips. -->
        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}">
            <TextBox Style="{StaticResource FieldBox}" Text="{Binding ActiveName, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="Image_LayersName"
                     AutomationProperties.Name="{loc:Str Images.Layers.Name}" ToolTip="{loc:Str Images.Layers.Name}"/>
            <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Layers.Opacity}" ValueFormat="0'%'" Margin="0,8,0,2"
                                    Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" DefaultValue="100"
                                    Value="{Binding Opacity, Mode=TwoWay}" AutomationProperties.AutomationId="Image_LayersOpacity"/>
            <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                    <ToggleButton Style="{StaticResource ToolbarToggleStyle}" Padding="6,4" Margin="0,0,3,0" IsChecked="{Binding ActiveClips, Mode=TwoWay}" ToolTip="{loc:Str Images.Layers.ClipTip}"
                                  AutomationProperties.AutomationId="Image_LayersClip" AutomationProperties.Name="{loc:Str Images.Layers.Clip}">
                        <icons:IconGlyph Icon="fluent:link" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleStyle}" Padding="6,4" Margin="0,0,3,0" IsChecked="{Binding ActiveAlphaLocked, Mode=TwoWay}" ToolTip="{loc:Str Images.Layers.AlphaLockTip}"
                                  AutomationProperties.AutomationId="Image_LayersAlphaLock" AutomationProperties.Name="{loc:Str Images.Layers.AlphaLock}">
                        <icons:IconGlyph Icon="fluent:transparency_square" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleStyle}" Padding="6,4" Margin="0,0,3,0" IsChecked="{Binding ActiveLocked, Mode=TwoWay}" ToolTip="{loc:Str Images.Layers.LockTip}"
                                  AutomationProperties.AutomationId="Image_LayersLock" AutomationProperties.Name="{loc:Str Images.Layers.Lock}">
                        <icons:IconGlyph Icon="fluent:lock_closed" FontSize="14"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ToolbarToggleStyle}" Padding="6,4" IsChecked="{Binding ActiveIsolated, Mode=TwoWay}" ToolTip="{loc:Str Images.Layers.IsolatedTip}"
                                  Visibility="{Binding ActiveIsGroup, Converter={StaticResource BoolToVis}}"
                                  AutomationProperties.AutomationId="Image_LayersIsolated" AutomationProperties.Name="{loc:Str Images.Layers.Isolated}">
                        <icons:IconGlyph Icon="fluent:layer_diagonal" FontSize="14"/>
                    </ToggleButton>
                </StackPanel>
                <ComboBox ItemsSource="{Binding BlendChoices}" SelectedItem="{Binding Blend, Mode=TwoWay}" DisplayMemberPath="Label" Height="28"
                          ToolTip="{loc:Str Images.Layers.Blend}" AutomationProperties.AutomationId="Image_LayersBlend" AutomationProperties.Name="{loc:Str Images.Layers.Blend}"/>
            </DockPanel>
        </StackPanel>

        <!-- Masks, pixels, the canvas and what a selection does: beneath the layer's settings, folded until wanted. -->
        <StackPanel Margin="0,10,0,0">
            <views:FoldingGroup Icon="fluent:eye" Title="{loc:Str Images.Layers.Mask}"
                                IsOpen="{Binding DataContext.Folds[LayersMask], RelativeSource={RelativeSource AncestorType=views:ImageEditView}}"
                                AutomationProperties.AutomationId="Image_LayersMaskSection">
                <WrapPanel Margin="0,6,0,0">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding RevealAllMaskCommand}" ToolTip="{loc:Str Images.Layers.RevealAllTip}" AutomationProperties.AutomationId="Image_LayersMaskRevealAll"><icons:IconLabel Icon="fluent:eye" Text="{loc:Str Images.Layers.RevealAll}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding HideAllMaskCommand}" ToolTip="{loc:Str Images.Layers.HideAllTip}" AutomationProperties.AutomationId="Image_LayersMaskHideAll"><icons:IconLabel Icon="fluent:eye_off" Text="{loc:Str Images.Layers.HideAll}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MaskFromSelectionCommand}" ToolTip="{loc:Str Images.Layers.FromSelectionTip}" AutomationProperties.AutomationId="Image_LayersMaskFromSelection"><icons:IconLabel Icon="fluent:select_object" Text="{loc:Str Images.Layers.FromSelection}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MaskHidingSelectionCommand}" ToolTip="{loc:Str Images.Layers.HideSelectionTip}" AutomationProperties.AutomationId="Image_LayersMaskHideSelection"><icons:IconLabel Icon="fluent:shape_subtract" Text="{loc:Str Images.Layers.HideSelection}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MaskFromTransparencyCommand}" ToolTip="{loc:Str Images.Layers.FromTransparencyTip}" AutomationProperties.AutomationId="Image_LayersMaskFromTransparency"><icons:IconLabel Icon="fluent:transparency_square" Text="{loc:Str Images.Layers.FromTransparency}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MaskFromCutOutCommand}" ToolTip="{loc:Str Images.Layers.FromCutOutTip}" AutomationProperties.AutomationId="Image_LayersMaskFromCutOut"><icons:IconLabel Icon="fluent:cut" Text="{loc:Str Images.Layers.FromCutOut}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding InvertMaskCommand}" ToolTip="{loc:Str Images.Layers.InvertMaskTip}" AutomationProperties.AutomationId="Image_LayersMaskInvert"><icons:IconLabel Icon="fluent:arrow_swap" Text="{loc:Str Images.Layers.InvertMask}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding ApplyMaskCommand}" ToolTip="{loc:Str Images.Layers.ApplyMaskTip}" AutomationProperties.AutomationId="Image_LayersMaskApply"><icons:IconLabel Icon="fluent:checkmark" Text="{loc:Str Images.Layers.ApplyMask}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding DeleteMaskCommand}" ToolTip="{loc:Str Images.Layers.DeleteMaskTip}" AutomationProperties.AutomationId="Image_LayersMaskDelete"><icons:IconLabel Icon="fluent:delete" Text="{loc:Str Images.Layers.DeleteMask}" FontSize="11"/></Button>
                </WrapPanel>
            </views:FoldingGroup>
            <views:FoldingGroup Icon="fluent:image_edit" Title="{loc:Str Images.Layers.Pixels}"
                                IsOpen="{Binding DataContext.Folds[LayersPixels], RelativeSource={RelativeSource AncestorType=views:ImageEditView}}"
                                AutomationProperties.AutomationId="Image_LayersPixelsSection">
                <StackPanel Margin="0,6,0,0">
                    <WrapPanel>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding RasterizeCommand}" ToolTip="{loc:Str Images.Layers.RasterizeTip}" AutomationProperties.AutomationId="Image_LayersRasterize"><icons:IconLabel Icon="fluent:image_edit" Text="{loc:Str Images.Layers.Rasterize}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MergeDownCommand}" ToolTip="{loc:Str Images.Layers.MergeDownTip}" AutomationProperties.AutomationId="Image_LayersMergeDown"><icons:IconLabel Icon="fluent:merge" Text="{loc:Str Images.Layers.MergeDown}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding FlattenCommand}" ToolTip="{loc:Str Images.Layers.FlattenTip}" AutomationProperties.AutomationId="Image_LayersFlatten"><icons:IconLabel Icon="fluent:layer_diagonal" Text="{loc:Str Images.Layers.Flatten}" FontSize="11"/></Button>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource EditSliderLabel}" Text="{loc:Str Images.Layers.Selection}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding FillCommand}" ToolTip="{loc:Str Images.Layers.FillTip}" AutomationProperties.AutomationId="Image_LayersFill"><icons:IconLabel Icon="fluent:paint_bucket" Text="{loc:Str Images.Layers.Fill}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding DeleteSelectedCommand}" ToolTip="{loc:Str Images.Layers.ClearTip}" AutomationProperties.AutomationId="Image_LayersClear"><icons:IconLabel Icon="fluent:eraser" Text="{loc:Str Images.Layers.Clear}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding CopyCommand}" ToolTip="{loc:Str Images.Layers.CopyTip}" AutomationProperties.AutomationId="Image_LayersCopy" AutomationProperties.Name="{loc:Str Images.Layers.Copy}"><icons:IconLabel Icon="fluent:copy" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding CopyMergedCommand}" ToolTip="{loc:Str Images.Layers.CopyMergedTip}" AutomationProperties.AutomationId="Image_LayersCopyMerged"><icons:IconLabel Icon="fluent:copy_select" Text="{loc:Str Images.Layers.CopyMerged}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding CutCommand}" ToolTip="{loc:Str Images.Layers.CutTip}" AutomationProperties.AutomationId="Image_LayersCut" AutomationProperties.Name="{loc:Str Images.Layers.Cut}"><icons:IconLabel Icon="fluent:cut" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding PasteCommand}" ToolTip="{loc:Str Images.Layers.PasteTip}" AutomationProperties.AutomationId="Image_LayersPaste" AutomationProperties.Name="{loc:Str Images.Layers.Paste}"><icons:IconLabel Icon="fluent:clipboard_paste" FontSize="11"/></Button>
                    </WrapPanel>
                </StackPanel>
            </views:FoldingGroup>
            <views:FoldingGroup Icon="fluent:resize" Title="{loc:Str Images.Layers.Canvas}" Opened="Canvas_Expanded"
                                IsOpen="{Binding DataContext.Folds[LayersCanvas], RelativeSource={RelativeSource AncestorType=views:ImageEditView}}"
                                AutomationProperties.AutomationId="Image_LayersCanvasSection">
                <StackPanel Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource EditCaption}" Text="{loc:Str Images.Layers.Width}"/>
                            <TextBox Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="4,3"
                                     Text="{Binding CanvasWidth, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Image_LayersCanvasWidth"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Width}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource EditCaption}" Text="{loc:Str Images.Layers.Height}"/>
                            <TextBox Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="4,3"
                                     Text="{Binding CanvasHeight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Image_LayersCanvasHeight"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Height}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,6,0,2" Text="{loc:Str Images.Layers.Anchor}"/>
                    <!-- Where the picture stays as the canvas grows or shrinks: one of nine, left to right, top to bottom. -->
                    <UniformGrid Columns="3" Rows="3" Width="72" Height="72" HorizontalAlignment="Left">
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorTopLeft"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.TopLeft}" ToolTip="{loc:Str Images.Layers.Anchor.TopLeft}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=TopLeft}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorTop"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.Top}" ToolTip="{loc:Str Images.Layers.Anchor.Top}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=Top}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorTopRight"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.TopRight}" ToolTip="{loc:Str Images.Layers.Anchor.TopRight}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=TopRight}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorLeft"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.Left}" ToolTip="{loc:Str Images.Layers.Anchor.Left}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=Left}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorCentre"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.Centre}" ToolTip="{loc:Str Images.Layers.Anchor.Centre}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=Centre}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorRight"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.Right}" ToolTip="{loc:Str Images.Layers.Anchor.Right}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=Right}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorBottomLeft"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.BottomLeft}" ToolTip="{loc:Str Images.Layers.Anchor.BottomLeft}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=BottomLeft}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorBottom"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.Bottom}" ToolTip="{loc:Str Images.Layers.Anchor.Bottom}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=Bottom}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorBottomRight"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.BottomRight}" ToolTip="{loc:Str Images.Layers.Anchor.BottomRight}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=BottomRight}"/>
                    </UniformGrid>
                    <!-- The colour the picture is held in: converted to another mode or depth as one step. -->
                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,8,0,2" Text="{loc:Str Images.Colour.Mode}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ColourModes}" SelectedItem="{Binding ColourMode, Mode=TwoWay}" DisplayMemberPath="Label"
                                  Style="{StaticResource DarkComboBox}" Height="26"
                                  AutomationProperties.AutomationId="Image_LayersColourMode" AutomationProperties.Name="{loc:Str Images.Colour.Mode}"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ColourDepths}" SelectedItem="{Binding ColourDepth, Mode=TwoWay}" DisplayMemberPath="Label"
                                  Style="{StaticResource DarkComboBox}" Height="26"
                                  AutomationProperties.AutomationId="Image_LayersColourDepth" AutomationProperties.Name="{loc:Str Images.Colour.Depth}"/>
                    </Grid>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,4,0,0" HorizontalAlignment="Left" Command="{Binding ConvertColourCommand}"
                            ToolTip="{loc:Str Images.Layers.ConvertColourTip}" AutomationProperties.AutomationId="Image_LayersConvertColour">
                        <icons:IconLabel Icon="fluent:color" Text="{loc:Str Images.Layers.ConvertColour}" FontSize="11"/>
                    </Button>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding ShowsLight, Converter={StaticResource BoolToVis}}">
                        <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Layers.ViewExposure}" ValueFormat="+0.0;−0.0;0"
                                                Minimum="-8" Maximum="8" SmallChange="0.1" LargeChange="1" DefaultValue="0"
                                                Value="{Binding ViewExposure, Mode=TwoWay}" AutomationProperties.AutomationId="Image_LayersViewExposure"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding CanvasMemory}"/>
                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                               Text="{loc:Str Images.Layers.CanvasTooLarge}" Visibility="{Binding CanvasTooLarge, Converter={StaticResource BoolToVis}}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding ResizeCanvasCommand}" ToolTip="{loc:Str Images.Layers.ResizeCanvasTip}" AutomationProperties.AutomationId="Image_LayersCanvasApply"><icons:IconLabel Icon="fluent:resize" Text="{loc:Str Images.Layers.ResizeCanvas}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding CropToSelectionCommand}" ToolTip="{loc:Str Images.Layers.CropToSelectionTip}" AutomationProperties.AutomationId="Image_LayersCropToSelection"><icons:IconLabel Icon="fluent:crop" Text="{loc:Str Images.Layers.CropToSelection}" FontSize="11"/></Button>
                    </WrapPanel>
                </StackPanel>
            </views:FoldingGroup>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
