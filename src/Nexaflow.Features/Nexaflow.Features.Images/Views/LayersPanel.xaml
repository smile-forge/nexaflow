<UserControl x:Class="Nexaflow.Features.Images.Views.LayersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Images.ViewModels"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="Image_LayersPanel">

    <!-- The layers panel of a layered picture, bound to its LayersViewModel: the layers top first, the active one's settings,
         and what is done to layers, masks, the canvas and a selection. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <cv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <cv:EnumToBoolConverter x:Key="EnumToBool"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="10,9,10,10">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource EditPanelTitle}" Text="{loc:Str Images.Layers.Title}"/>

        <!-- Adding, grouping, copying, removing and moving layers. -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding AddPixelLayerCommand}"
                    ToolTip="{loc:Str Images.Layers.AddPixelTip}" AutomationProperties.AutomationId="Image_LayersAddPixel">
                <TextBlock Text="{loc:Str Images.Layers.AddPixel}" FontSize="11"/>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding AddMarkupLayerCommand}"
                    ToolTip="{loc:Str Images.Layers.AddMarkupTip}" AutomationProperties.AutomationId="Image_LayersAddMarkup">
                <TextBlock Text="{loc:Str Images.Layers.AddMarkup}" FontSize="11"/>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding GroupCommand}"
                    ToolTip="{loc:Str Images.Layers.GroupTip}" AutomationProperties.AutomationId="Image_LayersGroup">
                <TextBlock Text="{loc:Str Images.Layers.Group}" FontSize="11"/>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding DuplicateCommand}"
                    ToolTip="{loc:Str Images.Layers.DuplicateTip}" AutomationProperties.AutomationId="Image_LayersDuplicate">
                <TextBlock Text="{loc:Str Images.Layers.Duplicate}" FontSize="11"/>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding DeleteCommand}"
                    ToolTip="{loc:Str Images.Layers.DeleteTip}" AutomationProperties.AutomationId="Image_LayersDelete">
                <TextBlock Text="{loc:Str Images.Layers.Delete}" FontSize="11"/>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MoveUpCommand}"
                    ToolTip="{loc:Str Images.Layers.MoveUpTip}" AutomationProperties.AutomationId="Image_LayersMoveUp"
                    AutomationProperties.Name="{loc:Str Images.Layers.MoveUpTip}">
                <TextBlock Text="▲" FontSize="11"/>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MoveDownCommand}"
                    ToolTip="{loc:Str Images.Layers.MoveDownTip}" AutomationProperties.AutomationId="Image_LayersMoveDown"
                    AutomationProperties.Name="{loc:Str Images.Layers.MoveDownTip}">
                <TextBlock Text="▼" FontSize="11"/>
            </Button>
        </WrapPanel>

        <!-- The active layer's settings. -->
        <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}">
            <TextBox Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="4,3"
                     Text="{Binding ActiveName, UpdateSourceTrigger=LostFocus}" AutomationProperties.AutomationId="Image_LayersName"
                     AutomationProperties.Name="{loc:Str Images.Layers.Name}"/>
            <DockPanel Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource EditCaption}" Text="{Binding Opacity, StringFormat={}{0:0}%}"/>
                <TextBlock Style="{StaticResource EditCaption}" Text="{loc:Str Images.Layers.Opacity}"/>
            </DockPanel>
            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding Opacity, Mode=TwoWay}"
                    AutomationProperties.AutomationId="Image_LayersOpacity" AutomationProperties.Name="{loc:Str Images.Layers.Opacity}"/>
            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding BlendChoices}" SelectedItem="{Binding Blend, Mode=TwoWay}" DisplayMemberPath="Label"
                      AutomationProperties.AutomationId="Image_LayersBlend" AutomationProperties.Name="{loc:Str Images.Layers.Blend}"/>
            <WrapPanel Margin="0,6,0,0">
                <CheckBox Margin="0,0,10,4" IsChecked="{Binding ActiveClips, Mode=TwoWay}" ToolTip="{loc:Str Images.Layers.ClipTip}"
                          AutomationProperties.AutomationId="Image_LayersClip" Content="{loc:Str Images.Layers.Clip}" Foreground="{StaticResource TextBrush}"/>
                <CheckBox Margin="0,0,10,4" IsChecked="{Binding ActiveAlphaLocked, Mode=TwoWay}" ToolTip="{loc:Str Images.Layers.AlphaLockTip}"
                          AutomationProperties.AutomationId="Image_LayersAlphaLock" Content="{loc:Str Images.Layers.AlphaLock}" Foreground="{StaticResource TextBrush}"/>
                <CheckBox Margin="0,0,10,4" IsChecked="{Binding ActiveLocked, Mode=TwoWay}" ToolTip="{loc:Str Images.Layers.LockTip}"
                          AutomationProperties.AutomationId="Image_LayersLock" Content="{loc:Str Images.Layers.Lock}" Foreground="{StaticResource TextBrush}"/>
                <CheckBox Margin="0,0,10,4" IsChecked="{Binding ActiveIsolated, Mode=TwoWay}" ToolTip="{loc:Str Images.Layers.IsolatedTip}"
                          Visibility="{Binding ActiveIsGroup, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.AutomationId="Image_LayersIsolated" Content="{loc:Str Images.Layers.Isolated}" Foreground="{StaticResource TextBrush}"/>
            </WrapPanel>
        </StackPanel>

        <!-- Masks, pixels, the canvas and what a selection does: beneath the list, folded until wanted. -->
        <StackPanel DockPanel.Dock="Bottom">
            <Expander Header="{loc:Str Images.Layers.Mask}" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0" AutomationProperties.AutomationId="Image_LayersMaskSection">
                <WrapPanel Margin="0,6,0,0">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding RevealAllMaskCommand}" ToolTip="{loc:Str Images.Layers.RevealAllTip}" AutomationProperties.AutomationId="Image_LayersMaskRevealAll"><TextBlock Text="{loc:Str Images.Layers.RevealAll}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding HideAllMaskCommand}" ToolTip="{loc:Str Images.Layers.HideAllTip}" AutomationProperties.AutomationId="Image_LayersMaskHideAll"><TextBlock Text="{loc:Str Images.Layers.HideAll}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MaskFromSelectionCommand}" ToolTip="{loc:Str Images.Layers.FromSelectionTip}" AutomationProperties.AutomationId="Image_LayersMaskFromSelection"><TextBlock Text="{loc:Str Images.Layers.FromSelection}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MaskHidingSelectionCommand}" ToolTip="{loc:Str Images.Layers.HideSelectionTip}" AutomationProperties.AutomationId="Image_LayersMaskHideSelection"><TextBlock Text="{loc:Str Images.Layers.HideSelection}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MaskFromTransparencyCommand}" ToolTip="{loc:Str Images.Layers.FromTransparencyTip}" AutomationProperties.AutomationId="Image_LayersMaskFromTransparency"><TextBlock Text="{loc:Str Images.Layers.FromTransparency}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MaskFromCutOutCommand}" ToolTip="{loc:Str Images.Layers.FromCutOutTip}" AutomationProperties.AutomationId="Image_LayersMaskFromCutOut"><TextBlock Text="{loc:Str Images.Layers.FromCutOut}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding InvertMaskCommand}" ToolTip="{loc:Str Images.Layers.InvertMaskTip}" AutomationProperties.AutomationId="Image_LayersMaskInvert"><TextBlock Text="{loc:Str Images.Layers.InvertMask}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding ApplyMaskCommand}" ToolTip="{loc:Str Images.Layers.ApplyMaskTip}" AutomationProperties.AutomationId="Image_LayersMaskApply"><TextBlock Text="{loc:Str Images.Layers.ApplyMask}" FontSize="11"/></Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding DeleteMaskCommand}" ToolTip="{loc:Str Images.Layers.DeleteMaskTip}" AutomationProperties.AutomationId="Image_LayersMaskDelete"><TextBlock Text="{loc:Str Images.Layers.DeleteMask}" FontSize="11"/></Button>
                </WrapPanel>
            </Expander>
            <Expander Header="{loc:Str Images.Layers.Pixels}" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" AutomationProperties.AutomationId="Image_LayersPixelsSection">
                <StackPanel Margin="0,6,0,0">
                    <WrapPanel>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding RasterizeCommand}" ToolTip="{loc:Str Images.Layers.RasterizeTip}" AutomationProperties.AutomationId="Image_LayersRasterize"><TextBlock Text="{loc:Str Images.Layers.Rasterize}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding MergeDownCommand}" ToolTip="{loc:Str Images.Layers.MergeDownTip}" AutomationProperties.AutomationId="Image_LayersMergeDown"><TextBlock Text="{loc:Str Images.Layers.MergeDown}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding FlattenCommand}" ToolTip="{loc:Str Images.Layers.FlattenTip}" AutomationProperties.AutomationId="Image_LayersFlatten"><TextBlock Text="{loc:Str Images.Layers.Flatten}" FontSize="11"/></Button>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource EditSectionHeader}" Text="{loc:Str Images.Layers.Selection}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding FillCommand}" ToolTip="{loc:Str Images.Layers.FillTip}" AutomationProperties.AutomationId="Image_LayersFill"><TextBlock Text="{loc:Str Images.Layers.Fill}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding DeleteSelectedCommand}" ToolTip="{loc:Str Images.Layers.ClearTip}" AutomationProperties.AutomationId="Image_LayersClear"><TextBlock Text="{loc:Str Images.Layers.Clear}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding CopyCommand}" ToolTip="{loc:Str Images.Layers.CopyTip}" AutomationProperties.AutomationId="Image_LayersCopy"><TextBlock Text="{loc:Str Images.Layers.Copy}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding CopyMergedCommand}" ToolTip="{loc:Str Images.Layers.CopyMergedTip}" AutomationProperties.AutomationId="Image_LayersCopyMerged"><TextBlock Text="{loc:Str Images.Layers.CopyMerged}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding CutCommand}" ToolTip="{loc:Str Images.Layers.CutTip}" AutomationProperties.AutomationId="Image_LayersCut"><TextBlock Text="{loc:Str Images.Layers.Cut}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding PasteCommand}" ToolTip="{loc:Str Images.Layers.PasteTip}" AutomationProperties.AutomationId="Image_LayersPaste"><TextBlock Text="{loc:Str Images.Layers.Paste}" FontSize="11"/></Button>
                    </WrapPanel>
                </StackPanel>
            </Expander>
            <Expander Header="{loc:Str Images.Layers.Canvas}" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" AutomationProperties.AutomationId="Image_LayersCanvasSection"
                      Expanded="Canvas_Expanded">
                <StackPanel Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource EditCaption}" Text="{loc:Str Images.Layers.Width}"/>
                            <TextBox Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="4,3"
                                     Text="{Binding CanvasWidth, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Image_LayersCanvasWidth"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Width}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource EditCaption}" Text="{loc:Str Images.Layers.Height}"/>
                            <TextBox Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="4,3"
                                     Text="{Binding CanvasHeight, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Image_LayersCanvasHeight"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Height}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,6,0,2" Text="{loc:Str Images.Layers.Anchor}"/>
                    <!-- Where the picture stays as the canvas grows or shrinks: one of nine, left to right, top to bottom. -->
                    <UniformGrid Columns="3" Rows="3" Width="72" Height="72" HorizontalAlignment="Left">
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorTopLeft"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.TopLeft}" ToolTip="{loc:Str Images.Layers.Anchor.TopLeft}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=TopLeft}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorTop"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.Top}" ToolTip="{loc:Str Images.Layers.Anchor.Top}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=Top}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorTopRight"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.TopRight}" ToolTip="{loc:Str Images.Layers.Anchor.TopRight}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=TopRight}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorLeft"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.Left}" ToolTip="{loc:Str Images.Layers.Anchor.Left}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=Left}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorCentre"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.Centre}" ToolTip="{loc:Str Images.Layers.Anchor.Centre}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=Centre}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorRight"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.Right}" ToolTip="{loc:Str Images.Layers.Anchor.Right}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=Right}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorBottomLeft"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.BottomLeft}" ToolTip="{loc:Str Images.Layers.Anchor.BottomLeft}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=BottomLeft}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorBottom"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.Bottom}" ToolTip="{loc:Str Images.Layers.Anchor.Bottom}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=Bottom}"/>
                        <RadioButton GroupName="CanvasAnchor" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_LayersAnchorBottomRight"
                                     AutomationProperties.Name="{loc:Str Images.Layers.Anchor.BottomRight}" ToolTip="{loc:Str Images.Layers.Anchor.BottomRight}"
                                     IsChecked="{Binding CanvasAnchor, Converter={StaticResource EnumToBool}, ConverterParameter=BottomRight}"/>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding CanvasMemory}"/>
                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                               Text="{loc:Str Images.Layers.CanvasTooLarge}" Visibility="{Binding CanvasTooLarge, Converter={StaticResource BoolToVis}}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding ResizeCanvasCommand}" ToolTip="{loc:Str Images.Layers.ResizeCanvasTip}" AutomationProperties.AutomationId="Image_LayersCanvasApply"><TextBlock Text="{loc:Str Images.Layers.ResizeCanvas}" FontSize="11"/></Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding CropToSelectionCommand}" ToolTip="{loc:Str Images.Layers.CropToSelectionTip}" AutomationProperties.AutomationId="Image_LayersCropToSelection"><TextBlock Text="{loc:Str Images.Layers.CropToSelection}" FontSize="11"/></Button>
                    </WrapPanel>
                </StackPanel>
            </Expander>
        </StackPanel>

        <!-- The layers, top first: drag one onto another to move it — onto a group's middle to put it inside. -->
        <ListBox x:Name="LayerList" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Margin="0,6,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                 AutomationProperties.AutomationId="Image_LayersList" AutomationProperties.Name="{loc:Str Images.Layers.Title}"
                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove" Drop="List_Drop">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:LayerItem}">
                    <Border x:Name="Row" Padding="2,3" CornerRadius="4" Background="Transparent">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="{Binding Indent}"/>
                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0"
                                      IsChecked="{Binding Visible, Mode=OneWay}" Command="{Binding DataContext.ToggleVisibleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                      CommandParameter="{Binding}" ToolTip="{loc:Str Images.Layers.VisibleTip}" AutomationProperties.AutomationId="Image_LayersVisible"
                                      AutomationProperties.Name="{loc:Str Images.Layers.VisibleTip}"/>
                            <Button DockPanel.Dock="Left" Click="Thumbnail_Click" Padding="0" Margin="0,0,3,0" BorderThickness="1" Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}" ToolTip="{loc:Str Images.Layers.ThumbnailTip}" AutomationProperties.AutomationId="Image_LayersThumbnail"
                                    AutomationProperties.Name="{Binding Name}">
                                <Image Source="{Binding Thumbnail}" Width="36" Height="28" Stretch="Uniform"/>
                            </Button>
                            <Button DockPanel.Dock="Left" Click="MaskThumbnail_Click" Padding="0" Margin="0,0,4,0" BorderThickness="1" Background="{StaticResource Surface2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}" ToolTip="{loc:Str Images.Layers.MaskThumbnailTip}" AutomationProperties.AutomationId="Image_LayersMaskThumbnail"
                                    AutomationProperties.Name="{loc:Str Images.Layers.Mask}" Visibility="{Binding HasMask, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Image Source="{Binding MaskThumbnail}" Width="28" Height="28" Stretch="Uniform"/>
                                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" Visibility="{Binding IsMaskActive, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>
                            <TextBlock DockPanel.Dock="Right" Text="🔒" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding Locked, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Surface2Brush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
