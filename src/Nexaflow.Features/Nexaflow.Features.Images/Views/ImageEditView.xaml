                                                 IsChecked="{Binding Editor.MarkupTool, Converter={StaticResource EnumToBool}, ConverterParameter=Highlighter}">
                                    <icons:IconGlyph Icon="fluent:highlight" FontSize="15"/>
                                    </RadioButton>
