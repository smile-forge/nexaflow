<UserControl x:Class="Nexaflow.Features.Images.Views.ImageEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Nexaflow.Features.Images.Views"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:vcl="clr-namespace:Nexaflow.Visuals.Common.Layout;assembly=Nexaflow.Visuals.Common"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             AutomationProperties.AutomationId="ImageEditView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <cv:EnumToBoolConverter x:Key="EnumToBool"/>
            <cv:NullToVisibilityConverter x:Key="NullToCollapsed"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Layers: a layered picture's, beside the tools ══ -->
        <Border Grid.Column="2" Width="260" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsLayered, Converter={StaticResource BoolToVis}}" Thumb.DragStarted="Slider_DragStarted" Thumb.DragCompleted="Slider_DragCompleted">
            <DockPanel>
                <!-- What the workspace's image models do to the picture, side by side: each sets itself up just below. -->
                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="8,8,8,0">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Pictures.AskForLayerCommand}" Margin="0,0,4,4"
                            ToolTip="{loc:Str Images.Layers.GenerateTip}" AutomationProperties.AutomationId="Image_LayersGenerate"
                            Visibility="{Binding Pictures.OffersGeneration, Converter={StaticResource BoolToVis}}">
                        <icons:IconLabel Icon="fluent:sparkle" Text="{loc:Str Images.Layers.Generate}" FontSize="11"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Edits.AskFillCommand}" Margin="0,0,4,4"
                            ToolTip="{loc:Str Images.Edits.FillTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.AutomationId="Image_LayersAiFill"
                            Visibility="{Binding Edits.OffersFill, Converter={StaticResource BoolToVis}}">
                        <icons:IconLabel Icon="fluent:paint_brush_sparkle" Text="{loc:Str Images.Edits.Fill}" FontSize="11"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Edits.AskExpandCommand}" Margin="0,0,4,4"
                            ToolTip="{loc:Str Images.Edits.ExpandTip}" AutomationProperties.AutomationId="Image_LayersAiExpand"
                            Visibility="{Binding Edits.OffersFill, Converter={StaticResource BoolToVis}}">
                        <icons:IconLabel Icon="fluent:resize" Text="{loc:Str Images.Edits.Expand}" FontSize="11"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Edits.AskChangeCommand}" Margin="0,0,4,4"
                            ToolTip="{loc:Str Images.Edits.ChangeTip}" AutomationProperties.AutomationId="Image_LayersAiChange"
                            Visibility="{Binding Edits.OffersChange, Converter={StaticResource BoolToVis}}">
                        <icons:IconLabel Icon="fluent:wand" Text="{loc:Str Images.Edits.Change}" FontSize="11"/>
                    </Button>
                </UniformGrid>
                <views:CanvasPicturesPanel DockPanel.Dock="Top" DataContext="{Binding Pictures}"/>
                <views:PictureEditsPanel DockPanel.Dock="Top" DataContext="{Binding Edits}"/>
                <views:LayersPanel DataContext="{Binding Layers}"/>
            </DockPanel>
        </Border>

        <!-- ══ Canvas: the picture and the editing chrome over it, on the shared pan/zoom surface ══ -->
        <Grid x:Name="CanvasHost" Grid.Column="0" ClipToBounds="True" SizeChanged="CanvasHost_SizeChanged"
              AllowDrop="True" DragOver="CanvasHost_DragOver" Drop="CanvasHost_Drop">
            <vcl:PanZoomSurface x:Name="Surface" Background="{StaticResource BgBrush}" AutomationProperties.AutomationId="Image_EditCanvas"
                                ZoomOnPlainWheel="True" MinScale="0.1"/>
            <TextBlock Text="{loc:Str Images.LoadFailed}" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding Stage.LoadFailed, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- ══ Tools ══ -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <!-- The tools, in the order a picture is usually worked on: framed, corrected, cleaned up, picked apart, annotated, sized. -->
                <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="8,8,8,2">
                    <RadioButton GroupName="EditTool" Style="{StaticResource EditToolTileStyle}"
                                 ToolTip="{loc:Str Images.Edit.Tool.CropTip}" AutomationProperties.AutomationId="Image_EditToolCrop" AutomationProperties.Name="{loc:Str Images.Edit.Tool.Crop}"
                                 IsChecked="{Binding Editor.Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Crop}">
                        <StackPanel>
                            <icons:IconGlyph Style="{StaticResource EditToolTileIcon}" Icon="fluent:crop_arrow_rotate"/>
                            <TextBlock Style="{StaticResource EditToolTileLabel}" Text="{loc:Str Images.Edit.Tool.Crop}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="EditTool" Style="{StaticResource EditToolTileStyle}"
                                 ToolTip="{loc:Str Images.Edit.Tool.AdjustTip}" AutomationProperties.AutomationId="Image_EditToolAdjust" AutomationProperties.Name="{loc:Str Images.Edit.Tool.Adjust}"
                                 IsChecked="{Binding Editor.Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Adjust}">
                        <StackPanel>
                            <icons:IconGlyph Style="{StaticResource EditToolTileIcon}" Icon="fluent:options"/>
                            <TextBlock Style="{StaticResource EditToolTileLabel}" Text="{loc:Str Images.Edit.Tool.Adjust}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="EditTool" Style="{StaticResource EditToolTileStyle}"
                                 ToolTip="{loc:Str Images.Edit.Tool.RetouchTip}" AutomationProperties.AutomationId="Image_EditToolRetouch" AutomationProperties.Name="{loc:Str Images.Edit.Tool.Retouch}"
                                 IsChecked="{Binding Editor.Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Retouch}">
                        <StackPanel>
                            <icons:IconGlyph Style="{StaticResource EditToolTileIcon}" Icon="fluent:paint_brush_sparkle"/>
                            <TextBlock Style="{StaticResource EditToolTileLabel}" Text="{loc:Str Images.Edit.Tool.Retouch}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="EditTool" Style="{StaticResource EditToolTileStyle}"
                                 ToolTip="{loc:Str Images.Edit.Tool.SelectTip}" AutomationProperties.AutomationId="Image_EditToolSelect" AutomationProperties.Name="{loc:Str Images.Edit.Tool.Select}"
                                 IsChecked="{Binding Editor.Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Select}">
                        <StackPanel>
                            <icons:IconGlyph Style="{StaticResource EditToolTileIcon}" Icon="fluent:select_object"/>
                            <TextBlock Style="{StaticResource EditToolTileLabel}" Text="{loc:Str Images.Edit.Tool.Select}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="EditTool" Style="{StaticResource EditToolTileStyle}"
                                 ToolTip="{loc:Str Images.Edit.Tool.MarkupTip}" AutomationProperties.AutomationId="Image_EditToolMarkup" AutomationProperties.Name="{loc:Str Images.Edit.Tool.Markup}"
                                 IsChecked="{Binding Editor.Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Markup}">
                        <StackPanel>
                            <icons:IconGlyph Style="{StaticResource EditToolTileIcon}" Icon="fluent:draw_shape"/>
                            <TextBlock Style="{StaticResource EditToolTileLabel}" Text="{loc:Str Images.Edit.Tool.Markup}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="EditTool" Style="{StaticResource EditToolTileStyle}"
                                 ToolTip="{loc:Str Images.Edit.Tool.PaintTip}" AutomationProperties.AutomationId="Image_EditToolPaint" AutomationProperties.Name="{loc:Str Images.Edit.Tool.Paint}"
                                 IsChecked="{Binding Editor.Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Paint}">
                        <StackPanel>
                            <icons:IconGlyph Style="{StaticResource EditToolTileIcon}" Icon="fluent:paint_brush"/>
                            <TextBlock Style="{StaticResource EditToolTileLabel}" Text="{loc:Str Images.Edit.Tool.Paint}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="EditTool" Style="{StaticResource EditToolTileStyle}"
                                 ToolTip="{loc:Str Images.Edit.Tool.MoveTip}" AutomationProperties.AutomationId="Image_EditToolMove" AutomationProperties.Name="{loc:Str Images.Edit.Tool.Move}"
                                 IsChecked="{Binding Editor.Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Move}">
                        <StackPanel>
                            <icons:IconGlyph Style="{StaticResource EditToolTileIcon}" Icon="fluent:arrow_move"/>
                            <TextBlock Style="{StaticResource EditToolTileLabel}" Text="{loc:Str Images.Edit.Tool.Move}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton GroupName="EditTool" Style="{StaticResource EditToolTileStyle}"
                                 ToolTip="{loc:Str Images.Edit.Tool.ResizeTip}" AutomationProperties.AutomationId="Image_EditToolResize" AutomationProperties.Name="{loc:Str Images.Edit.Tool.Resize}"
                                 IsChecked="{Binding Editor.Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Resize}">
                        <StackPanel>
                            <icons:IconGlyph Style="{StaticResource EditToolTileIcon}" Icon="fluent:resize_image"/>
                            <TextBlock Style="{StaticResource EditToolTileLabel}" Text="{loc:Str Images.Edit.Tool.Resize}"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Thumb.DragStarted="Slider_DragStarted" Thumb.DragCompleted="Slider_DragCompleted">
                    <StackPanel Margin="12,0,12,16">

                        <!-- ── Crop & rotate ── -->
                        <StackPanel Visibility="{Binding Editor.IsCropTool, Converter={StaticResource BoolToVis}}">
                            <views:FoldingGroup Icon="fluent:arrow_rotate_clockwise" Title="{loc:Str Images.Edit.Crop.RotateHeader}" IsOpen="{Binding Folds[CropRotate]}"
                                                AutomationProperties.AutomationId="Image_GroupCropRotate">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Stage.RotateLeftCommand}" Margin="0,0,4,0"
                                        ToolTip="{loc:Str Images.Tools.RotateLeft}" AutomationProperties.AutomationId="Image_EditRotateLeft" AutomationProperties.Name="{loc:Str Images.Tools.RotateLeft}">
                                    <icons:IconGlyph Icon="fluent:arrow_rotate_counterclockwise" FontSize="15"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Stage.RotateRightCommand}" Margin="0,0,4,0"
                                        ToolTip="{loc:Str Images.Tools.RotateRight}" AutomationProperties.AutomationId="Image_EditRotateRight" AutomationProperties.Name="{loc:Str Images.Tools.RotateRight}">
                                    <icons:IconGlyph Icon="fluent:arrow_rotate_clockwise" FontSize="15"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Stage.FlipHorizontalCommand}" Margin="0,0,4,0"
                                        ToolTip="{loc:Str Images.Tools.FlipHorizontal}" AutomationProperties.AutomationId="Image_EditFlipHorizontal" AutomationProperties.Name="{loc:Str Images.Tools.FlipHorizontal}">
                                    <icons:IconGlyph Icon="fluent:flip_horizontal" FontSize="15"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Stage.FlipVerticalCommand}"
                                        ToolTip="{loc:Str Images.Tools.FlipVertical}" AutomationProperties.AutomationId="Image_EditFlipVertical" AutomationProperties.Name="{loc:Str Images.Tools.FlipVertical}">
                                    <icons:IconGlyph Icon="fluent:flip_vertical" FontSize="15"/>
                                </Button>
                            </StackPanel>
                            </views:FoldingGroup>

                            <views:FoldingGroup Icon="fluent:crop" Title="{loc:Str Images.Edit.Crop.AspectHeader}" IsOpen="{Binding Folds[CropAspect]}"
                                                AutomationProperties.AutomationId="Image_GroupCropAspect">
                            <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToolbarToggleStyle}" Margin="6,0,0,0" Padding="6,4"
                                          IsChecked="{Binding Editor.AspectPortrait, Mode=TwoWay}"
                                          ToolTip="{loc:Str Images.Edit.Crop.PortraitTip}" AutomationProperties.AutomationId="Image_EditAspectPortrait"
                                          AutomationProperties.Name="{loc:Str Images.Edit.Crop.Portrait}">
                                <icons:IconGlyph Icon="fluent:orientation" FontSize="15"/>
                            </ToggleButton>
<Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <UniformGrid Rows="1">
                                    <RadioButton GroupName="Aspect" Style="{StaticResource SegRadioStyle}" Padding="2,5" AutomationProperties.AutomationId="Image_EditAspectFree"
                                                 ToolTip="{loc:Str Images.Edit.Crop.FreeTip}"
                                                 IsChecked="{Binding Editor.Aspect, Converter={StaticResource EnumToBool}, ConverterParameter=Free}">
                                        <TextBlock Text="{loc:Str Images.Edit.Crop.Free}" FontSize="11"/>
                                    </RadioButton>
                                    <RadioButton GroupName="Aspect" Style="{StaticResource SegRadioStyle}" Padding="2,5" AutomationProperties.AutomationId="Image_EditAspectOriginal"
                                                 ToolTip="{loc:Str Images.Edit.Crop.OriginalTip}"
                                                 IsChecked="{Binding Editor.Aspect, Converter={StaticResource EnumToBool}, ConverterParameter=Original}">
                                        <TextBlock Text="{loc:Str Images.Edit.Crop.Original}" FontSize="11"/>
                                    </RadioButton>
                                    <RadioButton GroupName="Aspect" Style="{StaticResource SegRadioStyle}" Padding="2,5" AutomationProperties.AutomationId="Image_EditAspectSquare"
                                                 IsChecked="{Binding Editor.Aspect, Converter={StaticResource EnumToBool}, ConverterParameter=Square}">
                                        <TextBlock Text="1:1" FontSize="11"/>
                                    </RadioButton>
                                    <RadioButton GroupName="Aspect" Style="{StaticResource SegRadioStyle}" Padding="2,5" AutomationProperties.AutomationId="Image_EditAspectFourThree"
                                                 IsChecked="{Binding Editor.Aspect, Converter={StaticResource EnumToBool}, ConverterParameter=FourThree}">
                                        <TextBlock Text="4:3" FontSize="11"/>
                                    </RadioButton>
                                    <RadioButton GroupName="Aspect" Style="{StaticResource SegRadioStyle}" Padding="2,5" AutomationProperties.AutomationId="Image_EditAspectSixteenNine"
                                                 IsChecked="{Binding Editor.Aspect, Converter={StaticResource EnumToBool}, ConverterParameter=SixteenNine}">
                                        <TextBlock Text="16:9" FontSize="11"/>
                                    </RadioButton>
                                </UniformGrid>
                            </Border>
                            </DockPanel>
                            </views:FoldingGroup>

                            <views:FoldingGroup Icon="fluent:ruler" Title="{loc:Str Images.Edit.Crop.StraightenHeader}" IsOpen="{Binding Folds[CropStraighten]}"
                                                AutomationProperties.AutomationId="Image_GroupCropStraighten">
                            <StackPanel>
                            <views:AdjustmentSlider x:Name="StraightenSlider" Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Edit.Crop.Angle}" ValueFormat="0.0°"
                                                    Minimum="-45" Maximum="45" SmallChange="0.1" LargeChange="1"
                                                    Value="{Binding Editor.Straighten, Mode=TwoWay}" DefaultValue="0"
                                                    AutomationProperties.AutomationId="Image_EditStraighten"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ToggleButton Style="{StaticResource ToolbarToggleStyle}" Margin="0,0,6,0"
                                              IsChecked="{Binding Editor.IsLevelTool, Mode=TwoWay}"
                                              ToolTip="{loc:Str Images.Edit.Crop.LevelTip}" AutomationProperties.AutomationId="Image_EditLevel">
                                    <icons:IconLabel Icon="fluent:ruler" Text="{loc:Str Images.Edit.Crop.Level}" FontSize="11"/>
                                </ToggleButton>
                                <Button Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding Editor.ResetCropCommand}" ToolTip="{loc:Str Images.Edit.Crop.ResetTip}" AutomationProperties.AutomationId="Image_EditResetCrop">
                                    <icons:IconLabel Icon="fluent:arrow_reset" Text="{loc:Str Images.Edit.Crop.Reset}" FontSize="11"/>
                                </Button>
                            </StackPanel>
                            </StackPanel>
                            </views:FoldingGroup>
                        </StackPanel>

                        <!-- ── Adjust ── -->
                        <StackPanel Visibility="{Binding Editor.IsAdjustTool, Converter={StaticResource BoolToVis}}">


                            <!-- Histogram: the picture's tones as it is drawn, at its own depth, and where its shadows and highlights clip. -->
                            <views:FoldingGroup Icon="fluent:data_histogram" Title="{loc:Str Images.Edit.Histogram.Header}" IsOpen="{Binding Folds[AdjustHistogram]}"
                                                AutomationProperties.AutomationId="Image_GroupAdjustHistogram">
                            <Grid Height="80" Margin="0,2,0,6">
                                <views:ToneChart x:Name="TonesChart" Histogram="{Binding Tones.Histogram}" IsVisibleChanged="TonesChart_IsVisibleChanged"
                                                 Background="{StaticResource Surface2Brush}" LuminanceFill="{StaticResource TextMutedBrush}"
                                                 RedStroke="{DynamicResource Swatch.Red}" GreenStroke="{DynamicResource Swatch.Green}" BlueStroke="{DynamicResource Swatch.Blue}"/>
                                <ToggleButton x:Name="ShadowsMark" Style="{StaticResource ClipMark}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1"
                                              IsChecked="{Binding Tones.KeepsShadows, Mode=TwoWay}" Tag="{Binding Tones.ShadowsClip}"
                                              MouseEnter="ClipMark_Pointed" MouseLeave="ClipMark_Pointed"
                                              AutomationProperties.Name="{loc:Str Images.Edit.Histogram.Shadows}" AutomationProperties.ItemStatus="{Binding Tones.ShadowsStatus}"
                                              AutomationProperties.AutomationId="Image_HistogramShadows">
                                    <ToggleButton.ToolTip>
                                        <StackPanel MaxWidth="260">
                                            <TextBlock Text="{Binding Tones.ShadowsStatus}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Str Images.Edit.Histogram.ShadowsTip}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToggleButton.ToolTip>
                                </ToggleButton>
                                <!-- The highlights' mark is the shadows' turned to the right-hand corner. -->
                                <ToggleButton x:Name="HighlightsMark" Style="{StaticResource ClipMark}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="1"
                                              RenderTransformOrigin="0.5,0.5"
                                              IsChecked="{Binding Tones.KeepsHighlights, Mode=TwoWay}" Tag="{Binding Tones.HighlightsClip}"
                                              MouseEnter="ClipMark_Pointed" MouseLeave="ClipMark_Pointed"
                                              AutomationProperties.Name="{loc:Str Images.Edit.Histogram.Highlights}" AutomationProperties.ItemStatus="{Binding Tones.HighlightsStatus}"
                                              AutomationProperties.AutomationId="Image_HistogramHighlights">
                                    <ToggleButton.RenderTransform>
                                        <ScaleTransform ScaleX="-1"/>
                                    </ToggleButton.RenderTransform>
                                    <ToggleButton.ToolTip>
                                        <StackPanel MaxWidth="260">
                                            <TextBlock Text="{Binding Tones.HighlightsStatus}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{loc:Str Images.Edit.Histogram.HighlightsTip}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToggleButton.ToolTip>
                                </ToggleButton>
                            </Grid>
                            </views:FoldingGroup>

                            <!-- Quick fix: one press, every slider still free after it. -->
                            <views:FoldingGroup Icon="fluent:sparkle" Title="{loc:Str Images.Edit.Adjust.QuickFixHeader}" IsOpen="{Binding Folds[AdjustQuickFix]}"
                                                AutomationProperties.AutomationId="Image_GroupAdjustQuickFix">
                            <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Editor.AutoEnhanceCommand}" Margin="0,0,6,0"
                                        ToolTip="{loc:Str Images.Edit.Adjust.AutoTip}" AutomationProperties.AutomationId="Image_EditAuto">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:IconGlyph Icon="fluent:wand" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Str Images.Edit.Adjust.Auto}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding Editor.ResetAdjustmentsCommand}"
                                        ToolTip="{loc:Str Images.Edit.Adjust.ResetTip}" AutomationProperties.AutomationId="Image_EditResetAdjust">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:IconGlyph Icon="fluent:arrow_reset" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Str Images.Edit.Adjust.Reset}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- AI enhance: the photo restored by the picture tools before the sliders apply. -->
                            <StackPanel Visibility="{Binding Editor.CanRestore, Converter={StaticResource BoolToVis}}">
                                <ToggleButton Style="{StaticResource RowSwitchHeading}" Content="{loc:Str Images.Edit.Restore.Enhance}" IsChecked="{Binding Editor.AiEnhance, Mode=TwoWay}"
                                              ToolTip="{Binding Editor.RestoringModels.DisabledReason, TargetNullValue={loc:Str Images.Edit.Restore.EnhanceTip}}"
                                              AutomationProperties.AutomationId="Image_EditAiEnhance"
                                              IsEnabled="{Binding Editor.CanToggleAiEnhance}" ToolTipService.ShowOnDisabled="True"/>
                                <StackPanel Visibility="{Binding Editor.AiEnhance, Converter={StaticResource BoolToVis}}">
                                    <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Edit.Restore.Strength}"
                                                            Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" DefaultValue="100"
                                                            Value="{Binding Editor.EnhanceStrength, Mode=TwoWay}"
                                                            AutomationProperties.AutomationId="Image_EditAiStrength"/>
                                    <ToggleButton Style="{StaticResource RowSwitch}" Content="{loc:Str Images.Edit.Restore.Faces}" IsChecked="{Binding Editor.RepairFaces, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="Image_EditAiFaces"/>
                                </StackPanel>
                            </StackPanel>
                            </StackPanel>
                            </views:FoldingGroup>


                            <!-- Light: how bright, and where. -->
                            <views:FoldingGroup Icon="fluent:brightness_high" Title="{loc:Str Images.Edit.Adjust.LightHeader}" IsOpen="{Binding Folds[AdjustLight]}"
                                                AutomationProperties.AutomationId="Image_GroupAdjustLight">
                            <StackPanel>
                            <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Edit.Adjust.Exposure}" ValueFormat="+0.00;−0.00;0.00"
                                                    Minimum="-3" Maximum="3" SmallChange="0.05" LargeChange="0.5" Value="{Binding Editor.Exposure, Mode=TwoWay}"
                                                    AutomationProperties.AutomationId="Image_EditExposure"/>
                            <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Edit.Adjust.Contrast}" ValueFormat="+0;−0;0"
                                                    Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding Editor.Contrast, Mode=TwoWay}"
                                                    AutomationProperties.AutomationId="Image_EditContrast"/>
                            <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Edit.Adjust.Highlights}" ValueFormat="+0;−0;0"
                                                    Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding Editor.Highlights, Mode=TwoWay}"
                                                    AutomationProperties.AutomationId="Image_EditHighlights"/>
                            <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Edit.Adjust.Shadows}" ValueFormat="+0;−0;0"
                                                    Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding Editor.Shadows, Mode=TwoWay}"
                                                    AutomationProperties.AutomationId="Image_EditShadows"/>
                            </StackPanel>
                            </views:FoldingGroup>


                            <!-- Colour: how vivid, how warm, which way it leans. -->
                            <views:FoldingGroup Icon="fluent:color" Title="{loc:Str Images.Edit.Adjust.ColourHeader}" IsOpen="{Binding Folds[AdjustColour]}"
                                                AutomationProperties.AutomationId="Image_GroupAdjustColour">
                            <StackPanel>
                            <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Edit.Adjust.Saturation}" ValueFormat="+0;−0;0"
                                                    Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding Editor.Saturation, Mode=TwoWay}"
                                                    AutomationProperties.AutomationId="Image_EditSaturation"/>
                            <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Edit.Adjust.Temperature}" ValueFormat="+0;−0;0"
                                                    Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding Editor.Temperature, Mode=TwoWay}"
                                                    AutomationProperties.AutomationId="Image_EditTemperature"/>
                            <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Edit.Adjust.Tint}" ValueFormat="+0;−0;0"
                                                    Minimum="-100" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding Editor.Tint, Mode=TwoWay}"
                                                    AutomationProperties.AutomationId="Image_EditTint"/>
                            </StackPanel>
                            </views:FoldingGroup>


                            <!-- Scene depth: a lens's blur and haze drawn from how far each part of the picture lies, and the depth itself for compositing. -->
                            <views:FoldingGroup Icon="fluent:layer_diagonal" Title="{loc:Str Images.SceneDepth.Header}" IsOpen="{Binding Folds[AdjustDepth]}"
                                                Visibility="{Binding Depth.Models.IsOffered, Converter={StaticResource BoolToVis}}"
                                                AutomationProperties.AutomationId="Image_GroupAdjustDepth">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EditCaption}" Text="{loc:Str Images.SceneDepth.NeedsPictureLayer}" Margin="0,0,0,6"
                                           Visibility="{Binding Depth.NeedsPictureLayer, Converter={StaticResource BoolToVis}}"/>

                                <!-- Lens blur: sharp over a band of distance, set on the picture or dragged over the strip of its depths. -->
                                <ToggleButton Style="{StaticResource RowSwitchHeading}" Content="{loc:Str Images.SceneDepth.LensBlur}" IsChecked="{Binding Depth.LensBlur, Mode=TwoWay}"
                                              ToolTip="{Binding Depth.Models.DisabledReason, TargetNullValue={loc:Str Images.SceneDepth.LensBlurTip}}"
                                              IsEnabled="{Binding Depth.CanEdit}" ToolTipService.ShowOnDisabled="True"
                                              AutomationProperties.AutomationId="Image_DepthLensBlur"/>
                                <StackPanel Visibility="{Binding Depth.LensBlur, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
