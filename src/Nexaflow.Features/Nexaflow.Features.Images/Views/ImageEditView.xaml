                                    </TextBox>
                                    <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding Editor.Cutter.FindCommand}" ToolTip="{Binding Editor.PickingModels.DisabledReason, TargetNullValue={loc:Str Images.CutOut.FindTip}}"
                                            AutomationProperties.AutomationId="Image_CutOutFind"
                                            IsEnabled="{Binding Editor.PickingModels.IsReady}"
                                            ToolTipService.ShowOnDisabled="True">
                                        <TextBlock Text="{loc:Str Images.CutOut.Find}" FontSize="11"/>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource EditCaption}" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding Editor.Cutter.Notice}"/>
                                <Button Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding Editor.Cutter.ActCommand}"
                                        Visibility="{Binding Editor.Cutter.HasAction, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.AutomationId="Image_CutOutAction" AutomationProperties.Name="{Binding Editor.Cutter.ActionLabel}">
                                    <TextBlock Text="{Binding Editor.Cutter.ActionLabel}" FontSize="11"/>
                                </Button>
                            </StackPanel>
                            </StackPanel>
                            </views:FoldingGroup>

                        </StackPanel>

                        <!-- ── Retouch: what is rubbed out of the picture, and what fills where it was ── -->
                        <StackPanel Visibility="{Binding Editor.IsRetouchTool, Converter={StaticResource BoolToVis}}">

                            <views:FoldingGroup Icon="fluent:eraser" Title="{loc:Str Images.Erase.Mark}" IsOpen="{Binding Folds[RetouchMark]}"
                                                AutomationProperties.AutomationId="Image_GroupRetouchMark">
                            <StackPanel>
                            <!-- The ways of marking, each once: picked, brushed, or a shape drawn by hand. -->
                            <Border Style="{StaticResource SegGroup}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_EraseMarkPick" AutomationProperties.Name="{loc:Str Images.Erase.Pick}"
                                                 ToolTip="{Binding Editor.PickingModels.DisabledReason, TargetNullValue={loc:Str Images.Erase.PickTip}}"
                                                 IsEnabled="{Binding Editor.PickingModels.IsReady}" ToolTipService.ShowOnDisabled="True"
                                                 IsChecked="{Binding Editor.EraseBy, Converter={StaticResource EnumToBool}, ConverterParameter=Pick}">
                                        <icons:IconGlyph Icon="fluent:cursor_click" FontSize="15"/>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_EraseMarkBrush" AutomationProperties.Name="{loc:Str Images.Erase.Brush}"
                                                 ToolTip="{loc:Str Images.Erase.BrushTip}"
                                                 IsChecked="{Binding Editor.EraseBy, Converter={StaticResource EnumToBool}, ConverterParameter=Brush}">
                                        <icons:IconGlyph Icon="fluent:paint_brush" FontSize="15"/>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_EraseRectangle" AutomationProperties.Name="{loc:Str Images.Region.Rectangle}"
                                                 ToolTip="{loc:Str Images.Region.RectangleTip}"
                                                 IsChecked="{Binding Editor.EraseBy, Converter={StaticResource EnumToBool}, ConverterParameter=Rectangle}">
                                        <icons:IconGlyph Icon="fluent:rectangle_landscape" FontSize="15"/>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_EraseEllipse" AutomationProperties.Name="{loc:Str Images.Region.Ellipse}"
                                                 ToolTip="{loc:Str Images.Region.EllipseTip}"
                                                 IsChecked="{Binding Editor.EraseBy, Converter={StaticResource EnumToBool}, ConverterParameter=Ellipse}">
                                        <icons:IconGlyph Icon="fluent:oval" FontSize="15"/>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_EraseLasso" AutomationProperties.Name="{loc:Str Images.Region.Lasso}"
                                                 ToolTip="{loc:Str Images.Region.FreehandTip}"
                                                 IsChecked="{Binding Editor.EraseBy, Converter={StaticResource EnumToBool}, ConverterParameter=Lasso}">
                                        <icons:IconGlyph Icon="fluent:lasso" FontSize="15"/>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_ErasePolygon" AutomationProperties.Name="{loc:Str Images.Region.Polygon}"
                                                 ToolTip="{loc:Str Images.Region.PolygonTip}"
                                                 IsChecked="{Binding Editor.EraseBy, Converter={StaticResource EnumToBool}, ConverterParameter=Polygon}">
                                        <icons:IconGlyph Icon="fluent:pentagon" FontSize="15"/>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_EraseColour" AutomationProperties.Name="{loc:Str Images.Region.Colour}"
                                                 ToolTip="{loc:Str Images.Region.ColourTip}"
                                                 IsChecked="{Binding Editor.EraseBy, Converter={StaticResource EnumToBool}, ConverterParameter=Colour}">
                                        <icons:IconGlyph Icon="fluent:color" FontSize="15"/>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_EraseDistance" AutomationProperties.Name="{loc:Str Images.Region.Distance}"
                                                 ToolTip="{Binding Editor.DepthModels.DisabledReason, TargetNullValue={loc:Str Images.Region.DistanceTip}}"
                                                 IsEnabled="{Binding Editor.DepthModels.IsReady}" ToolTipService.ShowOnDisabled="True"
                                                 Visibility="{Binding Editor.DepthModels.IsOffered, Converter={StaticResource BoolToVis}}"
                                                 IsChecked="{Binding Editor.EraseBy, Converter={StaticResource EnumToBool}, ConverterParameter=Distance}">
                                        <icons:IconGlyph Icon="fluent:layer_diagonal" FontSize="15"/>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <!-- Picking, as the cut-out tool picks: what is picked here is what it has picked. -->
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding Editor.EraseMarks.IsPicking, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource FieldBox}"
                                             Text="{Binding Editor.Cutter.Phrase, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="Image_ErasePhrase" AutomationProperties.Name="{loc:Str Images.CutOut.Phrase}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding Editor.Cutter.FindCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding Editor.Cutter.FindCommand}" ToolTip="{loc:Str Images.CutOut.FindTip}"
                                            AutomationProperties.AutomationId="Image_EraseFind">
                                        <TextBlock Text="{loc:Str Images.CutOut.Find}" FontSize="11"/>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource EditCaption}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Editor.Cutter.Notice}"/>
                                <Button Style="{StaticResource ToolbarButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Command="{Binding Editor.Cutter.ActCommand}"
                                        Visibility="{Binding Editor.Cutter.HasAction, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.AutomationId="Image_ErasePickAction" AutomationProperties.Name="{Binding Editor.Cutter.ActionLabel}">
                                    <TextBlock Text="{Binding Editor.Cutter.ActionLabel}" FontSize="11"/>
                                </Button>
                            </StackPanel>

                            <!-- Brushing: the brush's width in the photo's pixels. -->
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding Editor.EraseMarks.IsBrushing, Converter={StaticResource BoolToVis}}">
                                <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Erase.BrushSize}" ValueFormat="0' px'"
                                                        Minimum="4" Maximum="400" SmallChange="1" LargeChange="10" DefaultValue="40"
                                                        Value="{Binding Editor.EraseMarks.BrushSize, Mode=TwoWay}" AutomationProperties.AutomationId="Image_EraseBrushSize"/>

                            </StackPanel>
                            </StackPanel>
                            </views:FoldingGroup>

                        </StackPanel>

                        <!-- ── The selection Cut out and Retouch both take: shapes drawn, how they meet it, and refinements ── -->
                        <views:RegionMarkingPanel DataContext="{Binding Editor}" Visibility="{Binding TakesSelection, Converter={StaticResource BoolToVis}}"/>

                        <!-- ── Select: what is done with what is selected — kept apart from the picture, kept in it, moved, made a layer, erased ── -->
                        <StackPanel Visibility="{Binding Editor.IsSelectTool, Converter={StaticResource BoolToVis}}">
                            <views:FoldingGroup Icon="fluent:copy_select" Title="{loc:Str Images.Select.With}" IsOpen="{Binding Folds[SelectWith]}"
                                                AutomationProperties.AutomationId="Image_GroupSelectWith">
                            <WrapPanel>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding Editor.MoveSelectionCommand}"
                                        ToolTip="{loc:Str Images.Select.MoveTip}" AutomationProperties.AutomationId="Image_SelectMove">
                                    <icons:IconLabel Icon="fluent:arrow_move" Text="{loc:Str Images.Select.Move}" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding Editor.LayerFromSelectionCommand}"
                                        ToolTip="{loc:Str Images.Select.NewLayerTip}" AutomationProperties.AutomationId="Image_SelectNewLayer">
                                    <icons:IconLabel Icon="fluent:layer_diagonal_add" Text="{loc:Str Images.Select.NewLayer}" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding Editor.EraseSelectionCommand}"
                                        ToolTip="{loc:Str Images.Select.EraseTip}" AutomationProperties.AutomationId="Image_SelectErase">
                                    <icons:IconLabel Icon="fluent:eraser" Text="{loc:Str Images.Select.Erase}" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding Editor.CopyCutOutCommand}"
                                        ToolTip="{loc:Str Images.CutOut.CopyTip}" AutomationProperties.AutomationId="Image_CutOutCopy">
                                    <icons:IconLabel Icon="fluent:copy" Text="{loc:Str Images.CutOut.Copy}" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding Editor.SaveCutOutCommand}"
                                        ToolTip="{loc:Str Images.CutOut.SaveTip}" AutomationProperties.AutomationId="Image_CutOutSave">
                                    <icons:IconLabel Icon="fluent:save" Text="{loc:Str Images.CutOut.Save}" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding Editor.RemoveBackgroundCommand}"
                                        ToolTip="{loc:Str Images.CutOut.RemoveBackgroundTip}" AutomationProperties.AutomationId="Image_CutOutRemoveBackground">
                                    <icons:IconLabel Icon="fluent:image_off" Text="{loc:Str Images.CutOut.RemoveBackground}" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding Editor.KeepBackgroundCommand}"
                                        Visibility="{Binding Editor.RemovesBackground, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{loc:Str Images.CutOut.KeepBackgroundTip}" AutomationProperties.AutomationId="Image_CutOutKeepBackground">
                                    <icons:IconLabel Icon="fluent:image" Text="{loc:Str Images.CutOut.KeepBackground}" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding Editor.RegionMarks.DeselectCommand}"
                                        AutomationProperties.AutomationId="Image_CutOutClear">
                                    <icons:IconLabel Icon="fluent:dismiss" Text="{loc:Str Images.CutOut.Clear}" FontSize="11"/>
                                </Button>
                            </WrapPanel>
                            </views:FoldingGroup>
                        </StackPanel>

                        <!-- ── Retouch: what fills where the selection was, and erasing it ── -->
                        <StackPanel Visibility="{Binding Editor.IsRetouchTool, Converter={StaticResource BoolToVis}}">
                            <views:FoldingGroup Icon="fluent:paint_brush_sparkle" Title="{loc:Str Images.Erase.Fill}" IsOpen="{Binding Folds[RetouchFill]}"
                                                AutomationProperties.AutomationId="Image_GroupRetouchFill">
                            <StackPanel>
                            <Border Style="{StaticResource SegGroup}"><StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="EraseFill" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_EraseFillAi"
                                             ToolTip="{Binding Editor.ErasingModels.DisabledReason, TargetNullValue={loc:Str Images.Erase.AiTip}}" IsEnabled="{Binding Editor.ErasingModels.IsReady}"
                                             IsChecked="{Binding Editor.EraseMarks.Fill, Converter={StaticResource EnumToBool}, ConverterParameter=Ai}"
                                             ToolTipService.ShowOnDisabled="True">
                                    <TextBlock Text="{loc:Str Images.Erase.Ai}" FontSize="11"/>
                                </RadioButton>
                                <RadioButton GroupName="EraseFill" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_EraseFillContentAware"
                                             ToolTip="{loc:Str Images.Erase.ContentAwareTip}"
                                             IsChecked="{Binding Editor.EraseMarks.Fill, Converter={StaticResource EnumToBool}, ConverterParameter=ContentAware}">
                                    <TextBlock Text="{loc:Str Images.Erase.ContentAware}" FontSize="11"/>
                                </RadioButton>
                                <RadioButton GroupName="EraseFill" Style="{StaticResource SegRadioStyle}" AutomationProperties.AutomationId="Image_EraseFillHeal"
                                             ToolTip="{loc:Str Images.Erase.HealTip}"
                                             IsChecked="{Binding Editor.EraseMarks.Fill, Converter={StaticResource EnumToBool}, ConverterParameter=Heal}">
                                    <TextBlock Text="{loc:Str Images.Erase.Heal}" FontSize="11"/>
                                </RadioButton>
                            </StackPanel></Border>
                            <TextBlock Style="{StaticResource EditCaption}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{loc:Str Images.Erase.HealHint}"
                                       Visibility="{Binding Editor.EraseMarks.NeedsHealSource, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            </views:FoldingGroup>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,6" Command="{Binding Editor.EraseCommand}"
                                        ToolTip="{loc:Str Images.Erase.ApplyTip}" AutomationProperties.AutomationId="Image_EraseApply">
                                    <TextBlock Text="{loc:Str Images.Erase.Apply}" FontSize="11"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,6" Command="{Binding Editor.ClearMarksCommand}"
                                        ToolTip="{loc:Str Images.Erase.ClearTip}" AutomationProperties.AutomationId="Image_EraseClear">
                                    <TextBlock Text="{loc:Str Images.Erase.Clear}" FontSize="11"/>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
