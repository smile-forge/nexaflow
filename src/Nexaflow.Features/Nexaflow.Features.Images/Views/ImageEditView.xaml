                                            AutomationProperties.AutomationId="Image_DepthAsMask">
                                        <icons:IconLabel Icon="fluent:layer_diagonal" Text="{loc:Str Images.SceneDepth.AsMask}" FontSize="11"/>
                                    </Button>
                                </UniformGrid>
                            
                            </StackPanel>
                            </views:FoldingGroup>
                        </StackPanel>

                        <!-- ── Markup ── -->
                        <StackPanel Visibility="{Binding Editor.IsMarkupTool, Converter={StaticResource BoolToVis}}">

                            <views:FoldingGroup Icon="fluent:draw_shape" Title="{loc:Str Images.Edit.Markup.ToolHeader}" IsOpen="{Binding Folds[MarkupTool]}"
