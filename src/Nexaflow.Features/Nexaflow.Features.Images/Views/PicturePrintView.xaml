<UserControl x:Class="Nexaflow.Features.Images.Views.PicturePrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">

    <!-- Print (Ctrl+P): the picture as shown, or the canvas, laid on paper as its options set. DataContext: PicturePrinting. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <cv:EnumToBoolConverter x:Key="EnumToBool"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="Toggle" IsChecked="{Binding IsOpen, Mode=TwoWay}" IsEnabled="{Binding CanPrint}"
                      ToolTip="{loc:Str Images.Print.ButtonTip}" Style="{StaticResource ToolbarToggleStyle}"
                      AutomationProperties.AutomationId="Image_Print" AutomationProperties.Name="{loc:Str Images.Print.Button}">
            <icons:IconLabel Icon="fluent:print" Text="{loc:Str Images.Print.Button}"/>
        </ToggleButton>
        <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="12" Width="300">
                <StackPanel>
                    <TextBlock Style="{StaticResource EditSectionHeader}" Text="{loc:Str Images.Print.Size}" Margin="0,0,0,6"/>
                    <UniformGrid Columns="4">
                        <RadioButton GroupName="PrintSize" Style="{StaticResource SegRadioStyle}" Content="{loc:Str Images.Print.Size.Fit}"
                                     IsChecked="{Binding Size, Converter={StaticResource EnumToBool}, ConverterParameter=Fit}" AutomationProperties.AutomationId="Image_PrintFit"/>
                        <RadioButton GroupName="PrintSize" Style="{StaticResource SegRadioStyle}" Content="{loc:Str Images.Print.Size.Fill}"
                                     IsChecked="{Binding Size, Converter={StaticResource EnumToBool}, ConverterParameter=Fill}" AutomationProperties.AutomationId="Image_PrintFill"/>
                        <RadioButton GroupName="PrintSize" Style="{StaticResource SegRadioStyle}" Content="{loc:Str Images.Print.Size.Actual}"
                                     IsChecked="{Binding Size, Converter={StaticResource EnumToBool}, ConverterParameter=Actual}" AutomationProperties.AutomationId="Image_PrintActual"/>
                        <RadioButton GroupName="PrintSize" Style="{StaticResource SegRadioStyle}" Content="{loc:Str Images.Print.Size.Width}"
                                     IsChecked="{Binding Size, Converter={StaticResource EnumToBool}, ConverterParameter=Width}" AutomationProperties.AutomationId="Image_PrintWidth"/>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource EditCaption}" TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding ActualNote}"
                               Visibility="{Binding IsActual, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Visibility="{Binding SetsWidth, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                        <TextBlock Style="{StaticResource EditSliderLabel}" Text="{loc:Str Images.Print.WidthMillimetres}"/>
                        <TextBox Text="{Binding WidthMillimetres, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"
                                 AutomationProperties.AutomationId="Image_PrintWidthMillimetres" AutomationProperties.Name="{loc:Str Images.Print.WidthMillimetres}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource EditSectionHeader}" Text="{loc:Str Images.Print.Orientation}"/>
                    <UniformGrid Columns="3">
                        <RadioButton GroupName="PrintOrientation" Style="{StaticResource SegRadioStyle}" Content="{loc:Str Images.Print.Orientation.Auto}"
                                     IsChecked="{Binding Orientation, Converter={StaticResource EnumToBool}, ConverterParameter=Auto}" AutomationProperties.AutomationId="Image_PrintAuto"/>
                        <RadioButton GroupName="PrintOrientation" Style="{StaticResource SegRadioStyle}" Content="{loc:Str Images.Print.Orientation.Portrait}"
                                     IsChecked="{Binding Orientation, Converter={StaticResource EnumToBool}, ConverterParameter=Portrait}" AutomationProperties.AutomationId="Image_PrintPortrait"/>
                        <RadioButton GroupName="PrintOrientation" Style="{StaticResource SegRadioStyle}" Content="{loc:Str Images.Print.Orientation.Landscape}"
                                     IsChecked="{Binding Orientation, Converter={StaticResource EnumToBool}, ConverterParameter=Landscape}" AutomationProperties.AutomationId="Image_PrintLandscape"/>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource EditSliderLabel}" Text="{loc:Str Images.Print.Margins}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding MarginMillimetres, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"
                             AutomationProperties.AutomationId="Image_PrintMargins" AutomationProperties.Name="{loc:Str Images.Print.Margins}"/>
                    <CheckBox Margin="0,8,0,0" Foreground="{StaticResource TextBrush}" IsChecked="{Binding Centre, Mode=TwoWay}"
                              Content="{loc:Str Images.Print.Centre}" AutomationProperties.AutomationId="Image_PrintCentre"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Click="PrintGo_Click" Style="{StaticResource ToolbarPrimaryButtonStyle}" Padding="12,4" Margin="0,0,6,0"
                                ToolTip="{loc:Str Images.Print.GoTip}" AutomationProperties.AutomationId="Image_PrintGo">
                            <icons:IconLabel Icon="fluent:print" Text="{loc:Str Images.Print.Go}"/>
                        </Button>
                        <Button Command="{Binding CloseCommand}" Style="{StaticResource ToolbarButtonStyle}" Padding="12,4"
                                AutomationProperties.AutomationId="Image_PrintClose">
                            <icons:IconLabel Icon="fluent:dismiss" Text="{loc:Str Images.Print.Cancel}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
