<UserControl x:Class="Nexaflow.Features.Images.Views.CanvasSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="Images_CanvasSetup">

    <!-- A new canvas's size and background: bound to a CanvasSetup, wherever a blank canvas is made. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
            <cv:EnumToBoolConverter x:Key="EnumToBool"/>
            <cv:NullToVisibilityConverter x:Key="NullToCollapsed"/>
            <cv:ColorSpecToBrushConverter x:Key="SpecBrush"/>
            <Style x:Key="OptionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,10,0,4"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0,4,0,0">
        <TextBlock Text="{loc:Str Images.Canvas.Size}" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset, Mode=TwoWay}" DisplayMemberPath="Label"
                  Style="{StaticResource DarkComboBox}" HorizontalAlignment="Left" MinWidth="200" Height="28"
                  AutomationProperties.AutomationId="Images_CanvasPreset"
                  AutomationProperties.Name="{loc:Str Images.Canvas.Size}"/>

        <!-- Width ⇄ Height, in the unit beside them; the resolution after, what millimetres and inches are counted in. -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Str Images.Canvas.Width}" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     AutomationProperties.AutomationId="Images_CanvasWidth"
                     AutomationProperties.Name="{loc:Str Images.Canvas.Width}"/>
            <Button Grid.Row="1" Grid.Column="1" Command="{Binding SwapOrientationCommand}" Style="{StaticResource FloatingToolButtonStyle}" Margin="2,0"
                    ToolTip="{loc:Str Images.Canvas.SwapTip}"
                    AutomationProperties.AutomationId="Images_CanvasSwap"
                    AutomationProperties.Name="{loc:Str Images.Canvas.SwapTip}">
                <icons:IconGlyph Icon="fluent:arrow_swap" FontSize="14"/>
            </Button>
            <TextBlock Grid.Column="2" Text="{loc:Str Images.Canvas.Height}" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     AutomationProperties.AutomationId="Images_CanvasHeight"
                     AutomationProperties.Name="{loc:Str Images.Canvas.Height}"/>
            <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit, Mode=TwoWay}" DisplayMemberPath="Label"
                      Style="{StaticResource DarkComboBox}" Width="64" Height="28" Margin="8,0,0,0"
                      AutomationProperties.AutomationId="Images_CanvasUnit"
                      AutomationProperties.Name="{loc:Str Images.Canvas.Unit}"/>
            <TextBlock Grid.Column="4" Text="{loc:Str Images.Canvas.Dpi}" Style="{StaticResource OptionLabel}" Margin="16,0,0,4"/>
            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0">
                <TextBox Text="{Binding DpiText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" Width="56"
                         AutomationProperties.AutomationId="Images_CanvasDpi"
                         AutomationProperties.Name="{loc:Str Images.Canvas.Dpi}"/>
                <TextBlock Text="{loc:Str Images.Canvas.DpiUnit}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="{Binding SizeNote}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                   Visibility="{Binding SizeNote, Converter={StaticResource NullToCollapsed}}"/>

        <!-- The background, shown rather than named: see-through, white, or a colour of its own. -->
        <TextBlock Text="{loc:Str Images.Canvas.Background}" Style="{StaticResource OptionLabel}"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="CanvasBackground" Style="{StaticResource SwatchRadio}"
                         ToolTip="{loc:Str Images.Canvas.Background.Transparent}" AutomationProperties.Name="{loc:Str Images.Canvas.Background.Transparent}"
                         IsChecked="{Binding Background, Converter={StaticResource EnumToBool}, ConverterParameter=Transparent}"
                         AutomationProperties.AutomationId="Images_CanvasBackgroundTransparent">
                <Rectangle Fill="{StaticResource SwatchChecker}"/>
            </RadioButton>
            <RadioButton GroupName="CanvasBackground" Style="{StaticResource SwatchRadio}"
                         ToolTip="{loc:Str Images.Canvas.Background.White}" AutomationProperties.Name="{loc:Str Images.Canvas.Background.White}"
                         IsChecked="{Binding Background, Converter={StaticResource EnumToBool}, ConverterParameter=White}"
                         AutomationProperties.AutomationId="Images_CanvasBackgroundWhite">
                <Rectangle Fill="{Binding WhiteSwatch, Converter={StaticResource SpecBrush}}"/>
            </RadioButton>
            <RadioButton GroupName="CanvasBackground" Style="{StaticResource SwatchRadio}"
                         ToolTip="{loc:Str Images.Canvas.Background.Colour}" AutomationProperties.Name="{loc:Str Images.Canvas.Background.Colour}"
                         IsChecked="{Binding Background, Converter={StaticResource EnumToBool}, ConverterParameter=Colour}"
                         AutomationProperties.AutomationId="Images_CanvasBackgroundColour">
                <Rectangle Fill="{Binding BackgroundColour, Converter={StaticResource SpecBrush}}"/>
            </RadioButton>
        </StackPanel>
        <vcc:ColorPicker AutomationPrefix="Images_CanvasColour" AllowDefault="False" Margin="0,8,0,0"
                         Value="{Binding BackgroundColour, Mode=TwoWay}"
                         Visibility="{Binding TakesColour, Converter={StaticResource BoolVis}}"/>
    </StackPanel>
</UserControl>
