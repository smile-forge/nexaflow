<UserControl x:Class="Nexaflow.Features.Images.Views.ImageDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:details="clr-namespace:Nexaflow.Features.Images.Details"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="Image_DetailsPanel"
             Width="280">

    <!-- What the picture's file says about it: beside the picture, on the left, in every view. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <cv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="14,4,8,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource FloatingToolButtonStyle}" VerticalAlignment="Center"
                        Command="{Binding CloseCommand}" ToolTip="{loc:Str Images.Details.CloseTip}"
                        AutomationProperties.AutomationId="Image_DetailsClose" AutomationProperties.Name="{loc:Str Images.Details.CloseTip}">
                    <icons:IconGlyph Icon="fluent:dismiss" FontSize="14"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                    <icons:IconGlyph Style="{StaticResource EditGroupIcon}" Icon="fluent:info" FontSize="16"/>
                    <TextBlock Style="{StaticResource EditPanelTitle}" Margin="0" Text="{loc:Str Images.Details.Title}"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,0,14,16">
                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,12,0,0" Text="{loc:Str Images.Details.Reading}"
                               Visibility="{Binding IsReading, Converter={StaticResource BoolToVis}}"/>

                    <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type details:DetailsSection}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EditGroupHeader}" Margin="0,16,0,4" Text="{Binding Title}"/>
                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type details:DetailsRow}">
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource TextBrush}" FontSize="12"
                                                               TextWrapping="Wrap" Margin="8,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,16,0,0" Text="{Binding Notice}"
                               Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
