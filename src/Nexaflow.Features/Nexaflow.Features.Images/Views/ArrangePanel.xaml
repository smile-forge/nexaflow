<UserControl x:Class="Nexaflow.Features.Images.Views.ArrangePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="Image_ArrangePanel">

    <!-- The Move tool's panel, bound to a LayerArranging: Transform, and while one is open its flips, turns, Apply and Cancel;
         Drop for what floats. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
            <cv:InverseBoolToVisibilityConverter x:Key="NotBoolVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource EditSectionHeader}" Text="{loc:Str Images.Arrange.Title}"/>
        <TextBlock Style="{StaticResource EditCaption}" TextWrapping="Wrap" Text="{loc:Str Images.Arrange.Intro}"/>

        <StackPanel Visibility="{Binding OffersLayer, Converter={StaticResource BoolVis}}" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource EditCaption}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Text="{loc:Str Images.Arrange.NoLayers}"/>
            <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding AddLayerCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                    ToolTip="{loc:Str Images.Edit.AddLayerTip}" AutomationProperties.AutomationId="Image_ArrangeAddLayer">
                <TextBlock Text="{loc:Str Images.Edit.AddLayer}"/>
            </Button>
        </StackPanel>

        <StackPanel Visibility="{Binding IsTransforming, Converter={StaticResource NotBoolVis}}" Margin="0,10,0,0">
            <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding TransformCommand}" HorizontalAlignment="Left"
                    ToolTip="{loc:Str Images.Arrange.TransformTip}" AutomationProperties.AutomationId="Image_ArrangeTransform">
                <TextBlock Text="{loc:Str Images.Arrange.Transform}"/>
            </Button>
            <StackPanel Visibility="{Binding HasFloating, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource EditCaption}" TextWrapping="Wrap" Text="{loc:Str Images.Arrange.Floating}"/>
                <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DropCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                        ToolTip="{loc:Str Images.Arrange.DropTip}" AutomationProperties.AutomationId="Image_ArrangeDrop">
                    <TextBlock Text="{loc:Str Images.Arrange.Drop}"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel Visibility="{Binding IsTransforming, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource EditCaption}" TextWrapping="Wrap" Text="{loc:Str Images.Arrange.Transforming}"/>
            <WrapPanel Margin="0,8,0,0">
                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding FlipHorizontalCommand}"
                        ToolTip="{loc:Str Images.Arrange.FlipHorizontal}" AutomationProperties.AutomationId="Image_ArrangeFlipHorizontal">
                    <TextBlock Text="{loc:Str Images.Arrange.FlipHorizontal}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding FlipVerticalCommand}"
                        ToolTip="{loc:Str Images.Arrange.FlipVertical}" AutomationProperties.AutomationId="Image_ArrangeFlipVertical">
                    <TextBlock Text="{loc:Str Images.Arrange.FlipVertical}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding RotateLeftCommand}"
                        ToolTip="{loc:Str Images.Arrange.RotateLeft}" AutomationProperties.AutomationId="Image_ArrangeRotateLeft">
                    <TextBlock Text="{loc:Str Images.Arrange.RotateLeft}"/>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,4" Command="{Binding RotateRightCommand}"
                        ToolTip="{loc:Str Images.Arrange.RotateRight}" AutomationProperties.AutomationId="Image_ArrangeRotateRight">
                    <TextBlock Text="{loc:Str Images.Arrange.RotateRight}"/>
                </Button>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="{loc:Str Images.Arrange.Apply}" Command="{Binding ApplyCommand}" Padding="12,4" Margin="0,0,6,0"
                        ToolTip="{loc:Str Images.Arrange.ApplyTip}" AutomationProperties.AutomationId="Image_ArrangeApply"/>
                <Button Content="{loc:Str Images.Arrange.Cancel}" Command="{Binding CancelCommand}" Padding="12,4"
                        ToolTip="{loc:Str Images.Arrange.CancelTip}" AutomationProperties.AutomationId="Image_ArrangeCancel"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
