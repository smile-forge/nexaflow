<UserControl x:Class="Nexaflow.Features.Images.Views.PaintPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             xmlns:views="clr-namespace:Nexaflow.Features.Images.Views"
             AutomationProperties.AutomationId="Image_PaintPanel">

    <!-- The Paint tool's panel, bound to a LayerPainting: its way, the colour, the tip, the fill's reach, the eyedropper's sampling. -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
            <cv:InverseBoolToVisibilityConverter x:Key="NotBoolVis"/>
            <cv:EnumToBoolConverter x:Key="EnumToBool"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>




        <!-- What a press on the layer does: paint, rub out, take a colour, or fill. -->
        <views:FoldingGroup Icon="fluent:paint_brush" Title="{loc:Str Images.Paint.ToolHeader}"
                            IsOpen="{Binding DataContext.Folds[PaintTool], RelativeSource={RelativeSource AncestorType=views:ImageEditView}}"
                            AutomationProperties.AutomationId="Image_GroupPaintTool">
            <StackPanel>
                <Border Style="{StaticResource SegGroup}"><StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="PaintTool" Style="{StaticResource SegRadioStyle}" ToolTip="{loc:Str Images.Paint.BrushTip}"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Brush}" AutomationProperties.AutomationId="Image_PaintBrush" AutomationProperties.Name="{loc:Str Images.Paint.Brush}">
                        <icons:IconLabel Icon="fluent:paint_brush"/>
                    </RadioButton>
                    <RadioButton GroupName="PaintTool" Style="{StaticResource SegRadioStyle}" ToolTip="{loc:Str Images.Paint.EraserTip}"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Eraser}" AutomationProperties.AutomationId="Image_PaintEraser" AutomationProperties.Name="{loc:Str Images.Paint.Eraser}">
                        <icons:IconLabel Icon="fluent:eraser"/>
                    </RadioButton>
                    <RadioButton GroupName="PaintTool" Style="{StaticResource SegRadioStyle}" ToolTip="{loc:Str Images.Paint.EyedropperTip}"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Eyedropper}" AutomationProperties.AutomationId="Image_PaintEyedropper" AutomationProperties.Name="{loc:Str Images.Paint.Eyedropper}">
                        <icons:IconLabel Icon="fluent:eyedropper"/>
                    </RadioButton>
                    <RadioButton GroupName="PaintTool" Style="{StaticResource SegRadioStyle}" ToolTip="{loc:Str Images.Paint.FillTip}"
                                 IsChecked="{Binding Tool, Converter={StaticResource EnumToBool}, ConverterParameter=Fill}" AutomationProperties.AutomationId="Image_PaintFill" AutomationProperties.Name="{loc:Str Images.Paint.Fill}">
                        <icons:IconLabel Icon="fluent:paint_bucket"/>
                    </RadioButton>
                </StackPanel></Border>
                <ToggleButton Style="{StaticResource RowSwitch}" Content="{loc:Str Images.Paint.SampleMerged}" IsChecked="{Binding SampleMerged, Mode=TwoWay}" Margin="0,6,0,0"
                              Visibility="{Binding IsEyedropper, Converter={StaticResource BoolVis}}"
                              AutomationProperties.AutomationId="Image_PaintSampleMerged"/>
            </StackPanel>
        </views:FoldingGroup>

        <!-- The colour painted — in a 32-bit picture, brighter than white by stops of intensity. -->
        <views:FoldingGroup Icon="fluent:color" Title="{loc:Str Images.Paint.Colour}"
                            IsOpen="{Binding DataContext.Folds[PaintColour], RelativeSource={RelativeSource AncestorType=views:ImageEditView}}"
                            AutomationProperties.AutomationId="Image_GroupPaintColour">
            <StackPanel>
                <vcc:ColorPicker AutomationPrefix="Image_PaintColour" AllowDefault="False" Value="{Binding Colour, Mode=TwoWay}"/>
                <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Paint.Intensity}" ValueFormat="+0.0;−0.0;0" Margin="0,6,0,2"
                                        Minimum="-4" Maximum="10" SmallChange="0.1" LargeChange="1" DefaultValue="0"
                                        Value="{Binding Intensity, Mode=TwoWay}" AutomationProperties.AutomationId="Image_PaintIntensity"
                                        Visibility="{Binding PaintsLight, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </views:FoldingGroup>

        <!-- The tip a brush or the eraser lays down, and how a pen's pressure moves it. -->
        <views:FoldingGroup Icon="fluent:paint_brush_sparkle" Title="{loc:Str Images.Paint.BrushHeader}"
                            IsOpen="{Binding DataContext.Folds[PaintBrush], RelativeSource={RelativeSource AncestorType=views:ImageEditView}}"
                            Visibility="{Binding PaintsWithTip, Converter={StaticResource BoolVis}}"
                            AutomationProperties.AutomationId="Image_GroupPaintBrush">
            <StackPanel>
                <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Paint.Size}" ValueFormat="0' px'"
                                        Minimum="1" Maximum="500" SmallChange="1" LargeChange="10" DefaultValue="24"
                                        Value="{Binding Size, Mode=TwoWay}" AutomationProperties.AutomationId="Image_PaintSize"/>
                <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Paint.Hardness}" ValueFormat="0'%'"
                                        Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" DefaultValue="80"
                                        Value="{Binding Hardness, Mode=TwoWay}" AutomationProperties.AutomationId="Image_PaintHardness"/>
                <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Paint.Opacity}" ValueFormat="0'%'"
                                        Minimum="1" Maximum="100" SmallChange="1" LargeChange="10" DefaultValue="100"
                                        Value="{Binding Opacity, Mode=TwoWay}" AutomationProperties.AutomationId="Image_PaintOpacity"/>
                <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Paint.Flow}" ValueFormat="0'%'"
                                        Minimum="1" Maximum="100" SmallChange="1" LargeChange="10" DefaultValue="100"
                                        Value="{Binding Flow, Mode=TwoWay}" AutomationProperties.AutomationId="Image_PaintFlow"/>

            </StackPanel>
        </views:FoldingGroup>

        <!-- How far a fill reaches from the press. -->
        <views:FoldingGroup Icon="fluent:paint_bucket" Title="{loc:Str Images.Paint.FillHeader}"
                            IsOpen="{Binding DataContext.Folds[PaintFill], RelativeSource={RelativeSource AncestorType=views:ImageEditView}}"
                            Visibility="{Binding IsFill, Converter={StaticResource BoolVis}}"
                            AutomationProperties.AutomationId="Image_GroupPaintFill">
            <StackPanel>
                <views:AdjustmentSlider Style="{StaticResource EditSliderRow}" Label="{loc:Str Images.Paint.Tolerance}"
                                        Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" DefaultValue="32"
                                        Value="{Binding Tolerance, Mode=TwoWay}" AutomationProperties.AutomationId="Image_PaintTolerance"/>
                <ToggleButton Style="{StaticResource RowSwitch}" Content="{loc:Str Images.Paint.Contiguous}" IsChecked="{Binding Contiguous, Mode=TwoWay}"
                              AutomationProperties.AutomationId="Image_PaintContiguous"/>
            </StackPanel>
        </views:FoldingGroup>
</StackPanel>
</UserControl>
