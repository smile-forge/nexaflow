<UserControl x:Class="Nexaflow.Features.Images.Views.ImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.Images.ViewModels"
             xmlns:views="clr-namespace:Nexaflow.Features.Images.Views"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:vcl="clr-namespace:Nexaflow.Visuals.Common.Layout;assembly=Nexaflow.Visuals.Common"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Controls;assembly=Nexaflow.Visuals.Common"
             xmlns:pages="clr-namespace:Nexaflow.Visuals.Text.Pages;assembly=Nexaflow.Visuals.Text"
             xmlns:drafts="clr-namespace:Nexaflow.Visuals.Common.Drafts;assembly=Nexaflow.Visuals.Common"
             xmlns:icons="clr-namespace:Nexaflow.Visuals.Icons;assembly=Nexaflow.Visuals.Icons"
             AutomationProperties.AutomationId="ImageView"
             Focusable="True"
             KeyDown="OnViewKeyDown"
             Background="{StaticResource BgBrush}"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ImageViewStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <cv:EnumToBoolConverter x:Key="EnumToBool"/>
            <cv:NullToCollapsedConverter x:Key="NullToCollapsed"/>

            <Style x:Key="NavArrowStyle" TargetType="Button">
                <Setter Property="Background" Value="#55000000"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="36"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#99000000"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Right-click → Copy / Delete menus (defined before the templates that reference them, so the
                 top-down StaticResource lookup can resolve them). -->
            <ContextMenu x:Key="ThumbPictureMenu" x:Shared="False">
                <MenuItem Header="{loc:Str Images.Menu.Copy}"
                          Command="{Binding PlacementTarget.Tag.CopyPictureCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext.Index, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="{loc:Str Images.Menu.Delete}"
                          Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext.Index, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            </ContextMenu>
            <ContextMenu x:Key="CurrentPictureMenu" x:Shared="False">
                <MenuItem Header="{loc:Str Images.Menu.Copy}"
                          Command="{Binding PlacementTarget.DataContext.CopyPictureCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext.CurrentIndex, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                <Separator/>
                <MenuItem Header="{loc:Str Images.Menu.Delete}"
                          Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                          CommandParameter="{Binding PlacementTarget.DataContext.CurrentIndex, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            </ContextMenu>

            <!-- Shared thumbnail card (album / explore / collage). Size & placement are set by each view's
                 ItemContainerStyle; the card fills its container. Accent border on hover or when selected. -->
            <DataTemplate x:Key="ThumbCard" DataType="{x:Type vm:ImageThumbItem}">
                <Border Cursor="Hand" BorderThickness="1.5" CornerRadius="4" ToolTip="{Binding FileName}"
                        ContextMenu="{StaticResource ThumbPictureMenu}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding FileName}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="6,4"/>
                        <Grid Margin="6,6,6,2">
                            <TextBlock Text="🖼" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <!-- Collage card: thinner border, no name section (name shows on hover via the tooltip). -->
            <DataTemplate x:Key="CollageCard" DataType="{x:Type vm:ImageThumbItem}">
                <Border Cursor="Hand" BorderThickness="1" CornerRadius="3" ToolTip="{Binding FileName}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.4" Color="Black"/>
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <!-- Card hugs the image: a square placeholder until it loads, then the image at its
                         own aspect ratio (fixed height, width follows) so there's no padding around it. -->
                    <Grid>
                        <Border Width="150" Height="150" Background="{StaticResource Surface2Brush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="🖼" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                        </Border>
                        <Image Source="{Binding Thumbnail}" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Floating image-tools toolbar (rotate / flip / scale), shared by the carousel and explore panes.
                 Hosted on a Control so it inherits the view-model DataContext; empty areas stay click-through.
                 A turn or a flip is an edit: it is remembered with the photo, and undone with Ctrl+Z. -->
            <ControlTemplate x:Key="ImageToolsTemplate" TargetType="Control">
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Panel.ZIndex="10"
                        Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.4" Color="Black"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" Margin="3">
                        <Button Command="{Binding RotateLeftCommand}" ToolTip="{loc:Str Images.Tools.RotateLeft}" Style="{StaticResource FloatingToolButtonStyle}"
                                AutomationProperties.AutomationId="Image_RotateLeft">
                            <Grid Width="15" Height="15">
                                <Path Data="M 7,1 A 6,6 0 1 0 13,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" StrokeEndLineCap="Round"/>
                                <Path Data="M 13,4 L 13,7 L 10,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding RotateRightCommand}" ToolTip="{loc:Str Images.Tools.RotateRight}" Style="{StaticResource FloatingToolButtonStyle}"
                                AutomationProperties.AutomationId="Image_RotateRight">
                            <Grid Width="15" Height="15">
                                <Path Data="M 7,1 A 6,6 0 1 1 1,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" StrokeEndLineCap="Round"/>
                                <Path Data="M 1,4 L 1,7 L 4,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding FlipHorizontalCommand}" ToolTip="{loc:Str Images.Tools.FlipHorizontal}" Style="{StaticResource FloatingToolButtonStyle}"
                                AutomationProperties.AutomationId="Image_FlipHorizontal">
                            <!-- Two triangles mirrored about a dashed vertical axis. -->
                            <Grid Width="15" Height="15">
                                <Path Data="M 7.5,1 L 7.5,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" StrokeDashArray="2 1.5"/>
                                <Path Data="M 5.5,3 L 1,11 L 5.5,11 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" Fill="Transparent"/>
                                <Path Data="M 9.5,3 L 14,11 L 9.5,11 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding FlipVerticalCommand}" ToolTip="{loc:Str Images.Tools.FlipVertical}" Style="{StaticResource FloatingToolButtonStyle}"
                                AutomationProperties.AutomationId="Image_FlipVertical">
                            <!-- The same, mirrored about a horizontal axis. -->
                            <Grid Width="15" Height="15">
                                <Path Data="M 1,7.5 L 14,7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" StrokeDashArray="2 1.5"/>
                                <Path Data="M 3,5.5 L 11,1 L 11,5.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" Fill="Transparent"/>
                                <Path Data="M 3,9.5 L 11,14 L 11,9.5 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding ToggleFitCommand}" ToolTip="{loc:Str Images.Tools.ToggleFit}" Style="{StaticResource FloatingToolButtonStyle}"
                                AutomationProperties.AutomationId="Image_FitMode">
                            <Grid Width="15" Height="15">
                                <Path Data="M 6.5,1 A 5.5,5.5 0 1 0 6.5,12 A 5.5,5.5 0 1 0 6.5,1  M 10.5,10.5 L 14,14"
                                      StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{StaticResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FitToWindow}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </ControlTemplate>

            <!-- The featured image, fitted or at actual size, with a note while it cannot be shown. Shared by the
                 carousel and the explore pane. -->
            <ControlTemplate x:Key="FeaturedImageTemplate" TargetType="Control">
                <Grid>
                    <!-- Fit-to-window -->
                    <Grid Margin="20">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FitToWindow}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="2">
                            <Border.Effect>
                                <!-- Glow matches the accent border around the image, so it follows the theme. -->
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="{DynamicResource AccentColor}"/>
                            </Border.Effect>
                            <Viewbox Stretch="Uniform" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}">
                                <Image Source="{Binding CurrentImage}" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <!-- Actual size (scrollable) -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgBrush}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FitToWindow}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <Border Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="2">
                            <Border.Effect>
                                <!-- Glow matches the accent border around the image, so it follows the theme. -->
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="{DynamicResource AccentColor}"/>
                            </Border.Effect>
                            <Image Source="{Binding CurrentImage}" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </ScrollViewer>

                    <TextBlock Text="{loc:Str Images.LoadFailed}" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding LoadFailed, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Top toolbar ══ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- Details: what the picture's file says about it, in a panel on the left (I) — browsing and editing alike -->
                    <ToggleButton IsChecked="{Binding Details.IsOpen, Mode=TwoWay}" ToolTip="{loc:Str Images.Details.Tip}" Style="{StaticResource ToolbarToggleStyle}" Margin="0,0,8,0"
                                  AutomationProperties.AutomationId="Image_Details" AutomationProperties.Name="{loc:Str Images.Details.Title}">
                        <StackPanel Orientation="Horizontal">
                            <icons:IconGlyph Icon="fluent:info" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Str Images.Details.Title}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Sub-view selector (browsing only) -->
                    <Border x:Name="SubViewSelector" VerticalAlignment="Center"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding ShowsSubViewSelector, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="ImageSubView" Style="{StaticResource SegRadioStyle}" ToolTip="{loc:Str Images.Toolbar.CarouselTip}"
                                         AutomationProperties.AutomationId="Image_ViewCarousel"
                                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Carousel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▣" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Str Images.Toolbar.Carousel}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <Border Style="{StaticResource SegDivider}"/>
                            <RadioButton GroupName="ImageSubView" Style="{StaticResource SegRadioStyle}" ToolTip="{loc:Str Images.Toolbar.AlbumTip}"
                                         AutomationProperties.AutomationId="Image_ViewAlbum"
                                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Album}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Str Images.Toolbar.Album}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <Border Style="{StaticResource SegDivider}"/>
                            <RadioButton GroupName="ImageSubView" Style="{StaticResource SegRadioStyle}" ToolTip="{loc:Str Images.Toolbar.ExploreTip}"
                                         AutomationProperties.AutomationId="Image_ViewExplore"
                                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Explore}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="◫" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Str Images.Toolbar.Explore}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <Border Style="{StaticResource SegDivider}"/>
                            <RadioButton GroupName="ImageSubView" Style="{StaticResource SegRadioStyle}" ToolTip="{loc:Str Images.Toolbar.CollageTip}"
                                         AutomationProperties.AutomationId="Image_ViewCollage"
                                         IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Collage}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❖" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Str Images.Toolbar.Collage}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- A mark when the shown photo carries edits; its name is the tab's and the breadcrumb's -->
                <Border Padding="6,1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Surface2Brush}"
                        ToolTip="{loc:Str Images.Edit.EditedTip}"
                        Visibility="{Binding ShowsEditedMark, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Str Images.Edit.Edited}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                </Border>

                <!-- Browsing: edit, then the playback controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding EnterEditModeCommand}" ToolTip="{loc:Str Images.Toolbar.EditTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="Image_EditMode">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✎" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Str Images.Toolbar.Edit}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Make a video from this picture: enabled where the workspace has a model that carries a picture on, and saying how to
                         enable it where it has none -->
                    <Grid Margin="0,0,8,0">
                        <Button x:Name="MakeVideoButton" Command="{Binding MakeVideo.OpenCommand}" ToolTip="{loc:Str Images.Toolbar.VideoTip}"
                                vcc:AiAbilityGating.Gate="{Binding MakeVideo}"
                                Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.AutomationId="Image_MakeVideo">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎬" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Str Images.Toolbar.Video}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Popup IsOpen="{Binding MakeVideo.IsOpen, Mode=TwoWay}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=MakeVideoButton}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,6,0,0" Padding="14,12" Width="340"
                                    DataContext="{Binding MakeVideo}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Str Images.MakeVideo.Heading}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{loc:Str Images.MakeVideo.WhatHappens}" FontSize="11" Margin="0,10,0,4" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"
                                             AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.AutomationId="Image_MakeVideoDescription"
                                             AutomationProperties.Name="{loc:Str Images.MakeVideo.WhatHappens}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Str Images.MakeVideo.Length}" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}"/>
                                            <ComboBox ItemsSource="{Binding Lengths}" SelectedItem="{Binding Length, Mode=TwoWay}" DisplayMemberPath="Label"
                                                      Style="{StaticResource DarkComboBox}" MinWidth="110"
                                                      AutomationProperties.AutomationId="Image_MakeVideoLength"
                                                      AutomationProperties.Name="{loc:Str Images.MakeVideo.Length}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock Text="{loc:Str Images.MakeVideo.Shape}" FontSize="11" Margin="0,0,0,4" Foreground="{StaticResource TextMutedBrush}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="{loc:Str Images.MakeVideo.Landscape}" IsChecked="{Binding Landscape, Mode=TwoWay}"
                                                             GroupName="MakeVideoShape" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                                             AutomationProperties.AutomationId="Image_MakeVideoLandscape"/>
                                                <RadioButton Content="{loc:Str Images.MakeVideo.Portrait}" IsChecked="{Binding Portrait, Mode=TwoWay}"
                                                             GroupName="MakeVideoShape" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                             AutomationProperties.AutomationId="Image_MakeVideoPortrait"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{loc:Str Images.MakeVideo.Note}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button Content="{loc:Str Images.MakeVideo.Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource ToolbarButtonStyle}"
                                                AutomationProperties.AutomationId="Image_MakeVideoCancel"/>
                                        <Button Content="{loc:Str Images.MakeVideo.Make}" Command="{Binding MakeCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="8,0,0,0"
                                                AutomationProperties.AutomationId="Image_MakeVideoStart"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <!-- Convert the picture, as a page of writing, to Markdown: shown where it is a page, or before page reading is here to tell -->
                    <Button Command="{Binding ReadPage.ConvertCommand}" ToolTip="{loc:Str Images.Toolbar.ConvertToMarkdownTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,8,0"
                            Visibility="{Binding ReadPage.CanRead, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="Image_ConvertToMarkdown">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="¶" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Str Images.Toolbar.ConvertToMarkdown}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ToggleButton IsChecked="{Binding IsAuto, Mode=TwoWay}" ToolTip="{loc:Str Images.Toolbar.AutoTip}" Style="{StaticResource ToolbarToggleStyle}" Visibility="{Binding HasMultiple, Converter={StaticResource BoolToVis}}"
                                  AutomationProperties.AutomationId="Image_AutoAdvance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Str Images.Toolbar.Auto}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,8,0" Visibility="{Binding HasMultiple, Converter={StaticResource BoolToVis}}">
                        <Slider Width="92" Minimum="0" Maximum="2" Value="{Binding AutoSpeed, Mode=TwoWay}"
                                IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="None"
                                SmallChange="1" LargeChange="1" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="Image_AutoSpeed"
                                ToolTip="{loc:Str Images.Toolbar.SpeedTip}"/>
                        <TextBlock Text="{Binding AutoSpeedLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Width="46" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Command="{Binding EnterFullScreenCommand}" ToolTip="{loc:Str Images.Toolbar.FullScreenTip}" Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.AutomationId="Image_FullScreen">
                        <!-- Distinct from the fit/scale glyph: two diagonal arrows expanding outward. -->
                        <Grid Width="15" Height="15">
                            <Path Data="M 6,2 L 2,2 L 2,6  M 2,2 L 7,7  M 9,13 L 13,13 L 13,9  M 13,13 L 8,8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Editing: history, compare, revert, save, done -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding UndoEditCommand}" ToolTip="{loc:Str Images.Edit.UndoTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,0"
                            AutomationProperties.AutomationId="Image_EditUndo">
                        <TextBlock Text="↶" FontSize="14"/>
                    </Button>
                    <Button Command="{Binding RedoEditCommand}" ToolTip="{loc:Str Images.Edit.RedoTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,10,0"
                            AutomationProperties.AutomationId="Image_EditRedo">
                        <TextBlock Text="↷" FontSize="14"/>
                    </Button>
                    <ToggleButton IsChecked="{Binding Editor.ShowOriginal, Mode=TwoWay}" ToolTip="{loc:Str Images.Edit.CompareTip}" Style="{StaticResource ToolbarToggleStyle}" Margin="0,0,4,0"
                                  AutomationProperties.AutomationId="Image_EditCompare">
                        <TextBlock Text="{loc:Str Images.Edit.Compare}"/>
                    </ToggleButton>
                    <Button Command="{Binding RevertEditsCommand}" ToolTip="{loc:Str Images.Edit.RevertTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,10,0"
                            AutomationProperties.AutomationId="Image_EditRevert">
                        <TextBlock Text="{loc:Str Images.Edit.Revert}"/>
                    </Button>
                    <Button Command="{Binding Editor.SaveCommand}" ToolTip="{loc:Str Images.Edit.SaveTip}" Style="{StaticResource ToolbarPrimaryButtonStyle}" Margin="0,0,4,0"
                            AutomationProperties.AutomationId="Image_EditSave">
                        <TextBlock Text="{loc:Str Images.Edit.Save}"/>
                    </Button>
                    <Button Command="{Binding Editor.SaveCopyCommand}" ToolTip="{loc:Str Images.Edit.SaveCopyTip}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,4,0"
                            AutomationProperties.AutomationId="Image_EditSaveCopy">
                        <TextBlock Text="{loc:Str Images.Edit.SaveCopy}"/>
                    </Button>
                    <!-- Save options: what a save keeps and the quality it writes — decided where saving is, not among the tools -->
                    <Grid Margin="0,0,10,0">
                        <Button x:Name="SaveOptionsButton" Command="{Binding Editor.OpenSaveOptionsCommand}" ToolTip="{loc:Str Images.Edit.SaveOptions.Tip}"
                                Style="{StaticResource ToolbarButtonStyle}"
                                AutomationProperties.AutomationId="Image_EditSaveOptions" AutomationProperties.Name="{loc:Str Images.Edit.SaveOptions.Title}">
                            <Grid>
                                <icons:IconGlyph Icon="fluent:settings" FontSize="14"/>
                                <!-- What Save will not do is said inside: marked here so it is not missed. -->
                                <Ellipse Width="6" Height="6" Fill="{StaticResource WarningBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-5,0"
                                         Visibility="{Binding Editor.SaveNote, Converter={StaticResource NullToCollapsed}}"/>
                            </Grid>
                        </Button>
                        <Popup IsOpen="{Binding Editor.IsSaveOptionsOpen, Mode=TwoWay}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=SaveOptionsButton}" Placement="Bottom"
                               AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Margin="0,6,0,0" Padding="14,0,14,14" Width="320"
                                    Thumb.DragStarted="SaveOptions_DragStarted" Thumb.DragCompleted="SaveOptions_DragCompleted">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EditPanelTitle}" Text="{loc:Str Images.Edit.SaveOptions.Title}"/>
                                    <TextBlock Style="{StaticResource EditCaption}" Text="{loc:Str Images.Edit.Export.Hint}"/>

                                    <TextBlock Style="{StaticResource EditSectionHeader}" Text="{loc:Str Images.Edit.Export.MetadataHeader}"/>
                                    <CheckBox Style="{StaticResource EditCheckBox}" IsChecked="{Binding Editor.StripMetadata, Mode=TwoWay}"
                                              Content="{loc:Str Images.Edit.Export.Strip}" AutomationProperties.AutomationId="Image_EditStripMetadata"/>
                                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,4,0,0" Text="{loc:Str Images.Edit.Export.StripHint}"/>

                                    <TextBlock Style="{StaticResource EditSectionHeader}" Text="{loc:Str Images.Edit.Export.Quality}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <views:AdjustmentSlider Minimum="50" Maximum="100" SmallChange="1" LargeChange="5" DefaultValue="92" VerticalAlignment="Center"
                                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                                Value="{Binding Editor.Quality, Mode=TwoWay}" AutomationProperties.AutomationId="Image_EditQuality"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource EditCaption}" Margin="8,0,0,0" Text="{Binding Editor.Quality}"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,4,0,0" Text="{loc:Str Images.Edit.Export.QualityHint}"/>

                                    <TextBlock Style="{StaticResource EditCaption}" Margin="0,14,0,0" Foreground="{StaticResource WarningBrush}"
                                               Text="{Binding Editor.SaveNote}" Visibility="{Binding Editor.SaveNote, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Command="{Binding ExitEditModeCommand}" ToolTip="{loc:Str Images.Edit.DoneTip}" Style="{StaticResource ToolbarButtonStyle}"
                            AutomationProperties.AutomationId="Image_EditDone">
                        <TextBlock Text="{loc:Str Images.Edit.Done}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Recipe notices ══ -->
        <StackPanel Grid.Row="1">
            <!-- A picture made for the user and not saved yet: its Save as. -->
            <drafts:DraftBanner DataContext="{Binding Draft}"/>
            <!-- The photo changed since its edits were made. -->
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding HasChangedSourceNotice, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding KeepChangedEditsCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0"
                                AutomationProperties.AutomationId="Image_EditKeepChanged">
                            <TextBlock Text="{loc:Str Images.Edit.Notice.Keep}"/>
                        </Button>
                        <Button Command="{Binding DiscardChangedEditsCommand}" Style="{StaticResource ToolbarButtonStyle}"
                                AutomationProperties.AutomationId="Image_EditDiscardChanged">
                            <TextBlock Text="{loc:Str Images.Edit.Notice.Discard}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{loc:Str Images.Edit.Notice.SourceChanged}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <!-- Edits that last only for the session. -->
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding ShowsSessionOnlyNotice, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SessionOnlyNotice}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
            </Border>
            <!-- The photo's AI enhance: being made, waiting on the picture tools, or why it shows as it was. -->
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding Restorer.HasNotice, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding Restorer.ActCommand}" Style="{StaticResource ToolbarButtonStyle}"
                                Visibility="{Binding Restorer.HasAction, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="Image_RestoreAction" AutomationProperties.Name="{Binding Restorer.ActionLabel}">
                            <TextBlock Text="{Binding Restorer.ActionLabel}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding Restorer.Notice}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <!-- The photo's erasing: being made, waiting on a tool, or why the photo shows as it is. -->
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding Eraser.HasNotice, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding Eraser.ActCommand}" Style="{StaticResource ToolbarButtonStyle}"
                                Visibility="{Binding Eraser.HasAction, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="Image_EraseAction" AutomationProperties.Name="{Binding Eraser.ActionLabel}">
                            <TextBlock Text="{Binding Eraser.ActionLabel}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding Eraser.Notice}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- The photo's removed background: being made, waiting on picture selection, or why it shows whole. -->
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding Remover.HasNotice, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding Remover.ActCommand}" Style="{StaticResource ToolbarButtonStyle}"
                                Visibility="{Binding Remover.HasAction, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.AutomationId="Image_RemoveBackgroundAction" AutomationProperties.Name="{Binding Remover.ActionLabel}">
                            <TextBlock Text="{Binding Remover.ActionLabel}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding Remover.Notice}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <!-- The open panel's tools wait for models not here yet: their download, offered once. -->
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding Editor.PickingModels.ShowsOffer, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding Editor.PickingModels.DownloadCommand}" Style="{StaticResource ToolbarButtonStyle}"
                            Visibility="{Binding Editor.PickingModels.CanDownload, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="Image_PickingModelsDownload" AutomationProperties.Name="{loc:Str Images.Models.Download}">
                        <TextBlock Text="{loc:Str Images.Models.Download}"/>
                    </Button>
                    <TextBlock Text="{Binding Editor.PickingModels.Notice}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding Editor.ErasingModels.ShowsOffer, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding Editor.ErasingModels.DownloadCommand}" Style="{StaticResource ToolbarButtonStyle}"
                            Visibility="{Binding Editor.ErasingModels.CanDownload, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="Image_ErasingModelsDownload" AutomationProperties.Name="{loc:Str Images.Models.Download}">
                        <TextBlock Text="{loc:Str Images.Models.Download}"/>
                    </Button>
                    <TextBlock Text="{Binding Editor.ErasingModels.Notice}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6"
                    Visibility="{Binding Editor.RestoringModels.ShowsOffer, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding Editor.RestoringModels.DownloadCommand}" Style="{StaticResource ToolbarButtonStyle}"
                            Visibility="{Binding Editor.RestoringModels.CanDownload, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="Image_RestoringModelsDownload" AutomationProperties.Name="{loc:Str Images.Models.Download}">
                        <TextBlock Text="{loc:Str Images.Models.Download}"/>
                    </Button>
                    <TextBlock Text="{Binding Editor.RestoringModels.Notice}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <!-- Converting the page to Markdown: how far it has got, its download, or why it could not -->
            <pages:PageConversionBar DataContext="{Binding ReadPage.Conversion}"/>
        </StackPanel>

        <!-- ══ Content: the Details panel on the left when it is open, and exactly one sub-view beside it ══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <views:ImageDetailsPanel DataContext="{Binding Details}" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"/>

            <!-- ── Carousel ── -->
            <Grid x:Name="CarouselSurface" Visibility="{Binding IsCarousel, Converter={StaticResource BoolToVis}}" PreviewMouseWheel="OnPreviewMouseWheel" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="CarouselImageHost" Grid.Row="0" ClipToBounds="True" Background="Transparent"
                      ContextMenu="{StaticResource CurrentPictureMenu}" SizeChanged="ImageHost_SizeChanged" IsVisibleChanged="ImageHost_IsVisibleChanged">
                    <Control Template="{StaticResource FeaturedImageTemplate}" Focusable="False" IsTabStop="False"/>

                    <!-- Prev / Next -->
                    <Button Command="{Binding PreviousCommand}" Style="{StaticResource NavArrowStyle}" ToolTip="{loc:Str Images.Nav.Previous}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="60" Margin="10,0" Visibility="{Binding HasMultiple, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="Image_Previous">
                        <Path Data="M 10 4 L 4 10 L 10 16" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                    </Button>
                    <Button Command="{Binding NextCommand}" Style="{StaticResource NavArrowStyle}" ToolTip="{loc:Str Images.Nav.Next}" HorizontalAlignment="Right" VerticalAlignment="Center" Height="60" Margin="10,0" Visibility="{Binding HasMultiple, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="Image_Next">
                        <Path Data="M 4 4 L 10 10 L 4 16" Stroke="{StaticResource TextBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                    </Button>

                    <!-- Floating image-tools toolbar (rotate / flip / scale) — shared template, top-right of the image -->
                    <Control Template="{StaticResource ImageToolsTemplate}" Focusable="False" IsTabStop="False"/>
                </Grid>

                <!-- Position indicator: a window of ≤20 dots, paged by arrows when there are more -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,14"
                            Visibility="{Binding HasMultiple, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding PageDotsLeftCommand}" Style="{StaticResource ToolbarButtonStyle}" Padding="5,1" Margin="0,0,8,0"
                            ToolTip="{loc:Str Images.Nav.PreviousPage}" Focusable="False"
                            AutomationProperties.AutomationId="Image_DotsPageLeft"
                            Visibility="{Binding CanPageDotsLeft, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="‹" FontSize="13"/>
                    </Button>
                    <ItemsControl ItemsSource="{Binding VisibleDots}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ImageDotItem}">
                            <Button Margin="4,0" Width="10" Height="10" Cursor="Hand" Focusable="False" AutomationProperties.AutomationId="Image_DotJump"
                                    Command="{Binding DataContext.GoToIndexCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Index}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Ellipse x:Name="Dot">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Width" Value="8"/>
                                                    <Setter Property="Height" Value="8"/>
                                                    <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Fill" Value="Transparent"/>
                                                            <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                                            <Setter Property="StrokeThickness" Value="1.5"/>
                                                            <Setter Property="Width" Value="10"/>
                                                            <Setter Property="Height" Value="10"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCurrent}" Value="False"/>
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding PageDotsRightCommand}" Style="{StaticResource ToolbarButtonStyle}" Padding="5,1" Margin="8,0,0,0"
                            ToolTip="{loc:Str Images.Nav.NextPage}" Focusable="False"
                            AutomationProperties.AutomationId="Image_DotsPageRight"
                            Visibility="{Binding CanPageDotsRight, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="›" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── Album ── -->
            <ScrollViewer x:Name="AlbumSurface" Visibility="{Binding IsAlbum, Converter={StaticResource BoolToVis}}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Background="{StaticResource BgBrush}"
                          PreviewMouseLeftButtonUp="ThumbSelect_Click"
                          MouseDoubleClick="AlbumThumb_MouseDoubleClick"
                          Grid.Column="1">
                <ItemsControl ItemsSource="{Binding Thumbnails}" Margin="8" ItemTemplate="{StaticResource ThumbCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Width"  Value="190"/>
                            <Setter Property="Height" Value="200"/>
                            <Setter Property="Margin" Value="6"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── Explore: thumbnail strip (left) + selected image (right) ── -->
            <Grid x:Name="ExploreSurface" Visibility="{Binding IsExplore, Converter={StaticResource BoolToVis}}" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="160"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card size leaves room for the vertical scrollbar so two columns always fit. -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                              PreviewMouseLeftButtonUp="ThumbSelect_Click">
                    <ItemsControl ItemsSource="{Binding Thumbnails}" Margin="6" ItemTemplate="{StaticResource ThumbCard}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Width"  Value="116"/>
                                <Setter Property="Height" Value="116"/>
                                <Setter Property="Margin" Value="5"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </ScrollViewer>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

                <Grid x:Name="ExploreImageHost" Grid.Column="2" ClipToBounds="True" Background="{StaticResource BgBrush}"
                      MouseWheel="ExploreImage_MouseWheel" ContextMenu="{StaticResource CurrentPictureMenu}"
                      SizeChanged="ImageHost_SizeChanged" IsVisibleChanged="ImageHost_IsVisibleChanged">
                    <Control Template="{StaticResource FeaturedImageTemplate}" Focusable="False" IsTabStop="False"/>

                    <!-- Same rotate / flip / scale tools as the carousel, over the selected image -->
                    <Control Template="{StaticResource ImageToolsTemplate}" Focusable="False" IsTabStop="False"/>
                </Grid>
            </Grid>

            <!-- ── Collage: scattered, tilted thumbnails on the shared pan/zoom surface — drag to pan,
                 wheel to zoom about the cursor, zoom chips and a bottom-right overview. ── -->
            <vcl:PanZoomSurface x:Name="CollageSurface"
                                Visibility="{Binding IsCollage, Converter={StaticResource BoolToVis}}"
                                Background="{StaticResource BgBrush}" Focusable="True"
                                ZoomOnPlainWheel="True"
                                MinScale="0.2" MaxScale="5"
                                SizeChanged="Collage_SizeChanged"
                                Grid.Column="1">
                <vcl:PanZoomSurface.SurfaceContent>
                    <ItemsControl ItemsSource="{Binding Thumbnails}"
                                  MouseLeftButtonDown="CollageCard_MouseDown">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <!-- No fixed size: each card sizes to its image (no letterbox padding). -->
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding CollageX}"/>
                                <Setter Property="Canvas.Top"  Value="{Binding CollageY}"/>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="{Binding CollageRotation}"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="CollageCard"/>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </vcl:PanZoomSurface.SurfaceContent>
            </vcl:PanZoomSurface>

            <!-- ── Edit: the photo on an editing canvas, with the tools beside it ── -->
            <views:ImageEditView x:Name="EditSurface" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Grid.Column="1"/>

        </Grid>
    </Grid>
</UserControl>
