<UserControl x:Class="Nexaflow.Features.Images.Views.GenerateImageOptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="Images_GenerateOptions">

    <!-- What Gen Image in the New picker draws: shown between the kinds and the name while it is chosen. -->

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="NotBoolVis"/>
        <cv:CountToVisibilityConverter x:Key="CountVis"/>
        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,8,0,0">
        <!-- No model draws yet: why, and the download of one of Nexaflow's own where one waits on it. -->
        <StackPanel Visibility="{Binding IsReady, Converter={StaticResource NotBoolVis}}">
            <TextBlock Text="{loc:Str Images.Generate.NoModel}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
            <Button Content="{loc:Str Images.Generate.Download}" Command="{Binding DownloadCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Padding="10,4" Visibility="{Binding IsWaiting, Converter={StaticResource BoolVis}}"
                    AutomationProperties.AutomationId="Images_GenerateDownload"/>
        </StackPanel>

        <StackPanel Visibility="{Binding IsReady, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{loc:Str Images.Generate.WhatToDraw}" Style="{StaticResource OptionLabel}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto"
                     AutomationProperties.AutomationId="Images_GeneratePrompt"
                     AutomationProperties.Name="{loc:Str Images.Generate.WhatToDraw}"/>

            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,8,0" Visibility="{Binding Qualities.Count, Converter={StaticResource CountVis}}">
                    <TextBlock Text="{loc:Str Images.Generate.Quality}" Style="{StaticResource OptionLabel}"/>
                    <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding Quality, Mode=TwoWay}" DisplayMemberPath="Label"
                              Style="{StaticResource DarkComboBox}"
                              AutomationProperties.AutomationId="Images_GenerateQuality"
                              AutomationProperties.Name="{loc:Str Images.Generate.Quality}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{loc:Str Images.Generate.Shape}" Style="{StaticResource OptionLabel}"/>
                    <ComboBox ItemsSource="{Binding Aspects}" SelectedItem="{Binding Aspect, Mode=TwoWay}" DisplayMemberPath="Label"
                              Style="{StaticResource DarkComboBox}"
                              AutomationProperties.AutomationId="Images_GenerateShape"
                              AutomationProperties.Name="{loc:Str Images.Generate.Shape}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0" Visibility="{Binding Resolutions.Count, Converter={StaticResource CountVis}}">
                    <TextBlock Text="{loc:Str Images.Generate.Size}" Style="{StaticResource OptionLabel}"/>
                    <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution, Mode=TwoWay}" DisplayMemberPath="Label"
                              Style="{StaticResource DarkComboBox}"
                              AutomationProperties.AutomationId="Images_GenerateSize"
                              AutomationProperties.Name="{loc:Str Images.Generate.Size}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0" Visibility="{Binding Details.Count, Converter={StaticResource CountVis}}">
                    <TextBlock Text="{loc:Str Images.Generate.Detail}" Style="{StaticResource OptionLabel}"/>
                    <ComboBox ItemsSource="{Binding Details}" SelectedItem="{Binding Detail, Mode=TwoWay}" DisplayMemberPath="Label"
                              Style="{StaticResource DarkComboBox}"
                              AutomationProperties.AutomationId="Images_GenerateDetail"
                              AutomationProperties.Name="{loc:Str Images.Generate.Detail}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0" Visibility="{Binding Seeds, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{loc:Str Images.Generate.Seed}" Style="{StaticResource OptionLabel}"/>
                    <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"
                             ToolTip="{loc:Str Images.Generate.SeedTip}"
                             AutomationProperties.AutomationId="Images_GenerateSeed"
                             AutomationProperties.Name="{loc:Str Images.Generate.Seed}"/>
                </StackPanel>
            </UniformGrid>
            <TextBlock Text="{loc:Str Images.Generate.SeedInvalid}" FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}"
                       Visibility="{Binding SeedIsValid, Converter={StaticResource NotBoolVis}}"/>

            <StackPanel Visibility="{Binding Loras.Count, Converter={StaticResource CountVis}}">
                <TextBlock Text="{loc:Str Images.Generate.Lora}" Style="{StaticResource OptionLabel}"/>
                <ComboBox ItemsSource="{Binding Loras}" SelectedItem="{Binding Lora, Mode=TwoWay}" DisplayMemberPath="Label"
                          Style="{StaticResource DarkComboBox}" HorizontalAlignment="Left" MinWidth="200"
                          ToolTip="{loc:Str Images.Generate.LoraTip}"
                          AutomationProperties.AutomationId="Images_GenerateLora"
                          AutomationProperties.Name="{loc:Str Images.Generate.Lora}"/>
                <TextBlock Text="{Binding LoraNote}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <StackPanel Visibility="{Binding NegativePrompts, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{loc:Str Images.Generate.KeepOut}" Style="{StaticResource OptionLabel}"/>
                <TextBox Text="{Binding NegativePrompt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"
                         AutomationProperties.AutomationId="Images_GenerateKeepOut"
                         AutomationProperties.Name="{loc:Str Images.Generate.KeepOut}"/>
            </StackPanel>

            <CheckBox Content="{loc:Str Images.Generate.Transparent}" IsChecked="{Binding TransparentBackground, Mode=TwoWay}"
                      Foreground="{StaticResource TextBrush}" Margin="0,10,0,0"
                      Visibility="{Binding TransparentBackgrounds, Converter={StaticResource BoolVis}}"
                      AutomationProperties.AutomationId="Images_GenerateTransparent"/>

            <TextBlock Text="{loc:Str Images.Generate.Note}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
