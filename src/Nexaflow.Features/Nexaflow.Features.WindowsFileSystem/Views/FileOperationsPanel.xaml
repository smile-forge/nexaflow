<UserControl x:Class="Nexaflow.Features.WindowsFileSystem.Views.FileOperationsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <cv:StringToVisibilityConverter x:Key="TextToVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="NotToVis"/>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="6,2"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RetryButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <!-- Expands and collapses by animating its own height cap; ClipToBounds is what makes the
         contents slide rather than squash. Zero height when idle, so the tree keeps the column. -->
    <Border ClipToBounds="True"
            Background="{DynamicResource SurfaceBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="MaxHeight" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                     To="420" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                     To="0" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseIn"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>

                <!-- ── Header ─────────────────────────────────────────────── -->
                <Grid Margin="8,6,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource RowButton}"
                            Command="{Binding ToggleCollapsedCommand}"
                            Padding="0,0,6,0"
                            AutomationProperties.AutomationId="FileOps_Toggle">
                        <TextBlock FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▾"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter Property="Text" Value="▸"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <TextBlock Grid.Column="1" Text="{Binding Summary}"
                               VerticalAlignment="Center"
                               FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}"/>

                    <Button Grid.Column="2" Content="Stop all"
                            Style="{StaticResource RowButton}"
                            Command="{Binding CancelAllCommand}"
                            AutomationProperties.AutomationId="FileOps_CancelAll"/>
                </Grid>

                <!-- ── Rows ───────────────────────────────────────────────── -->
                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsCollapsed, Converter={StaticResource NotToVis}}">
                    <ItemsControl ItemsSource="{Binding Operations}" Margin="8,0,8,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Status glyph: pulses while the work is live, settles when it stops. -->
                                        <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}"
                                                   Margin="0,0,6,0" FontSize="12"
                                                   VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="PulseSb">
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="1" To="0.45" Duration="0:0:1.2"
                                                                                         AutoReverse="True"
                                                                                         RepeatBehavior="Forever"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="PulseSb"/>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Completed">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Paused">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextBrush}"/>

                                            <ProgressBar Style="{StaticResource NexaProgressBar}"
                                                         Margin="0,4,0,3"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         IsIndeterminate="{Binding IsIndeterminate}"
                                                         AutomationProperties.AutomationId="FileOps_Progress"/>

                                            <TextBlock Text="{Binding Detail}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Visibility="{Binding Detail, Converter={StaticResource TextToVis}}"/>

                                            <TextBlock Text="{Binding CurrentItem}"
                                                       FontSize="10" Opacity="0.75"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Visibility="{Binding CurrentItem, Converter={StaticResource TextToVis}}"/>

                                            <!-- Out of space: nothing has been deleted, and the run is
                                                 waiting to be told whether to carry on. -->
                                            <StackPanel Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,4,0,0">
                                                <TextBlock Text="{Binding PauseDetail}"
                                                           FontSize="10" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource WarningBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Button Content="Try again" Style="{StaticResource RetryButton}"
                                                            Command="{Binding DataContext.RetryCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.AutomationId="FileOps_Retry"/>
                                                    <Button Content="Stop" Style="{StaticResource RowButton}"
                                                            Command="{Binding DataContext.CancelCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Problems}" Margin="0,4,0,0"
                                                          Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap"
                                                                   Margin="0,0,0,2"
                                                                   Foreground="{DynamicResource DangerBrush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="✕"
                                                Style="{StaticResource RowButton}"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.CancelCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Stop this"
                                                AutomationProperties.AutomationId="FileOps_CancelRow"/>

                                        <Button Grid.Column="2" Content="✕"
                                                Style="{StaticResource RowButton}"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.DismissCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Dismiss"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
