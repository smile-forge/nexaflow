<UserControl x:Class="Nexaflow.Features.WindowsFileSystem.Views.FileSystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexaflow.Features.WindowsFileSystem.ViewModels"
             xmlns:conv="clr-namespace:Nexaflow.Features.WindowsFileSystem.Converters"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── GridView column header style ────────────────────────────── -->
        <ControlTemplate x:Key="GvColHeaderPaddingTemplate" TargetType="GridViewColumnHeader">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"/>
        </ControlTemplate>

        <Style x:Key="GvColHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Background"          Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"          Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="BorderBrush"         Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"     Value="0,0,1,1"/>
            <Setter Property="Padding"             Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <!-- Resize gripper — WPF wires PART_HeaderGripper for column drag-resize.
                                 Transparent (the 1px column divider is drawn by the header border). -->
                            <Thumb x:Name="PART_HeaderGripper"
                                   HorizontalAlignment="Right"
                                   Width="8" Margin="0,0,-4,0"
                                   Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Padding role — the filler header at the right edge; swap Template at Style level -->
                <Trigger Property="Role" Value="Padding">
                    <Setter Property="Template" Value="{StaticResource GvColHeaderPaddingTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Sortable column header (shared by all GridView columns) ──── -->
        <!-- DataContext is the column's vm:SortableHeader (Label + sort Key). The whole
             header is clickable — sort is dispatched in code-behind from the
             GridViewColumnHeader.Click event (a Button here would swallow the click). -->
        <DataTemplate x:Key="SortHeaderTemplate" DataType="{x:Type vm:SortableHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Sort glyph, right-aligned: ↕ when inactive, ▲/▼ when this column is sorted. -->
                <TextBlock Grid.Column="1" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Foreground>
                        <MultiBinding Converter="{x:Static conv:SortBrushConverter.Instance}">
                            <Binding Path="DataContext.SortColumn" RelativeSource="{RelativeSource AncestorType=ListView}"/>
                            <Binding Path="Key"/>
                        </MultiBinding>
                    </TextBlock.Foreground>
                    <TextBlock.Text>
                        <MultiBinding Converter="{x:Static conv:SortGlyphConverter.Instance}">
                            <Binding Path="DataContext.SortColumn"    RelativeSource="{RelativeSource AncestorType=ListView}"/>
                            <Binding Path="DataContext.SortAscending" RelativeSource="{RelativeSource AncestorType=ListView}"/>
                            <Binding Path="Key"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- ── ListView item style ─────────────────────────────────────── -->
        <Style x:Key="FileRowStyle" TargetType="ListViewItem">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="Foreground"              Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding"                 Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBg"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="2,1">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick"
                                              Command="{Binding DataContext.OpenEntryCommand,
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <GridViewRowPresenter
                                Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                Content="{TemplateBinding Content}"/>
                        </Border>
											<ControlTemplate.Triggers>
													<DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True">
															<Setter TargetName="RowBg" Property="Background"
																			Value="{StaticResource Surface2Brush}"/>
															<Setter TargetName="RowBg" Property="BorderBrush"
																			Value="{StaticResource AccentBrush}"/>
															<Setter TargetName="RowBg" Property="BorderThickness" Value="1"/>
													</DataTrigger>
													<MultiTrigger>
															<MultiTrigger.Conditions>
																	<Condition Property="IsSelected" Value="False"/>
																	<Condition Property="IsMouseOver" Value="True"/>
															</MultiTrigger.Conditions>
															<Setter TargetName="RowBg" Property="Background"
																			Value="{StaticResource SurfaceBrush}"/>
													</MultiTrigger>
											</ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── TreeView item style ─────────────────────────────────────── -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Padding"    Value="4,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border x:Name="RowBorder"
                                    Grid.Row="0"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Expand chevron -->
                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Width="16" Height="16"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                      RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                  Focusable="False" Style="{x:Null}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Width="16" Height="16" Background="Transparent">
                                                    <Path x:Name="ArrowRight"
                                                          Data="M 6 4 L 10 8 L 6 12"
                                                          Stroke="{StaticResource TextDimBrush}"
                                                          StrokeThickness="1.5" StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Path x:Name="ArrowDown"
                                                          Data="M 4 6 L 8 10 L 12 6"
                                                          Stroke="{StaticResource TextDimBrush}"
                                                          StrokeThickness="1.5" StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ArrowRight" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="ArrowDown"  Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <!-- Header (uses the HierarchicalDataTemplate) -->
                                    <ContentPresenter Grid.Column="1"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <ItemsPresenter Grid.Row="1" x:Name="ItemsHost"
                                            Margin="16,0,0,0" Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="RowBorder" Property="Background"
                                        Value="{StaticResource Surface2Brush}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="1"/>
                            </DataTrigger>
								<MultiDataTrigger>
									<MultiDataTrigger.Conditions>
										<Condition Binding="{Binding IsSelected}" Value="False"/>
										<Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
									</MultiDataTrigger.Conditions>
									<Setter TargetName="RowBorder" Property="Background"
											Value="{StaticResource SurfaceBrush}"/>
								</MultiDataTrigger>
                            <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Tree panel -->
            <ColumnDefinition Width="240" MinWidth="140" MaxWidth="480"/>
            <!-- Splitter -->
            <ColumnDefinition Width="5"/>
            <!-- File list panel -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Left: Directory Tree ──────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{StaticResource FileList.PanelBg}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <TreeView x:Name="DirectoryTree"
                      Background="Transparent"
                      BorderThickness="0"
                      AllowDrop="True"
                      ItemsSource="{Binding TreeRoots}"
                      ItemContainerStyle="{StaticResource TreeItemStyle}"
                      SelectedItemChanged="DirectoryTree_SelectedItemChanged"
                      PreviewMouseRightButtonDown="DirectoryTree_PreviewMouseRightButtonDown"
                      Padding="8"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FileSystemTreeNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Icon area: 18×18, one child visible at a time -->
                            <Grid Width="18" Height="18" Margin="0,0,5,0" VerticalAlignment="Center">

                                <!-- This PC -->
                                <TextBlock Text="💻" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="ThisPc">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Folder -->
                                <TextBlock Text="📁" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- HDD / SSD / Network / CDDVD: 🖴 + color dot -->
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Kind}" Value="Drive"/>
                                                        <Condition Binding="{Binding DriveIconType}" Value="HDD"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Kind}" Value="Drive"/>
                                                        <Condition Binding="{Binding DriveIconType}" Value="SSD"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Kind}" Value="Drive"/>
                                                        <Condition Binding="{Binding DriveIconType}" Value="Network"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Kind}" Value="Drive"/>
                                                        <Condition Binding="{Binding DriveIconType}" Value="CDDVD"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <TextBlock Text="&#x1F5B4;" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="6" Height="6"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#888888"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DriveIconType}" Value="HDD">
                                                        <Setter Property="Fill" Value="#0047AB"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DriveIconType}" Value="SSD">
                                                        <Setter Property="Fill" Value="#002D8A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DriveIconType}" Value="Network">
                                                        <Setter Property="Fill" Value="#00AA44"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>

                                <!-- USB / Removable -->
                                <Viewbox Width="11" Height="15"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox.Style>
                                        <Style TargetType="Viewbox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Kind}" Value="Drive"/>
                                                        <Condition Binding="{Binding DriveIconType}" Value="Removable"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Viewbox.Style>
                                    <Canvas Width="20" Height="22">
                                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Data="M10,3 L10,14 M10,3 L6,7 M10,3 L14,7 M6,7 L6,11 M14,7 L14,11 M6,11 L10,15 L14,11 M10,15 L10,19"/>
                                    </Canvas>
                                </Viewbox>

                                <!-- Drive status badge -->
                                <TextBlock FontSize="7" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DriveStatus}" Value="Loading">
                                                    <Setter Property="Text"       Value="⏳"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DriveStatus}" Value="Unavailable">
                                                    <Setter Property="Text"       Value="✖"/>
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
                <TreeView.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"         Color="Transparent"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"     Color="{StaticResource TextColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                </TreeView.Resources>
            </TreeView>
        </Border>

        <!-- ── Splitter ──────────────────────────────────────────────── -->
        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- ── Right: AI summary + ListView + footer ────────────────── -->
        <Grid Grid.Column="2" x:Name="RightGrid">
            <Grid.ColumnDefinitions>
                <!-- File list + footer -->
                <ColumnDefinition Width="*"/>
                <!-- Action strip -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!-- Viewlet stack: non-full viewlets stacked here; height=Auto -->
                <RowDefinition x:Name="ViewletStackRow" Height="Auto"/>
                <!-- File list: takes all remaining space -->
                <RowDefinition Height="*"/>
                <!-- Footer bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Non-full viewlet stack ──────────────────────────────── -->
            <StackPanel x:Name="ViewletStackPanel"
                        Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Vertical"/>

            <!-- ── Full-viewlet overlay (covers rows 0-3 and both columns) ── -->
            <ContentControl x:Name="FullViewletContent"
                            Grid.Row="0" Grid.Column="0"
                            Grid.RowSpan="3" Grid.ColumnSpan="2"
                            Panel.ZIndex="5"
                            Visibility="Collapsed"/>

            <!-- ── Drive ListView (This PC mode) ───────────────────────── -->
            <ListView Grid.Row="1" Grid.Column="0"
                      x:Name="DriveListView"
                      Visibility="Collapsed"
                      ItemsSource="{Binding Entries}"
                      ItemContainerStyle="{StaticResource FileRowStyle}"
                      Background="{StaticResource BgBrush}"
                      BorderThickness="0"
                      SelectionMode="Extended"
                      SelectionChanged="FileListView_SelectionChanged"
                      PreviewMouseLeftButtonDown="FileListView_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="FileListView_PreviewMouseRightButtonDown"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      Padding="4,4,4,4">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource GvColHeaderStyle}">

                        <!-- Name -->
                        <GridViewColumn Width="300" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                            <GridViewColumn.Header>
                                <vm:SortableHeader Label="Name" Key="Name"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center">

                                            <!-- HDD / SSD / Network / CDDVD: 🖴 + color dot -->
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DriveIconType}" Value="HDD">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DriveIconType}" Value="SSD">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DriveIconType}" Value="Network">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DriveIconType}" Value="CDDVD">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <TextBlock Text="&#x1F5B4;" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Ellipse Width="7" Height="7"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#888888"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DriveIconType}" Value="HDD">
                                                                    <Setter Property="Fill" Value="#0047AB"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DriveIconType}" Value="SSD">
                                                                    <Setter Property="Fill" Value="#002D8A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DriveIconType}" Value="Network">
                                                                    <Setter Property="Fill" Value="#00AA44"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Grid>

                                            <!-- USB / Removable -->
                                            <Viewbox Width="13" Height="17"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Viewbox.Style>
                                                    <Style TargetType="Viewbox">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DriveIconType}" Value="Removable">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Viewbox.Style>
                                                <Canvas Width="20" Height="22">
                                                    <Path Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M10,3 L10,14 M10,3 L6,7 M10,3 L14,7 M6,7 L6,11 M14,7 L14,11 M6,11 L10,15 L14,11 M10,15 L10,19"/>
                                                </Canvas>
                                            </Viewbox>

                                            <!-- Drive status badge -->
                                            <TextBlock FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DriveStatus}" Value="Loading">
                                                                <Setter Property="Text"       Value="⏳"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DriveStatus}" Value="Unavailable">
                                                                <Setter Property="Text"       Value="✖"/>
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Type -->
                        <GridViewColumn Width="90" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                            <GridViewColumn.Header>
                                <vm:SortableHeader Label="Type" Key="TypeLabel"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <TextBlock Text="{Binding TypeLabel}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Filesystem -->
                        <GridViewColumn Width="75">
                            <GridViewColumn.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Filesystem"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </GridViewColumn.HeaderTemplate>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <TextBlock Text="{Binding FileSystem}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Size (wider for drive usage display) -->
                        <GridViewColumn Width="160" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                            <GridViewColumn.Header>
                                <vm:SortableHeader Label="Size" Key="SizeBytes"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <TextBlock Text="{Binding SizeLabel}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>

            <!-- ── File ListView (folder navigation) ────────────────────── -->
            <ListView Grid.Row="1" Grid.Column="0"
                      x:Name="FileListView"
                      ItemsSource="{Binding Entries}"
                      ItemContainerStyle="{StaticResource FileRowStyle}"
                      Background="{StaticResource BgBrush}"
                      BorderThickness="0"
                      AllowDrop="True"
                      SelectionMode="Extended"
                      SelectionChanged="FileListView_SelectionChanged"
                      PreviewMouseLeftButtonDown="FileListView_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="FileListView_PreviewMouseRightButtonDown"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      Padding="4,4,4,4">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource GvColHeaderStyle}">

                        <!-- Name -->
                        <GridViewColumn Width="300" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                            <GridViewColumn.Header>
                                <vm:SortableHeader Label="Name" Key="Name"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <!-- File icon -->
                                            <TextBlock Text="📄" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- Folder icon -->
                                            <TextBlock Text="📁" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Type -->
                        <GridViewColumn Width="90" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                            <GridViewColumn.Header>
                                <vm:SortableHeader Label="Type" Key="TypeLabel"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <TextBlock Text="{Binding TypeLabel}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Size -->
                        <GridViewColumn Width="80" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                            <GridViewColumn.Header>
                                <vm:SortableHeader Label="Size" Key="SizeBytes"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <TextBlock Text="{Binding SizeLabel}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Modified -->
                        <GridViewColumn Width="150" HeaderTemplate="{StaticResource SortHeaderTemplate}">
                            <GridViewColumn.Header>
                                <vm:SortableHeader Label="Modified" Key="Modified"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileSystemEntry}">
                                    <TextBlock Text="{Binding ModifiedLabel}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>
            </ListView>

            <!-- ── Footer bar ────────────────────────────────────────── -->
            <!-- Folder / file counts double as a quick-filter: click to show only that
                 kind, click again to clear. Active filter is shown in the accent colour. -->
            <Border Grid.Row="2" Grid.Column="0"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="10,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionSummary}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="0 items"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding FolderCountText}"
                               FontSize="11" VerticalAlignment="Center" Cursor="Hand"
                               ToolTip="Show only folders"
                               Visibility="{Binding HasFolders, Converter={StaticResource BoolToVis}}"
                               Foreground="{Binding ActiveFilter, Converter={x:Static conv:FilterBrushConverter.Instance}, ConverterParameter=Folders}">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleFolderFilterCommand}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <TextBlock Text=",&#160;&#160;"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding ShowCountSeparator, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding FileCountText}"
                               FontSize="11" VerticalAlignment="Center" Cursor="Hand"
                               ToolTip="Show only files"
                               Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}"
                               Foreground="{Binding ActiveFilter, Converter={x:Static conv:FilterBrushConverter.Instance}, ConverterParameter=Files}">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleFileFilterCommand}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ── File Action Strip ─────────────────────────────────── -->
            <Border x:Name="ActionStrip"
                    Grid.Row="1" Grid.Column="1" Grid.RowSpan="2"
                    Background="{StaticResource FileList.PanelBg}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Width="120"
                    MinWidth="120"
                    MaxWidth="120">
                <Grid>
                    <!-- Scrollable button area -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FileActions}"
                                      Margin="4,6,4,6"
                                      VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Fixed 2-column grid; each cell is exactly 54×58 px -->
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FileActionViewModel}">
                                    <Button Command="{Binding ExecuteCommand}"
                                            ToolTip="{Binding ButtonTooltip}"
                                            Width="54" Height="58"
                                            Margin="1"
                                            Cursor="Hand"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Add to Ribbon"
                                                          Command="{Binding PlacementTarget.Tag.PinFileActionToRibbonCommand,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext,
                                                                                     RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
                                                <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid>
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="4"
                                                                        Padding="2">
                                                                    <StackPanel VerticalAlignment="Center"
                                                                                HorizontalAlignment="Center">
                                                                        <!-- Registry icon image (when available) -->
                                                                        <Image Source="{Binding IconImage}"
                                                                               Width="20" Height="20"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IconImage, Converter={x:Static cv:NullToBoolConverter.Instance}}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>
                                                                        <!-- Emoji / glyph fallback -->
                                                                        <TextBlock Text="{Binding Icon}"
                                                                                   FontSize="18"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IconImage, Converter={x:Static cv:NullToBoolConverter.Instance}}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                   FontSize="9"
                                                                                   HorizontalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   Margin="0,3,0,0"
                                                                                   MaxWidth="48"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <!-- Dim overlay: shown when another button is flashing -->
                                                                <Border x:Name="DimOverlay"
                                                                        Background="#99000000"
                                                                        CornerRadius="4"
                                                                        Visibility="Collapsed"/>
                                                                <!-- Success tick overlay -->
                                                                <Border x:Name="TickOverlay"
                                                                        Background="#CC1A7A3C"
                                                                        CornerRadius="4"
                                                                        Visibility="Collapsed">
                                                                    <TextBlock Text="✔"
                                                                               FontSize="20"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background"
                                                                            Value="{StaticResource Surface2Brush}"/>
                                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                                            Value="{StaticResource AccentBrush}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                                </Trigger>
                                                                <!-- Success flash -->
                                                                <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                                                    <Setter TargetName="TickOverlay" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <!-- Dimmed while sibling flashes -->
                                                                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                                    <Setter TargetName="DimOverlay" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <!-- Destructive: dim red border -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsDestructive}" Value="True"/>
                                                                        <Condition Binding="{Binding ShiftHeld}"     Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                                </MultiDataTrigger>
                                                                <!-- Destructive + Shift: bright red border -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsDestructive}" Value="True"/>
                                                                        <Condition Binding="{Binding ShiftHeld}"     Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                                    <Setter TargetName="Bd" Property="Background"  Value="{StaticResource DangerSubtleBrush}"/>
                                                                </MultiDataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── Input Prompt Overlay (spans entire right pane) ───────────── -->
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
                    Visibility="{Binding InputPromptVisible,
                                 Converter={StaticResource BoolToVis}}"
                    Background="#CC000000"
                    Panel.ZIndex="20">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="320"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding InputPromptTitle}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding InputPromptLabel}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,4"/>
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Margin="0,0,0,12">
                            <TextBox x:Name="InputPromptTextBox"
                                     Text="{Binding InputPromptValue,
                                            UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource Surface2Brush}"
                                     Foreground="{StaticResource TextBrush}"
                                     CaretBrush="{StaticResource TextBrush}"
                                     BorderThickness="0"
                                     FontSize="12"
                                     Padding="8,6"
                                     GotFocus="InputPromptTextBox_GotFocus"
                                     KeyDown="InputPromptTextBox_KeyDown"/>
                        </Border>
                        <Button Content="Rename"
                                Command="{Binding ConfirmInputPromptCommand}"
                                Cursor="Hand"
                                Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
                                    <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0,7"/>
                                    <Setter Property="FontSize"        Value="12"/>
                                    <Setter Property="FontWeight"      Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Cancel"
                                Command="{Binding CancelInputPromptCommand}"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
                                    <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0,7"/>
                                    <Setter Property="FontSize"        Value="12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{StaticResource BorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ── Confirmation Overlay (spans entire right pane) ───────────── -->
            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="2"
                    Visibility="{Binding ConfirmationVisible,
                                 Converter={StaticResource BoolToVis}}"
                    Background="#CC000000"
                    Panel.ZIndex="19">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="320"
                        Padding="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding ConfirmationTitle}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ConfirmationPrompt}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="Confirm"
                                Command="{Binding ConfirmActionCommand}"
                                Cursor="Hand"
                                Margin="0,0,0,6">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="{StaticResource DangerBrush}"/>
                                    <Setter Property="Foreground"      Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0,7"/>
                                    <Setter Property="FontSize"        Value="12"/>
                                    <Setter Property="FontWeight"      Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Cancel"
                                Command="{Binding CancelConfirmationCommand}"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"      Value="{StaticResource Surface2Brush}"/>
                                    <Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0,7"/>
                                    <Setter Property="FontSize"        Value="12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>

        <!-- ── Drop tooltip: follows cursor during drag-over ────────────── -->
        <Popup x:Name="DropTooltipPopup"
               Grid.Column="0" Grid.ColumnSpan="3"
               AllowsTransparency="True"
               Placement="Relative"
               IsOpen="False"
               IsHitTestVisible="False">
            <Border Background="#CC000000"
                    CornerRadius="4"
                    Padding="8,4">
                <TextBlock x:Name="DropTooltipText"
                           Foreground="White"
                           FontSize="12"/>
            </Border>
        </Popup>

    </Grid>

</UserControl>
