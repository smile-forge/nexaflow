<UserControl x:Class="Nexaflow.Features.WindowsFileSystem.Controls.TemplatedCreateEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:local="clr-namespace:Nexaflow.Features.WindowsFileSystem.Controls">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>
    </UserControl.Resources>

    <DockPanel Margin="12">

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                   Text="Define reusable file templates. Pick a source file — it is copied into the app's data folder, so the original can move or be deleted. Each template appears in the file browser's New dialog."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" MinWidth="120"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: template list + add/remove -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="AddTemplateButton" Content="+ Add"
                            MinWidth="56" Margin="0,0,4,0"
                            Style="{StaticResource IconButton}"
                            Click="AddTemplate_Click"/>
                    <Button x:Name="RemoveTemplateButton" Content="✕ Remove"
                            MinWidth="72"
                            Style="{StaticResource IconButton}"
                            Click="RemoveTemplate_Click"/>
                </StackPanel>

                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4">
                    <ListBox x:Name="TemplatesList"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="TemplatesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                        <TextBlock Text="{Binding FileExtension}"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- Right: detail form -->
            <Grid Grid.Column="2" Margin="10,0,0,0">

                <TextBlock Text="Add or select a template on the left."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{Binding HasSelectedTemplate, RelativeSource={RelativeSource AncestorType=UserControl},
                                                Converter={StaticResource InverseBoolVis}}"/>

                <Grid Visibility="{Binding HasSelectedTemplate, RelativeSource={RelativeSource AncestorType=UserControl},
                                          Converter={StaticResource BoolVis}}"
                      DataContext="{Binding SelectedTemplate, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name"
                               Foreground="{StaticResource TextBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,3,4,3"/>
                    <TextBox  x:Name="TemplateNameBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                              Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DarkTextBox}" FontSize="11" Margin="0,3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Icon"
                               Foreground="{StaticResource TextBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,3,4,3"/>
                    <TextBox  x:Name="TemplateIconBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                              Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DarkTextBox}" FontSize="11" Margin="0,3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Extension"
                               Foreground="{StaticResource TextBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,3,4,3"/>
                    <TextBox  x:Name="TemplateExtBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                              Text="{Binding FileExtension, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DarkTextBox}" FontSize="11" Margin="0,3"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Template file"
                               Foreground="{StaticResource TextBrush}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,3,4,3"/>
                    <TextBox  x:Name="TemplateSourceBox" Grid.Row="3" Grid.Column="1"
                              Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DarkTextBox}" FontSize="11" Margin="0,3"/>
                    <Button   Grid.Row="3" Grid.Column="2" Content="…"
                              MinWidth="28" Margin="4,3,0,3"
                              Style="{StaticResource IconButton}"
                              Click="BrowseTemplate_Click"/>

                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                               Margin="0,2,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasStoredTemplate, Converter={StaticResource BoolVis}}"
                               Text="A template file is already stored. Pick a new file only to replace it."/>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
