<UserControl x:Class="Nexaflow.Features.WindowsFileSystem.Controls.ExternalAppsEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:local="clr-namespace:Nexaflow.Features.WindowsFileSystem.Controls">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InverseBoolVis"/>

        <!-- Field label above each input -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Margin"     Value="0,8,0,3"/>
        </Style>

        <!-- Collapsible-section header (chevron flips with IsChecked) -->
        <Style x:Key="SectionToggle" TargetType="ToggleButton">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin"              Value="0,12,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock x:Name="Chev" Text="▸" Margin="0,0,6,0"
                                       Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextBlock.Foreground="{StaticResource AccentBrush}"
                                              TextBlock.FontSize="12" TextBlock.FontWeight="SemiBold"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chev" Property="Text" Value="▾"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Match-rule rows: an ItemsControl (no selection/hover) whose template is a 3-column grid
             with a stretching Pattern field that rings red when the value is invalid for its type. -->
        <Style x:Key="RuleRows" TargetType="ItemsControl">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeName}"
                                      Style="{StaticResource DarkComboBox}" FontSize="11" Margin="0,0,4,0"/>
                            <Border Grid.Column="1" BorderThickness="1.5" CornerRadius="8" Margin="0,0,4,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}" FontSize="11"/>
                            </Border>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Remove rule"
                                    Tag="{Binding}" Click="RemoveCriterion_Click">
                                <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">

        <!-- Top: registry toggle + help icon -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding UseRegistryMapping, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Unchecked="RegistryToggle_Unchecked"/>
                <TextBlock Text="Show Windows-registered handlers (Open with &amp; New menu)"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12" VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           ToolTip="When on, files show their Windows &quot;Open with&quot; apps and the New menu lists Windows file types. Turning it off can import those apps into your External Apps list."/>
            </StackPanel>

            <Border Grid.Column="1"
                    Width="20" Height="20" CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    Cursor="Help">
                <Border.ToolTip>
                    <ToolTip>
                        <StackPanel MaxWidth="360">
                            <TextBlock FontWeight="SemiBold" Text="Template tokens"/>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                <Run Text="#file"/> · filename with extension
                                <LineBreak/>
                                <Run Text="#file[N]"/> · Nth selected file (0-based)
                                <LineBreak/>
                                <Run Text="#filenoext"/> · filename without extension
                                <LineBreak/>
                                <Run Text="#filepath"/> · full path
                                <LineBreak/>
                                <Run Text="#pathonly"/> · containing directory
                                <LineBreak/>
                                <Run Text="%ENVVAR%"/> · environment variable
                            </TextBlock>
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Tip: typing # or % opens an inline picker; Tab or Enter inserts the highlighted option."/>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <TextBlock Text="?" FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" MinWidth="120"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: app list + add/remove -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="+ Add"
                            MinWidth="56" Margin="0,0,4,0"
                            Style="{StaticResource IconButton}"
                            Click="AddApp_Click"/>
                    <Button Content="✕ Remove"
                            MinWidth="72"
                            Style="{StaticResource IconButton}"
                            Click="RemoveApp_Click"/>
                </StackPanel>

                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4">
                    <ListBox x:Name="AppsList"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="AppsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12"/>
                                    <TextBlock Text="{Binding ListLabel}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- Right: detail form -->
            <Grid Grid.Column="2" Margin="10,0,0,0">

                <TextBlock Text="Add or select an external app on the left."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Visibility="{Binding HasSelectedApp, RelativeSource={RelativeSource AncestorType=UserControl},
                                                Converter={StaticResource InverseBoolVis}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasSelectedApp, RelativeSource={RelativeSource AncestorType=UserControl},
                                                   Converter={StaticResource BoolVis}}"
                              DataContext="{Binding SelectedApp, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <StackPanel Margin="0,0,4,0">

                        <!-- Essentials -->
                        <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkTextBox}" FontSize="11"/>

                        <TextBlock Text="Application path" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="…" MinWidth="28" Margin="4,0,0,0"
                                    Style="{StaticResource IconButton}" Click="BrowseAppPath_Click"/>
                            <TextBox Text="{Binding ApplicationPath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" FontSize="11"
                                     local:TokenAutocomplete.IsEnabled="True"/>
                        </DockPanel>

                        <!-- Advanced (collapsed by default) -->
                        <ToggleButton Style="{StaticResource SectionToggle}" Content="Advanced options"
                                      IsChecked="{Binding AdvancedExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <StackPanel Visibility="{Binding AdvancedExpanded, RelativeSource={RelativeSource AncestorType=UserControl},
                                                          Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Arguments" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBox}" FontSize="11"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46"
                                     local:TokenAutocomplete.IsEnabled="True"/>
                            <TextBlock Text="Working directory" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="…" MinWidth="28" Margin="4,0,0,0"
                                        Style="{StaticResource IconButton}" Click="BrowseWorkingDir_Click"/>
                                <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}" FontSize="11"
                                         local:TokenAutocomplete.IsEnabled="True"/>
                            </DockPanel>
                            <TextBlock Text="Icon path" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="…" MinWidth="28" Margin="4,0,0,0"
                                        Style="{StaticResource IconButton}" Click="BrowseIconPath_Click"/>
                                <TextBox Text="{Binding IconPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}" FontSize="11"/>
                            </DockPanel>
                            <TextBlock Text="Multi-file behaviour" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding MultiFileOptions}"
                                      SelectedItem="{Binding MultiFileName, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource DarkComboBox}" FontSize="11"/>
                        </StackPanel>

                        <!-- File matching rules (expanded by default) -->
                        <ToggleButton Style="{StaticResource SectionToggle}" Content="File matching rules"
                                      IsChecked="{Binding RulesExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <StackPanel Visibility="{Binding RulesExpanded, RelativeSource={RelativeSource AncestorType=UserControl},
                                                          Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Opens files matching any of these rules — extension glob (e.g. *.slnx) or full-path glob (e.g. C:\src\**\*.cs)."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,2,0,4"/>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4" MinHeight="120">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Match by" Margin="2,0"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="Pattern" Margin="2,0"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding CriteriaRows}" Style="{StaticResource RuleRows}"/>
                                </DockPanel>
                            </Border>
                            <Button Content="+ Add rule"
                                    HorizontalAlignment="Left" MinWidth="100" Margin="0,6,0,0"
                                    Style="{StaticResource IconButton}"
                                    Click="AddCriterion_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
