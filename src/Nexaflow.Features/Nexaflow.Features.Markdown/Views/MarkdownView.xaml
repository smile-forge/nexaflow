<UserControl x:Class="Nexaflow.Features.Markdown.Views.MarkdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources/>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/> <!-- toolbar   -->
            <RowDefinition Height="*"/> <!-- content   -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             TOOLBAR
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File name -->
                <TextBlock Grid.Column="0"
                           Text="{Binding FileName}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Save button (greyed out when clean) -->
                <Button Grid.Column="1"
                        Style="{StaticResource TbBtn}"
                        ToolTip="Save (Ctrl+S)"
                        Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="Save"  FontSize="12"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             DOCUMENT — single scrollable block list
             ══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScroll"
                      Background="{StaticResource BgBrush}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel x:Name="BlocksPanel"
                        Margin="40,24,40,48"
                        HorizontalAlignment="Stretch"/>
        </ScrollViewer>

    </Grid>
</UserControl>
