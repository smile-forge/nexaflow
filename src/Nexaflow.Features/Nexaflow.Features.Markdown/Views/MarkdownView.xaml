<UserControl x:Class="Nexaflow.Features.Markdown.Views.MarkdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>

        <!-- ── Toolbar button ── -->
        <Style x:Key="TbBtn" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="8,5"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource Surface2Brush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/> <!-- toolbar   -->
            <RowDefinition Height="*"/> <!-- content   -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             TOOLBAR
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File name -->
                <TextBlock Grid.Column="0"
                           Text="{Binding FileName}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Save button (greyed out when clean) -->
                <Button Grid.Column="1"
                        Style="{StaticResource TbBtn}"
                        ToolTip="Save (Ctrl+S)"
                        Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="Save"  FontSize="12"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             DOCUMENT — single scrollable block list
             ══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ContentScroll"
                      Background="{StaticResource BgBrush}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel x:Name="BlocksPanel"
                        Margin="40,24,40,48"
                        HorizontalAlignment="Stretch"/>
        </ScrollViewer>

    </Grid>
</UserControl>
