<UserControl x:Class="Nexaflow.Features.Markdown.Views.MarkdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="clr-namespace:Nexaflow.Visuals.Text.Markdown;assembly=Nexaflow.Visuals.Text"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="MarkdownView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/> <!-- toolbar   -->
            <RowDefinition Height="*"/> <!-- content   -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             TOOLBAR
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File name -->
                <TextBlock Grid.Column="0"
                           Text="{Binding FileName}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Source-only toggle (default off → rendered + inline editing) -->
                <ToggleButton Grid.Column="1"
                              Style="{StaticResource TbToggle}"
                              Margin="0,0,6,0"
                              Content="&lt;/&gt; Source"
                              ToolTip="Edit raw markdown source"
                              AutomationProperties.AutomationId="Markdown_SourceToggle"
                              IsChecked="{Binding SourceOnly, Mode=TwoWay}"/>

                <!-- Save button (greyed out when clean) -->
                <Button Grid.Column="2"
                        Style="{StaticResource TbBtn}"
                        ToolTip="Save (Ctrl+S)"
                        AutomationProperties.AutomationId="Markdown_Save"
                        Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="12" Margin="0,0,4,0"/>
                        <TextBlock Text="Save"  FontSize="12"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             DOCUMENT — two surfaces over the same text, toggled by SourceOnly
             ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Background="{StaticResource BgBrush}">

            <!-- Default: rendered markdown with inline editing -->
            <md:InlineMarkdownEditor x:Name="Editor"
                                     Margin="40,24,40,48"
                                     EditOnDoubleClick="True"
                                     AutomationProperties.AutomationId="Markdown_Editor"
                                     Visibility="{Binding SourceOnly, Converter={StaticResource InvBoolVis}}"
                                     Markdown="{Binding Markdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- Source-only: the whole document as raw markdown -->
            <TextBox x:Name="SourceBox"
                     AutomationProperties.AutomationId="Markdown_SourceBox"
                     Visibility="{Binding SourceOnly, Converter={StaticResource BoolVis}}"
                     Text="{Binding Markdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     SpellCheck.IsEnabled="False"
                     FontFamily="Consolas, Courier New"
                     FontSize="13"
                     Foreground="{StaticResource TextBrush}"
                     Background="{StaticResource DeepBgBrush}"
                     CaretBrush="{StaticResource AccentBrush}"
                     BorderThickness="0"
                     Padding="40,24,40,48"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Grid>

    </Grid>
</UserControl>
