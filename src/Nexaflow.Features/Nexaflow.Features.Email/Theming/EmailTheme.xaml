<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════ Email colour tokens ════
         Shipped as an IThemeContribution so they merge BELOW the active theme (layer 3): every theme gets these
         defaults for free, and any theme may retune a key by name without Core or the feature referencing each other. -->

    <!-- The paper a rich-text (RTF) body is drawn on. Its writer set its colours against white — black text, coloured
         highlights — so it is shown on the page it was written on, whatever the theme round it. -->
    <SolidColorBrush x:Key="Email.RichText.Paper" Color="#FFFFFF"/>

</ResourceDictionary>
