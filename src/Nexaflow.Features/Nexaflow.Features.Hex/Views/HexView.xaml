<UserControl x:Class="Nexaflow.Features.Hex.Views.HexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cv="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             xmlns:ctrl="clr-namespace:Nexaflow.Features.Hex.Controls"
             AutomationProperties.AutomationId="HexView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <cv:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>

        <!-- ── TextBox (Goto) ── -->
        <Style x:Key="GotoBox" TargetType="TextBox">
            <Setter Property="Background"        Value="{StaticResource Surface2Brush}"/>
            <Setter Property="Foreground"        Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily"        Value="Consolas, Courier New"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="Width"             Value="110"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════
             TOOLBAR
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: mode + goto + undo/redo + save -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Edit mode -->
                    <ToggleButton Style="{StaticResource TbToggle}"
                                  IsChecked="{Binding IsReadOnly, Mode=OneWay}"
                                  Command="{Binding SetModeReadOnlyCommand}"
                                  ToolTip="Read-only mode (no edits)">
                        <TextBlock Text="RO" FontSize="11" FontFamily="Consolas"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource TbToggle}"
                                  IsChecked="{Binding IsInsert, Mode=OneWay}"
                                  Command="{Binding SetModeInsertCommand}"
                                  ToolTip="Insert mode (insert bytes at cursor)">
                        <TextBlock Text="INS" FontSize="11" FontFamily="Consolas"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource TbToggle}"
                                  IsChecked="{Binding IsOverwrite, Mode=OneWay}"
                                  Command="{Binding SetModeOverwriteCommand}"
                                  ToolTip="Overwrite mode (replace bytes at cursor)">
                        <TextBlock Text="OVR" FontSize="11" FontFamily="Consolas"/>
                    </ToggleButton>

                    <Separator Style="{StaticResource TbSep}"/>

                    <!-- Goto -->
                    <TextBlock Text="Go to:" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="GotoBox"
                             Style="{StaticResource GotoBox}"
                             Text="{Binding GotoText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Enter hex offset (e.g. 1A2B) and press Enter">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding GotoOffsetCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Style="{StaticResource TbBtn}"
                            Command="{Binding GotoOffsetCommand}"
                            ToolTip="Jump to offset"
                            Margin="2,0">
                        <TextBlock Text="↵" FontSize="12"/>
                    </Button>

                    <Separator Style="{StaticResource TbSep}"/>

                    <!-- Undo / Redo -->
                    <Button Style="{StaticResource TbBtn}"
                            Command="{Binding UndoCommand}"
                            ToolTip="Undo (Ctrl+Z)">
                        <TextBlock Text="↩" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource TbBtn}"
                            Command="{Binding RedoCommand}"
                            ToolTip="Redo (Ctrl+Y)">
                        <TextBlock Text="↪" FontSize="13"/>
                    </Button>

                    <Separator Style="{StaticResource TbSep}"/>

                    <!-- Save split button -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource TbBtn}"
                                Command="{Binding SaveCommand}"
                                Padding="8,5,4,5"
                                ToolTip="Save (Ctrl+S)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="Save" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <ToggleButton x:Name="SaveDropToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource TbToggle}"
                                      IsEnabled="{Binding IsModified}"
                                      Padding="4,5"
                                      ToolTip="Save options">
                            <TextBlock Text="▾" FontSize="9"/>
                            <ToggleButton.Triggers>
                                <!-- Popup closes the toggle when it loses focus -->
                            </ToggleButton.Triggers>
                        </ToggleButton>
                        <Popup x:Name="SavePopup"
                               PlacementTarget="{Binding ElementName=SaveDropToggle}"
                               Placement="Bottom"
                               IsOpen="{Binding IsChecked, ElementName=SaveDropToggle}"
                               StaysOpen="False">
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="2">
                                <StackPanel>
                                    <Button Style="{StaticResource TbBtn}"
                                            Command="{Binding SaveCommand}"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,6">
                                        <TextBlock Text="Save" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource TbBtn}"
                                            Command="{Binding SaveAsCommand}"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,6">
                                        <TextBlock Text="Save As…" FontSize="11"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                </StackPanel>

                <!-- Right: encoding + evaluate pane toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Encoding -->
                    <TextBlock Text="Enc:" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="EncodingCombo"
                              Width="80" FontSize="11"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="Auto"   IsSelected="True"/>
                        <ComboBoxItem Content="ASCII"/>
                        <ComboBoxItem Content="UTF-8"/>
                        <ComboBoxItem Content="UTF-16"/>
                    </ComboBox>

                    <Separator Style="{StaticResource TbSep}"/>

                    <!-- Toggle evaluate pane -->
                    <ToggleButton Style="{StaticResource TbToggle}"
                                  IsChecked="{Binding ShowEvaluatePane}"
                                  Command="{Binding ToggleEvaluatePaneCommand}"
                                  ToolTip="Show/hide text evaluation pane">
                        <TextBlock Text="¶" FontSize="13"/>
                    </ToggleButton>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             CONTENT AREA
             ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- hex panel -->
                <ColumnDefinition Width="*" MinWidth="300"/>
                <!-- splitter (hidden when eval pane is collapsed) -->
                <ColumnDefinition Width="Auto"/>
                <!-- eval pane -->
                <ColumnDefinition x:Name="EvalColumn" Width="200" MinWidth="80"/>
                <!-- scrollbar -->
                <ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>

            <!-- Hex render panel -->
            <ctrl:HexRenderPanel x:Name="HexPanel" Grid.Column="0"/>

            <!-- GridSplitter between hex and eval pane -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Visibility="{Binding ShowEvaluatePane, Converter={StaticResource BoolVis}}"/>

            <!-- Eval pane -->
            <ctrl:EvalRenderPanel x:Name="EvalPanel"
                                  Grid.Column="2"
                                  Visibility="{Binding ShowEvaluatePane, Converter={StaticResource BoolVis}}"/>

            <!-- Shared scrollbar -->
            <ScrollBar x:Name="MainScrollBar"
                       Grid.Column="3"
                       Orientation="Vertical"
                       SmallChange="1"
                       Minimum="0"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════
             STATUS BAR
             ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Size: " FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding FileSizeText}"
                               FontSize="11"
                               Foreground="{StaticResource TextBrush}"
                               FontFamily="Consolas"/>
                    <TextBlock Text="  |  " FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding SelectionText, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding SelectionText}"
                               FontSize="11"
                               Foreground="{StaticResource TextBrush}"
                               FontFamily="Consolas"/>
                </StackPanel>
                <!-- Edit mode indicator on right -->
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontFamily="Consolas"
                           Foreground="{StaticResource AccentBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="READ-ONLY"/>
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EditMode}" Value="Insert">
                                    <Setter Property="Text" Value="INSERT"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EditMode}" Value="Overwrite">
                                    <Setter Property="Text" Value="OVERWRITE"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

    </Grid>
</UserControl>
