<UserControl x:Class="Nexaflow.Features.Model3D.Views.Model3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="http://helix-toolkit.org/wpf"
             xmlns:loc="clr-namespace:Nexaflow.Visuals.Common.Localization;assembly=Nexaflow.Visuals.Common"
             AutomationProperties.AutomationId="Model3DView"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar, full width -->
            <RowDefinition Height="*"/>      <!-- viewport + inspector -->
        </Grid.RowDefinitions>

        <!-- Toolbar (spans the full width; inspector toggle sits on the right) -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource TbToggle}" Content="{loc:Str Model3D.Toolbar.Inspector}"
                              AutomationProperties.AutomationId="Model3D_InspectorToggle"
                              IsChecked="{Binding ShowInspector}" ToolTip="{loc:Str Model3D.Toolbar.InspectorTip}"
                              Visibility="{Binding HasInspectorContent, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource TbToggle}" Content="{loc:Str Model3D.Toolbar.Wireframe}"
                                  AutomationProperties.AutomationId="Model3D_Wireframe"
                                  IsChecked="{Binding ShowWireframe}" ToolTip="{loc:Str Model3D.Toolbar.WireframeTip}"/>
                    <Button Style="{StaticResource TbBtn}" Content="{loc:Str Model3D.Toolbar.ResetView}" Click="OnResetClick"
                            AutomationProperties.AutomationId="Model3D_ResetView"
                            ToolTip="{loc:Str Model3D.Toolbar.ResetViewTip}"/>
                    <TextBlock Text="{loc:Str Model3D.Toolbar.TurnHint}" VerticalAlignment="Center" Margin="10,0,0,0"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content: viewport (+footer) on the left, inspector slides out under the toolbar on the right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Viewport -->
                <Border Grid.Row="0" Background="{DynamicResource Model3D.ViewportBg}">
                    <Grid>
                        <h:HelixViewport3D x:Name="Viewport" Background="Transparent"
                                           ShowViewCube="True" ShowCoordinateSystem="True"
                                           ZoomExtentsWhenLoaded="True">
                            <h:DefaultLights/>
                        </h:HelixViewport3D>

                        <!-- Error overlay -->
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="16,12"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" MaxWidth="360"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Footer: live counts -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FormatName}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding TriangleCount, StringFormat={loc:Str Model3D.Footer.TrianglesFormat}}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding VertexCount, StringFormat={loc:Str Model3D.Footer.VerticesFormat}}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding MeshCount, StringFormat={loc:Str Model3D.Footer.MeshesFormat}}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding FileSizeText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Inspector (materials + unsupported elements) -->
            <Border Grid.Column="1" Width="300" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding ShowInspector, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,12">
                        <TextBlock Text="{loc:Str Model3D.Inspector.Materials}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   Margin="0,0,0,6" Visibility="{Binding HasMaterials, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Materials}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="14" Height="14" CornerRadius="2"
                                                Margin="0,2,8,0" VerticalAlignment="Top"
                                                Background="{Binding Swatch}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVis}}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Str Model3D.Inspector.NotRendered}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="0,16,0,6"
                                   Visibility="{Binding HasUnsupported, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding UnsupportedElements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
