<UserControl x:Class="Nexaflow.Features.Network.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource RegionBrush}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What to run, and the one button -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left"
                    Content="Discover"
                    Padding="18,6"
                    Command="{Binding DiscoverCommand}" />

            <ItemsControl DockPanel.Dock="Left" Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Layers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="0,0,14,0"
                                  Content="{Binding Name}"
                                  ToolTip="{Binding Description}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="{Binding Status}" />

        <!-- What was found. 'Found by' is the column this page exists to show: two independent layers
             agreeing on one device is the graph working, and a device only SSDP saw came from a protocol
             description rather than from compiled code. -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Devices}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Device"   Binding="{Binding Name}"    Width="2*" />
                <DataGridTextColumn Header="Address"  Binding="{Binding Address}" Width="1.5*" />
                <DataGridTextColumn Header="MAC"      Binding="{Binding Mac}"     Width="1.2*" />
                <DataGridTextColumn Header="Found by" Binding="{Binding FoundBy}" Width="1.4*" />
                <DataGridTextColumn Header="Detail"   Binding="{Binding Detail}"  Width="2.5*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- A layer that found nothing has to be able to say why: a refused multicast join on a VPN
             adapter is normal and invisible otherwise. -->
        <ItemsControl Grid.Row="3" Margin="0,10,0,0"
                      ItemsSource="{Binding Log}"
                      MaxHeight="120">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="Consolas" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
