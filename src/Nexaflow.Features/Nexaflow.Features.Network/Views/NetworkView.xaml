<UserControl x:Class="Nexaflow.Features.Network.Views.NetworkView"
             AutomationProperties.AutomationId="NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Nexaflow.Features.Network.Views"
             xmlns:vcc="clr-namespace:Nexaflow.Visuals.Common.Converters;assembly=Nexaflow.Visuals.Common"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <!-- One cell that may hold several addresses, one per line. A device with three IPv6 addresses is
             ordinary, and comma-joining them makes a column nothing can be read out of. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vcc:NullToVisibilityConverter x:Key="NullToVis" />

        <DataTemplate x:Key="AddressCell">
            <TextBlock Text="{Binding}"
                       Foreground="{StaticResource TextBrush}"
                       FontFamily="Consolas"
                       TextWrapping="NoWrap"
                       LineHeight="17" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What to run, and the one button -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource TbBtn}"
                    AutomationProperties.AutomationId="Net_Discover"
                    Content="Discover"
                    Padding="16,6"
                    Command="{Binding DiscoverCommand}" />

            <ItemsControl DockPanel.Dock="Left" Margin="16,0,0,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Layers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0"
                                    ToolTip="{Binding Description}">
                            <ToggleButton Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Name}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="2,0,0,10"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"
                   Text="{Binding Status}" />

        <!-- What was found, and beside it whatever the selection is. 'Found by' is the column this page
             exists to show: two independent layers agreeing on one device is the graph working, and a
             device only SSDP saw came from a protocol description rather than from compiled code. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <!-- Dragged, not fixed: a SERVER banner is a paragraph and a name can be long, so how
                     much room the panel deserves is the reader's call rather than a number here. Bound,
                     because a column holds its width even when its child is collapsed — and a 360-wide
                     band of nothing reads as an empty pane. -->
                <ColumnDefinition Width="{Binding PanelWidth, Mode=TwoWay}" MaxWidth="720" />
            </Grid.ColumnDefinitions>

        <ListView Grid.Column="0"
                  AutomationProperties.AutomationId="Net_Devices"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  PreviewMouseLeftButtonDown="Devices_PreviewMouseLeftButtonDown"
                  ItemsSource="{Binding Devices}"
                  Background="{StaticResource SurfaceBrush}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  ItemContainerStyle="{StaticResource FileListRowStyle}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource GridColumnHeaderStyle}">
                    <GridViewColumn Header="Device" Width="210">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Already fetched, through the guard, during discovery. Binding a
                                         device-supplied URL here would have WPF fetch it directly, which
                                         is the one thing this feature promises does not happen. -->
                                    <Image Source="{Binding Icon}"
                                           Width="20" Height="20"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="IPv4" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding IPv4}"
                                              ItemTemplate="{StaticResource AddressCell}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="IPv6" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding IPv6}"
                                              ItemTemplate="{StaticResource AddressCell}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="MAC" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Mac}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Found by" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FoundBy}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Detail" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- A SERVER banner names an OS, a UPnP version and a product; trimming it
                                     to one line hides the half that says what the device is. -->
                                <TextBlock Text="{Binding Detail}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           MaxWidth="290"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"
                          Visibility="{Binding Selected, Converter={StaticResource NullToVis}}" />

            <v:DevicePanel Grid.Column="2"
                           AutomationProperties.AutomationId="Net_Panel"
                           Visibility="{Binding Selected, Converter={StaticResource NullToVis}}" />
        </Grid>

        <!-- A layer that found nothing has to be able to say why: a refused multicast join on a VPN
             adapter is normal and invisible otherwise. -->
        <ItemsControl Grid.Row="3" Margin="2,10,0,0"
                      ItemsSource="{Binding Log}"
                      MaxHeight="110">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontFamily="Consolas"
                               FontSize="11" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
