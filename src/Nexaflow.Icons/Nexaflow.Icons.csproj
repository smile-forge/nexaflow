<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Icons as names, WPF-free: what an icon is (IconRef — an emoji, or a face of the Fluent UI System Icons font and one of
    its names) and which glyph each Fluent name draws, read from the font's own name map. Nothing here draws: the font
    itself, and the pickers, are Nexaflow.Visuals.Icons'. It sits under anything headless that has to say which glyph an
    icon is — the ribbon's saved layout, and a diagram's stages naming the icon a node is drawn with.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Fluent font's name map (MIT, microsoft/fluentui-system-icons, fonts/), which goes with the font in
         Nexaflow.Visuals.Icons: updating the font is swapping the two files. -->
    <EmbeddedResource Include="FluentSystemIcons-Resizable.json" LogicalName="Nexaflow.Icons.FluentSystemIcons-Resizable.json" />
  </ItemGroup>

</Project>
