<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless entry point for the initiatives backend. Exists so the *same* validation the Product tab runs
    can also run from the installer build and from PowerShell — one implementation, no drift.
    Deliberately depends only on Nexaflow.Services.Initiatives (no WPF, no Core, no features).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Short on purpose: this exe goes on PATH via the installer's optional "command-line tools" feature, so
      it is typed by hand. NOT `ni` — that is a ReadOnly PowerShell alias for New-Item and wins over an
      external command, so `ni find x` would silently create a file in the repo's own documented shell.
    -->
    <AssemblyName>nfi</AssemblyName>
    <RootNamespace>Nexaflow.Services.Initiatives.Cli</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Metadata-only reflection over the built test DLLs for `scan-tests` — never executes them, so a
         net10.0-windows test assembly's WPF/WinRT deps are not loaded into this net10.0 host. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexaflow.Services.Initiatives\Nexaflow.Services.Initiatives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The argument parser (VerbArgs/VerbSpec) is unit-tested — a CLI that silently drops an option is
         how a batch edit loses data. Those tests live in Nexaflow.Tests.Initiatives (the WPF-free suite
         for this backend); Tests.Features.Architecture still reaches in for CliHasNoPrivateGraphTwins. -->
    <InternalsVisibleTo Include="Nexaflow.Tests.Initiatives" />
    <InternalsVisibleTo Include="Nexaflow.Tests.Features.Architecture" />
  </ItemGroup>

  <!--
    Visual Studio's Publish button hands off to tools/publish-graph-cli.ps1 rather than publishing on its own.
    A hand-driven publish of this project is not a smaller version of the script's job, it is a different and
    wrong one: nfi.exe is a framework-dependent apphost — a stub with no code in it — so a profile that lands
    the exe without nfi.dll and the libraries beside it produces something that still runs, as whatever the
    previous build was. That is the worst failure available to a tool whose whole job is telling you when
    something is out of date, and it is what happened. The script is what stops resident daemons, publishes
    win-x64 (a RID-less publish drops ~618 MB of other-platform natives in here), swaps the folder whole, and
    proves the result runs before calling it published.

    Scoped to VS because that is the button being fixed; `dotnet publish` from CI or the installer is left
    alone. NfiPublishingViaScript breaks the recursion — the script's own publish sets it, and this target
    then stands aside so the inner publish is an ordinary one.
  -->
  <Target Name="NfiPublishViaScript"
          AfterTargets="Publish"
          Condition="'$(NfiPublishingViaScript)' != 'true' And '$(BuildingInsideVisualStudio)' == 'true'">
    <Message Importance="high" Text="Publishing the graph CLI through tools/publish-graph-cli.ps1 ..." />
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\publish-graph-cli.ps1&quot;" />
  </Target>

  <!--
    A publish profile must not aim at tools/graph-cli itself, and this refuses before anything is deleted.
    Publish profiles are gitignored, so this guard is the only part that travels with the repo — and the
    profile it was written for did exactly this: PublishDir straight at the live folder plus
    DeleteExistingFiles, which wipes it and then copies. Hit one locked file partway through that copy and
    the folder is left gutted; what survived last time was nfi.exe alone, an apphost stub that still runs and
    silently executes whatever nfi.dll it can find. The script exists because the destination has to be
    written whole or not at all, and it cannot promise that if the button has already emptied it.

    The publish itself is not blocked, only its destination: point the profile anywhere scratch (its output
    is discarded) and the target above republishes properly through the script.
  -->
  <Target Name="NfiRefusePublishOverLiveTools"
          BeforeTargets="Publish"
          Condition="'$(NfiPublishingViaScript)' != 'true' And '$(PublishDir)' != ''">
    <PropertyGroup>
      <_NfiLiveTools>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\tools\graph-cli'))</_NfiLiveTools>
      <_NfiPublishDir>$([MSBuild]::NormalizeDirectory('$(PublishDir)'))</_NfiPublishDir>
    </PropertyGroup>
    <Error Condition="'$(_NfiPublishDir)' == '$(_NfiLiveTools)'"
           Text="This profile publishes straight into $(_NfiLiveTools), which is the exe everyone runs. A partial copy there leaves a working-looking nfi.exe running stale code. Point PublishDir at a scratch folder (bin\vs-publish) — the Publish button then republishes properly via tools/publish-graph-cli.ps1 — or run that script directly." />
  </Target>

</Project>
