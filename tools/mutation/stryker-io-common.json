{
  "stryker-config": {
    "solution": "Nexaflow.slnx",
    "project": "Nexaflow.IO.Common.csproj",
    "test-projects": [
      "src/Nexaflow.Tests/Nexaflow.Tests.IO/Nexaflow.Tests.IO.csproj"
    ],
    "test-runner": "mtp",
    "target-framework": "net10.0",
    "mutate": [
      "**/*.cs",
      "!**/obj/**",
      "!**/bin/**"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 60
    }
  }
}
