{
  "stryker-config": {
    "project": "Nexaflow.Services.Initiatives.csproj",
    "test-runner": "mtp",
    "target-framework": "net10.0",
    "mutate": [
      "**/Product/Services/*.cs",
      "**/Graph/*.cs",
      "**/Graph/Communities/*.cs",
      "!**/*Report.cs",
      "!**/ProductMarkdown.cs",
      "!**/Model/**",
      "!**/obj/**",
      "!**/bin/**"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 55
    }
  }
}
