{
  "stryker-config": {
    "solution": "Nexaflow.slnx",
    "project": "Nexaflow.Services.Initiatives.csproj",
    "test-projects": [
      "src/Nexaflow.Tests/Nexaflow.Tests.Initiatives/Nexaflow.Tests.Initiatives.csproj"
    ],
    "test-runner": "mtp",
    "target-framework": "net10.0",
    "mutate": [
      "**/Product/Services/*.cs",
      "**/Product/Model/*.cs",
      "**/Graph/*.cs",
      "!**/obj/**",
      "!**/bin/**"
    ],
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 60
    }
  }
}
