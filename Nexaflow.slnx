  <!-- WPF-free Portable Executable reader: headers, imports/exports, resources, entropy,
       Authenticode. Reaches the app transitively through Nexaflow.Features.Executable. -->
  <Project Path="src/Nexaflow.IO.Pe/Nexaflow.IO.Pe.csproj">
    <Platform Project="x64" />
  </Project>
  <!-- WPF-free network leaf: device graph, discovery contracts, send guard, transports. -->
  <!-- The DynamicProtocol engine. Zero refs by design: no socket API is in scope, so a protocol
       document cannot reach the network from here even by accident. -->
  <Project Path="src/Nexaflow.IO.Protocol/Nexaflow.IO.Protocol.csproj">
