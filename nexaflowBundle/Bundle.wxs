<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="Nexaflow"
          Version="$(var.AppVersion)"
          Manufacturer="Smile-forge"
          IconSourceFile="..\src\Nexaflow.Core\Appicon.ico"
          UpgradeCode="{58063FC5-A853-43D8-8A7B-5B4C3C81D569}">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="hyperlinkLicense"
        ThemeFile="Theme.xml"
        LocalizationFile="Theme.wxl"
        LicenseUrl=""
        ShowVersion="yes"
        LaunchTarget="[ProgramFiles64Folder]Smile-forge\Nexaflow\Nexaflow.exe"
        LaunchWorkingFolder="[ProgramFiles64Folder]Smile-forge\Nexaflow" />
      <Payload SourceFile="bundlebanner.png" />
    </BootstrapperApplication>

    <!-- .NET writes a DWORD per installed patch under this key, in the 32-bit registry view
         (WOW6432Node) even for the x64 runtime — hence Bitness="always32". Update Value= when
         bundling a newer 10.0.x patch. A same-or-newer runtime that lacks this exact value is
         still handled: the runtime installer returns 1638, mapped to success on the package below. -->
    <util:RegistrySearch
        Id="NetDesktop10Search"
        Variable="NetDesktop10Installed"
        Root="HKLM"
        Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App"
        Value="10.0.8"
        Result="exists"
        Bitness="always32" />

    <!--
      Opt-in for the MSI's Tools feature, surfaced as a checkbox on the theme's Options page and passed
      through as a property below. Off by default. Overridable so an unattended install can request it:
      nexaflowBundle.exe /quiet InstallTools=1
    -->
    <Variable Name="InstallTools" bal:Overridable="yes" Type="numeric" Value="0" />

    <!--
      Backs the Options page's "Install location" box. It was never declared, so the box opened EMPTY
      and the page could not be completed without typing a path by hand — and since the Tools checkbox
      shares that page, opting into nfi.exe meant inventing an install path first.

      Defaulted to where the MSI puts itself anyway (ProgramFiles ▸ Manufacturer ▸ ProductName — see
      Folders.wxs), so the page is answerable by pressing Next. Overridable so an unattended install can
      redirect it alongside InstallTools.

      Type MUST be "formatted", not "string": Burn stores a string variable's value verbatim and does not
      recursively format it, so [InstallFolder] would expand to the literal text "[ProgramFiles64Folder]…"
      and the MSI would try to install to a folder of that name. "formatted" evaluates the value when it
      is read, which is what turns the token into a real path.
    -->
    <Variable Name="InstallFolder" bal:Overridable="yes" Type="formatted"
              Value="[ProgramFiles64Folder]Smile-forge\Nexaflow" />

    <Chain>
      <ExePackage Id="NetDesktopRuntime10"
                  DisplayName=".NET 10 Desktop Runtime (x64)"
                  DetectCondition="NetDesktop10Installed"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart"
                  UninstallArguments="/uninstall /quiet /norestart"
                  Permanent="yes"
                  Vital="yes">
        <ExePackagePayload Name="windowsdesktop-runtime-10.0.8-win-x64.exe"
                           DownloadUrl="https://dotnetcli.azureedge.net/dotnet/WindowsDesktop/10.0.8/windowsdesktop-runtime-10.0.8-win-x64.exe"
                           Hash="8DDE7D1FE5D1934D386C01AC208E1A9DEBC1AFA2448C5404E969C3BDEE36B2DBAA9CFF999452BD26181659F27F3EEFFE200AC223C26A2196DC563BEF0536CA1E"
                           Size="59968752"
                           Version="10.0.8.0" />
        <!-- 1638 = "a same-or-newer version is already installed": the dependency is satisfied, so
             treat it as success rather than failing the (Vital) chain. 3010 = reboot needed. -->
        <ExitCode Value="1638" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <MsiPackage Id="NexaflowApp"
                  SourceFile="$(var.nexaflowSetup.TargetPath)"
                  Visible="no"
                  Vital="yes">
        <!-- Drives the MSI's Tools feature Level (Package.wxs). The MSI declares INSTALLTOOLS
             Secure="yes" so it survives the handoff to the elevated execute sequence. -->
        <MsiProperty Name="INSTALLTOOLS" Value="[InstallTools]" />
        <!-- Hands the Options page's location to the MSI. Without it the path was collected and then
             ignored — the MSI fell back to its own default, so the box was decorative as well as blank. -->
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
      </MsiPackage>
    </Chain>

  </Bundle>
</Wix>
