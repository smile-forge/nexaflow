<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="Nexaflow"
          Version="$(var.AppVersion)"
          Manufacturer="Smile-forge"
          IconSourceFile="..\src\Nexaflow.Core\Appicon.ico"
          UpgradeCode="{58063FC5-A853-43D8-8A7B-5B4C3C81D569}">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="hyperlinkLicense"
        ThemeFile="Theme.xml"
        LocalizationFile="Theme.wxl"
        LicenseUrl=""
        ShowVersion="yes"
        LaunchTarget="[ProgramFiles64Folder]Smile-forge\Nexaflow\Nexaflow.exe"
        LaunchWorkingFolder="[ProgramFiles64Folder]Smile-forge\Nexaflow" />
      <Payload SourceFile="bundlebanner.png" />
    </BootstrapperApplication>

    <!-- .NET writes a DWORD per installed patch under this key, in the 32-bit registry view
         (WOW6432Node) even for the x64 runtime — hence Bitness="always32". Update Value= when
         bundling a newer 10.0.x patch. A same-or-newer runtime that lacks this exact value is
         still handled: the runtime installer returns 1638, mapped to success on the package below. -->
    <util:RegistrySearch
        Id="NetDesktop10Search"
        Variable="NetDesktop10Installed"
        Root="HKLM"
        Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App"
        Value="10.0.8"
        Result="exists"
        Bitness="always32" />

    <!-- The Visual C++ runtime the native libraries load: llama.cpp, ONNX Runtime and onnxruntime-genai in the AI
         host, whisper and assimp in the app. The x64 redistributable records itself under this key in the 64-bit
         view. A DLL needs a runtime at least as new as the toolset that linked it, so the minimum the package below
         detects is the newest linker version among those DLLs' PE headers - 14.44. Raise it when a native
         dependency is built with a newer toolset; the payload itself can be newer than the minimum. -->
    <util:RegistrySearch
        Id="VCRuntimeX64InstalledSearch"
        Variable="VCRuntimeX64Installed"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
        Value="Installed"
        Result="value"
        Bitness="always64" />
    <util:RegistrySearch
        Id="VCRuntimeX64MinorSearch"
        Variable="VCRuntimeX64Minor"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
        Value="Minor"
        Result="value"
        Bitness="always64" />

    <!--
      Opt-in for the MSI's Tools feature, surfaced as the checkbox on the theme's Install page and passed
      through as INSTALLTOOLS below. Overridable so an unattended install can decide it:
      nexaflowBundle.exe /quiet InstallTools=1   (or InstallTools=0 to take the tools away on an upgrade)

      Left alone, it starts as whatever is installed now, so an upgrade keeps the tools someone already has
      and the checkbox opens showing that. "auto" is the only value that lets the search below run: a value
      from the command line replaces it, so what was asked for is never overwritten by what was found. The
      search writes 1 or 0, which is what the checkbox reads; "auto" left unresolved reads as unticked.
    -->
    <Variable Name="InstallTools" bal:Overridable="yes" Type="string" Value="auto" />

    <!--
      ToolsOnPath is the key path of the Tools feature's PATH component (Folders.wxs), so it exists exactly
      when the feature is installed. HKMU in a per-machine x64 package is HKLM's 64-bit view.
    -->
    <util:RegistrySearch
        Id="ToolsInstalledSearch"
        Variable="InstallTools"
        Condition="InstallTools = &quot;auto&quot;"
        Root="HKLM"
        Key="SOFTWARE\Smile-forge\Nexaflow"
        Value="ToolsOnPath"
        Result="exists"
        Bitness="always64" />

    <!--
      The choice of the MSI's ExplorerMenu feature ("Open in Nexaflow" on Explorer's right-click menu), the checkbox
      under InstallTools and passed through as INSTALLEXPLORERMENU below. Overridable like InstallTools:
      nexaflowBundle.exe /quiet InstallExplorerMenu=0

      Left alone it is on, except over an install where someone turned it off. The two searches tell those apart:
      ExplorerMenuOffered is written by every version that has the menu, ExplorerMenu only while the menu is installed
      (ExplorerMenu.wxs), so offered-and-absent is the one case that reads 0. Never offered - a fresh install, or one
      from before the menu - is left "auto", which the SetVariable turns on. A value from the command line replaces
      "auto", so neither search nor default overrides it.
    -->
    <Variable Name="InstallExplorerMenu" bal:Overridable="yes" Type="string" Value="auto" />

    <util:RegistrySearch
        Id="ExplorerMenuOfferedSearch"
        Variable="ExplorerMenuOffered"
        Root="HKLM"
        Key="SOFTWARE\Smile-forge\Nexaflow"
        Value="ExplorerMenuOffered"
        Result="exists"
        Bitness="always64" />
    <util:RegistrySearch
        Id="ExplorerMenuInstalledSearch"
        After="ExplorerMenuOfferedSearch"
        Variable="InstallExplorerMenu"
        Condition="InstallExplorerMenu = &quot;auto&quot; AND ExplorerMenuOffered"
        Root="HKLM"
        Key="SOFTWARE\Smile-forge\Nexaflow"
        Value="ExplorerMenu"
        Result="exists"
        Bitness="always64" />
    <SetVariable
        Id="ExplorerMenuByDefault"
        After="ExplorerMenuInstalledSearch"
        Variable="InstallExplorerMenu"
        Condition="InstallExplorerMenu = &quot;auto&quot;"
        Value="1" />

    <!--
      Backs the Options page's "Install location" box. It was never declared, so the box opened EMPTY
      and the page could not be completed without typing a path by hand — and since the Tools checkbox
      shares that page, opting into nfi.exe meant inventing an install path first.

      Defaulted to where the MSI puts itself anyway (ProgramFiles ▸ Manufacturer ▸ ProductName — see
      Folders.wxs), so the page is answerable by pressing Next. Overridable so an unattended install can
      redirect it alongside InstallTools.

      Type MUST be "formatted", not "string": Burn stores a string variable's value verbatim and does not
      recursively format it, so [InstallFolder] would expand to the literal text "[ProgramFiles64Folder]…"
      and the MSI would try to install to a folder of that name. "formatted" evaluates the value when it
      is read, which is what turns the token into a real path.
    -->
    <Variable Name="InstallFolder" bal:Overridable="yes" Type="formatted"
              Value="[ProgramFiles64Folder]Smile-forge\Nexaflow" />

    <Chain>
      <ExePackage Id="NetDesktopRuntime10"
                  DisplayName=".NET 10 Desktop Runtime (x64)"
                  DetectCondition="NetDesktop10Installed"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart"
                  UninstallArguments="/uninstall /quiet /norestart"
                  Permanent="yes"
                  Vital="yes">
        <ExePackagePayload Name="windowsdesktop-runtime-10.0.8-win-x64.exe"
                           DownloadUrl="https://dotnetcli.azureedge.net/dotnet/WindowsDesktop/10.0.8/windowsdesktop-runtime-10.0.8-win-x64.exe"
                           Hash="8DDE7D1FE5D1934D386C01AC208E1A9DEBC1AFA2448C5404E969C3BDEE36B2DBAA9CFF999452BD26181659F27F3EEFFE200AC223C26A2196DC563BEF0536CA1E"
                           Size="59968752"
                           Version="10.0.8.0" />
        <!-- 1638 = "a same-or-newer version is already installed": the dependency is satisfied, so
             treat it as success rather than failing the (Vital) chain. 3010 = reboot needed. -->
        <ExitCode Value="1638" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <ExePackage Id="VCRuntimeX64"
                  DisplayName="Microsoft Visual C++ v14 Redistributable (x64)"
                  DetectCondition="VCRuntimeX64Installed = 1 AND VCRuntimeX64Minor >= 44"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart"
                  UninstallArguments="/uninstall /quiet /norestart"
                  Permanent="yes"
                  Vital="yes">
        <!-- A versioned link rather than the permanent aka.ms/vs/18/release/vc_redist.x64.exe: Burn refuses a
             download whose hash and size differ from those pinned here, and the permanent link moves to each new
             redistributable, so it would break the install the day Microsoft ships the next one. -->
        <ExePackagePayload Name="vc_redist-14.51.36247-x64.exe"
                           DownloadUrl="https://download.visualstudio.microsoft.com/download/pr/ebdab8e5-1d7b-4d9f-a11b-cbb1720c3b12/843068991DAAA1F73AD9F6239BCE4D0F6A07A51F18C37EA2A867E9BECA71295C/VC_redist.x64.exe"
                           Hash="C42C82CFD5EAA2165B600F6109CB14FF4308CDF4CFF656A1375B4A933F1630BFE54C99C4D0FB9ED3BEA4DC4E4FDAA3DB8E7C58356CCA07C2954F4C297757D62D"
                           Size="18731856"
                           Version="14.51.36247.0" />
        <!-- 1638 = a newer runtime than the payload is already installed: satisfied. 3010 = reboot needed. -->
        <ExitCode Value="1638" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <MsiPackage Id="NexaflowApp"
                  SourceFile="$(var.nexaflowSetup.TargetPath)"
                  Visible="no"
                  Vital="yes">
        <!-- Drives the MSI's Tools feature Level (Package.wxs), which decides it alone because the MSI
             does not migrate feature states on upgrade. The MSI declares INSTALLTOOLS Secure="yes" so it
             survives the handoff to the elevated execute sequence. -->
        <MsiProperty Name="INSTALLTOOLS" Value="[InstallTools]" />
        <!-- Drives the ExplorerMenu feature's Level the same way. -->
        <MsiProperty Name="INSTALLEXPLORERMENU" Value="[InstallExplorerMenu]" />
        <!-- Hands the Options page's location to the MSI. Without it the path was collected and then
             ignored — the MSI fell back to its own default, so the box was decorative as well as blank. -->
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
      </MsiPackage>
    </Chain>

  </Bundle>
</Wix>
