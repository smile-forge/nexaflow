<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="Nexaflow"
          Version="$(var.AppVersion)"
          Manufacturer="Smile-forge"
          UpgradeCode="{58063FC5-A853-43D8-8A7B-5B4C3C81D569}">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="hyperlinkLicense"
        LicenseUrl=""
        ShowVersion="yes" />
    </BootstrapperApplication>

    <!-- .NET installs a DWORD value named after each version under this key.
         Update Value= when targeting a newer 10.0.x patch. -->
    <util:RegistrySearch
        Id="NetDesktop10Search"
        Variable="NetDesktop10Installed"
        Root="HKLM"
        Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App"
        Value="10.0.8"
        Result="exists" />

    <Chain>
      <ExePackage Id="NetDesktopRuntime10"
                  DisplayName=".NET 10 Desktop Runtime (x64)"
                  DetectCondition="NetDesktop10Installed"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart"
                  UninstallArguments="/uninstall /quiet /norestart"
                  Permanent="yes"
                  Vital="yes">
        <ExePackagePayload Name="windowsdesktop-runtime-10.0.8-win-x64.exe"
                           DownloadUrl="https://dotnetcli.azureedge.net/dotnet/WindowsDesktop/10.0.8/windowsdesktop-runtime-10.0.8-win-x64.exe"
                           Hash="8DDE7D1FE5D1934D386C01AC208E1A9DEBC1AFA2448C5404E969C3BDEE36B2DBAA9CFF999452BD26181659F27F3EEFFE200AC223C26A2196DC563BEF0536CA1E"
                           Size="59968752"
                           Version="10.0.8.0" />
      </ExePackage>

      <MsiPackage Id="NexaflowApp"
                  SourceFile="$(var.nexaflowSetup.TargetPath)"
                  Vital="yes" />
    </Chain>

  </Bundle>
</Wix>
