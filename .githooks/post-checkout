#!/bin/sh
# post-checkout — runs after `git checkout` / `git switch` / `git worktree add`.
#
# Populate any *uninitialised* submodules so a freshly-created worktree has its external/
# ProjectReference targets (external/DiscUtils, external/xaml-math) on disk before Visual Studio
# opens — so "create a worktree, open VS, hit F5" just works instead of failing on missing .csproj.
#
# Delegates to the shared, safe-and-idempotent helper (it only touches submodules that are not yet
# checked out; it never resets an already-checked-out one). See docs/externals.md.
#
# Enabled via `git config core.hooksPath .githooks` (one-time, per clone).

# A checkout hook runs with GIT_DIR pointed at the (new) worktree; clear it so the helper can
# rediscover the repo cleanly from the working-tree root.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
script="$root/tools/ensure-submodules.ps1"
[ -f "$script" ] || exit 0

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File "$script"
elif command -v powershell >/dev/null 2>&1; then
    powershell -NoProfile -ExecutionPolicy Bypass -File "$script"
fi

exit 0
